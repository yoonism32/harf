":"فَعَّالٌۭ","kind":"word","gloss":"Doer","transliteration":"faʿʿālun","lemma":"فَعَّال","root":"فعل","entryId":null},{"key":"85:16:2","position":2,"arabic":"لِّمَا","kind":"word","gloss":"of what","transliteration":"limā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"85:16:3","position":3,"arabic":"يُرِيدُ","kind":"word","gloss":"He intends","transliteration":"yurīdu","lemma":"أَرَادَ","root":"رود","entryId":"l-1eaa86c69a1267cc"},{"key":"85:16:4","position":4,"arabic":"١٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"85:17","translation":"Has the story reached you of the hosts,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"85:17:1","position":1,"arabic":"هَلْ","kind":"word","gloss":"Has","transliteration":"hal","lemma":"هَل","root":null,"entryId":"l-acd15f3532f2b613"},{"key":"85:17:2","position":2,"arabic":"أَتَىٰكَ","kind":"word","gloss":"come to you","transliteration":"atāka","lemma":"أَتَى","root":"اتي","entryId":"l-491a40b1f8d047fe"},{"key":"85:17:3","position":3,"arabic":"حَدِيثُ","kind":"word","gloss":"(the) story","transliteration":"ḥadīthu","lemma":"حَدِيث","root":"حدث","entryId":null},{"key":"85:17:4","position":4,"arabic":"ٱلْجُنُودِ","kind":"word","gloss":"(of) the hosts","transliteration":"l-junūdi","lemma":"جُند","root":"جند","entryId":null},{"key":"85:17:5","position":5,"arabic":"١٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"85:18","translation":"Of Fir‘aun (Pharaoh) and Thamûd?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"85:18:1","position":1,"arabic":"فِرْعَوْنَ","kind":"word","gloss":"Firaun","transliteration":"fir'ʿawna","lemma":"فِرْعَوْن","root":null,"entryId":"l-59e880136eb31a4d"},{"key":"85:18:2","position":2,"arabic":"وَثَمُودَ","kind":"word","gloss":"and Thamud","transliteration":"wathamūda","lemma":"ثَمُود","root":null,"entryId":null},{"key":"85:18:3