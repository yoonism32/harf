":"113:4:6","position":6,"arabic":"٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"113:5","translation":"\"And from the evil of the envier when he envies.\"","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"113:5:1","position":1,"arabic":"وَمِن","kind":"word","gloss":"And from","transliteration":"wamin","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"113:5:2","position":2,"arabic":"شَرِّ","kind":"word","gloss":"(the) evil","transliteration":"sharri","lemma":"شَرّ","root":"شرر","entryId":null},{"key":"113:5:3","position":3,"arabic":"حَاسِدٍ","kind":"word","gloss":"(of) an envier","transliteration":"ḥāsidin","lemma":"حَاسِد","root":"حسد","entryId":null},{"key":"113:5:4","position":4,"arabic":"إِذَا","kind":"word","gloss":"when","transliteration":"idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"113:5:5","position":5,"arabic":"حَسَدَ","kind":"word","gloss":"he envies","transliteration":"ḥasada","lemma":"حَسَدَ","root":"حسد","entryId":null},{"key":"113:5:6","position":6,"arabic":"٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]}]