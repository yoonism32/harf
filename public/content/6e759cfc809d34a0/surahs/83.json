":"83:19:5","position":5,"arabic":"١٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"83:20","translation":"A Register inscribed,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"83:20:1","position":1,"arabic":"كِتَـٰبٌۭ","kind":"word","gloss":"A book","transliteration":"kitābun","lemma":"كِتَٰب","root":"كتب","entryId":"l-a68c915be321aa35"},{"key":"83:20:2","position":2,"arabic":"مَّرْقُومٌۭ","kind":"word","gloss":"written","transliteration":"marqūmun","lemma":"مَّرْقُوم","root":"رقم","entryId":null},{"key":"83:20:3","position":3,"arabic":"٢٠","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"83:21","translation":"To which bear witness those nearest (to Allâh, i.e. the angels).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"83:21:1","position":1,"arabic":"يَشْهَدُهُ","kind":"word","gloss":"Witness it","transliteration":"yashhaduhu","lemma":"شَهِدَ","root":"شهد","entryId":"l-1bfee933281e7987"},{"key":"83:21:2","position":2,"arabic":"ٱلْمُقَرَّبُونَ","kind":"word","gloss":"those brought near","transliteration":"l-muqarabūna","lemma":"مُقَرَّبُون","root":"قرب","entryId":null},{"key":"83:21:3","position":3,"arabic":"٢١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"83:22","translation":"Verily, Al-Abrâr (the pious believers of Islamic Monotheism) will be in Delight (Paradise).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"83:22:1","position":1,"arabic":"إِنَّ","kind":"word","gloss":"Indeed","transliteration":"inna","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"83:22:2","position":2,"arabic":"ٱلْأَبْرَارَ","kind":"word","gloss":"the righteous","transliteration":"l-abrāra","lemma":"بَرّ","root":"برر","entryId":null},{"key":"83:22:3","position":3,"arabic":"لَفِى","kind":"word","gloss":"(will be) surely in","translite