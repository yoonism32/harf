":"word","gloss":"that","transliteration":"dhālika","lemma":"ذَٰلِك","root":null,"entryId":"l-096a9ad382db7640"},{"key":"83:26:5","position":5,"arabic":"فَلْيَتَنَافَسِ","kind":"word","gloss":"let aspire","transliteration":"falyatanāfasi","lemma":null,"root":"نفس","entryId":null},{"key":"83:26:6","position":6,"arabic":"ٱلْمُتَنَـٰفِسُونَ","kind":"word","gloss":"the aspirers","transliteration":"l-mutanāfisūna","lemma":"مُتَنَٰفِسُون","root":"نفس","entryId":null},{"key":"83:26:7","position":7,"arabic":"٢٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"83:27","translation":"It (that wine) will be mixed with Tasnîm:","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"83:27:1","position":1,"arabic":"وَمِزَاجُهُۥ","kind":"word","gloss":"And its mixture","transliteration":"wamizājuhu","lemma":"مِزَاج","root":"مزج","entryId":null},{"key":"83:27:2","position":2,"arabic":"مِن","kind":"word","gloss":"(is) of","transliteration":"min","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"83:27:3","position":3,"arabic":"تَسْنِيمٍ","kind":"word","gloss":"Tasneem","transliteration":"tasnīmin","lemma":"تَسْنِيم","root":"سنم","entryId":null},{"key":"83:27:4","position":4,"arabic":"٢٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"83:28","translation":"A spring whereof drink those nearest to Allâh.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"83:28:1","position":1,"arabic":"عَيْنًۭا","kind":"word","gloss":"A spring","transliteration":"ʿaynan","lemma":"عَيْن","root":"عين","entryId":"l-1b5ec51c16058996"},{"key":"83:28:2","position":2,"arabic":"يَشْرَبُ","kind":"word","gloss":"will drink","transliteration":"yashrabu","lemma":"شَرِبَ","root":"شرب","entryId":null},{"key":"83:28:3","position":3,"arabic":"بِهَا","kind":"word","gloss":"from it","transliteration":"bihā","lemma":null,"root":null,"entryId":null},{"key":"83:28