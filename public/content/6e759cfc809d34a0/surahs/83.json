[{"ref":"83:1","translation":"Woe to Al-Mutaffifûn (those who give less in measure and weight).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"83:1:1","position":1,"arabic":"وَيْلٌۭ","kind":"word","gloss":"Woe","transliteration":"waylun","lemma":"وَيْل","root":null,"entryId":"l-d11f2adf827dd758"},{"key":"83:1:2","position":2,"arabic":"لِّلْمُطَفِّفِينَ","kind":"word","gloss":"to those who give less","transliteration":"lil'muṭaffifīna","lemma":"مُطَفِّفِين","root":"طفف","entryId":null},{"key":"83:1:3","position":3,"arabic":"١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"83:2","translation":"Those who, when they have to receive by measure from men, demand full measure,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"83:2:1","position":1,"arabic":"ٱلَّذِينَ","kind":"word","gloss":"Those who","transliteration":"alladhīna","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"83:2:2","position":2,"arabic":"إِذَا","kind":"word","gloss":"when","transliteration":"idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"83:2:3","position":3,"arabic":"ٱكْتَالُوا۟","kind":"word","gloss":"they take a measure","transliteration":"ik'tālū","lemma":"اكْتَالُ","root":"كيل","entryId":null},{"key":"83:2:4","position":4,"arabic":"عَلَى","kind":"word","gloss":"from","transliteration":"ʿalā","lemma":"عَلَىٰ","root":null,"entryId":"l-08dd9283adb70e54"},{"key":"83:2:5","position":5,"arabic":"ٱلنَّاسِ","kind":"word","gloss":"the people","transliteration":"l-nāsi","lemma":"نَّاس","root":"نوس","entryId":"l-490d7f2d4cbaf6d4"},{"key":"83:2:6","position":6,"arabic":"يَسْتَوْفُونَ","kind":"word","gloss":"they take in full","transliteration":"yastawfūna","lemma":"يَسْتَوْفُ","root":"وفي","entryId":null},{"key":"83:2:7","position":7,"arabic":"٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"83:3","transl