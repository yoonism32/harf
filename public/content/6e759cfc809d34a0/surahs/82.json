[{"ref":"82:1","translation":"When the heaven is cleft asunder.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"82:1:1","position":1,"arabic":"إِذَا","kind":"word","gloss":"When","transliteration":"idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"82:1:2","position":2,"arabic":"ٱلسَّمَآءُ","kind":"word","gloss":"the sky","transliteration":"l-samāu","lemma":"سَمَآء","root":"سمو","entryId":"l-e873a75addf25baf"},{"key":"82:1:3","position":3,"arabic":"ٱنفَطَرَتْ","kind":"word","gloss":"(is) cleft asunder","transliteration":"infaṭarat","lemma":"انفَطَرَتْ","root":"فطر","entryId":null},{"key":"82:1:4","position":4,"arabic":"١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"82:2","translation":"And when the stars have fallen and scattered.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"82:2:1","position":1,"arabic":"وَإِذَا","kind":"word","gloss":"And when","transliteration":"wa-idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"82:2:2","position":2,"arabic":"ٱلْكَوَاكِبُ","kind":"word","gloss":"the stars","transliteration":"l-kawākibu","lemma":"كَوْكَب","root":"كوكب","entryId":null},{"key":"82:2:3","position":3,"arabic":"ٱنتَثَرَتْ","kind":"word","gloss":"scatter","transliteration":"intatharat","lemma":"انتَثَرَتْ","root":"نثر","entryId":null},{"key":"82:2:4","position":4,"arabic":"٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"82:3","translation":"And when the seas are burst forth.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"82:3:1","position":1,"arabic":"وَإِذَا","kind":"word","gloss":"And when","transliteration":"wa-idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"82:3:2","position":2,"arabic":"ٱلْبِحَارُ","kind":"word","gloss":"the seas","transliteration":"l-biḥāru","lemma":"بَحْر","root":"بحر","entryId":"l-2d6cae9206a34f68"},{"key":"82:3:3","position":3,"arabic":"فُجِّرَتْ","kind":"word","gloss":"are made to gush forth","transliteration":"fujjirat","lemma":"فُجِّرَتْ","root":"فجر","entryId":null},{"key":"82:3:4","position":4,"arabic":"٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"82:4","translation":"And when the graves are turned upside down (and bring out their contents)","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"82:4:1","position":1,"arabic":"وَإِذَا","kind":"word","gloss":"And when","transliteration":"wa-idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"82:4:2","position":2,"arabic":"ٱلْقُبُورُ","kind":"word","gloss":"the graves","transliteration":"l-qubūru","lemma":"قَبْر","root":"قبر","entryId":null},{"key":"82:4:3","position":3,"arabic":"بُعْثِرَتْ","kind":"word","gloss":"are overturned","transliteration":"buʿ'thirat","lemma":"بُعْثِرَ","root":"بعثر","entryId":null},{"key":"82:4:4","position":4,"arabic":"٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"82:5","translation":"(Then) a person will know what he has sent forward and (what he has) left behind (of good or bad deeds).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"82:5:1","position":1,"arabic":"عَلِمَتْ","kind":"word","gloss":"Will know","transliteration":"ʿalimat","lemma":"عَلِمَ","root":"علم","entryId":"l-6de9979b254804ea"},{"key":"82:5:2","position":2,"arabic":"نَفْسٌۭ","kind":"word","gloss":"a soul","transliteration":"nafsun","lemma":"نَفْس","root":"نفس","entryId":"l-95a2521e875a8b29"},{"key":"82:5:3","position":3,"arabic":"مَّا","kind":"word","gloss":"what","transliteration":"mā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"82:5:4","position":4,"arabic":"قَدَّمَتْ","kind":"word","gloss":"it has sent forth","transliteration":"qaddamat","lemma":"قَدَّمَ","root":"قدم","entryId":null},{"key":"82:5:5","position":5,"arabic":"وَأَخَّرَتْ","kind":"word","gloss":"and left behind","transliteration":"wa-akharat","lemma":"أَخَّرَ","root":"اخر","entryId":null},{"key":"82:5:6","position":6,"arabic":"٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"82:6","translation":"O man! What has made you careless about your Lord, the Most Generous?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"82:6:1","position":1,"arabic":"يَـٰٓأَيُّهَا","kind":"word","gloss":"O","transliteration":"yāayyuhā","lemma":"أَيُّهَا","root":"ايي","entryId":"l-a3fa5dd17841b221"},{"key":"82:6:2","position":2,"arabic":"ٱلْإِنسَـٰنُ","kind":"word","gloss":"man","transliteration":"l-insānu","lemma":"إِنسَٰن","root":"انس","entryId":"l-bec7f7166ce0ed1b"},{"key":"82:6:3","position":3,"arabic":"مَا","kind":"word","gloss":"What","transliteration":"mā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"82:6:4","position":4,"arabic":"غَرَّكَ","kind":"word","gloss":"has deceived you","transliteration":"gharraka","lemma":"غَرَّ","root":"غرر","entryId":null},{"key":"82:6:5","position":5,"arabic":"بِرَبِّكَ","kind":"word","gloss":"concerning your Lord","transliteration":"birabbika","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"82:6:6","position":6,"arabic":"ٱلْكَرِيمِ","kind":"word","gloss":"the Most Noble","transliteration":"l-karīmi","lemma":"كَرِيم","root":"كرم","entryId":null},{"key":"82:6:7","position":7,"arabic":"٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"82:7","translation":"Who created you, fashioned you perfectly, and gave you due proportion.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"82:7:1","position":1,"arabic":"ٱلَّذِى","kind":"word","gloss":"Who","transliteration":"alladhī","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"82:7:2","position":2,"arabic":"خَلَقَكَ","kind":"word","gloss":"created you","transliteration":"khalaqaka","lemma":"خَلَقَ","root":"خلق","entryId":"l-9e7414ba00a88ddc"},{"key":"82:7:3","position":3,"arabic":"فَسَوَّىٰكَ","kind":"word","gloss":"then fashioned you","transliteration":"fasawwāka","lemma":"سَوَّىٰ","root":"سوي","entryId":null},{"key":"82:7:4","position":4,"arabic":"فَعَدَلَكَ","kind":"word","gloss":"then balanced you","transliteration":"faʿadalaka","lemma":"عَدَلَ","root":"عدل","entryId":null},{"key":"82:7:5","position":5,"arabic":"٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"82:8","translation":"In whatever form He willed, He put you together.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"82:8:1","position":1,"arabic":"فِىٓ","kind":"word","gloss":"In","transliteration":"fī","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"82:8:2","position":2,"arabic":"أَىِّ","kind":"word","gloss":"whatever","transliteration":"ayyi","lemma":"أَىّ","root":"ايي","entryId":"l-1b17d6cf8e714c6a"},{"key":"82:8:3","position":3,"arabic":"صُورَةٍۢ","kind":"word","gloss":"form","transliteration":"ṣūratin","lemma":"صُورَة","root":"صور","entryId":null},{"key":"82:8:4","position":4,"arabic":"مَّا","kind":"word","gloss":"what","transliteration":"mā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"82:8:5","position":5,"arabic":"شَآءَ","kind":"word","gloss":"He willed","transliteration":"shāa","lemma":"شَآءَ","root":"شيا","entryId":"l-e6061b9230d95354"},{"key":"82:8:6","position":6,"arabic":"رَكَّبَكَ","kind":"word","gloss":"He assembled you","transliteration":"rakkabaka","lemma":"رَكَّبَ","root":"ركب","entryId":null},{"key":"82:8:7","position":7,"arabic":"٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"82:9","translation":"Nay! But you deny Ad-Dîn (i.e. the Day of Recompense).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"82:9:1","position":1,"arabic":"كَلَّا","kind":"word","gloss":"Nay","transliteration":"kallā","lemma":"كَلَّا","root":null,"entryId":null},{"key":"82:9:2","position":2,"arabic":"بَلْ","kind":"word","gloss":"But","transliteration":"bal","lemma":"بَل","root":null,"entryId":"l-706f9c6eca0445cc"},{"key":"82:9:3","position":3,"arabic":"تُكَذِّبُونَ","kind":"word","gloss":"you deny","transliteration":"tukadhibūna","lemma":"كَذَّبَ","root":"كذب","entryId":"l-db86b0654d661fb2"},{"key":"82:9:4","position":4,"arabic":"بِٱلدِّينِ","kind":"word","gloss":"the Judgment","transliteration":"bil-dīni","lemma":"دِين","root":"دين","entryId":"l-869ef1d12b24f52a"},{"key":"82:9:5","position":5,"arabic":"٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"82:10","translation":"But verily, over you (are appointed angels in charge of mankind) to watch you,","translationSource":"qul-301-hilali-khan","notes":[{"text":"Narrated Abu Hurairah رضي الله عنه: The Prophet صلى الله عليه وسلم said: \"Angels come (to you) in succession by night and day, and all of them get together at the time of the Fajr and ‘Asr prayers. Then those who have stayed with you overnight, ascend unto Allâh, Who asks them (and He knows the answer better than they): \"How have you left My slaves?\" They reply, \"We left them while they were praying and we came to them while they were praying\". The Prophet صلى الله عليه وسلم added: \"If anyone of you says Amîn (during the prayer at the end of the recitation of Sûrat Al-Fâtihah), and the angels in heaven say the same, and the two sayings coincide, all his past sins will be forgiven\". (Sahih Al-Bukhari, Vol.4, Hadith No.446).","ref":null}],"tokens":[{"key":"82:10:1","position":1,"arabic":"وَإِنَّ","kind":"word","gloss":"And indeed","transliteration":"wa-inna","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"82:10:2","position":2,"arabic":"عَلَيْكُمْ","kind":"word","gloss":"over you","transliteration":"ʿalaykum","lemma":"عَلَىٰ","root":null,"entryId":"l-08dd9283adb70e54"},{"key":"82:10:3","position":3,"arabic":"لَحَـٰفِظِينَ","kind":"word","gloss":"(are) surely guardians","transliteration":"laḥāfiẓīna","lemma":"حَٰفِظ","root":"حفظ","entryId":null},{"key":"82:10:4","position":4,"arabic":"١٠","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"82:11","translation":"Kirâman (Honourable) Kâtibîn writing down (your deeds),","translationSource":"qul-301-hilali-khan","notes":[{"text":"Whoever intended to do a good deed or a bad deed. Narrated Ibn ‘Abbâs رضي الله عنهما: The Prophet صلى الله عليه وسلم narrating about his Lord عز وجل said, \"Allâh ordered (the angels appointed over you) that the good and the bad deeds be written, and He then showed (the way) how (to write). If somebody intends to do a good deed and he does not do it, then Allâh will write for him a full good deed (in his account with Him); and if he intends to do a good deed and actually does it, then Allâh will write for him (in his account) with Him (its reward equal) from ten to seven hundred times, to many more times; and if somebody intends to do a bad deed and he does not do it, then Allâh will write a full good deed (in his account) with Him, and if he intends to do it (a bad deed) and actually does it, then Allâh will write one bad deed (in his account).\" (Sahih Al-Bukhari, Vol.8, Hadith No.498).","ref":null}],"tokens":[{"key":"82:11:1","position":1,"arabic":"كِرَامًۭا","kind":"word","gloss":"Noble","transliteration":"kirāman","lemma":"كَرِيم","root":"كرم","entryId":null},{"key":"82:11:2","position":2,"arabic":"كَـٰتِبِينَ","kind":"word","gloss":"recording","transliteration":"kātibīna","lemma":"كَاتِب","root":"كتب","entryId":null},{"key":"82:11:3","position":3,"arabic":"١١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"82:12","translation":"They know all that you do.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"82:12:1","position":1,"arabic":"يَعْلَمُونَ","kind":"word","gloss":"They know","transliteration":"yaʿlamūna","lemma":"عَلِمَ","root":"علم","entryId":"l-6de9979b254804ea"},{"key":"82:12:2","position":2,"arabic":"مَا","kind":"word","gloss":"whatever","transliteration":"mā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"82:12:3","position":3,"arabic":"تَفْعَلُونَ","kind":"word","gloss":"you do","transliteration":"tafʿalūna","lemma":"فَعَلَ","root":"فعل","entryId":"l-b0a120934c602e5e"},{"key":"82:12:4","position":4,"arabic":"١٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"82:13","translation":"Verily, the Abrâr (the pious believers of Islamic Monotheism) will be in Delight (Paradise);","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"82:13:1","position":1,"arabic":"إِنَّ","kind":"word","gloss":"Indeed","transliteration":"inna","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"82:13:2","position":2,"arabic":"ٱلْأَبْرَارَ","kind":"word","gloss":"the righteous","transliteration":"l-abrāra","lemma":"بَرّ","root":"برر","entryId":null},{"key":"82:13:3","position":3,"arabic":"لَفِى","kind":"word","gloss":"(will be) surely in","transliteration":"lafī","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"82:13:4","position":4,"arabic":"نَعِيمٍۢ","kind":"word","gloss":"bliss","transliteration":"naʿīmin","lemma":"نَعِيم","root":"نعم","entryId":null},{"key":"82:13:5","position":5,"arabic":"١٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"82:14","translation":"And verily, the Fujjâr (the wicked, disbelievers, polytheists, sinners and evil-doers) will be in the blazing Fire (Hell),","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"82:14:1","position":1,"arabic":"وَإِنَّ","kind":"word","gloss":"And indeed","transliteration":"wa-inna","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"82:14:2","position":2,"arabic":"ٱلْفُجَّارَ","kind":"word","gloss":"the wicked","transliteration":"l-fujāra","lemma":"فُجَّار","root":"فجر","entryId":null},{"key":"82:14:3","position":3,"arabic":"لَفِى","kind":"word","gloss":"(will be) surely in","transliteration":"lafī","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"82:14:4","position":4,"arabic":"جَحِيمٍۢ","kind":"word","gloss":"Hellfire","transliteration":"jaḥīmin","lemma":"جَحِيم","root":"جحم","entryId":null},{"key":"82:14:5","position":5,"arabic":"١٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"82:15","translation":"Therein they will enter, and taste its burning flame on the Day of Recompense,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"82:15:1","position":1,"arabic":"يَصْلَوْنَهَا","kind":"word","gloss":"They will burn (in) it","transliteration":"yaṣlawnahā","lemma":"يَصْلَى","root":"صلي","entryId":null},{"key":"82:15:2","position":2,"arabic":"يَوْمَ","kind":"word","gloss":"(on the) Day","transliteration":"yawma","lemma":"يَوْم","root":"يوم","entryId":"l-bd6f5747b4dfe79c"},{"key":"82:15:3","position":3,"arabic":"ٱلدِّينِ","kind":"word","gloss":"(of) the Judgment","transliteration":"l-dīni","lemma":"دِين","root":"دين","entryId":"l-869ef1d12b24f52a"},{"key":"82:15:4","position":4,"arabic":"١٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"82:16","translation":"And they (Al-Fujjâr) will not be absent therefrom.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"82:16:1","position":1,"arabic":"وَمَا","kind":"word","gloss":"And not","transliteration":"wamā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"82:16:2","position":2,"arabic":"هُمْ","kind":"word","gloss":"they","transliteration":"hum","lemma":null,"root":null,"entryId":null},{"key":"82:16:3","position":3,"arabic":"عَنْهَا","kind":"word","gloss":"from it","transliteration":"ʿanhā","lemma":"عَن","root":null,"entryId":"l-f1109a78c8548754"},{"key":"82:16:4","position":4,"arabic":"بِغَآئِبِينَ","kind":"word","gloss":"(will be) absent","transliteration":"bighāibīna","lemma":"غَآئِبِين","root":"غيب","entryId":null},{"key":"82:16:5","position":5,"arabic":"١٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"82:17","translation":"And what will make you know what the Day of Recompense is?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"82:17:1","position":1,"arabic":"وَمَآ","kind":"word","gloss":"And what","transliteration":"wamā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"82:17:2","position":2,"arabic":"أَدْرَىٰكَ","kind":"word","gloss":"can make you know","transliteration":"adrāka","lemma":"أَدْرَىٰ","root":"دري","entryId":null},{"key":"82:17:3","position":3,"arabic":"مَا","kind":"word","gloss":"what","transliteration":"mā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"82:17:4","position":4,"arabic":"يَوْمُ","kind":"word","gloss":"(is the) Day","transliteration":"yawmu","lemma":"يَوْم","root":"يوم","entryId":"l-bd6f5747b4dfe79c"},{"key":"82:17:5","position":5,"arabic":"ٱلدِّينِ","kind":"word","gloss":"(of) the Judgment","transliteration":"l-dīni","lemma":"دِين","root":"دين","entryId":"l-869ef1d12b24f52a"},{"key":"82:17:6","position":6,"arabic":"١٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"82:18","translation":"Again, what will make you know what the Day of Recompense is?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"82:18:1","position":1,"arabic":"ثُمَّ","kind":"word","gloss":"Then","transliteration":"thumma","lemma":"ثُمّ","root":null,"entryId":"l-75b66396af12da75"},{"key":"82:18:2","position":2,"arabic":"مَآ","kind":"word","gloss":"what","transliteration":"m