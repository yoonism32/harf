[{"ref":"80:1","translation":"(The Prophet صلى الله عليه وسلم) frowned and turned away.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"80:1:1","position":1,"arabic":"عَبَسَ","kind":"word","gloss":"He frowned","transliteration":"ʿabasa","lemma":"عَبَسَ","root":"عبس","entryId":null},{"key":"80:1:2","position":2,"arabic":"وَتَوَلَّىٰٓ","kind":"word","gloss":"and turned away","transliteration":"watawallā","lemma":"تَوَلَّىٰ","root":"ولي","entryId":"l-f32564c74acc4226"},{"key":"80:1:3","position":3,"arabic":"١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"80:2","translation":"Because there came to him the blind man (i.e. ‘Abdullâh bin Umm-Maktûm, who came to the Prophet صلى الله عليه وسلم while he was preaching to one or some of the Quraish chiefs).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"80:2:1","position":1,"arabic":"أَن","kind":"word","gloss":"Because","transliteration":"an","lemma":"أَن","root":null,"entryId":"l-6fb897ea8dfcda9d"},{"key":"80:2:2","position":2,"arabic":"جَآءَهُ","kind":"word","gloss":"came to him","transliteration":"jāahu","lemma":"جَآءَ","root":"جيا","entryId":"l-1abf61bfcb8fdd4c"},{"key":"80:2:3","position":3,"arabic":"ٱلْأَعْمَىٰ","kind":"word","gloss":"the blind man","transliteration":"l-aʿmā","lemma":"أَعْمَىٰ","root":"عمي","entryId":null},{"key":"80:2:4","position":4,"arabic":"٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"80:3","translation":"And how can you know that he might become pure (from sins)?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"80:3:1","position":1,"arabic":"وَمَا","kind":"word","gloss":"But what","transliteration":"wamā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"80:3:2","position":2,"arabic":"يُدْرِيكَ","kind":"word","gloss":"would make you know","transliteration":"yud'rīka","lemma":"أَدْرَىٰ","root":"دري","entryId":null},{"key":"80:3:3","position":3,"arabic":"لَعَلَّهُۥ","kind":"word","gloss":"that he might","transliteration":"laʿallahu","lemma":"لَعَلّ","root":null,"entryId":"l-d6ec00bab0ae6b09"},{"key":"80:3:4","position":4,"arabic":"يَزَّكَّىٰٓ","kind":"word","gloss":"purify himself","transliteration":"yazzakkā","lemma":"تَزَكَّىٰ","root":"زكو","entryId":null},{"key":"80:3:5","position":5,"arabic":"٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"80:4","translation":"Or he might receive admonition, and the admonition might profit him?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"80:4:1","position":1,"arabic":"أَوْ","kind":"word","gloss":"Or","transliteration":"aw","lemma":"أَو","root":null,"entryId":"l-338778252179b4e1"},{"key":"80:4:2","position":2,"arabic":"يَذَّكَّرُ","kind":"word","gloss":"be reminded","transliteration":"yadhakkaru","lemma":"تَذَكَّرَ","root":"ذكر","entryId":"l-9bc7d78e536db086"},{"key":"80:4:3","position":3,"arabic":"فَتَنفَعَهُ","kind":"word","gloss":"so would benefit him","transliteration":"fatanfaʿahu","lemma":"نَفَعَ","root":"نفع","entryId":null},{"key":"80:4:4","position":4,"arabic":"ٱلذِّكْرَىٰٓ","kind":"word","gloss":"the reminder","transliteration":"l-dhik'rā","lemma":"ذِكْرَىٰ","root":"ذكر","entryId":null},{"key":"80:4:5","position":5,"arabic":"٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"80:5","translation":"As for him who thinks himself self-sufficient,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"80:5:1","position":1,"arabic":"أَمَّا","kind":"word","gloss":"As for","transliteration":"ammā","lemma":"أَمَّا","root":null,"entryId":"l-6c43b34cf75dec4b"},{"key":"80:5:2","position":2,"arabic":"مَنِ","kind":"word","gloss":"(him) who","transliteration":"mani","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"80:5:3","position":3,"arabic":"ٱسْتَغْنَىٰ","kind":"word","gloss":"considers himself free from need","transliteration":"is'taghnā","lemma":"اسْتَغْنَىٰ","root":"غني","entryId":null},{"key":"80:5:4","position":4,"arabic":"٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"80:6","translation":"To him you attend;","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"80:6:1","position":1,"arabic":"فَأَنتَ","kind":"word","gloss":"So you","transliteration":"fa-anta","lemma":null,"root":null,"entryId":null},{"key":"80:6:2","position":2,"arabic":"لَهُۥ","kind":"word","gloss":"to him","transliteration":"lahu","lemma":null,"root":null,"entryId":null},{"key":"80:6:3","position":3,"arabic":"تَصَدَّىٰ","kind":"word","gloss":"give attention","transliteration":"taṣaddā","lemma":"تَصَدَّىٰ","root":"صدي","entryId":null},{"key":"80:6:4","position":4,"arabic":"٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"80:7","translation":"What does it matter to you if he will not become pure (from disbelief: you are only a Messenger, your duty is to convey the Message of Allâh).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"80:7:1","position":1,"arabic":"وَمَا","kind":"word","gloss":"And not","transliteration":"wamā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"80:7:2","position":2,"arabic":"عَلَيْكَ","kind":"word","gloss":"upon you","transliteration":"ʿalayka","lemma":"عَلَىٰ","root":null,"entryId":"l-08dd9283adb70e54"},{"key":"80:7:3","position":3,"arabic":"أَلَّا","kind":"word","gloss":"that not","transliteration":"allā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"80:7:4","position":4,"arabic":"يَزَّكَّىٰ","kind":"word","gloss":"he purifies himself","transliteration":"yazzakkā","lemma":"تَزَكَّىٰ","root":"زكو","entryId":null},{"key":"80:7:5","position":5,"arabic":"٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"80:8","translation":"But as to him who came to you running,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"80:8:1","position":1,"arabic":"وَأَمَّا","kind":"word","gloss":"But as for","transliteration":"wa-ammā","lemma":"أَمَّا","root":null,"entryId":"l-6c43b34cf75dec4b"},{"key":"80:8:2","position":2,"arabic":"مَن","kind":"word","gloss":"(he) who","transliteration":"man","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"80:8:3","position":3,"arabic":"جَآءَكَ","kind":"word","gloss":"came to you","transliteration":"jāaka","lemma":"جَآءَ","root":"جيا","entryId":"l-1abf61bfcb8fdd4c"},{"key":"80:8:4","position":4,"arabic":"يَسْعَىٰ","kind":"word","gloss":"striving","transliteration":"yasʿā","lemma":"سَعَىٰ","root":"سعي","entryId":null},{"key":"80:8:5","position":5,"arabic":"٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"80:9","translation":"And is afraid (of Allâh and His punishment).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"80:9:1","position":1,"arabic":"وَهُوَ","kind":"word","gloss":"While he","transliteration":"wahuwa","lemma":null,"root":null,"entryId":null},{"key":"80:9:2","position":2,"arabic":"يَخْشَىٰ","kind":"word","gloss":"fears","transliteration":"yakhshā","lemma":"خَشِىَ","root":"خشي","entryId":null},{"key":"80:9:3","position":3,"arabic":"٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"80:10","translation":"Of him you are neglectful and divert your attention to another,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"80:10:1","position":1,"arabic":"فَأَنتَ","kind":"word","gloss":"But you","transliteration":"fa-anta","lemma":null,"root":null,"entryId":null},{"key":"80:10:2","position":2,"arabic":"عَنْهُ","kind":"word","gloss":"from him","transliteration":"ʿanhu","lemma":"عَن","root":null,"entryId":"l-f1109a78c8548754"},{"key":"80:10:3","position":3,"arabic":"تَلَهَّىٰ","kind":"word","gloss":"(are) distracted","transliteration":"talahhā","lemma":"تَلَهَّىٰ","root":"لهو","entryId":null},{"key":"80:10:4","position":4,"arabic":"١٠","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"80:11","translation":"Nay, (do not do like this); indeed it (this Qur’ân) is an admonition.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"80:11:1","position":1,"arabic":"كَلَّآ","kind":"word","gloss":"Nay","transliteration":"kallā","lemma":"كَلَّا","root":null,"entryId":null},{"key":"80:11:2","position":2,"arabic":"إِنَّهَا","kind":"word","gloss":"Indeed, it","transliteration":"innahā","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"80:11:3","position":3,"arabic":"تَذْكِرَةٌۭ","kind":"word","gloss":"(is) a reminder","transliteration":"tadhkiratun","lemma":"تَذْكِرَة","root":"ذكر","entryId":null},{"key":"80:11:4","position":4,"arabic":"١١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"80:12","translation":"So whoever wills, let him pay attention to it.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"80:12:1","position":1,"arabic":"فَمَن","kind":"word","gloss":"So whosoever","transliteration":"faman","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"80:12:2","position":2,"arabic":"شَآءَ","kind":"word","gloss":"wills","transliteration":"shāa","lemma":"شَآءَ","root":"شيا","entryId":"l-e6061b9230d95354"},{"key":"80:12:3","position":3,"arabic":"ذَكَرَهُۥ","kind":"word","gloss":"may remember it","transliteration":"dhakarahu","lemma":"ذَكَرَ","root":"ذكر","entryId":"l-53d8783c59294aca"},{"key":"80:12:4","position":4,"arabic":"١٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"80:13","translation":"(It is) in Records held (greatly) in honour (Al-Lauh Al-Mahfûz),","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"80:13:1","position":1,"arabic":"فِى","kind":"word","gloss":"In","transliteration":"fī","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"80:13:2","position":2,"arabic":"صُحُفٍۢ","kind":"word","gloss":"sheets","transliteration":"ṣuḥufin","lemma":"صُحُف","root":"صحف","entryId":null},{"key":"80:13:3","position":3,"arabic":"مُّكَرَّمَةٍۢ","kind":"word","gloss":"honored","transliteration":"mukarramatin","lemma":"مُّكَرَّمَة","root":"كرم","entryId":null},{"key":"80:13:4","position":4,"arabic":"١٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"80:14","translation":"Exalted (in dignity), purified,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"80:14:1","position":1,"arabic":"مَّرْفُوعَةٍۢ","kind":"word","gloss":"Exalted","transliteration":"marfūʿatin","lemma":"مَّرْفُوعَة","root":"رفع","entryId":null},{"key":"80:14:2","position":2,"arabic":"مُّطَهَّرَةٍۭ","kind":"word","gloss":"purified","transliteration":"muṭahharatin","lemma":"مُّطَهَّرَة","root":"طهر","entryId":null},{"key":"80:14:3","position":3,"arabic":"١٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"80:15","translation":"In the hands of scribes (angels).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"80:15:1","position":1,"arabic":"بِأَيْدِى","kind":"word","gloss":"In (the) hands","transliteration":"bi-aydī","lemma":"يَد","root":"يدي","entryId":"l-d6185269501ba306"},{"key":"80:15:2","position":2,"arabic":"سَفَرَةٍۢ","kind":"word","gloss":"(of) scribes","transliteration":"safaratin","lemma":"سَفَرَة","root":"سفر","entryId":null},{"key":"80:15:3","position":3,"arabic":"١٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"80:16","translation":"Honourable and obedient.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"80:16:1","position":1,"arabic":"كِرَامٍۭ","kind":"word","gloss":"Noble","transliteration":"kirāmin","lemma":"كَرِيم","root":"كرم","entryId":null},{"key":"80:16:2","position":2,"arabic":"بَرَرَةٍۢ","kind":"word","gloss":"dutiful","transliteration":"bararatin","lemma":"بَرّ","root":"برر","entryId":null},{"key":"80:16:3","position":3,"arabic":"١٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"80:17","translation":"Be cursed (the disbelieving) man! How ungrateful he is!","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"80:17:1","position":1,"arabic":"قُتِلَ","kind":"word","gloss":"Is destroyed","transliteration":"qutila","lemma":"قَتَلَ","root":"قتل","entryId":"l-12fa2efc8330d476"},{"key":"80:17:2","position":2,"arabic":"ٱلْإِنسَـٰنُ","kind":"word","gloss":"[the] man","transliteration":"l-insānu","lemma":"إِنسَٰن","root":"انس","entryId":"l-bec7f7166ce0ed1b"},{"key":"80:17:3","position":3,"arabic":"مَآ","kind":"word","gloss":"how","transliteration":"mā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"80:17:4","position":4,"arabic":"أَكْفَرَهُۥ","kind":"word","gloss":"ungrateful is he","transliteration":"akfarahu","lemma":"أَكْفَرَ","root":"كفر","entryId":null},{"key":"80:17:5","position":5,"arabic":"١٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"80:18","translation":"From what thing did He create him?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"80:18:1","position":1,"arabic":"مِنْ","kind":"word","gloss":"From","transliteration":"min","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"80:18:2","position":2,"arabic":"أَىِّ","kind":"word","gloss":"what","transliteration":"ayyi","lemma":"أَىّ","root":"ايي","entryId":"l-1b17d6cf8e714c6a"},{"key":"80:18:3","position":3,"arabic":"شَىْءٍ","kind":"word","gloss":"thing","transliteration":"shayin","lemma":"شَىْء","root":"شيا","entryId":"l-180c07cc91c0f47b"},{"key":"80:18:4","position":4,"arabic":"خَلَقَهُۥ","kind":"word","gloss":"He created him","transliteration":"khalaqahu","lemma":"خَلَقَ","root":"خلق","entryId":"l-9e7414ba00a88ddc"},{"key":"80:18:5","position":5,"arabic":"١٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"80:19","translation":"From Nutfah (male and female semen drops) He created him and then set him in due proportion.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"80:19:1","position":1,"arabic":"مِن","kind":"word","gloss":"From","transliteration":"min","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"80:19:2","position":2,"arabic":"نُّطْفَةٍ","kind":"word","gloss":"a semen-drop","transliteration":"nuṭ'fatin","lemma":"نُّطْفَة","root":"نطف","entryId":null},{"key":"80:19:3","position":3,"arabic":"خَلَقَهُۥ","kind":"word","gloss":"He created him","transliteration":"khalaqahu","lemma":"خَلَقَ","root":"خلق","entryId":"l-9e7414ba00a88ddc"},{"key":"80:19:4","position":4,"arabic":"فَقَدَّرَهُۥ","kind":"word","gloss":"then He proportioned him","transliteration":"faqaddarahu","lemma":"قَدَّرَ","root":"قدر","entryId":null},{"key":"80:19:5","position":5,"arabic":"١٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"80:20","translation":"Then He makes the Path easy for him.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"80:20:1","position":1,"arabic":"ثُمَّ","kind":"word","gloss":"Then","transliteration":"thumma","lemma":"ثُمّ","root":null,"entryId":"l-75b66396af12da75"},{"key":"80:20:2","position":2,"arabic":"ٱلسَّبِيلَ","kind":"word","gloss":"the way","transliteration":"l-sabīla","lemma":"سَبِيل","root":"سبل","entryId":"l-c204df14296b43ea"},{"key":"80:20:3","position":3,"arabic":"يَسَّرَهُۥ","kind":"word","gloss":"He made easy for him","transliteration":"yassarahu","lemma":"يَسَّرَ","root":"يسر","entryId":null},{"key":"80:20:4","position":4,"arabic":"٢٠","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"80:21","translation":"Then He causes him to die and puts him in his grave.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"80:21:1","position":1,"arabic":"ثُمَّ","kind":"word","gloss":"Then","transliteration":"thumma","lemma":"ثُمّ","root":null,"entryId":"l-75b66396af12da75"},{"key":"80:21:2","position":2,"arabic":"أَمَاتَهُۥ","kind":"word","gloss":"He causes him to die","transliteration":"amātahu","lemma":"أَمَاتَ","root":"موت","entryId":null},{"key":"80:21:3","position":3,"arabic":"فَأَقْبَرَهُۥ","kind":"word","gloss":"and provides a grave for him","transliteration":"fa-aqbarahu","lemma":"أَقْبَرَ","root":"قبر","entryId":null},{"key":"80:21:4","position":4,"arabic":"٢١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"80:22","translation":"Then when it is His Will, He will resurrect him (again).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"80:22:1","position":1,"arabic":"ثُمَّ","kind":"word","gloss":"Then","transliteration":"thumma","lemma":"ثُمّ","root":null,"entryId":"l-75b66396af12da75"},{"key":"80:22:2","position":2,"arabic":"إِذَا","kind":"word","gloss":"when","transliteration":"idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"80:22:3","position":3,"arabic":"شَآءَ","kind":"word","gloss":"He wills","transliteration":"shāa","lemma":"شَآءَ","root":"شيا","entryId":"l-e6061b9230d95354"},{"key":"80:22:4","position":4,"arabic":"أَنشَرَهُۥ","kind":"word","gloss":"He will resurrect him","transliteration":"ansharahu","lemma":"أَنشَرَ","root":"نشر","entryId":null},{"key":"80:22:5","position":5,"arabic":"٢٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"80:23","translation":"Nay, but (man) has not done what He commanded him.","t