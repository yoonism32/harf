[{"ref":"108:1","translation":"Verily, We have granted you (O Muhammad صلى الله عليه وسلم) Al-Kauthar (a river in Paradise).","translationSource":"qul-301-hilali-khan","notes":[{"text":"Narrated Anas رضي الله عنه: When the Prophet صلى الله عليه وسلم was made to ascend to the heavens. He صلى الله عليه وسلم said (after his return), \"I came upon a river (in Paradise) the banks of which were made of tents of hollow pearls. I asked Jibrîl (Gabriel), ‘What is this (river)?’ He replied, ‘This is the Kauthar’ \" (Sahih Al-Bukhâri, Vol.6, Hadîth No. 488).","ref":null}],"tokens":[{"key":"108:1:1","position":1,"arabic":"إِنَّآ","kind":"word","gloss":"Indeed, We","transliteration":"innā","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"108:1:2","position":2,"arabic":"أَعْطَيْنَـٰكَ","kind":"word","gloss":"We have given you","transliteration":"aʿṭaynāka","lemma":"أَعْطَىٰ","root":"عطو","entryId":null},{"key":"108:1:3","position":3,"arabic":"ٱلْكَوْثَرَ","kind":"word","gloss":"Al-Kauthar","transliteration":"l-kawthara","lemma":"كَوْثَر","root":"كثر","entryId":null},{"key":"108:1:4","position":4,"arabic":"١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"108:2","translation":"Therefore turn in prayer to your Lord and sacrifice (to Him only).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"108:2:1","position":1,"arabic":"فَصَلِّ","kind":"word","gloss":"So pray","transliteration":"faṣalli","lemma":"صَلَّىٰ","root":"صلو","entryId":null},{"key":"108:2:2","position":2,"arabic":"لِرَبِّكَ","kind":"word","gloss":"to your Lord","transliteration":"lirabbika","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"108:2:3","position":3,"arabic":"وَٱنْحَرْ","kind":"word","gloss":"and sacrifice","transliteration":"wa-in'ḥar","lemma":"انْحَرْ","root":"نحر","entryId":null},{"key":"108:2:4","position":4,"arabic":"٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"108:3","translation":"For he who hates you (O Muhammad صلى الله عليه وسلم), he will be cut off (from posterity and every good thing in this world and in the Hereafter).","translationSource":"qul-301-hilali-khan","notes":[{"text":"Narrated Anas رضي الله عنه : The Prophet صلى الله عليه وسلم said, \"None of you will have Faith till he loves me more than his father, his children and all mankind. (Sahih Al-Bukhari, Vol.1, Hadith No.14).","ref":null}],"tokens":[{"key":"108:3:1","position":1,"arabic":"إِنَّ","kind":"word","gloss":"Indeed","transliteration":"inna","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"108:3:2","position":2,"arabic":"شَانِئَكَ","kind":"word","gloss":"your enemy","transliteration":"shāni-aka","lemma":"شَانِئ","root":"شنا","entryId":null},{"key":"108:3:3","position":3,"arabic":"هُوَ","kind":"word","gloss":"he (is)","transliteration":"huwa","lemma":null,"root":null,"entryId":null},{"key":"108:3:4","position":4,"arabic":"ٱلْأَبْتَرُ","kind":"word","gloss":"the one cut off","transliteration":"l-abtaru","lemma":"أَبْتَر","root":"بتر","entryId":null},{"key":"108:3:5","position":5,"arabic":"٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]}]