[{"ref":"61:1","translation":"Whatsoever is in the heavens and whatsoever is on the earth glorifies Allâh. And He is the All-Mighty, the All-Wise.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"61:1:1","position":1,"arabic":"سَبَّحَ","kind":"word","gloss":"Glorifies","transliteration":"sabbaḥa","lemma":"سَبَّحَ","root":"سبح","entryId":"l-2e7f33ad65358df7"},{"key":"61:1:2","position":2,"arabic":"لِلَّهِ","kind":"word","gloss":"Allah","transliteration":"lillahi","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"61:1:3","position":3,"arabic":"مَا","kind":"word","gloss":"whatever","transliteration":"mā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"61:1:4","position":4,"arabic":"فِى","kind":"word","gloss":"(is) in","transliteration":"fī","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"61:1:5","position":5,"arabic":"ٱلسَّمَـٰوَٰتِ","kind":"word","gloss":"the heavens","transliteration":"l-samāwāti","lemma":"سَمَآء","root":"سمو","entryId":"l-e873a75addf25baf"},{"key":"61:1:6","position":6,"arabic":"وَمَا","kind":"word","gloss":"and whatever","transliteration":"wamā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"61:1:7","position":7,"arabic":"فِى","kind":"word","gloss":"(is) in","transliteration":"fī","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"61:1:8","position":8,"arabic":"ٱلْأَرْضِ ۖ","kind":"word","gloss":"the earth","transliteration":"l-arḍi","lemma":"أَرْض","root":"ارض","entryId":"l-2c626a3b4c64dbc9"},{"key":"61:1:9","position":9,"arabic":"وَهُوَ","kind":"word","gloss":"And He","transliteration":"wahuwa","lemma":null,"root":null,"entryId":null},{"key":"61:1:10","position":10,"arabic":"ٱلْعَزِيزُ","kind":"word","gloss":"(is) the All-Mighty","transliteration":"l-ʿazīzu","lemma":"عَزِيز","root":"عزز","entryId":"l-da1ac3fcbe3eed57"},{"key":"61:1:11","position":11,"arabic":"ٱلْحَكِيمُ","kind":"word","gloss":"the All-Wise","transliteration":"l-ḥakīmu","lemma":"حَكِيم","root":"حكم","entryId":"l-a583e31fa7264499"},{"key":"61:1:12","position":12,"arabic":"١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"61:2","translation":"O you who believe! Why do you say that which you do not do?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"61:2:1","position":1,"arabic":"يَـٰٓأَيُّهَا","kind":"word","gloss":"O you","transliteration":"yāayyuhā","lemma":"أَيُّهَا","root":"ايي","entryId":"l-a3fa5dd17841b221"},{"key":"61:2:2","position":2,"arabic":"ٱلَّذِينَ","kind":"word","gloss":"those who(believe)","transliteration":"alladhīna","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"61:2:3","position":3,"arabic":"ءَامَنُوا۟","kind":"word","gloss":"believe","transliteration":"āmanū","lemma":"ءَامَنَ","root":"امن","entryId":"l-f6ec3a6dc0f76aa6"},{"key":"61:2:4","position":4,"arabic":"لِمَ","kind":"word","gloss":"Why","transliteration":"lima","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"61:2:5","position":5,"arabic":"تَقُولُونَ","kind":"word","gloss":"(do) you say","transliteration":"taqūlūna","lemma":"قَالَ","root":"قول","entryId":"l-effaf24a5c86c56f"},{"key":"61:2:6","position":6,"arabic":"مَا","kind":"word","gloss":"what","transliteration":"mā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"61:2:7","position":7,"arabic":"لَا","kind":"word","gloss":"not","transliteration":"lā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"61:2:8","position":8,"arabic":"تَفْعَلُونَ","kind":"word","gloss":"you do","transliteration":"tafʿalūna","lemma":"فَعَلَ","root":"فعل","entryId":"l-b0a120934c602e5e"},{"key":"61:2:9","position":9,"arabic":"٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"61:3","translation":"Most hateful it is with Allâh that you say that which you do not do.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"61:3:1","position":1,"arabic":"كَبُرَ","kind":"word","gloss":"Great is","transliteration":"kabura","lemma":"كَبُرَ","root":"كبر","entryId":null},{"key":"61:3:2","position":2,"arabic":"مَقْتًا","kind":"word","gloss":"hatred","transliteration":"maqtan","lemma":"مَقْت","root":"مقت","entryId":null},{"key":"61:3:3","position":3,"arabic":"عِندَ","kind":"word","gloss":"with","transliteration":"ʿinda","lemma":"عِند","root":"عند","entryId":"l-30b61508aaa6b3fa"},{"key":"61:3:4","position":4,"arabic":"ٱللَّهِ","kind":"word","gloss":"Allah","transliteration":"l-lahi","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"61:3:5","position":5,"arabic":"أَن","kind":"word","gloss":"that","transliteration":"an","lemma":"أَن","root":null,"entryId":"l-6fb897ea8dfcda9d"},{"key":"61:3:6","position":6,"arabic":"تَقُولُوا۟","kind":"word","gloss":"you say","transliteration":"taqūlū","lemma":"قَالَ","root":"قول","entryId":"l-effaf24a5c86c56f"},{"key":"61:3:7","position":7,"arabic":"مَا","kind":"word","gloss":"what","transliteration":"mā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"61:3:8","position":8,"arabic":"لَا","kind":"word","gloss":"not","transliteration":"lā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"61:3:9","position":9,"arabic":"تَفْعَلُونَ","kind":"word","gloss":"you do","transliteration":"tafʿalūna","lemma":"فَعَلَ","root":"فعل","entryId":"l-b0a120934c602e5e"},{"key":"61:3:10","position":10,"arabic":"٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"61:4","translation":"Verily, Allâh loves those who fight in His Cause in rows (ranks) as if they were a solid structure.","translationSource":"qul-301-hilali-khan","notes":[{"text":"a) Narrated Abû Sa‘îd Al-Khudrî رضي الله عنه : Somebody asked, \"O Allâh’s Messenger! Who is the best among the people?\" Allâh’s Messenger صلى الله عليه وسلم replied, \"A believer who strives his utmost in Allâh’s Cause with his life and property.\" They asked, \"Who is next?\" He replied, \"A believer who stays in one of the mountain paths worshipping Allâh and leaving the people secure from his mischief.\" (Sahih Al-Bukhari, Vol. 4., Hadîth No. 45). b) See the footnote (A) of (V.9:111).","ref":null}],"tokens":[{"key":"61:4:1","position":1,"arabic":"إِنَّ","kind":"word","gloss":"Indeed","transliteration":"inna","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"61:4:2","position":2,"arabic":"ٱللَّهَ","kind":"word","gloss":"Allah","transliteration":"l-laha","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"61:4:3","position":3,"arabic":"يُحِبُّ","kind":"word","gloss":"loves","transliteration":"yuḥibbu","lemma":"أَحْبَبْ","root":"حبب","entryId":"l-43478ad8b9caa513"},{"key":"61:4:4","position":4,"arabic":"ٱلَّذِينَ","kind":"word","gloss":"those who","transliteration":"alladhīna","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"61:4:5","position":5,"arabic":"يُقَـٰتِلُونَ","kind":"word","gloss":"fight","transliteration":"yuqātilūna","lemma":"قَٰتَلَ","root":"قتل","entryId":"l-6499f22bdaad6937"},{"key":"61:4:6","position":6,"arabic":"فِى","kind":"word","gloss":"in","transliteration":"fī","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"61:4:7","position":7,"arabic":"سَبِيلِهِۦ","kind":"word","gloss":"His Way","transliteration":"sabīlihi","lemma":"سَبِيل","root":"سبل","entryId":"l-c204df14296b43ea"},{"key":"61:4:8","position":8,"arabic":"صَفًّۭا","kind":"word","gloss":"(in) a row","transliteration":"ṣaffan","lemma":"صَفّ","root":"صفف","entryId":null},{"key":"61:4:9","position":9,"arabic":"كَأَنَّهُم","kind":"word","gloss":"as if they","transliteration":"ka-annahum","lemma":"كَأَنّ","root":null,"entryId":null},{"key":"61:4:10","position":10,"arabic":"بُنْيَـٰنٌۭ","kind":"word","gloss":"(were) a structure","transliteration":"bun'yānun","lemma":"بُنْيَٰن","root":"بني","entryId":null},{"key":"61:4:11","position":11,"arabic":"مَّرْصُوصٌۭ","kind":"word","gloss":"joined firmly","transliteration":"marṣūṣun","lemma":"مَّرْصُوص","root":"رصص","entryId":null},{"key":"61:4:12","position":12,"arabic":"٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"61:5","translation":"And (remember) when Mûsâ (Moses) said to his people: \"O my people! Why do you annoy me while you know certainly that I am the Messenger of Allâh to you? So when they turned away (from the Path of Allâh), Allâh turned their hearts away (from the Right Path). And Allâh guides not the people who are Fâsiqûn (the rebellious, the disobedient to Allâh).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"61:5:1","position":1,"arabic":"وَإِذْ","kind":"word","gloss":"And when","transliteration":"wa-idh","lemma":"إِذ","root":null,"entryId":"l-70d1b6a3b74582a2"},{"key":"61:5:2","position":2,"arabic":"قَالَ","kind":"word","gloss":"said","transliteration":"qāla","lemma":"قَالَ","root":"قول","entryId":"l-effaf24a5c86c56f"},{"key":"61:5:3","position":3,"arabic":"مُوسَىٰ","kind":"word","gloss":"Musa","transliteration":"mūsā","lemma":"مُوسَىٰ","root":null,"entryId":"l-60d7194527b68cdf"},{"key":"61:5:4","position":4,"arabic":"لِقَوْمِهِۦ","kind":"word","gloss":"to his people","transliteration":"liqawmihi","lemma":"قَوْم","root":"قوم","entryId":"l-049e2cd6a60d39f0"},{"key":"61:5:5","position":5,"arabic":"يَـٰقَوْمِ","kind":"word","gloss":"O my people","transliteration":"yāqawmi","lemma":"قَوْم","root":"قوم","entryId":"l-049e2cd6a60d39f0"},{"key":"61:5:6","position":6,"arabic":"لِمَ","kind":"word","gloss":"Why","transliteration":"lima","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"61:5:7","position":7,"arabic":"تُؤْذُونَنِى","kind":"word","gloss":"do you hurt me","transliteration":"tu'dhūnanī","lemma":"أُوذِىَ","root":"اذي","entryId":null},{"key":"61:5:8","position":8,"arabic":"وَقَد","kind":"word","gloss":"while certainly","transliteration":"waqad","lemma":"قَد","root":null,"entryId":"l-11a59b67e56e7412"},{"key":"61:5:9","position":9,"arabic":"تَّعْلَمُونَ","kind":"word","gloss":"you know","transliteration":"taʿlamūna","lemma":"عَلِمَ","root":"علم","entryId":"l-6de9979b254804ea"},{"key":"61:5:10","position":10,"arabic":"أَنِّى","kind":"word","gloss":"that I am","transliteration":"annī","lemma":"أَنّ","root":null,"entryId":"l-9a8e074398908017"},{"key":"61:5:11","position":11,"arabic":"رَسُولُ","kind":"word","gloss":"(the) Messenger","transliteration":"rasūlu","lemma":"رَسُول","root":"رسل","entryId":"l-165e008d0f146d23"},{"key":"61:5:12","position":12,"arabic":"ٱللَّهِ","kind":"word","gloss":"(of) Allah","transliteration":"l-lahi","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"61:5:13","position":13,"arabic":"إِلَيْكُمْ ۖ","kind":"word","gloss":"to you","transliteration":"ilaykum","lemma":"إِلَىٰ","root":null,"entryId":"l-53539d2c3606b99e"},{"key":"61:5:14","position":14,"arabic":"فَلَمَّا","kind":"word","gloss":"Then when","transliteration":"falammā","lemma":"لَمَّا","root":null,"entryId":"l-c1b5336198ac1aed"},{"key":"61:5:15","position":15,"arabic":"زَاغُوٓا۟","kind":"word","gloss":"they deviated","transliteration":"zāghū","lemma":"زَاغَ","root":"زيغ","entryId":null},{"key":"61:5:16","position":16,"arabic":"أَزَاغَ","kind":"word","gloss":"(was caused to) deviate","transliteration":"azāgha","lemma":"أَزَاغَ","root":"زيغ","entryId":null},{"key":"61:5:17","position":17,"arabic":"ٱللَّهُ","kind":"word","gloss":"(by) Allah","transliteration":"l-lahu","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"61:5:18","position":18,"arabic":"قُلُوبَهُمْ ۚ","kind":"word","gloss":"their hearts","transliteration":"qulūbahum","lemma":"قَلْب","root":"قلب","entryId":"l-4fe27e415bdd53be"},{"key":"61:5:19","position":19,"arabic":"وَٱللَّهُ","kind":"word","gloss":"And Allah","transliteration":"wal-lahu","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"61:5:20","position":20,"arabic":"لَا","kind":"word","gloss":"(does) not","transliteration":"lā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"61:5:21","position":21,"arabic":"يَهْدِى","kind":"word","gloss":"guide","transliteration":"yahdī","lemma":"هَدَى","root":"هدي","entryId":"l-e0ac61a274311deb"},{"key":"61:5:22","position":22,"arabic":"ٱلْقَوْمَ","kind":"word","gloss":"the people","transliteration":"l-qawma","lemma":"قَوْم","root":"قوم","entryId":"l-049e2cd6a60d39f0"},{"key":"61:5:23","position":23,"arabic":"ٱلْفَـٰسِقِينَ","kind":"word","gloss":"the defiantly disobedient","transliteration":"l-fāsiqīna","lemma":"فَاسِق","root":"فسق","entryId":"l-967e9850e6d6d9fd"},{"key":"61:5:24","position":24,"arabic":"٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"61:6","translation":"And (remember) when ‘Îsâ (Jesus), son of Maryam (Mary), said: \"O Children of Israel! I am the Messenger of Allâh unto you, confirming the Taurât [(Torah) which came] before me, and giving glad tidings of a Messenger to come after me, whose name shall be Ahmad. But when he (Ahmad i.e. Muhammad صلى الله عليه وسلم) came to them with clear proofs, they said: \"This is plain magic.\"","translationSource":"qul-301-hilali-khan","notes":[{"text":"i.e. the second name of Prophet Muhammad صلى الله عليه وسلم and it (Ahmad) literally means: \"One who praises Allâh more than others\".","ref":null},{"text":"A) Narrated Jubair bin Mut‘im رضي الله عنه: Allâh’s Messenger صلى الله عليه وسلم said, \"I have five names: I am Muhammad and Ahmad; I am Al-Mahî through whom Allâh will eliminate Al-Kufr (infidelity); I am Al-Hashir who will be the first to be resurrected, the people being resurrected thereafter; and I am also Al-‘Âqib (i.e. there will be no Prophet after me).\" (Sahih Al-Bukhari, Vol. 4, Hadîfh No.732). B) Narrated Abû Hurairah رضي الله عنه: Allâh’s Messenger صلى الله عليه وسلم said, \"By Him (Allâh) in Whose Hand my soul is, surely, the son of Mary [‘Îsâ (Jesus)] عليهما السلام * will shortly descend amongst you people (Muslims), and will judge mankind justly by the Law of the Qur’ân (as a just ruler), and will break the Cross and kill the pigs and abolish the Jizyah [a tax taken from the people of the Scriptures (Jews and Christians), who are under the protection of a Muslim government. This Jizyah tax will not be accepted by ‘Îsâ (Jesus) عليه السلام and all mankind will be required to embrace Islam with no other alternative]. Then there will be abundance of money and nobody will accept charitable gifts.\" (See Fath Al-Bari , Page No. 304 and 305, Vol. 7), (Sahih Al-Bukhari, Vol. 3, Hadîth No.425). * ‘Îsâ (Jesus), the son of Maryam (Mary) عليهما السلام will descend as a leader of the Muslims and it is a severe warning to the Christians who claim to be the followers of ‘Îsâ (Jesus) and he will break the Cross and kill the pigs, and he will abolish the Jizyah (tax); and all mankind will be required to embrace Islam with no other alternative.","ref":null}],"tokens":[{"key":"61:6:1","position":1,"arabic":"وَإِذْ","kind":"word","gloss":"And when","transliteration":"wa-idh","lemma":"إِذ","root":null,"entryId":"l-70d1b6a3b74582a2"},{"key":"61:6:2","position":2,"arabic":"قَالَ","kind":"word","gloss":"said","transliteration":"qāla","lemma":"قَالَ","root":"قول","entryId":"l-effaf24a5c86c56f"},{"key":"61:6:3","position":3,"arabic":"عِيسَى","kind":"word","gloss":"Isa","transliteration":"ʿīsā","lemma":"عِيسَى","root":null,"entryId":null},{"key":"61:6:4","position":4,"arabic":"ٱبْنُ","kind":"word","gloss":"son","transliteration":"ub'nu","lemma":"ابْن","root":"بني","entryId":"l-2798330af5521eb0"},{"key":"61:6:5","position":5,"arabic":"مَرْيَمَ","kind":"word","gloss":"(of) Maryam","transliteration":"maryama","lemma":"مَرْيَم","root":null,"entryId":null},{"key":"61:6:6","position":6,"arabic":"يَـٰبَنِىٓ","kind":"word","gloss":"O Children","transliteration":"yābanī","lemma":"بُنَىّ","root":"بني","entryId":"l-5e967f542201f803"},{"key":"61:6:7","position":7,"arabic":"إِسْرَٰٓءِيلَ","kind":"word","gloss":"(of) Israel","transliteration":"is'rāīla","lemma":"إِسْرَائِيل","root":null,"entryId":"l-0b3810aa69d0dbed"},{"key":"61:6:8","position":8,"arabic":"إِنِّى","kind":"word","gloss":"Indeed, I am","transliteration":"innī","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"61:6:9","position":9,"arabic":"رَسُولُ","kind":"word","gloss":"(the) Messenger","transliteration":"rasūlu","lemma":"رَسُول","root":"رسل","entryId":"l-165e008d0f146d23"},{"key":"61:6:10","position":10,"arabic":"ٱللَّهِ","kind":"word","gloss":"(of) Allah","transliteration":"l-lahi","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"61:6:11","position":11,"arabic":"إِلَيْكُم","kind":"word","gloss":"to you","transliteration":"ilaykum","lemma":"إِلَىٰ","root":null,"entryId":"l-53539d2c3606b99e"},{"key":"61:6:12","position":12,"arabic":"مُّصَدِّقًۭا","kind":"word","gloss":"confirming","transliteration":"muṣaddiqan","lemma":"مُصَدِّق","root":"صدق","entryId":null},{"key":"61:6:13","position":13,"arabic":"لِّمَا","kind":"word","gloss":"that which","transliteration":"limā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"61:6:14","position":14,"arabic":"بَيْنَ","kind":"word","gloss":"(was) between","transliteration":"bayna","lemma":"بَيْن","root":"بين","entryId":"l-32db43d0920d28f8"},{"key":"61:6:15","position":15,"arabic":"يَدَىَّ","kind":"word","gloss":"my hands","transliteration":"yadayya","lemma":"يَد","root":"يدي","entryId":"l-d6185269501ba306"},{"key":"61:6:16","position":16,"arabic":"مِنَ","kind":"word","gloss":"of","transliteration":"mina","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"61:6:17","position":17,"arabic":"ٱلتَّوْرَىٰةِ","kind":"word","gloss":"the Taurat","transliteration":"l-tawrāti","lemma":"تَّوْرَىٰة","root":null,"entryId":null},{"key":"61:6:18","position":18,"arabic":"وَمُبَشِّرًۢا","kind":"word","gloss":"and bringing glad tidings","transliteration":"wamubashiran","lemma":"مُبَشِّر","root":"بشر","entryId":null},{"key":"61:6:19","position":19,"arabic":"بِرَسُولٍۢ","kind":"word","gloss":"(of) a Messenger","transliteration":"birasūlin","lemma":"رَسُول","root":"رسل","entryId":"l-165e008d0f146d23"},{"key":"61:6:20","position":20,"arabic":"يَأْتِى","kind":"word","gloss":"to come","transliteration":"yatī","lemma":"أَتَى","root":"اتي","entryId":"l-491a40b1f8d047fe"},{"key":"61:6:21","position":21,"arabic":"مِنۢ","kind":"word","gloss":"from","transliteration":"min","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"61:6:22","position":22,"arabic":"بَعْدِى","kind":"word","gloss":"after me","transliteration":"baʿdī","lemma":"بَعْد","root":"بعد","entryId":"l-8c0dc1d5dbc2a420"},{"key":"61:6:23","position":23,"arabic":"ٱسْمُهُۥٓ","kind":"word","gloss":"whose name (will be)","transliteration":"us'muhu","lemma":"اسْم","root":"سمو","entryId":"l-5f4457e006a745d9"},{"key":"61:6:24","position":24,"arabic":"أَحْمَدُ ۖ","kind":"word","gloss":"Ahmad","transliteration":"aḥmadu","lemma":"أَحْمَد","root":"حمد","entryId":null},{"key":"61:6:25","position":25,"arabic":"فَلَمَّا","kind":"word","gloss":"But when","transliteration":"falammā","lemma":"لَمَّا","root":null,"entryId":"l-c1b5336198ac1aed"},{"key":"61:6:26","position":26,"arabic":"جَآءَهُم","kind":"word","gloss":"he came to them","transliteration":"jāahum","lemma":"جَآءَ","root":"جيا","entryId":"l-1abf61bfcb8fdd4c"},{"key":"61:6:27","position":27,"arabic":"بِٱلْبَيِّنَـٰتِ","kind":"word","gloss":"with clear proofs","transliteration":"bil-bayināti","lemma":"بَيِّنَة","root":"بين","entryId":"l-3f748dc7c64d16bd"},{"key":"61:6:28","position":28,"arabic":"قَالُوا۟","kind":"word","gloss":"they said","transliteration":"qālū","lemma":"قَالَ","root":"قول","entryId":"l-effaf24a5c86c56f"},{"key":"61:6:29","position":29,"arabic":"هَـٰذَا","kind":"word","gloss":"This","transliteration":"hādhā","lemma":"هَٰذَا","root":null,"entryId":"l-a874a3c6f146e6a2"},{"key":"61:6:30","position":30,"arabic":"سِحْرٌۭ","kind":"word","gloss":"(is) a magic","transliteration":"siḥ'run","lemma":"سِحْر","root":"سحر","entryId":null},{"key":"61:6:31","position":31,"arabic":"مُّبِينٌۭ","kind":"word","gloss":"clear","transliteration":"mubīnun","lemma":"مُّبِين","root":"بين","entryId":"l-0d597777bd2bba00"},{"key":"61:6:32","position":32,"arabic":"٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"61:7","translation":"And who does more wrong than the one who invents a lie against Allâh, while he is being invited to Islâm? And Allâh guides not the people who are Zâlimûn (polytheists, wrong-doers and disbelievers) folk.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"61:7:1","position":1,"arabic":"وَمَنْ","kind":"word","gloss":"And who","transliteration":"waman","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"61:7:2","position":2,"arabic":"أَظْلَمُ","kind":"word","gloss":"(is) more wrong","transliteration":"aẓlamu","lemma":"أَظْلَم","root":"ظلم","entryId":null},{"key":"61:7:3","position":3,"arabic":"مِمَّنِ","kind":"word","gloss":"than (one) who","transliteration":"mimmani","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"61:7:4","position":4,"arabic":"ٱفْتَرَىٰ","kind":"word","gloss":"invents","transliteration":"if'tarā","lemma":"افْتَرَىٰ","root":"فري","entryId":"l-7bc9d76cc5b97947"},{"key":"61:7:5","position":5,"arabic":"عَلَى","kind":"word","gloss":"upon","transliteration":"ʿalā","lemma":"عَلَىٰ","root":null,"entryId":"l-08dd9283adb70e54"},{"key":"61:7:6","position":6,"arabic":"ٱللَّهِ","kind":"word","gloss":"Allah","transliteration":"l-lahi","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"61:7:7","position":7,"arabic":"ٱلْكَذِبَ","kind":"word","gloss":"the lie","transliteration":"l-kadhiba","lemma":"كَذِب","root":"كذب","entryId":null},{"key":"61:7:8","position":8,"arabic":"وَهُوَ","kind":"word","gloss":"while he","transliteration":"wahuwa","lemma":null,"root":null,"entryId":null},{"key":"61:7:9","position":9,"arabic":"يُدْعَىٰٓ","kind":"word","gloss":"is invited","transliteration":"yud'ʿā","lemma":"دَعَا","root":"دعو","entryId":"l-f687b25395102e70"},{"key":"61:7:10","position":10,"arabic":"إِلَى","kind":"word","gloss":"to","transliteration":"ilā","lemma":"إِلَىٰ","root":null,"entryId":"l-53539d2c3606b99e"},{"key":"61:7:11","position":11,"arabic":"ٱلْإِسْلَـٰمِ ۚ","kind":"word","gloss":"Islam","transliteration":"l-is'lāmi","lemma":"إِسْلَٰم","root":"سلم","entryId":null},{"key":"61:7:12","position":12,"arabic":"وَٱللَّهُ","kind":"word","gloss":"And Allah","transliteration":"wal-lahu","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"61:7:13","position":13,"arabic":"لَا","kind":"word","gloss":"(does) not","transliteration":"lā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"61:7:14","position":14,"arabic":"يَهْدِى","kind":"word","gloss":"guide","transliteration":"yahdī","lemma":"هَدَى","root":"هدي","entryId":"l-e0ac61a274311deb"},{"key":"61:7:15","position":15,"arabic":"ٱلْقَوْمَ","kind":"word","gloss":"the people","transliteration":"l-qawma","lemma":"قَوْم","root":"قوم","entryId":"l-049e2cd6a60d39f0"},{"key":"61:7:16","position":16,"arabic":"ٱلظَّـٰلِمِينَ","kind":"word","gloss":"[the] wrongdoers","transliteration":"l-ẓālimīna","lemma":"ظَالِم","root":"ظلم","entryId":"l-d61c30426de52f47"},{"key":"61:7:17","position":17,"arabic":"٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"61:8","translation":"They intend to put out the Light of Allâh (i.e. the Religion of Islâm, this Qur’ân, and the Prophet Muhammad صلى الله عليه وسلم) with their mouths. But Allâh will bring His Light to perfection even though the disbelievers hate (it).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"61:8:1","position":1,"arabic":"يُرِيدُونَ","kind":"word","gloss":"They intend","transliteration":"yurīdūna","lemma":"أَرَادَ","root":"رود","entryId":"l-1eaa86c69a1267cc"},{"key":"61:8:2","position":2,"arabic":"لِيُطْفِـُٔوا۟","kind":"word","gloss":"to put out","transliteration":"liyuṭ'fiū","lemma":"أَطْفَأَ","root":"طفا","entryId":null},{"key":"61:8:3","position":3,"arabic":"نُورَ","kind":"word","gloss":"(the) light","transliteration":"nūra","lemma":"نُور","root":"نور","entryId":"l-192bc5e7c1fe2bcb"},{"key":"61:8:4","position":4,"arabic":"ٱللَّهِ","kind":"word","gloss":"(of) Allah","transliteration":"l-lahi","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"61:8:5","position":5,"arabic":"بِأَفْوَٰهِهِمْ","kind":"word","gloss":"with their mouths","transliteration":"bi-afwāhihim","lemma":"أَفْوَٰه","root":"فوه","entryId":null},{"key":"61:8:6","position":6,"arabic":"وَٱللَّهُ","kind":"word","gloss":"but Allah","transliteration":"wal-lahu","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"61:8:7","position":7,"arabic":"مُتِمُّ","kind":"word","gloss":"will perfect","transliteration":"mutimmu","lemma":"مُتِمّ","root":"تمم","entryId":null},{"key":"61:8:8","position":8,"arabic":"نُورِهِۦ","kind":"word","gloss":"His Light","transliteration":"nūrihi","lemma":"نُور","root":"نور","entryId":"l-192bc5e7c1fe2bcb"},{"key":"61:8:9","position":9,"arabic":"وَلَوْ","kind":"word","gloss":"although","transliteration":"walaw","lemma":"لَو","root":null,"entryId":"l-9e02d9e1c2596c32"},{"key":"61:8:10","position":10,"arabic":"كَرِهَ","kind":"word","gloss":"dislike","transliteration":"kariha","lemma":"كَرِهَ","root":"كره","entryId":null},{"key":"61:8:11","position":11,"arabic":"ٱلْكَـٰفِرُونَ","kind":"word","gloss":"the disbelievers","transliteration":"l-kāfirūna","lemma":"كَٰفِرُون","root":"كفر","entryId":"l-f28a757ec38a9735"},{"key":"61:8:12","position":12,"arabic":"٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"61:9","translation":"He it is Who has sent His Messenger (Muhammad صلى الله عليه وسلم) with guidance and the religion of truth (Islâmic Monotheism) to make it victorious over all (other) religions even though the Mushrikûn (polytheists, pagans, idolaters, and disbelievers in the Oneness of Allâh and in His Messenger Muhammad صلى الله عليه وسلم) hate (it).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"61:9:1","position":1,"arabic":"هُوَ","kind":"word","gloss":"He","transliteration":"huwa","lemma":null,"root":null,"entryId":null},{"key":"61:9:2","position":2,"arabic":"ٱلَّذِىٓ","kind":"word","gloss":"(is) the One Who","transliteration":"alladhī","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"61:9:3","position":3,"arabic":"أَرْسَلَ","kind":"word","gloss":"sent","transliteration":"arsala","lemma":"أَرْسَلَ","root":"رسل","entryId":"l-8b46fe6c57f84b97"},{"key":"61:9:4","position":4,"arabic":"رَسُولَهُۥ","kind":"word","gloss":"His Messenger","transliteration":"rasūlahu","lemma":"رَسُول","root":"رسل","entryId":"l-165e008d0f146d23"},{"key":"61:9:5","position":5,"arabic":"بِٱلْهُدَىٰ","kind":"word","gloss":"with guidance","transliteration":"bil-hudā","lemma":"هُدًى","root":"هدي","entryId":"l-5983c95b20790bb0"},{"key":"61:9:6","position":6,"arabic":"وَدِينِ","kind":"word","gloss":"and (the) religion","transliteration":"wadīni","lemma":"دِين","root":"دين","entryId":"l-869ef1d12b24f52a"},{"key":"61:9:7","position":7,"arabic":"ٱلْحَقِّ","kind":"word","gloss":"(of) the truth","transliteration":"l-ḥaqi","lemma":"حَقّ","root":"حقق","entryId":"l-ab22afcdeb66ae98"},{"key":"61:9:8","position":8,"arabic":"لِيُظْهِرَهُۥ","kind":"word","gloss":"to make it prevail","transliteration":"liyuẓ'hirahu","lemma":"أَظْهَرَ","root":"ظهر","entryId":null},{"key":"61:9:9","position":9,"arabic":"عَلَى","kind":"word","gloss":"over","transliteration":"ʿalā","lemma":"عَلَىٰ","root":null,"entryId":"l-08dd9283adb70e54"},{"key":"61:9:10","position":10,"arabic":"ٱلدِّينِ","kind":"word","gloss":"the religion","transliteration":"l-dīni","lemma":"دِين","root":"دين","entryId":"l-869ef1d12b24f52a"},{"key":"61:9:11","position":11,"arabic":"كُلِّهِۦ","kind":"word","gloss":"all of them","transliteration":"kullihi","lemma":"كُلّ","root":"كلل","entryId":"l-6fac43bd71e38426"},{"key":"61:9:12","position":12,"arabic":"وَلَوْ","kind":"word","gloss":"although","transliteration":"walaw","lemma":"لَو","root":null,"entryId":"l-9e02d9e1c2596c32"},{"key":"61:9:13","position":13,"arabic":"كَرِهَ","kind":"word","gloss":"dislike (it)","transliteration":"kariha","lemma":"كَرِهَ","root":"كره","entryId":null},{"key":"61:9:14","position":14,"arabic":"ٱلْمُشْرِكُونَ","kind":"word","gloss":"the polytheists","transliteration":"l-mush'rikūna","lemma":"مُشْرِك","root":"شرك","entryId":"l-f1407d5b914fb36c"},{"key":"61:9:15","position":15,"arabic":"٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"61:10","translation":"O you who believe! Shall I guide you to a trade that will save you from a painful torment?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"61:10:1","position":1,"arabic":"يَـٰٓأَيُّهَا","kind":"word","gloss":"O you","transliteration":"yāayyuhā","lemma":"أَيُّهَا","root":"ايي","entryId":"l-a3fa5dd17841b221"},{"key":"61:10:2","position":2,"arabic":"ٱلَّذِينَ","kind":"word","gloss":"those who(believe)","transliteration":"alladhīna","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"61:10:3","position":3,"arabic":"ءَامَنُوا۟","kind":"word","gloss":"believe","transliteration":"āmanū","lemma":"ءَامَنَ","root":"امن","entryId":"l-f6ec3a6dc0f76aa6"},{"key":"61:10:4","position":4,"arabic":"هَلْ","kind":"word","gloss":"Shall","transliteration":"hal","lemma":"هَل","root":null,"entryId":"l-acd15f3532f2b613"},{"key":"61:10:5","position":5,"arabic":"أَدُلُّكُمْ","kind":"word","gloss":"I guide you","transliteration":"adullukum","lemma":"دَلَّ","root":"دلل","entryId":null},{"key":"61:10:6","position":6,"arabic":"عَلَىٰ","kind":"word","gloss":"to","transliteration":"ʿalā","lemma":"عَلَىٰ","root":null,"entryId":"l-08dd9283adb70e54"},{"key":"61:10:7","position":7,"arabic":"تِجَـٰرَةٍۢ","kind":"word","gloss":"a transaction","transliteration":"tijāratin","lemma":"تِجَٰرَة","root":"تجر","entryId":null},{"key":"61:10:8","position":8,"arabic":"تُنجِيكُم","kind":"word","gloss":"(that) will save you","transliteration":"tunjīkum","lemma":"أَنجَىٰ","root":"نجو","entryId":null},{"key":"61:10:9","position":9,"arabic":"مِّنْ","kind":"word","gloss":"from","transliteration":"min","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"61:10:10","position":10,"arabic":"عَذَابٍ","kind":"word","gloss":"a punishment","transliteration":"ʿadhābin","lemma":"عَذَاب","root":"عذب","entryId":"l-3eb7e15951d31876"},{"key":"61:10:11","position":11,"arabic":"أَلِيمٍۢ","kind":"word","gloss":"painful","transliteration":"alīmin","lemma":"أَلِيم","root":"الم","entryId":"l-e6db50422187d325"},{"key":"61:10:12","position":12,"arabic":"١٠","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"61:11","translation":"That you believe in Allâh and His Messenger (Muhammad صلى الله عليه وسلم) and that you strive hard and fight in the Cause of Allâh with your wealth and your lives: that will be better for you, if you but know!","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"61:11:1","position":1,"arabic":"تُؤْمِنُونَ","kind":"word","gloss":"Believe","transliteration":"tu'minūna","lemma":"ءَامَنَ","root":"امن","entryId":"l-f6ec3a6dc0f76aa6"},{"key":"61:11:2","position":2,"arabic":"بِٱللَّهِ","kind":"word","gloss":"in Allah","transliteration":"bil-lahi","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"61:11:3","position":3,"arabic":"وَرَسُولِهِۦ","kind":"word","gloss":"and His Messenger","transliteration":"warasūlihi","lemma":"رَسُول","root":"رسل","entryId":"l-165e008d0f146d23"},{"key":"61:11:4","position":4,"arabic":"وَتُجَـٰهِدُونَ","kin