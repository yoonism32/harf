d, and then disbelieved; therefore their hearts are sealed, so they understand not.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"63:3:1","position":1,"arabic":"ذَٰلِكَ","kind":"word","gloss":"That","transliteration":"dhālika","lemma":"ذَٰلِك","root":null,"entryId":"l-096a9ad382db7640"},{"key":"63:3:2","position":2,"arabic":"بِأَنَّهُمْ","kind":"word","gloss":"(is) because","transliteration":"bi-annahum","lemma":"أَنّ","root":null,"entryId":"l-9a8e074398908017"},{"key":"63:3:3","position":3,"arabic":"ءَامَنُوا۟","kind":"word","gloss":"they believed","transliteration":"āmanū","lemma":"ءَامَنَ","root":"امن","entryId":"l-f6ec3a6dc0f76aa6"},{"key":"63:3:4","position":4,"arabic":"ثُمَّ","kind":"word","gloss":"then","transliteration":"thumma","lemma":"ثُمّ","root":null,"entryId":"l-75b66396af12da75"},{"key":"63:3:5","position":5,"arabic":"كَفَرُوا۟","kind":"word","gloss":"they disbelieved","transliteration":"kafarū","lemma":"كَفَرَ","root":"كفر","entryId":"l-f6f8e55e4806177f"},{"key":"63:3:6","position":6,"arabic":"فَطُبِعَ","kind":"word","gloss":"so were sealed","transliteration":"faṭubiʿa","lemma":"طَبَعَ","root":"طبع","entryId":null},{"key":"63:3:7","position":7,"arabic":"عَلَىٰ","kind":"word","gloss":"[upon]","transliteration":"ʿalā","lemma":"عَلَىٰ","root":null,"entryId":"l-08dd9283adb70e54"},{"key":"63:3:8","position":8,"arabic":"قُلُوبِهِمْ","kind":"word","gloss":"their hearts","transliteration":"qulūbihim","lemma":"قَلْب","root":"قلب","entryId":"l-4fe27e415bdd53be"},{"key":"63:3:9","position":9,"arabic":"فَهُمْ","kind":"word","gloss":"so they","transliteration":"fahum","lemma":null,"root":null,"entryId":null},{"key":"63:3:10","position":10,"arabic":"لَا","kind":"word","gloss":"(do) not","transliteration":"lā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"63:3:11","position":11,"arabic":"يَفْقَهُونَ","kind":"word","gloss":"understand","transliteration":"yafqahūna","lemma":"يَفْقَهُ","root":"فقه","entryId":null},{"key":"63:3:12","position":12,"arabic":"٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"63:4","translation":"And when you look at them, their bodies please you; and when they speak, you listen to their words. They are as blocks of wood propped up. They think that every cry is against them. They are the enemies, so beware of them. May Allâh curse them! How are they denying (or deviating from) the Right Path?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"63:4:1","position":1,"arabic":"۞ وَإِذَا","kind":"word","gloss":"And when","transliteration":"wa-idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"63:4:2","position":2,"arabic":"رَأَيْتَهُمْ","kind":"word","gloss":"you see them","transliteration":"ra-aytahum","lemma":"رَءَا","root":"راي","entryId":"l-6b7f279dfcd3ea58"},{"key":"63:4:3","position":3,"arabic":"تُعْجِبُكَ","kind":"word","gloss":"pleases you","transliteration":"tuʿ'jibuka","lemma":"أَعْجَبَ","root":"عجب","entryId":null},{"key":"63:4:4","position":4,"arabic":"أَجْسَامُهُمْ ۖ","kind":"word","gloss":"their bodies","transliteration":"ajsāmuhum","lemma":"جِسْم","root":"جسم","entryId":null},{"key":"63:4:5","position":5,"arabic":"وَإِن","kind":"word","gloss":"and if","transliteration":"wa-in","lemma":"إِن","root":null,"entryId":"l-de626c6526849733"},{"key":"63:4:6","position":6,"arabic":"يَقُولُوا۟","kind":"word","gloss":"they speak","transliteration":"yaqūlū","lemma":"قَالَ","root":"قول","entryId":"l-effaf24a5c86c56f"},{"key":"63:4:7","position":7,"arabic":"تَسْمَعْ","kind":"word","gloss":"you listen","transliteration":"tasmaʿ","lemma":"سَمِعَ","root":"سمع","entryId":"l-aaa366d4d080c5ed"},{"key":"63:4:8","position":8,"arabic":"لِقَوْلِهِمْ ۖ","kind":"word","gloss":"to their speech","transliteration":"liqawlihim","lemma":"قَوْل","root":"قول","entryId":"l-5fc9c7afcefb8aa7"},{"key":"63:4:9","position":9,"arabic":"كَأَنَّهُمْ","kind":"word","gloss":"as if they (were)","transliteration":"ka-annahum","lemma":"كَأَنّ","root":null,"entryId":null},{"key":"63:4:10","position":10,"arabic":"خُشُبٌۭ","kind":"word","gloss":"pieces of wood","transliteration":"khushubun","lemma":"خُشُب","root":"خشب","entryId":null},{"key":"63:4:11","position":11,"arabic":"مُّسَنَّدَةٌۭ ۖ","kind":"word","gloss":"propped up","transliteration":"musannadatun","lemma":"مُّسَنَّدَة","root":"سند","entryId":null},{"key":"63:4:12","position":12,"arabic":"يَحْسَبُونَ","kind":"word","gloss":"They think","transliteration":"yaḥsabūna","lemma":"حَسِبَ","root":"حسب","entryId":"l-717e0311dc7803f9"},{"key":"63:4:13","position":13,"arabic":"كُلَّ","kind":"word","gloss":"every","transliteration":"kulla","lemma":"كُلّ","root":"كلل","entryId":"l-6fac43bd71e38426"},{"key":"63:4:14","position":14,"arabic":"صَيْحَةٍ","kind":"word","gloss":"shout","transliteration":"ṣayḥatin","lemma":"صَيْحَة","root":"صيح","entryId":null},{"key":"63:4:15","position":15,"arabic":"عَلَيْهِمْ ۚ","kind":"word","gloss":"(is) against them","transliteration":"ʿalayhim","lemma":"عَلَىٰ","root":null,"entryId":"l-08dd9283adb70e54"},{"key":"63:4:16","position":16,"arabic":"هُمُ","kind":"word","gloss":"They","transliteration":"humu","lemma":null,"root":null,"entryId":null},{"key":"63:4:17","position":17,"arabic":"ٱلْعَدُوُّ","kind":"word","gloss":"(are) the enemy","transliteration":"l-ʿaduwu","lemma":"عَدُوّ","root":"عدو","entryId":"l-f920590bc8ef63e8"},{"key":"63:4:18","position":18,"arabic":"فَٱحْذَرْهُمْ ۚ","kind":"word","gloss":"so beware of them","transliteration":"fa-iḥ'dharhum","lemma":"يَحْذَرُ","root":"حذر","entryId":null},{"key":"63:4:19","position":19,"arabic":"قَـٰتَلَهُمُ","kind":"word","gloss":"May destroy them","transliteration":"qātalahumu","lemma":"قَٰتَلَ","root":"قتل","entryId":"l-6499f22bdaad6937"},{"key":"63:4:20","position":20,"arabic":"ٱللَّهُ ۖ","kind":"word","gloss":"Allah","transliteration":"l-lahu","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"63:4:21","posit