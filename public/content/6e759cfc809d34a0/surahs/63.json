","kind":"word","gloss":"on","transliteration":"ʿalā","lemma":"عَلَىٰ","root":null,"entryId":"l-08dd9283adb70e54"},{"key":"63:7:7","position":7,"arabic":"مَنْ","kind":"word","gloss":"(those) who","transliteration":"man","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"63:7:8","position":8,"arabic":"عِندَ","kind":"word","gloss":"(are) with","transliteration":"ʿinda","lemma":"عِند","root":"عند","entryId":"l-30b61508aaa6b3fa"},{"key":"63:7:9","position":9,"arabic":"رَسُولِ","kind":"word","gloss":"(the) Messenger","transliteration":"rasūli","lemma":"رَسُول","root":"رسل","entryId":"l-165e008d0f146d23"},{"key":"63:7:10","position":10,"arabic":"ٱللَّهِ","kind":"word","gloss":"(of) Allah","transliteration":"l-lahi","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"63:7:11","position":11,"arabic":"حَتَّىٰ","kind":"word","gloss":"until","transliteration":"ḥattā","lemma":"حَتَّىٰ","root":null,"entryId":"l-4bc225a19ba4f7d1"},{"key":"63:7:12","position":12,"arabic":"يَنفَضُّوا۟ ۗ","kind":"word","gloss":"they disband","transliteration":"yanfaḍḍū","lemma":"انفَضُّ","root":"فضض","entryId":null},{"key":"63:7:13","position":13,"arabic":"وَلِلَّهِ","kind":"word","gloss":"And for Allah","transliteration":"walillahi","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"63:7:14","position":14,"arabic":"خَزَآئِنُ","kind":"word","gloss":"(are the) treasures","transliteration":"khazāinu","lemma":"خَزَآئِن","root":"خزن","entryId":null},{"key":"63:7:15","position":15,"arabic":"ٱلسَّمَـٰوَٰتِ","kind":"word","gloss":"(of) the heavens","transliteration":"l-samāwāti","lemma":"سَمَآء","root":"سمو","entryId":"l-e873a75addf25baf"},{"key":"63:7:16","position":16,"arabic":"وَٱلْأَرْضِ","kind":"word","gloss":"and the earth","transliteration":"wal-arḍi","lemma":"أَرْض","root":"ارض","entryId":"l-2c626a3b4c64dbc9"},{"key":"63:7:17","position":17,"arabic":"وَلَـٰكِنَّ","kind":"word","gloss":"but","transliteration":"walākinna","lemma":"لَٰكِنّ","root":null,"entryId":"l-eda514b588e7b3c0"},{"key":"63:7:18","position":18,"arabic":"ٱلْمُنَـٰفِقِينَ","kind":"word","gloss":"the hypocrites","transliteration":"l-munāfiqīna","lemma":"مُنَٰفِقُون","root":"نفق","entryId":null},{"key":"63:7:19","position":19,"arabic":"لَا","kind":"word","gloss":"(do) not","transliteration":"lā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"63:7:20","position":20,"arabic":"يَفْقَهُونَ","kind":"word","gloss":"understand","transliteration":"yafqahūna","lemma":"يَفْقَهُ","root":"فقه","entryId":null},{"key":"63:7:21","position":21,"arabic":"٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"63:8","translation":"They (hyprocrites) say: \"If we return to Al-Madinah, indeed the more honourable (‘Abdullâh bin Ubai bin Salûl, the chief of hyprocrites at Al-Madinah) will expel therefrom the meaner (i.e. Allâh’s Messenger صلى الله عليه وسلم).\" But honour, power and glory belong to Allâh, and to His Messenger (Muhammad صلى الله عليه وسلم), and to the believers, but the hypocrites know not.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"63:8:1","position":1,"arabic":"يَقُولُونَ","kind":"word","gloss":"They say","transliteration":"yaqūlūna","lemma":"قَالَ","root":"قول","entryId":"l-effaf24a5c86c56f"},{"key":"63:8:2","position":2,"arabic":"لَئِن","kind":"word","gloss":"If","transliteration":"la-in","lemma":"إِن","root":null,"entryId":"l-de626c6526849733"},{"key":"63:8:3","position":3,"arabic":"رَّجَعْنَآ","kind":"word","gloss":"we return","transliteration":"rajaʿnā","lemma":"رَجَعَ","root":"رجع","entryId":"l-67e770a61ddf6d5e"},{"key":"63:8:4","position":4,"arabic":"إِلَى","kind":"word","gloss":"to","transliteration":"ilā","lemma":"إِلَىٰ","root":null,"entryId":"l-53539d2c3606b99e"},{"key":"63:8:5","position":5,"arabic":"ٱلْمَدِينَةِ","kind":"word","gloss":"Al-Madinah","transliteration":"l-madīnati","lemma":"مَدِينَة","root":"مدن","entryId":null},{"key":"63:8:6","position":6,"arabic":"لَيُخْرِجَنَّ","kind":"word","gloss":"surely, will expel","transliteration":"layukh'rijanna","lemma":"أَخْرَجَ","root":"خرج","entryId":"l-a25810044f12cf39"},{"key":"63:8:7","position":7,"arabic":"ٱلْأَعَزُّ","kind":"word","gloss":"the more honorable","transliteration":"l-aʿazu","lemma":"أَعَزّ","root":"عزز","entryId":null},{"key":"63:8:8","position":8,"arabic":"مِنْهَا","kind":"word","gloss":"from it","transliteration":"min'hā","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"63:8:9","position":9,"arabic":"ٱلْأَذَلَّ ۚ","kind":"word","gloss":"the more humble","transliteration":"l-adhala","lemma":"أَذَلّ","root":"ذلل","entryId":null},{"key":"63:8:10","position":10,"arabic":"وَلِلَّهِ","kind":"word","gloss":"But for Allah","transliteration":"walillahi","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"63:8:11","position":11,"arabic":"ٱلْعِزَّةُ","kind":"word","gloss":"(is) the honor","transliteration":"l-ʿizatu","lemma":"عِزَّة","root":"عزز","entryId":null},{"key":"63:8:12","position":12,"arabic":"وَلِرَسُولِهِۦ","kind":"word","gloss":"and for His Messenger","transliteration":"walirasūlihi","lemma":"رَسُول","root":"رسل","entryId":"l-165e008d0f146d23"},{"key":"63:8:13","position":13,"arabic":"وَلِلْمُؤْمِنِينَ","kind":"word","gloss":"and for the believers","transliteration":"walil'mu'minīna","lemma":null,"root":"امن","entryId":null},{"key":"63:8:14","position":14,"arabic":"وَلَـٰكِنَّ","kind":"word","gloss":"but","transliteration":"walākinna","lemma":"لَٰكِنّ","root":null,"entryId":"l-eda514b588e7b3c0"},{"key":"63:8:15","position":15,"arabic":"ٱلْمُنَـٰفِقِينَ","kind":"word","gloss":"the hypocrites","transliteration":"l-munāfiqīna","lemma":"مُنَٰفِقُون","root":"نفق","entryId":null},{"key":"63:8:16","position":16,"arabic":"لَا","kind":"word","gloss":"(do) not","transliteration":"lā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"63:8:17","position":17,"arabic":"يَعْلَمُونَ","kind":"word","gloss":"know","transliteration":"yaʿlamūna","lemma":"عَلِمَ","root":"علم","entryId":"l-6de9979b254804ea"},{"key":"63:8:18","position":18,"arabic":"٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"63:9","translation":"O you who believe! Let not your properties or your children divert you from the remembrance of Allâh. And whosoever does that, then they are the losers.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"63:9:1","position":1,"arabic":"يَـٰٓأَيُّهَا","kind":"word","gloss":"O you","transliteration":"yāayyuhā","lemma":"أَيُّهَا","root":"ايي","entryId":"l-a3fa5dd17841b221"},{"key":"63:9:2","position":2,"arabic":"ٱلَّذِينَ","kind":"word","gloss":"those who(believe)","transliteration":"alladhīna","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"63:9:3","position":3,"arabic":"ءَامَنُوا۟","kind":"word","gloss":"believe","transliteration":"āmanū","lemma":"ءَامَنَ","root":"امن","entryId":"l-f6ec3a6dc0f76aa6"},{"key":"63:9:4","position":4,"arabic":"لَا","kind":"word","gloss":"(Let) not","transliteration":"lā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"63:9:5","position":5,"arabic":"تُلْهِكُمْ","kind":"word","gloss":"divert you","transliteration":"tul'hikum","lemma":"أَلْهَىٰ","root":"لهو","entryId":null},{"key":"63:9:6","position":6,"arabic":"أَمْوَٰلُكُمْ","kind":"word","gloss":"your wealth","transliteration":"amwālukum","lemma":"مَال","root":"مول","entryId":"l-ae66a2452b005081"},{"key":"63:9:7","position":7,"arabic":"وَلَآ","kind":"word","gloss":"and not","transliteration":"walā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"63:9:8","position":8,"arabic":"أَوْلَـٰدُكُمْ","kind":"word","gloss":"your children","transliteration":"awlādukum","lemma":"وَلَد","root":"ولد","entryId":"l-aea92fc8200149ce"},{"key":"63:9:9","position":9,"arabic":"عَن","kind":"word","gloss":"from","transliteration":"ʿan","lemma":"عَن","root":null,"entryId":"l-f1109a78c8548754"},{"key":"63:9:10","position":10,"arabic":"ذِكْرِ","kind":"word","gloss":"(the) remembrance","transliteration":"dhik'ri","lemma":"ذِكْر","root":"ذكر","entryId":"l-b273b8ee66c296d9"},{"key":"63:9:11","position":11,"arabic":"ٱللَّهِ ۚ","kind":"word","gloss":"(of) Allah","transliteration":"l-lahi","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"63:9:12","position":12,"arabic":"وَمَن","kind":"word","gloss":"And whoever","transliteration":"waman","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"63:9:13","position":13,"arabic":"يَفْعَلْ","kind":"word","gloss":"does","transliteration":"yafʿal","lemma":"فَعَلَ","root":"فعل","entryId":"l-b0a120934c602e5e"},{"key":"63:9:14","position":14,"arabic":"ذَٰلِكَ","kind":"word","gloss":"that","transliteration":"dhālika","lemma":"ذَٰلِك","root":null,"entryId":"l-096a9ad382db7640"},{"key":"63:9:15","position":15,"arabic":"فَأُو۟لَـٰٓئِكَ","kind":"word","gloss":"then those","transliteration":"fa-ulāika","lemma":"أُولَٰٓئِك","root":null,"entryId":"l-9b2e48d460410286"},{"key":"63:9:16","position":16,"arabic":"هُمُ","kind":"word","gloss":"[they]","transliteration":"humu","lemma":null,"root":null,"entryId":null},{"key":"63:9:17","position":17,"arabic":"ٱلْخَـٰسِرُونَ","kind":"word","gloss":"(are) the losers","transliteration":"l-khāsirūna","lemma":"خَٰسِرِين","root":"خسر","entryId":null},{"key":"63:9:18","position":18,"arabic":"٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"63:10","translation":"And spend (in charity) of that with which We have provided you before death comes to one of you, and he says: \"My Lord! If only You would give me respite for a little while (i.e. return to the worldly life), then I should giveSadaqah (i.e. Zakât ) of my wealth, and be among the righteous [i.e. perform Hajj (pilgrimage to Makkah) and other good deeds].","translationSource":"qul-301-hilali-khan","notes":[{"text":". A) Narrated Abu Hurairah رضي الله عنه : The Prophet صلى الله عليه وسلم said, \"Everyday two angels come down from heaven and one of them says, ‘O Allâh! Compensate every person who spends in Your Cause,’ and the other (angel) says, ‘O Allâh! Destroy every miser.’\" (Sahih Al-Bukhari, Vol.2, Hadith No.522). B) The performance of Hajj is an enjoined duty and its superiority, and the Statement of Allâh عز وجل: \"Hajj (pilgrimage) to the House (Ka‘bah), is a duty that mankind owes to Allâh, those who can afford the expenses (for one’s conveyance, provision and residence); and whoever disbelieves [i.e. denies Hajj (pilgrimage to Makkah), then he is a disbeliever of Allâh], then Allâh stands not in need of any of the ‘Âlamîn (mankind and jinn).\" (V.3:97). C) Islâm demolishes all the previous evil deeds and so do migration (for Allâh’s sake) and Hajj (pilgrimage to Makkah) [Al-Lû’lû’ wal-Marjân, Vol. 1, Chapter 52, Page 205] (Sahih Muslim, Vol.1, Chapter 52, Page 78) D) See the footnote of (V.3:180).","ref":{"surah":3,"ayah":180}}],"tokens":[{"key":"63:10:1","position":1,"arabic":"وَأَنفِقُوا۟","kind":"word","gloss":"And spend","transliteration":"wa-anfiqū","lemma":"أَنفَقَ","root":"نفق","entryId":"l-fda8c90dd801642f"},{"key":"63:10:2","position":2,"arabic":"مِن","kind":"word","gloss":"from","transliteration":"min","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"63:10:3","position":3,"arabic":"مَّا","kind":"word","gloss":"what","transliteration":"mā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"63:10:4","position":4,"arabic":"رَزَقْنَـٰكُم","kind":"word","gloss":"We have provided you","transliteration":"razaqnākum","lemma":"رَزَقَ","root":"رزق","entryId":"l-95d531f7b2b6dbe6"},{"key":"63:10:5","position":5,"arabic":"مِّن","kind":"word","gloss":"from","transliteration":"min","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"63:10:6","position":6,"arabic":"قَبْلِ","kind":"word","gloss":"before","transliteration":"qabli","lemma":"قَبْل","root":"قبل","entryId":"l-4bd70955def13ac7"},{"key":"63:10:7","position":7,"arabic":"أَن","kind":"word","gloss":"[that]","transliteration":"an","lemma":"أَن","root":null,"entryId":"l-6fb897ea8dfcda9d"},{"key":"63:10:8","position":8,"arabic":"يَأْتِىَ","kind":"word","gloss":"comes","transliteration":"yatiya","lemma":"أَتَى","root":"اتي","entryId":"l-491a40b1f8d047fe"},{"key":"63:10:9","position":9,"arabic":"أَحَدَكُمُ","kind":"word","gloss":"(to) one of you","transliteration":"aḥadakumu","lemma":"أَحَد","root":"احد","entryId":"l-4e0bd3447fb54c57"},{"key":"63:10:10","position":10,"arabic":"ٱلْمَوْتُ","kind":"word","gloss":"the death","transliteration":"l-mawtu","lemma":"مَوْت","root":"موت","entryId":"l-28cdb957df053f28"},{"key":"63:10:11","position":11,"arabic":"فَيَقُولَ","kind":"word","gloss":"and he says","transliteration":"fayaqūla","lemma":"قَالَ","root":"قول","entryId":"l-effaf24a5c86c56f"},{"key":"63:10:12","position":12,"arabic":"رَبِّ","kind":"word","gloss":"My Lord","transliteration":"rabbi","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"63:10:13","position":13,"arabic":"لَوْلَآ","kind":"word","gloss":"Why not","transliteration":"lawlā","lemma":"لَوْلَآ","root":null,"entryId":"l-3c9deff96e0632a2"},{"key":"63:10:14","position":14,"arabic":"أَخَّرْتَنِىٓ","kind":"word","gloss":"You delay me","transliteration":"akhartanī","lemma":"أَخَّرَ","root":"اخر","entryId":null},{"key":"63:10:15","position":15,"arabic":"إِلَىٰٓ","kind":"word","gloss":"for","transliteration":"ilā","lemma":"إِلَىٰ","root":null,"entryId":"l-53539d2c3606b99e"},{"key":"63:10:16","position":16,"arabic":"أَجَلٍۢ","kind":"word","gloss":"a term","transliteration":"ajalin","lemma":"أَجَل","root":"اجل","entryId":"l-257b946ceb8064da"},{"key":"63:10:17","position":17,"arabic":"قَرِيبٍۢ","kind":"word","gloss":"near","transliteration":"qarībin","lemma":"قَرِيب","root":"قرب","entryId":null},{"key":"63:10:18","position":18,"arabic":"فَأَصَّدَّقَ","kind":"word","gloss":"so I woul