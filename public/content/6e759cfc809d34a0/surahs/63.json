[{"ref":"63:1","translation":"When the hypocrites come to you (O Muhammad صلى الله عليه وسلم), they say: \"We bear witness that you are indeed the Messenger of Allâh.\" Allâh knows that you are indeed His Messenger, and Allâh bears witness that the hypocrites are liars indeed.","translationSource":"qul-301-hilali-khan","notes":[{"text":"See \"Hypocrisy\" in Appendix 2 at the end of the Book.","ref":null}],"tokens":[{"key":"63:1:1","position":1,"arabic":"إِذَا","kind":"word","gloss":"When","transliteration":"idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"63:1:2","position":2,"arabic":"جَآءَكَ","kind":"word","gloss":"come to you","transliteration":"jāaka","lemma":"جَآءَ","root":"جيا","entryId":"l-1abf61bfcb8fdd4c"},{"key":"63:1:3","position":3,"arabic":"ٱلْمُنَـٰفِقُونَ","kind":"word","gloss":"the hypocrites","transliteration":"l-munāfiqūna","lemma":"مُنَٰفِقُون","root":"نفق","entryId":null},{"key":"63:1:4","position":4,"arabic":"قَالُوا۟","kind":"word","gloss":"they say","transliteration":"qālū","lemma":"قَالَ","root":"قول","entryId":"l-effaf24a5c86c56f"},{"key":"63:1:5","position":5,"arabic":"نَشْهَدُ","kind":"word","gloss":"We testify","transliteration":"nashhadu","lemma":"شَهِدَ","root":"شهد","entryId":"l-1bfee933281e7987"},{"key":"63:1:6","position":6,"arabic":"إِنَّكَ","kind":"word","gloss":"that you","transliteration":"innaka","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"63:1:7","position":7,"arabic":"لَرَسُولُ","kind":"word","gloss":"(are) surely (the) Messenger","transliteration":"larasūlu","lemma":"رَسُول","root":"رسل","entryId":"l-165e008d0f146d23"},{"key":"63:1:8","position":8,"arabic":"ٱللَّهِ ۗ","kind":"word","gloss":"(of) Allah","transliteration":"l-lahi","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"63:1:9","position":9,"arabic":"وَٱللَّهُ","kind":"word","gloss":"And Allah","transliteration":"wal-lahu","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"63:1:10"