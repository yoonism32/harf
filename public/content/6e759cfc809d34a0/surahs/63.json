":"word","gloss":"(of) Allah","transliteration":"l-lahi","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"63:5:9","position":9,"arabic":"لَوَّوْا۟","kind":"word","gloss":"They turn aside","transliteration":"lawwaw","lemma":"لَوَّ","root":"لوي","entryId":null},{"key":"63:5:10","position":10,"arabic":"رُءُوسَهُمْ","kind":"word","gloss":"their heads","transliteration":"ruūsahum","lemma":"رَأْس","root":"راس","entryId":null},{"key":"63:5:11","position":11,"arabic":"وَرَأَيْتَهُمْ","kind":"word","gloss":"and you see them","transliteration":"wara-aytahum","lemma":"رَءَا","root":"راي","entryId":"l-6b7f279dfcd3ea58"},{"key":"63:5:12","position":12,"arabic":"يَصُدُّونَ","kind":"word","gloss":"turning away","transliteration":"yaṣuddūna","lemma":"صَدَّ","root":"صدد","entryId":"l-ca9317c6385dd6cf"},{"key":"63:5:13","position":13,"arabic":"وَهُم","kind":"word","gloss":"while they","transliteration":"wahum","lemma":null,"root":null,"entryId":null},{"key":"63:5:14","position":14,"arabic":"مُّسْتَكْبِرُونَ","kind":"word","gloss":"(are) arrogant","transliteration":"mus'takbirūna","lemma":"مُسْتَكْبِر","root":"كبر","entryId":null},{"key":"63:5:15","position":15,"arabic":"٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"63:6","translation":"It is equal to them whether you (Muhammad صلى الله عليه وسلم) ask forgiveness or ask not forgiveness for them, Allâh will never forgive them. Verily, Allâh guides not the people who are the Fâsiqîn (rebellious, disobedient to Allâh).","translationSource":"qul-301-hilali-khan","notes":[{"text":"See the Qur’ân (V.4:138-145).","ref":null}],"tokens":[{"key":"63:6:1","position":1,"arabic":"سَوَآءٌ","kind":"word","gloss":"(It) is same","transliteration":"sawāon","lemma":"سَوَآء","root":"سوي","entryId":null},{"key":"63:6:2","position":2,"arabic":"عَلَيْهِمْ","kind":"word","gloss":"for them","transliteration":"ʿalayhim","lemma":"عَلَىٰ","root":null,"entryId":"l-08dd9283adb70e54"},{"key":"63:6:3","position":3,"arabic":"أَسْتَغْفَرْتَ","kind":"word","gloss":"whether you ask forgiveness","transliteration":"astaghfarta","lemma":"اسْتَغْفَرَ","root":"غفر","entryId":"l-a814227928267cba"},{"key":"63:6:4","position":4,"arabic":"لَهُمْ","kind":"word","gloss":"for them","transliteration":"lahum","lemma":null,"root":null,"entryId":null},{"key":"63:6:5","position":5,"arabic":"أَمْ","kind":"word","gloss":"or","transliteration":"am","lemma":"أَم","root":null,"entryId":"l-4e40bd84c441ff6d"},{"key":"63:6:6","position":6,"arabic":"لَمْ","kind":"word","gloss":"(do) not","transliteration":"lam","lemma":"لَم","root":null,"entryId":"l-a5ee2f54ca9bbf2c"},{"key":"63:6:7","position":7,"arabic":"تَسْتَغْفِرْ","kind":"word","gloss":"ask forgiveness","transliteration":"tastaghfir","lemma":"اسْتَغْفَرَ","root":"غفر","entryId":"l-a814227928267cba"},{"key":"63:6:8","position":8,"arabic":"لَهُمْ","kind":"word","gloss":"for them","transliteration":"lahum","lemma":null,"root":null,"entryId":null},{"key":"63:6:9","position":9,"arabic":"لَن","kind":"word","gloss":"Never","transliteration":"lan","lemma":"لَن","root":null,"entryId":"l-3db5462128ff695e"},{"key":"63:6:10","position":10,"arabic":"يَغْفِرَ","kind":"word","gloss":"will forgive","transliteration":"yaghfira","lemma":"غَفَرَ","root":"غفر","entryId":"l-e2e4e54a6755dd20"},{"key":"63:6:11","position":11,"arabic":"ٱللَّهُ","kind":"word","gloss":"Allah","transliteration":"l-lahu","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"63:6:12","position":12,"arabic":"لَهُمْ ۚ","kind":"word","gloss":"[to] them","transliteration":"lahum","lemma":null,"root":null,"entryId":null},{"key":"63:6:13","position":13,"arabic":"إِنَّ","kind":"word","gloss":"Indeed","transliteration":"inna","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"63:6:14","position":14,"arabic":"ٱللَّهَ","kind":"word","gloss":"Allah","transliteration":"l-laha","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":