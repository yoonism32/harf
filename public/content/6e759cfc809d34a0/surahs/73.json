[{"ref":"73:1","translation":"O you wrapped in garments (i.e. Prophet Muhammad صلى الله عليه وسلم)!","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"73:1:1","position":1,"arabic":"يَـٰٓأَيُّهَا","kind":"word","gloss":"O you","transliteration":"yāayyuhā","lemma":"أَيُّهَا","root":"ايي","entryId":"l-a3fa5dd17841b221"},{"key":"73:1:2","position":2,"arabic":"ٱلْمُزَّمِّلُ","kind":"word","gloss":"who wraps himself","transliteration":"l-muzamilu","lemma":"مُزَّمِّل","root":"زمل","entryId":null},{"key":"73:1:3","position":3,"arabic":"١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"73:2","translation":"Stand (to pray) all night, except a little -","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"73:2:1","position":1,"arabic":"قُمِ","kind":"word","gloss":"Stand","transliteration":"qumi","lemma":"قَامَ","root":"قوم","entryId":null},{"key":"73:2:2","position":2,"arabic":"ٱلَّيْلَ","kind":"word","gloss":"(in) the night","transliteration":"al-layla","lemma":"لَيْل","root":"ليل","entryId":"l-d2e604e516a58959"},{"key":"73:2:3","position":3,"arabic":"إِلَّا","kind":"word","gloss":"except","transliteration":"illā","lemma":"إِلَّا","root":null,"entryId":"l-250ca4d5b58814dd"},{"key":"73:2:4","position":4,"arabic":"قَلِيلًۭا","kind":"word","gloss":"a little","transliteration":"qalīlan","lemma":"قَلِيل","root":"قلل","entryId":"l-4685af3ba2482099"},{"key":"73:2:5","position":5,"arabic":"٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"73:3","translation":"Half of it or a little less than that,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"73:3:1","position":1,"arabic":"نِّصْفَهُۥٓ","kind":"word","gloss":"Half of it","transliteration":"niṣ'fahu","lemma":"نِصْف","root":"نصف","entryId":null},{"key":"73:3:2","position":2,"arabic":"أَوِ","kind":"word","gloss":"or","transliteration":"awi","lemma":"أَو","root":null,"entryId":"l-338778252179b4e1"},{"key":"73:3:3","position":3,"arabic":"ٱنقُصْ","kind":"word","gloss":"lessen","transliteration":"unquṣ","lemma":"يُنقَصُ","root":"نقص","entryId":null},{"key":"73:3:4","position":4,"arabic":"مِنْهُ","kind":"word","gloss":"from it","transliteration":"min'hu","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"73:3:5","position":5,"arabic":"قَلِيلًا","kind":"word","gloss":"a little","transliteration":"qalīlan","lemma":"قَلِيل","root":"قلل","entryId":"l-4685af3ba2482099"},{"key":"73:3:6","position":6,"arabic":"٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"73:4","translation":"Or a little more. And recite the Qur’ân (aloud) in a slow, (pleasant tone and) style.","translationSource":"qul-301-hilali-khan","notes":[{"text":"See the footnote of (V.29:51).","ref":{"surah":29,"ayah":51}}],"tokens":[{"key":"73:4:1","position":1,"arabic":"أَوْ","kind":"word","gloss":"Or","transliteration":"aw","lemma":"أَو","root":null,"entryId":"l-338778252179b4e1"},{"key":"73:4:2","position":2,"arabic":"زِدْ","kind":"word","gloss":"add","transliteration":"zid","lemma":"زَادَ","root":"زيد","entryId":null},{"key":"73:4:3","position":3,"arabic":"عَلَيْهِ","kind":"word","gloss":"to it","transliteration":"ʿalayhi","lemma":"عَلَىٰ","root":null,"entryId":"l-08dd9283adb70e54"},{"key":"73:4:4","position":4,"arabic":"وَرَتِّلِ","kind":"word","gloss":"and recite","transliteration":"warattili","lemma":"رَتَّلْ","root":"رتل","entryId":null},{"key":"73:4:5","position":5,"arabic":"ٱلْقُرْءَانَ","kind":"word","gloss":"the Quran","transliteration":"l-qur'āna","lemma":"قُرْءَان","root":"قرا","entryId":"l-5ff4c6fce3db7bd6"},{"key":"73:4:6","position":6,"arabic":"تَرْتِيلًا","kind":"word","gloss":"(with) measured rhythmic recitation","transliteration":"tartīlan","lemma":"تَرْتِيل","root":"رتل","entryId":null},{"key":"73:4:7","position":7,"arabic":"٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"73:5","translation":"Verily, We shall send down to you a weighty Word (i.e. obligations, laws).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"73:5:1","position":1,"arabic":"إِنَّا","kind":"word","gloss":"Indeed, We","transliteration":"innā","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"73:5:2","position":2,"arabic":"سَنُلْقِى","kind":"word","gloss":"will cast","transliteration":"sanul'qī","lemma":"أَلْقَىٰٓ","root":"لقي","entryId":"l-09920b7d63c6ad5f"},{"key":"73:5:3","position":3,"arabic":"عَلَيْكَ","kind":"word","gloss":"upon you","transliteration":"ʿalayka","lemma":"عَلَىٰ","root":null,"entryId":"l-08dd9283adb70e54"},{"key":"73:5:4","position":4,"arabic":"قَوْلًۭا","kind":"word","gloss":"a Word","transliteration":"qawlan","lemma":"قَوْل","root":"قول","entryId":"l-5fc9c7afcefb8aa7"},{"key":"73:5:5","position":5,"arabic":"ثَقِيلًا","kind":"word","gloss":"heavy","transliteration":"thaqīlan","lemma":"ثَقِيل","root":"ثقل","entryId":null},{"key":"73:5:6","position":6,"arabic":"٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"73:6","translation":"Verily, the rising by night (for Tahajjud prayer) is very hard and most potent and good for governing oneself, and most suitable for (understanding) the Word (of Allâh).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"73:6:1","position":1,"arabic":"إِنَّ","kind":"word","gloss":"Indeed","transliteration":"inna","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"73:6:2","position":2,"arabic":"نَاشِئَةَ","kind":"word","gloss":"(the) rising","transliteration":"nāshi-ata","lemma":"نَاشِئَة","root":"نشا","entryId":null},{"key":"73:6:3","position":3,"arabic":"ٱلَّيْلِ","kind":"word","gloss":"(at) the night","transliteration":"al-layli","lemma":"لَيْل","root":"ليل","entryId":"l-d2e604e516a58959"},{"key":"73:6:4","position":4,"arabic":"هِىَ","kind":"word","gloss":"it","transliteration":"hiya","lemma":null,"root":null,"entryId":null},{"key":"73:6:5","position":5,"arabic":"أَشَدُّ","kind":"word","gloss":"(is) very hard","transliteration":"ashaddu","lemma":"أَشَدّ","root":"شدد","entryId":null},{"key":"73:6:6","position":6,"arabic":"وَطْـًۭٔا","kind":"word","gloss":"and most potent","transliteration":"waṭan","lemma":"وَطْـٔ","root":"وطا","entryId":null},{"key":"73:6:7","position":7,"arabic":"وَأَقْوَمُ","kind":"word","gloss":"and more suitable","transliteration":"wa-aqwamu","lemma":"أَقْوَم","root":"قوم","entryId":null},{"key":"73:6:8","position":8,"arabic":"قِيلًا","kind":"word","gloss":"(for) Word","transliteration":"qīlan","lemma":"قِيل","root":"قول","entryId":null},{"key":"73:6:9","position":9,"arabic":"٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"73:7","translation":"Verily, there is for you by day prolonged occupation with ordinary duties.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"73:7:1","position":1,"arabic":"إِنَّ","kind":"word","gloss":"Indeed","transliteration":"inna","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"73:7:2","position":2,"arabic":"لَكَ","kind":"word","gloss":"for you","transliteration":"laka","lemma":null,"root":null,"entryId":null},{"key":"73:7:3","position":3,"arabic":"فِى","kind":"word","gloss":"in","transliteration":"fī","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"73:7:4","position":4,"arabic":"ٱلنَّهَارِ","kind":"word","gloss":"the day","transliteration":"l-nahāri","lemma":"نَهَار","root":"نهر","entryId":"l-986a4c42272dc519"},{"key":"73:7:5","position":5,"arabic":"سَبْحًۭا","kind":"word","gloss":"(is) occupation","transliteration":"sabḥan","lemma":"سَبْح","root":"سبح","entryId":null},{"key":"73:7:6","position":6,"arabic":"طَوِيلًۭا","kind":"word","gloss":"prolonged","transliteration":"ṭawīlan","lemma":"طَوِيل","root":"طول","entryId":null},{"key":"73:7:7","position":7,"arabic":"٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"73:8","translation":"And remember the Name of your Lord and devote yourself to Him with a complete devotion.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"73:8:1","position":1,"arabic":"وَٱذْكُرِ","kind":"word","gloss":"And remember","transliteration":"wa-udh'kuri","lemma":"ذَكَرَ","root":"ذكر","entryId":"l-53d8783c59294aca"},{"key":"73:8:2","position":2,"arabic":"ٱسْمَ","kind":"word","gloss":"(the) name","transliteration":"is'ma","lemma":"اسْم","root":"سمو","entryId":"l-5f4457e006a745d9"},{"key":"73:8:3","position":3,"arabic":"رَبِّكَ","kind":"word","gloss":"(of) your Lord","transliteration":"rabbika","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"73:8:4","position":4,"arabic":"وَتَبَتَّلْ","kind":"word","gloss":"and devote yourself","transliteration":"watabattal","lemma":"تَبَتَّلْ","root":"بتل","entryId":null},{"key":"73:8:5","position":5,"arabic":"إِلَيْهِ","kind":"word","gloss":"to Him","transliteration":"ilayhi","lemma":"إِلَىٰ","root":null,"entryId":"l-53539d2c3606b99e"},{"key":"73:8:6","position":6,"arabic":"تَبْتِيلًۭا","kind":"word","gloss":"(with) devotion","transliteration":"tabtīlan","lemma":"تَبْتِيل","root":"بتل","entryId":null},{"key":"73:8:7","position":7,"arabic":"٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"73:9","translation":"(He Alone is) the Lord of the east and the west; Lâ ilâha illâ Huwa (none has the right to be worshipped but He). So take Him Alone as Wakîl (Disposer of your affairs).","translationSource":"qul-301-hilali-khan","notes":[{"text":"See the (V.3:173) and its footnotes.","ref":null}],"tokens":[{"key":"73:9:1","position":1,"arabic":"رَّبُّ","kind":"word","gloss":"(The) Lord","transliteration":"rabbu","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"73:9:2","position":2,"arabic":"ٱلْمَشْرِقِ","kind":"word","gloss":"(of) the east","transliteration":"l-mashriqi","lemma":"مَشْرِق","root":"شرق","entryId":null},{"key":"73:9:3","position":3,"arabic":"وَٱلْمَغْرِبِ","kind":"word","gloss":"and the west","transliteration":"wal-maghribi","lemma":"مَغْرِب","root":"غرب","entryId":null},{"key":"73:9:4","position":4,"arabic":"لَآ","kind":"word","gloss":"(there is) no","transliteration":"lā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"73:9:5","position":5,"arabic":"إِلَـٰهَ","kind":"word","gloss":"god","transliteration":"ilāha","lemma":"إِلَٰه","root":"اله","entryId":"l-c5bb2aebfa35aadd"},{"key":"73:9:6","position":6,"arabic":"إِلَّا","kind":"word","gloss":"except","transliteration":"illā","lemma":"إِلَّا","root":null,"entryId":"l-250ca4d5b58814dd"},{"key":"73:9:7","position":7,"arabic":"هُوَ","kind":"word","gloss":"Him","transliteration":"huwa","lemma":null,"root":null,"entryId":null},{"key":"73:9:8","position":8,"arabic":"فَٱتَّخِذْهُ","kind":"word","gloss":"so take Him","transliteration":"fa-ittakhidh'hu","lemma":"اتَّخَذَ","root":"اخذ","entryId":"l-ce6fef68e0607027"},{"key":"73:9:9","position":9,"arabic":"وَكِيلًۭا","kind":"word","gloss":"(as) Disposer of Affairs","transliteration":"wakīlan","lemma":"وَكِيل","root":"وكل","entryId":null},{"key":"73:9:10","position":10,"arabic":"٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"73:10","translation":"And be patient (O Muhammad صلى الله عليه وسلم) with what they say, and keep away from them in a good way.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"73:10:1","position":1,"arabic":"وَٱصْبِرْ","kind":"word","gloss":"And be patient","transliteration":"wa-iṣ'bir","lemma":"صَبَرَ","root":"صبر","entryId":"l-d5151e034c6e968a"},{"key":"73:10:2","position":2,"arabic":"عَلَىٰ","kind":"word","gloss":"over","transliteration":"ʿalā","lemma":"عَلَىٰ","root":null,"entryId":"l-08dd9283adb70e54"},{"key":"73:10:3","position":3,"arabic":"مَا","kind":"word","gloss":"what","transliteration":"mā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"73:10:4","position":4,"arabic":"يَقُولُونَ","kind":"word","gloss":"they say","transliteration":"yaqūlūna","lemma":"قَالَ","root":"قول","entryId":"l-effaf24a5c86c56f"},{"key":"73:10:5","position":5,"arabic":"وَٱهْجُرْهُمْ","kind":"word","gloss":"and avoid them","transliteration":"wa-uh'jur'hum","lemma":"اهْجُرْ","root":"هجر","entryId":null},{"key":"73:10:6","position":6,"arabic":"هَجْرًۭا","kind":"word","gloss":"an avoidance","transliteration":"hajran","lemma":"هَجْر","root":"هجر","entryId":null},{"key":"73:10:7","position":7,"arabic":"جَمِيلًۭا","kind":"word","gloss":"gracious","transliteration":"jamīlan","lemma":"جَمِيل","root":"جمل","entryId":null},{"key":"73:10:8","position":8,"arabic":"١٠","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"73:11","translation":"And leave Me Alone to deal with the beliers (those who deny My Verses), those who are in possession of good things of life. And give them respite for a little while.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"73:11:1","position":1,"arabic":"وَذَرْنِى","kind":"word","gloss":"And leave Me","transliteration":"wadharnī","lemma":"يَذَرَ","root":"وذر","entryId":"l-ec5f0f88a3e0b836"},{"key":"73:11:2","position":2,"arabic":"وَٱلْمُكَذِّبِينَ","kind":"word","gloss":"and the deniers","transliteration":"wal-mukadhibīna","lemma":"مُّكَذِّبِين","root":"كذب","entryId":null},{"key":"73:11:3","position":3,"arabic":"أُو۟لِى","kind":"word","gloss":"possessors","transliteration":"ulī","lemma":"أُولِى","root":"اول","entryId":"l-5c3e086184c72d04"},{"key":"73:11:4","position":4,"arabic":"ٱلنَّعْمَةِ","kind":"word","gloss":"(of) the ease","transliteration":"l-naʿmati","lemma":"نَّعْمَة","root":"نعم","entryId":null},{"key":"73:11:5","position":5,"arabic":"وَمَهِّلْهُمْ","kind":"word","gloss":"and allow them respite","transliteration":"wamahhil'hum","lemma":"مَهِّلِ","root":"مهل","entryId":null},{"key":"73:11:6","position":6,"arabic":"قَلِيلًا","kind":"word","gloss":"a little","transliteration":"qalīlan","lemma":"قَلِيل","root":"قلل","entryId":"l-4685af3ba2482099"},{"key":"73:11:7","position":7,"arabic":"١١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"73:12","translation":"Verily, with Us are fetters (to bind them), and a raging Fire.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"73:12:1","position":1,"arabic":"إِنَّ","kind":"word","gloss":"Indeed","transliteration":"inna","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"73:12:2","position":2,"arabic":"لَدَيْنَآ","kind":"word","gloss":"with Us","transliteration":"ladaynā","lemma":"لَدَي","root":null,"entryId":null},{"key":"73:12:3","position":3,"arabic":"أَنكَالًۭا","kind":"word","gloss":"(are) shackles","transliteration":"ankālan","lemma":"أَنكَال","root":"نكل","entryId":null},{"key":"73:12:4","position":4,"arabic":"وَجَحِيمًۭا","kind":"word","gloss":"and burning fire","transliteration":"wajaḥīman","lemma":"جَحِيم","root":"جحم","entryId":null},{"key":"73:12:5","position":5,"arabic":"١٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"73:13","translation":"And a food that chokes, and a painful torment.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"73:13:1","position":1,"arabic":"وَطَعَامًۭا","kind":"word","gloss":"And food","transliteration":"waṭaʿāman","lemma":"طَعَام","root":"طعم","entryId":null},{"key":"73:13:2","position":2,"arabic":"ذَا","kind":"word","gloss":"that","transliteration":"dhā","lemma":"ذَا","root":null,"entryId":null},{"key":"73:13:3","position":3,"arabic":"غُصَّةٍۢ","kind":"word","gloss":"chokes","transliteration":"ghuṣṣatin","lemma":"غُصَّة","root":"غصص","entryId":null},{"key":"73:13:4","position":4,"arabic":"وَعَذَابًا","kind":"word","gloss":"and a punishment","transliteration":"waʿadhāban","lemma":"عَذَاب","root":"عذب","entryId":"l-3eb7e15951d31876"},{"key":"73:13:5","position":5,"arabic":"أَلِيمًۭا","kind":"word","gloss":"painful","transliteration":"alīman","lemma":"أَلِيم","root":"الم","entryId":"l-e6db50422187d325"},{"key":"73:13:6","position":6,"arabic":"١٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"73:14","translation":"On the Day when the earth and the mountains will be in violent shake, and the mountains will be a heap of sand poured out.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"73:14:1","position":1,"arabic":"يَوْمَ","kind":"word","gloss":"(On the) Day","transliteration":"yawma","lemma":"يَوْم","root":"يوم","entryId":"l-bd6f5747b4dfe79c"},{"key":"73:14:2","position":2,"arabic":"تَرْجُفُ","kind":"word","gloss":"will quake","transliteration":"tarjufu","lemma":"تَرْجُفُ","root":"رجف","entryId":null},{"key":"73:14:3","position":3,"arabic":"ٱلْأَرْضُ","kind":"word","gloss":"the earth","transliteration":"l-arḍu","lemma":"أَرْض","root":"ارض","entryId":"l-2c626a3b4c64dbc9"},{"key":"73:14:4","position":4,"arabic":"وَٱلْجِبَالُ","kind":"word","gloss":"and the mountains","transliteration":"wal-jibālu","lemma":"جَبَل","root":"جبل","entryId":"l-740cdd8405f7481e"},{"key":"73:14:5","position":5,"arabic":"وَكَانَتِ","kind":"word","gloss":"and will become","transliteration":"wakānati","lemma":"كَانَ","root":"كون","entryId":"l-4b2f9969a9af0d45"},{"key":"73:14:6","position":6,"arabic":"ٱلْجِبَالُ","kind":"word","gloss":"the mountains","transliteration":"l-jibālu","lemma":"جَبَل","root":"جبل","entryId":"l-740cdd8405f7481e"},{"key":"73:14:7","position":7,"arabic":"كَثِيبًۭا","kind":"word","gloss":"a heap of sand","transliteration":"kathīban","lemma":"كَثِيب","root":"كثب","entryId":null},{"key":"73:14:8","position":8,"arabic":"مَّهِيلًا","kind":"word","gloss":"pouring down","transliteration":"mahīlan","lemma":"مَّهِيل","root":"هيل","entryId":null},{"key":"73:14:9","position":9,"arabic":"١٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"73:15","translation":"Verily, We have sent to you (O men) a Messenger (Muhammad صلى الله عليه وسلم) to be a witness over you, as We did send a Messenger [Mûsâ (Moses)] to Fir‘aun (Pharaoh).","translationSource":"qul-301-hilali-khan","notes":[{"text":"See the footnotes of (V.2:252).","ref":null}],"tokens":[{"key":"73:15:1","position":1,"arabic":"إِنَّآ","kind":"word","gloss":"Indeed, We","transliteration":"innā","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"73:15:2","position":2,"arabic":"أَرْسَلْنَآ","kind":"word","gloss":"[We] have sent","transliteration":"arsalnā","lemma":"أَرْسَلَ","root":"رسل","entryId":"l-8b46fe6c57f84b97"},{"key":"73:15:3","position":3,"arabic":"إِلَيْكُمْ","kind":"word","gloss":"to you","transliteration":"ilaykum","lemma":"إِلَىٰ","root":null,"entryId":"l-53539d2c3606b99e"},{"key":"73:15:4","position":4,"arabic":"رَسُولًۭا","kind":"word","gloss":"a Messenger","transliteration":"rasūlan","lemma":"رَسُول","root":"رسل","entryId":"l-165e008d0f146d23"},{"key":"73:15:5","position":5,"arabic":"شَـٰهِدًا","kind":"word","gloss":"(as) a witness","transliteration":"shāhidan","lemma":"شَاهِد","root":"شهد","entryId":null},{"key":"73:15:6","position":6,"arabic":"عَلَيْكُمْ","kind":"word","gloss":"upon you","transliteration":"ʿalaykum","lemma":"عَلَىٰ","root":null,"entryId":"l-08dd9283adb70e54"},{"key":"73:15:7","position":7,"arabic":"كَمَآ","kind":"word","gloss":"as","transliteration":"kamā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"73:15:8","position":8,"arabic":"أَرْسَلْنَآ","kind":"word","gloss":"We sent","transliteration":"arsalnā","lemma":"أَرْسَلَ","root":"رسل","entryId":"l-8b46fe6c57f84b97"},{"key":"73:15:9","position":9,"arabic":"إِلَىٰ","kind":"word","gloss":"to","transliteration":"ilā","lemma":"إِلَىٰ","root":null,"entryId":"l-53539d2c3606b99e"},{"key":"73:15:10","position":10,"arabic":"فِرْعَوْنَ","kind":"word","gloss":"Firaun","transliteration":"fir'ʿawna","lemma":"فِرْعَوْن","root":null,"entryId":"l-59e880136eb31a4d"},{"key":"73:15:11","position":11,"arabic":"رَسُولًۭا","kind":"word","gloss":"a Messenger","transliteration":"rasūlan","lemma":"رَسُول","root":"رسل","entryId":"l-165e008d0f146d23"},{"key":"73:15:12","position":12,"arabic":"١٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"73:16","translation":"But Fir‘aun (Pharaoh) disobeyed the Messenger [Mûsâ (Moses)]; so We seized him with a severe punishment.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"73:16:1","position":1,"arabic":"فَعَصَىٰ","kind":"word","gloss":"But disobeyed","transliteration":"faʿaṣā","lemma":"عَصَا","root":"عصي","entryId":null},{"key":"73:16:2","position":2,"arabic":"فِرْعَوْنُ","kind":"word","gloss":"Firaun","transliteration":"fir'ʿawnu","lemma":"فِرْعَوْن","root":null,"entryId":"l-59e880136eb31a4d"},{"key":"73:16:3","position":3,"arabic":"ٱلرَّسُولَ","kind":"word","gloss":"the Messenger","transliteration":"l-rasūla","lemma":"رَسُول","root":"رسل","entryId":"l-165e008d0f146d23"},{"key":"73:16:4","position":4,"arabic":"فَأَخَذْنَـٰهُ","kind":"word","gloss":"so We seized him","transliteration":"fa-akhadhnāhu","lemma":"أَخَذَ","root":"اخذ","entryId":"l-23b788401d30a4f6"},{"key":"73:16:5","position":5,"arabic":"أَخْذًۭا","kind":"word","gloss":"(with) a seizure","transliteration":"akhdhan","lemma":"أَخْذ","root":"اخذ","entryId":null},{"key":"73:16:6","position":6,"arabic":"وَبِيلًۭا","kind":"word","gloss":"ruinous","transliteration":"wabīlan","lemma":"وَبِيل","root":"وبل","entryId":null},{"key":"73:16:7","position":7,"arabic":"١٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"73:17","translation":"Then how can you avoid the punishment, if you disbelieve, on a Day (i.e. the Day of Resurrection) that will make the children grey-headed?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"73:17:1","position":1,"arabic":"فَكَيْفَ","kind":"word","gloss":"Then how","transliteration":"fakayfa","lemma":"كَيْف","root":"كيف","entryId":"l-9ae8af732625ada5"},{"key":"73:17:2","position":2,"arabic":"تَتَّقُونَ","kind":"word","gloss":"will you guard yourselves","transliteration":"tattaqūna","lemma":"اتَّقَىٰ","root":"وقي","entryId":"l-f72641a6cc6e53f2"},{"key":"73:17:3","position":3,"arabic":"إِن","kind":"word","gloss":"if","transliteration":"in","lemma":"إِن","root":null,"entryId":"l-de626c6526849733"},{"key":"73:17:4","position":4,"arabic":"كَفَرْتُمْ","kind":"word","gloss":"you disbelieve","transliteration":"kafartum","lemma":"كَفَرَ","root":"كفر","entryId":"l-f6f8e55e4806177f"},{"key":"73:17:5","position":5,"arabic":"يَوْمًۭا","kind":"word","gloss":"a Day","transliteration":"yawman","lemma":"يَوْم","root":"يوم","entryId":"l-bd6f5747b4dfe79c"},{"key":"73:17:6","position":6,"arabic":"يَجْعَلُ","kind":"word","gloss":"(that) will make","transliteration":"yajʿalu","lemma":"جَعَلَ","root":"جعل","entryId":"l-784f751d925aef34"},{"key":"73:17:7","position":7,"arabic":"ٱلْوِلْدَٰنَ","kind":"word","gloss":"the children","transliteration":"l-wil'dāna","lemma":"وَلِيد","root":"ولد","entryId":null},{"key":"73:17:8","position":8,"arabic":"شِيبًا","kind":"word","gloss":"gray-haired","transliteration":"shīban","lemma":"شِيب","root":"شيب","entryId":null},{"key":"73:17:9","position":9,"arabic":"١٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"73:18","translation":"Whereon the heaven will be cleft asunder? His Promise is certainly to be accomplished.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"73:18:1","position":1,"arabic":"ٱلسَّمَآءُ","kind":"word","gloss":"The heaven","transliteration":"al-samāu","lemma":"سَمَآء","root":"سمو","entryId":"l-e873a75addf25baf"},{"key":"73:18:2","position":2,"arabic":"مُنفَطِرٌۢ","kind":"word","gloss":"(will) break apart","transliteration":"munfaṭirun","lemma":"مُنفَطِر","root":"فطر","entryId":null},{"key":"73:18:3","position":3,"arabic":"بِهِۦ ۚ","kind":"word","gloss":"therefrom","transliteration":"bihi","lemma":null,"root":null,"entryId":null},{"key":"73:18:4","position":4,"arabic":"كَانَ","kind":"word","gloss":"is","transliteration":"kāna","lemma":"كَانَ","root":"كون","entryId":"l-4b2f9969a9af0d45"},{"key":"73:18:5","position":5,"arabic":"وَعْدُهُۥ","kind":"word","gloss":"His Promise","transliteration":"waʿduhu","lemma":"وَعْد","root":"وعد","entryId":"l-bb9d234fe783d9fb"},{"key":"73:18:6","position":6,"arabic":"مَفْعُولًا","kind":"word","gloss":"to be fulfilled","transliteration":"mafʿūlan","lemma":"مَفْعُول","root":"فعل","entryId":null},{"key":"73:18:7","position":7,"arabic":"١٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"73:19","translation":"Verily, this is an admonition: therefore whosoever will, let him take a Path to His Lord!","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"73:19:1","position":1,"arabic":"إِنَّ","kind":"word","gloss":"Indeed","transliteration":"inna","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"73:19:2","position":2,"arabic":"هَـٰذِهِۦ","kind":"word","gloss":"this","transliteration":"hādhihi","lemma":"هَٰذَا","root":null,"entryId":"l-a874a3c6f146e6a2"},{"key":"73:19:3","position":3,"arabic":"تَذْكِرَةٌۭ ۖ","kind":"word","gloss":"(is) a Reminder","transliteration":"tadhkiratun","lemma":"تَذْكِرَة","root":"ذكر","entryId":null},{"key":"73:19:4","position":4,"arabic":"فَمَن","kind":"word","gloss":"then whoever","transliteration":"faman","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"73:19:5","position":5,"arabic":"شَآءَ","kind":"word","gloss":"wills","transliteration":"shāa","lemma":"شَآءَ","root":"شيا","entryId":"l-e6061b9230d95354"},{"key":"73:19:6","position":6,"arabic":"ٱتَّخَذَ","kind":"word","gloss":"(let him) take","transliteration":"ittakhadha","lemma":"اتَّخَذَ","root":"اخذ","entryId":"l-ce6fef68e0607027"},{"key":"73:19:7","position":7,"arabic":"إِلَىٰ","kind":"word","gloss":"to","transliteration":"ilā","lemma":"إِلَىٰ","root":null,"entryId":"l-53539d2c3606b99e"},{"key":"73:19:8","position":8,"arabic":"رَبِّهِۦ","kind":"word","gloss":"his Lord","transliteration":"rabbihi","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"73:19:9","position":9,"arabic":"سَبِيلًا","kind":"word","gloss":"a way","transliteration":"sabīlan","lemma":"سَبِيل","root":"سبل","entryId":"l-c204df14296b43ea"},{"key":"73:19:10","position":10,"arabic":"١٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"73:20","translation":"Verily, your Lord knows that you do stand (to pray at night) a little less than two thirds of the night, or half the night, or a third of the night, and also a party of those with you. And Allâh measures the night and the day. He knows that you are unable to pray the whole night, so He has turned to you (in mercy). So, recite you of the Qur’ân as much as may be easy for you. He knows that there will be some among you sick, others travelling through the land, seeking of Allâh’s Bounty, yet others fighting in Allâh’s Cause. So recite as much of the Qur’ân as may be easy (for you), and perform As-Salât (Iqâmat-as-Salât ) and give Zakât, and lend to Allâh a goodly loan. And whatever good you send before you for yourselves (i.e. Nawâfil non-obligatory acts of worship: prayers, charity, fasting, Hajj and ‘Umrah), you will certainly find it with Allâh, better and greater in reward. And seek Forgiveness of Allâh. Verily, Allâh is Oft-Forgiving, Most-Merciful.","translationSource":"qul-301-hilali-khan","notes":[{"text":"See the footnotes of (V.50:39).","ref":null}],"tokens":[{"key":"73:20:1","position":1,"arabic":"۞ إِنَّ","kind