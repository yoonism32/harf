[{"ref":"102:1","translation":"The mutual rivalry (for piling up of worldly things) diverts you,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"102:1:1","position":1,"arabic":"أَلْهَىٰكُمُ","kind":"word","gloss":"Diverts you","transliteration":"alhākumu","lemma":"أَلْهَىٰ","root":"لهو","entryId":null},{"key":"102:1:2","position":2,"arabic":"ٱلتَّكَاثُرُ","kind":"word","gloss":"the competition to increase","transliteration":"l-takāthuru","lemma":"تَّكَاثُر","root":"كثر","entryId":null},{"key":"102:1:3","position":3,"arabic":"١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"102:2","translation":"Until you visit the graves (i.e. till you die).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"102:2:1","position":1,"arabic":"حَتَّىٰ","kind":"word","gloss":"Until","transliteration":"ḥattā","lemma":"حَتَّىٰ","root":null,"entryId":"l-4bc225a19ba4f7d1"},{"key":"102:2:2","position":2,"arabic":"زُرْتُمُ","kind":"word","gloss":"you visit","transliteration":"zur'tumu","lemma":"زُرْ","root":"زور","entryId":null},{"key":"102:2:3","position":3,"arabic":"ٱلْمَقَابِرَ","kind":"word","gloss":"the graves","transliteration":"l-maqābira","lemma":"مَقَابِر","root":"قبر","entryId":null},{"key":"102:2:4","position":4,"arabic":"٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"102:3","translation":"Nay! You shall come to know!","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"102:3:1","position":1,"arabic":"كَلَّا","kind":"word","gloss":"Nay","transliteration":"kallā","lemma":"كَلَّا","root":null,"entryId":null},{"key":"102:3:2","position":2,"arabic":"سَوْفَ","kind":"word","gloss":"Soon","transliteration":"sawfa","lemma":"سَوْف","root":null,"entryId":"l-0e28987d8e8dbefa"},{"key":"102:3:3","position":3,"arabic":"تَعْلَمُونَ","kind":"word","gloss":"you will know","transliteration":"taʿlamūna","lemma":"عَلِمَ","root":"علم","entryId":"l-6de9979b254804ea"},{"key":"102:3:4","position":4,"arabic":"٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"102:4","translation":"Again nay! You shall come to know!","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"102:4:1","position":1,"arabic":"ثُمَّ","kind":"word","gloss":"Then","transliteration":"thumma","lemma":"ثُمّ","root":null,"entryId":"l-75b66396af12da75"},{"key":"102:4:2","position":2,"arabic":"كَلَّا","kind":"word","gloss":"nay","transliteration":"kallā","lemma":"كَلَّا","root":null,"entryId":null},{"key":"102:4:3","position":3,"arabic":"سَوْفَ","kind":"word","gloss":"Soon","transliteration":"sawfa","lemma":"سَوْف","root":null,"entryId":"l-0e28987d8e8dbefa"},{"key":"102:4:4","position":4,"arabic":"تَعْلَمُونَ","kind":"word","gloss":"you will know","transliteration":"taʿlamūna","lemma":"عَلِمَ","root":"علم","entryId":"l-6de9979b254804ea"},{"key":"102:4:5","position":5,"arabic":"٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"102:5","translation":"Nay! If you knew with a sure knowledge (the end result of piling up, you would not have been occupied yourselves in worldly things).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"102:5:1","position":1,"arabic":"كَلَّا","kind":"word","gloss":"Nay","transliteration":"kallā","lemma":"كَلَّا","root":null,"entryId":null},{"key":"102:5:2","position":2,"arabic":"لَوْ","kind":"word","gloss":"If","transliteration":"law","lemma":"لَو","root":null,"entryId":"l-9e02d9e1c2596c32"},{"key":"102:5:3","position":3,"arabic":"تَعْلَمُونَ","kind":"word","gloss":"you know","transliteration":"taʿlamūna","lemma":"عَلِمَ","root":"علم","entryId":"l-6de9979b254804ea"},{"key":"102:5:4","position":4,"arabic":"عِلْمَ","kind":"word","gloss":"(with) a knowledge","transliteration":"ʿil'ma","lemma":"عِلْم","root":"علم","entryId":"l-c2e53cd05dc28448"},{"key":"102:5:5","position":5,"arabic":"ٱلْيَقِينِ","kind":"word","gloss":"(of) certainty","transliteration":"l-yaqīni","lemma":"يَقِين","root":"يقن","entryId":null},{"key":"102:5:6","position":6,"arabic":"٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"102:6","translation":"Verily, You shall see the blazing Fire (Hell)!","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"102:6:1","position":1,"arabic":"لَتَرَوُنَّ","kind":"word","gloss":"Surely you will see","transliteration":"latarawunna","lemma":"رَءَا","root":"راي","entryId":"l-6b7f279dfcd3ea58"},{"key":"102:6:2","position":2,"arabic":"ٱلْجَحِيمَ","kind":"word","gloss":"the Hellfire","transliteration":"l-jaḥīma","lemma":"جَحِيم","root":"جحم","entryId":null},{"key":"102:6:3","position":3,"arabic":"٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"102:7","translation":"And again, you shall see it with certainty of sight!","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"102:7:1","position":1,"arabic":"ثُمَّ","kind":"word","gloss":"Then","transliteration":"thumma","lemma":"ثُمّ","root":null,"entryId":"l-75b66396af12da75"},{"key":"102:7:2","position":2,"arabic":"لَتَرَوُنَّهَا","kind":"word","gloss":"surely you will see it","transliteration":"latarawunnahā","lemma":"رَءَا","root":"راي","entryId":"l-6b7f279dfcd3ea58"},{"key":"102:7:3","position":3,"arabic":"عَيْنَ","kind":"word","gloss":"(with the) eye","transliteration":"ʿayna","lemma":"عَيْن","root":"عين","entryId":"l-1b5ec51c16058996"},{"key":"102:7:4","position":4,"arabic":"ٱلْيَقِينِ","kind":"word","gloss":"(of) certainty","transliteration":"l-yaqīni","lemma":"يَقِين","root":"يقن","entryId":null},{"key":"102:7:5","position":5,"arabic":"٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"102:8","translation":"Then on that Day you shall be asked about the delights (you indulged in, in this world)!","translationSource":"qul-301-hilali-khan","notes":[{"text":"Narrated Abu Hurairah رضي الله عنه: Once during a day or a night Allâh’s Messenger صلى الله عليه وسلم came out and found Abu Bakr and ‘Umar رضي الله عنهما: he said: \"What has brought you out of your homes at this hour?\" They replied: \"Hunger, O Allâh’s Messenger.\" He said: \"By Him (Allâh) in Whose Hand my soul is, I too have come out for the same reason for which you have come out\". Then he صلى الله عليه وسلم said to them (both): \"Come along! \"And he went along with them to a man from the Ansâr but they did not find him in his house. The wife of that man saw the Prophet صلى الله عليه وسلم and said: \"You are welcome.\" Allâh’s Messenger صلى الله عليه وسلم asked her (saying): \"Where is so-and-so?\" She replied: \"He has gone to fetch some water for us.\" In the mean time the Ansarî man came, saw Allâh’s Messenger صلى الله عليه وسلم with his two Companions and said: \"All the praise and thanks be to Allâh: today there is none superior to me as regards guests.\" Then he went and brought a part of a bunch of date-fruit, having dates, some still green, some ripe and some fully ripe and requested them to eat from it. He then took his knife (to slaughter for them a sheep). Allâh’s Messenger صلى الله عليه وسلم said to him: \"Beware! Do not slaughter a milch sheep\". So he slaughtered a sheep (prepared the meals from its meat). They ate from that sheep and that bunch of dates and drank water. After they had finished eating and drinking to their fill, Allâh’s Messenger صلى الله عليه وسلم said to Abu Bakr and ‘Umar رضي الله عنهما : \"By Him in Whose Hand my soul is, you will be asked about this treat on the Day of Resurrection. He (Allâh) brought you out of your homes with hunger and you are not returning to your homes till you have been blessed with this treat.\" (Sahih Muslim, Vol.6, The Book of Drinks, Chapter 20, Pages 116,117).","ref":null}],"tokens":[{"key":"102:8:1","position":1,"arabic":"ثُمَّ","kind":"word","gloss":"Then","transliteration":"thumma","lemma":"ثُمّ","root":null,"entryId":"l-75b66396af12da75"},{"key":"102:8:2","position":2,"arabic":"لَتُسْـَٔلُنَّ","kind":"word","gloss":"surely you will be asked","transliteration":"latus'alunna","lemma":"سَأَلَ","root":"سال","entryId":"l-ad7819fc39b763e0"},{"key":"102:8:3","position":3,"arabic":"يَوْمَئِذٍ","kind":"word","gloss":"that Day","transliteration":"yawma-idhin","lemma":"يَوْمَئِذ","root":"يوم","entryId":"l-675d35e3d4bddca4"},{"key":"102:8:4","position":4,"arabic":"عَنِ","kind":"word","gloss":"about","transliteration":"ʿani","lemma":"عَن","root":null,"entryId":"l-f1109a78c8548754"},{"key":"102:8:5","position":5,"arabic":"ٱلنَّعِيمِ","kind":"word","gloss":"the pleasures","transliteration":"l-naʿīmi","lemma":"نَعِيم","root":"نعم","entryId":null},{"key":"102:8:6","position":6,"arabic":"٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]}]