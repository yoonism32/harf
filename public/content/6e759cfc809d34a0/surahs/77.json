[{"ref":"77:1","translation":"By the winds (or angels or the Messengers of Allâh) sent forth one after another.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"77:1:1","position":1,"arabic":"وَٱلْمُرْسَلَـٰتِ","kind":"word","gloss":"By the ones sent forth","transliteration":"wal-mur'salāti","lemma":"مُرْسَلَٰت","root":"رسل","entryId":null},{"key":"77:1:2","position":2,"arabic":"عُرْفًۭا","kind":"word","gloss":"one after another","transliteration":"ʿur'fan","lemma":"عُرْف","root":"عرف","entryId":null},{"key":"77:1:3","position":3,"arabic":"١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"77:2","translation":"And by the winds that blow violently.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"77:2:1","position":1,"arabic":"فَٱلْعَـٰصِفَـٰتِ","kind":"word","gloss":"And the winds that blow","transliteration":"fal-ʿāṣifāti","lemma":"عَٰصِفَٰت","root":"عصف","entryId":null},{"key":"77:2:2","position":2,"arabic":"عَصْفًۭا","kind":"word","gloss":"violently","transliteration":"ʿaṣfan","lemma":"عَصْف","root":"عصف","entryId":null},{"key":"77:2:3","position":3,"arabic":"٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"77:3","translation":"And by the winds that scatter clouds and rain.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"77:3:1","position":1,"arabic":"وَٱلنَّـٰشِرَٰتِ","kind":"word","gloss":"And the ones that scatter","transliteration":"wal-nāshirāti","lemma":"نَّٰشِرَٰت","root":"نشر","entryId":null},{"key":"77:3:2","position":2,"arabic":"نَشْرًۭا","kind":"word","gloss":"far and wide","transliteration":"nashran","lemma":"نَشْر","root":"نشر","entryId":null},{"key":"77:3:3","position":3,"arabic":"٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"77:4","translation":"And by the Verses (of the Qur’ân) that separate the right from the wrong.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"77:4:1","position":1,"arabic":"فَٱلْفَـٰرِقَـٰتِ","kind":"word","gloss":"And those who separate","transliteration":"fal-fāriqāti","lemma":"فَٰرِقَٰت","root":"فرق","entryId":null},{"key":"77:4:2","position":2,"arabic":"فَرْقًۭا","kind":"word","gloss":"(by the) Criterion","transliteration":"farqan","lemma":"فَرْق","root":"فرق","entryId":null},{"key":"77:4:3","position":3,"arabic":"٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"77:5","translation":"And by the angels that bring the revelations to the Messengers,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"77:5:1","position":1,"arabic":"فَٱلْمُلْقِيَـٰتِ","kind":"word","gloss":"And those who bring down","transliteration":"fal-mul'qiyāti","lemma":"مُلْقِيَٰت","root":"لقي","entryId":null},{"key":"77:5:2","position":2,"arabic":"ذِكْرًا","kind":"word","gloss":"(the) Reminder","transliteration":"dhik'ran","lemma":"ذِكْر","root":"ذكر","entryId":"l-b273b8ee66c296d9"},{"key":"77:5:3","position":3,"arabic":"٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"77:6","translation":"To cut off all excuses or to warn.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"77:6:1","position":1,"arabic":"عُذْرًا","kind":"word","gloss":"(As) justification","transliteration":"ʿudh'ran","lemma":"عُذْر","root":"عذر","entryId":null},{"key":"77:6:2","position":2,"arabic":"أَوْ","kind":"word","gloss":"or","transliteration":"aw","lemma":"أَو","root":null,"entryId":"l-338778252179b4e1"},{"key":"77:6:3","position":3,"arabic":"نُذْرًا","kind":"word","gloss":"warning","transliteration":"nudh'ran","lemma":"نُذْر","root":"نذر","entryId":null},{"key":"77:6:4","position":4,"arabic":"٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"77:7","translation":"Surely, wha