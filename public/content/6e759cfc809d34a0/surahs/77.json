"word","gloss":"they will speak","transliteration":"yanṭiqūna","lemma":"يَنطِقُ","root":"نطق","entryId":null},{"key":"77:35:5","position":5,"arabic":"٣٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"77:36","translation":"And they will not be permitted to put forth any excuse.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"77:36:1","position":1,"arabic":"وَلَا","kind":"word","gloss":"And not","transliteration":"walā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"77:36:2","position":2,"arabic":"يُؤْذَنُ","kind":"word","gloss":"will it be permitted","transliteration":"yu'dhanu","lemma":"أَذِنَ","root":"اذن","entryId":null},{"key":"77:36:3","position":3,"arabic":"لَهُمْ","kind":"word","gloss":"for them","transliteration":"lahum","lemma":null,"root":null,"entryId":null},{"key":"77:36:4","position":4,"arabic":"فَيَعْتَذِرُونَ","kind":"word","gloss":"to make excuses","transliteration":"fayaʿtadhirūna","lemma":"يَعْتَذِرُ","root":"عذر","entryId":null},{"key":"77:36:5","position":5,"arabic":"٣٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"77:37","translation":"Woe that Day to the deniers (of the Day of Resurrection)!","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"77:37:1","position":1,"arabic":"وَيْلٌۭ","kind":"word","gloss":"Woe","transliteration":"waylun","lemma":"وَيْل","root":null,"entryId":"l-d11f2adf827dd758"},{"key":"77:37:2","position":2,"arabic":"يَوْمَئِذٍۢ","kind":"word","gloss":"that Day","transliteration":"yawma-idhin","lemma":"يَوْمَئِذ","root":"يوم","entryId":"l-675d35e3d4bddca4"},{"key":"77:37:3","position":3,"arabic":"لِّلْمُكَذِّبِينَ","kind":"word","gloss":"to the deniers","transliteration":"lil'mukadhibīna","lemma":"مُّكَذِّبِين","root":"كذب","entryId":null},{"key":"77:37:4","position":4,"arabic":"٣٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"77:38","translation":"That will be a Day of Decision! We have brought you and the men of old together!","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"77:38:1","position":1,"arabic":"هَـٰذَا","kind":"word","gloss":"This","transliteration":"hādhā","lemma":"هَٰذَا","root":null,"entryId":"l-a874a3c6f146e6a2"},{"key":"77:38:2","position":2,"arabic":"يَوْمُ","kind":"word","gloss":"(is the) Day","transliteration":"yawmu","lemma":"يَوْم","root":"يوم","entryId":"l-bd6f5747b4dfe79c"},{"key":"77:38:3","position":3,"arabic":"ٱلْفَصْلِ ۖ","kind":"word","gloss":"(of) Judgment","transliteration":"l-faṣli","lemma":"فَصْل","root":"فصل","entryId":null},{"key":"77:38:4","position":4,"arabic":"جَمَعْنَـٰكُمْ","kind":"word","gloss":"We have gathered you","transliteration":"jamaʿnākum","lemma":"جَمَعَ","root":"جمع","entryId":null},{"key":"77:38:5","position":5,"arabic":"وَٱلْأَوَّلِينَ","kind":"word","gloss":"and the former (people)","transliteration":"wal-awalīna","lemma":"أَوَّل","root":"اول","entryId":"l-ecdf865520009f7c"},{"key":"77:38:6","position":6,"arabic":"٣٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"77:39","translation":"So if you have a plot, use it against Me (Allâh جل جلاله)!","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"77:39:1","position":1,"arabic":"فَإِن","kind":"word","gloss":"So if","transliteration":"fa-in","lemma":"إِن","root":null,"entryId":"l-de626c6526849733"},{"key":"77:39:2","position":2,"arabic":"كَانَ","kind":"word","gloss":"is","transliteration":"kāna","lemma":"كَانَ","root":"كون","entryId":"l-4b2f9969a9af0d45"},{"key":"77:39:3","position":3,"arabic":"لَكُمْ","kind":"word","gloss":"for you","transliteration":"lakum","lemma":null,"root":null,"entryId":null},{"key":"77:39:4","position":4,"arabic":"كَيْدٌۭ","kind":"word","gloss":"a plan","transliteration":"kaydun","lemma":"كَيْد","root":"كيد","entryId":null},{"key":"77:39:5","position":5,"arabic":"فَكِيدُونِ","kind":"word","gloss":"then plan against Me","transliteration":"fakīdūni","lemma":"كِيدُ","root":"كيد","entryId":null},{"key":"77:39:6","position":6,"arabic":"٣٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"77:40","translation":"Woe that Day to the deniers (of the Day of Resurrection)!","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"77:40:1","position":1,"arabic":"وَيْلٌۭ","kind":"word","gloss":"Woe","transliteration":"waylun","lemma":"وَيْل","root":null,"entryId":"l-d11f2adf827dd758"},{"key":"77:40:2","position":2,"arabic":"يَوْمَئِذٍۢ","kind":"word","gloss":"that Day","transliteration":"yawma-idhin","lemma":"يَوْمَئِذ","root":"يوم","entryId":"l-675d35e3d4bddca4"},{"key":"77:40:3","position":3,"arabic":"لِّلْمُكَذِّبِينَ","kind":"word","gloss":"to the deniers","transliteration":"lil'mukadhibīna","lemma":"مُّكَذِّبِين","root":"كذب","entryId":null},{"key":"77:40:4","position":4,"arabic":"٤٠","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"77:41","translation":"Verily, the Muttaqûn (the pious. See V.2:2) shall be amidst shades and springs.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"77:41:1","position":1,"arabic":"إِنَّ","kind":"word","gloss":"Indeed","transliteration":"inna","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"77:41:2","position":2,"arabic":"ٱلْمُتَّقِينَ","kind":"word","gloss":"the righteous","transliteration":"l-mutaqīna","lemma":"مُتَّقِين","root":"وقي","entryId":"l-1eeefa856cd97454"},{"key":"77:41:3","position":3,"arabic":"فِى","kind":"word","gloss":"(will be) in","transliteration":"fī","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"77:41:4","position":4,"arabic":"ظِلَـٰلٍۢ","kind":"word","gloss":"shades","transliteration":"ẓilālin","lemma":"ظِلّ","root":"ظلل","entryId":null},{"key":"77:41:5","position":5,"arabic":"وَعُيُونٍۢ","kind":"word","gloss":"and springs","transliteration":"waʿuyūnin","lemma":"عَيْن","root":"عين","entryId":"l-1b5ec51c16058996"},{"key":"77:41:6","position":6,"arabic":"٤١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"77:42","translation":"And fruits, such as they desire.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"77:42:1","position":1,"arabic":"وَفَوَٰكِهَ","kind":"word","gloss":"And fruits","transliteration":"wafawākiha","lemma":"فَوَٰكِه","root":"فكه","entryId":null},{"key":"77:42:2","position":2,"arabic":"مِمَّا","kind":"word","gloss":"from what","transliteration":"mimmā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"77:42:3","position":3,"arabic":"يَشْتَهُونَ","kind":"word","gloss":"they desire","transliteration":"yashtahūna","lemma":"اشْتَهَتْ","root":"شهو","entryId":null},{"key":"77:42:4","position":4,"arabic":"٤٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"77:43","translation":"\"Eat and drink comfortably for that which you used to do.\"","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"77:43:1","position":1,"arabic":"كُلُوا۟","kind":"word","gloss":"Eat","transliteration":"kulū","lemma":"أَكَلَ","root":"اكل","entryId":"l-dd3887135f91e5c7"},{"key":"77:43:2","position":2,"arabic":"وَٱشْرَبُوا۟","kind":"word","gloss":"and drink","transliteration":"wa-ish'rabū","lemma":"شَرِبَ","root":"شرب","entryId":null},{"key":"77:43:3","position":3,"arabic":"هَنِيٓـًٔۢا","kind":"word","gloss":"(in) satisfaction","transliteration":"hanīan","lemma":"هَنِيٓـٔ","root":"هنا","entryId":null},{"key":"77:43:4","position":4,"arabic":"بِمَا","kind":"word","gloss":"for what","transliteration":"bimā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"77:43:5","position":5,"arabic":"كُنتُمْ","kind":"word","gloss":"you used to","transliteration":"kuntum","lemma":"كَانَ","root":"كون","entryId":"l-4b2f9969a9af0d45"},{"key":"77:43:6","position":6,"arabic":"تَعْمَلُونَ","kind":"word","gloss":"do","transliteration":"taʿmalūna","lemma":"عَمِلَ","root":"عمل","entryId":"l-4fa22225cead4d92"},{"key":"77:43:7","position":7,"arabic":"٤٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"77:44","translation":"Verily, thus We reward the Muhsinûn (good-doers. See V.2:112).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"77:44:1","position":1,"arabic":"إِنَّا","kind":"word","gloss":"Indeed, We","transliteration":"innā","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"77:44:2","position":2,"arabic":"كَذَٰلِكَ","kind":"word","gloss":"thus","transliteration":"kadhālika","lemma":"ذَٰلِك","root":null,"entryId":"l-096a9ad382db7640"},{"key":"77:44:3","position":3,"arabic":"نَجْزِى","kind":"word","gloss":"reward","transliteration":"najzī","lemma":"جَزَىٰ","root":"جزي","entryId":"l-73cab29f9798ecaf"},{"key":"77:44:4","position":4,"arabic":"ٱلْمُحْسِنِينَ","kind":"word","gloss":"the good-doers","transliteration":"l-muḥ'sinīna","lemma":"مُحْسِن","root":"حسن","entryId":"l-5d209b5bba354209"},{"key":"77:44:5","position":5,"arabic":"٤٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"77:45","translation":"Woe that Day to the deniers (of the Day of Resurrection)!","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"77:45:1","position":1,"arabic":"وَيْلٌۭ","kind":"word","gloss":"Woe","transliteration":"waylun","lemma":"وَيْل","root":null,"entryId":"l-d11f2adf827dd758"},{"key":"77:45:2","position":2,"arabic":"يَوْمَئِذٍۢ","kind":"word","gloss":"that Day","transliteration":"yawma-idhin","lemma":"يَوْمَئِذ","root":"يوم","entryId":"l-675d35e3d4bddca4"},{"key":"77:45:3","position":3,"arabic":"لِّلْمُكَذِّبِينَ","kind":"word","gloss":"to the deniers","transliteration":"lil'mukadhibīna","lemma":"مُّكَذِّبِين","root":"كذب","entryId":null},{"key":"77:45:4","position":4,"arabic":"٤٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"77:46","translation":"(O you disbelievers)! Eat and enjoy yourselves (in this worldly life) for a little while. Verily, you are the Mujrimûn (polytheists, disbelievers, sinners, criminals).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"77:46:1","position":1,"arabic":"كُلُوا۟","kind":"word","gloss":"Eat","transliteration":"kulū","lemma":"أَكَلَ","root":"اكل","entryId":"l-dd3887135f91e5c7"},{"key":"77:46:2","position":2,"arabic":"وَتَمَتَّعُوا۟","kind":"word","gloss":"and enjoy yourselves","transliteration":"watamattaʿū","lemma":"تَمَتَّعَ","root":"متع","entryId":null},{"key":"77:46:3","position":3,"arabic":"قَلِيلًا","kind":"word","gloss":"a little","transliteration":"qalīlan","lemma":"قَلِيل","root":"قلل","entryId":"l-4685af3ba2482099"},{"key":"77:46:4","position":4,"arabic":"إِنَّكُم","kind":"word","gloss":"indeed, you","transliteration":"innakum","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"77:46:5","position":5,"arabic":"مُّجْرِمُونَ","kind":"word","gloss":"(are) criminals","transliteration":"muj'rimūna","lemma":"مُجْرِم","root":"جرم","entryId":"l-20d9c5e788f748c8"},{"key":"77:46:6","position":6,"arabic":"٤٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"77:47","translation":"Woe that Day to the deniers (of the Day of Resurrection)!","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"77:47:1","position":1,"arabic":"وَيْلٌۭ","kind":"word","gloss":"Woe","transliteration":"waylun","lemma":"وَيْل","root":null,"entryId":"l-d11f2adf827dd758"},{"key":"77:47:2","position":2,"arabic":"يَوْمَئِذٍۢ","kind":"word","gloss":"that Day","transliteration":"yawma-idhin","lemma":"يَوْمَئِذ","root":"يوم","entryId":"l-675d35e3d4bddca4"},{"key":"77:47:3","position":3,"arabic":"لِّلْمُكَذِّبِينَ","kind":"word","gloss":"to the deniers","transliteration":"lil'mukadhibīna","lemma":"مُّكَذِّبِين","root":"كذب","entryId":null},{"key":"77:47:4","position":4,"arabic":"٤٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"77:48","translation":"And when it is said to them: \"Bow down yourself (in prayer)!\" They bow not down (offer not their prayers).","translationSource":"qul-301-hilali-khan","notes":[{"text":"A) Narrated Anas bin Mâlik رضي الله عنه: Allâh’s Messenger صلى الله عليه وسلم said, \"I have been ordered to fight the people till they say: Lâ ilâha illallâh (none has the right to be worshipped but Allâh). And if they say so, perform As-Salât (the prayer) like our Salât (prayers), face our Qîblah and slaughter as we slaughter, then their blood and property will be sacred to us and we will not interfere with them except legally and their reckoning will be with Allâh.\" Narrated Maimûn bin Siyâh that he asked Anas bin Mâlik, \"O Abu Hamzah! What makes the life and property of a person sacred?\" He replied, \"Whoever says, Lâ ilâha illallâh (none has the right to be worshipped but Allâh), faces our Qîblah during the Salât (prayers), perform As-Salât (the prayer) like us, and eat our slaughtered animals then he is a Muslim and has got the same rights and obligations as other Muslims have.\" (Sahih Al Bukhari, Vol.1, Hadith No.387). B) Narrated Abu Hurairah رضي الله عنه: Allâh’s Messenger صلى الله عليه وسلم said, \"If the people knew (the reward for) pronouncing the Adhân and for standing in the first row (in congregational prayers) and found no other way to get that except by drawing lots they would draw lots, and if they knew (the reward of) the Zuhr prayer (in the early moments of its stated time) they would race for it (go early) and if they knew (the reward of) ‘Ishâ and Fajr (night and morning) prayers in congregation, they would come to offer them even if they had to crawl.\" (Sahih Al-Bukhari, Vol. 1, Hadith No.589).","ref":null}],"tokens":[{"key":"77:48:1","position":1,"arabic":"وَإِذَا","kind":"word","gloss":"And when","transliteration":"wa-idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"77:48:2","position":2,"arabic":"قِيلَ","kind":"word","gloss":"it is said","transliteration":"qīla","lemma":"قَالَ","root":"قول","entryId":"l-effaf24a5c86c56f"},{"key":"77:48:3","position":3,"arabic":"لَهُمُ","kind":"word","gloss":"to them","transliteration":"lahumu","lemma":null,"root":null,"entryId":null},{"key":"77:48:4","position":4,"arabic":"ٱرْكَعُوا۟","kind":"word","gloss":"Bow","transliteration":"ir'kaʿū","lemma":"يَرْكَعُ","root":"ركع","entryId":null},{"key":"77:48:5","position":5,"arabic":"لَا","kind":"word","gloss":"not","transliteration":"lā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"77:48:6","position":6,"arabic":"يَرْكَعُونَ","kind":"word","gloss":"they bow","transliteration":"yarkaʿūna","lemma":"يَرْكَعُ","root":"ركع","entryId":null},{"key":"77:48:7","position":7,"arabic":"٤٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"77:49","translation":"Woe that Day to the deniers (of the Day of Resurrection)!","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"77:49:1","position":1,"arabic":"وَيْلٌۭ","kind":"word","gloss":"Woe","transliteration":"waylun","lemma":"وَيْل","root":null,"entryId":"l-d11f2adf827dd758"},{"key":"77:49:2","position":2,"arabic":"يَوْمَئِذٍۢ","kind":"word","gloss":"that Day","transliteration":"yawma-idhin","lemma":"يَوْمَئِذ","root":"يوم","entryId":"l-675d35e3d4bddca4"},{"key":"77:49:3","position":3,"arabic":"لِّلْمُكَذِّبِينَ","kind":"word","gloss":"to the deniers","transliteration":"lil'mukadhibīna","lemma":"مُّكَذِّبِين","root":"كذب","entryId":null},{"key":"77:49:4","position":4,"arabic":"٤٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"77:50","translation":"Then in what statement after this (the Qur’ân) will they believe?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"77:50:1","position":1,"arabic":"فَبِأَىِّ","kind":"word","gloss":"Then in what","transliteration":"fabi-ayyi","lemma":"أَىّ","root":"ايي","entryId":"l-1b17d6cf8e714c6a"},{"key":"77:50:2","position":2,"arabic":"حَدِيثٍۭ","kind":"word","gloss":"statement","transliteration":"ḥadīthin","lemma":"حَدِيث","root":"حدث","entryId":null},{"key":"77:50:3","position":3,"arabic":"بَعْدَهُۥ","kind":"word","gloss":"after it","transliteration":"baʿdahu","lemma":"بَعْد","root":"بعد","entryId":"l-8c0dc1d5dbc2a420"},{"key":"77:50:4","position":4,"arabic":"يُؤْمِنُونَ","kind":"word","gloss":"will they believe","transliteration":"yu'minūna","lemma":"ءَامَنَ","root":"امن","entryId":"l-f6ec3a6dc0f76aa6"},{"key":"77:50:5","position":5,"arabic":"٥٠","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]}]