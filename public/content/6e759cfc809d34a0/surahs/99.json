ation":"waqāla","lemma":"قَالَ","root":"قول","entryId":"l-effaf24a5c86c56f"},{"key":"99:3:2","position":2,"arabic":"ٱلْإِنسَـٰنُ","kind":"word","gloss":"man","transliteration":"l-insānu","lemma":"إِنسَٰن","root":"انس","entryId":"l-bec7f7166ce0ed1b"},{"key":"99:3:3","position":3,"arabic":"مَا","kind":"word","gloss":"What","transliteration":"mā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"99:3:4","position":4,"arabic":"لَهَا","kind":"word","gloss":"(is) with it","transliteration":"lahā","lemma":null,"root":null,"entryId":null},{"key":"99:3:5","position":5,"arabic":"٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"99:4","translation":"That Day it will declare its information (about all that happened over it of good or evil).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"99:4:1","position":1,"arabic":"يَوْمَئِذٍۢ","kind":"word","gloss":"That Day","transliteration":"yawma-idhin","lemma":"يَوْمَئِذ","root":"يوم","entryId":"l-675d35e3d4bddca4"},{"key":"99:4:2","position":2,"arabic":"تُحَدِّثُ","kind":"word","gloss":"it will report","transliteration":"tuḥaddithu","lemma":"تُحَدِّثُ","root":"حدث","entryId":null},{"key":"99:4:3","position":3,"arabic":"أَخْبَارَهَا","kind":"word","gloss":"its news","transliteration":"akhbārahā","lemma":"أَخْبَار","root":"خبر","entryId":null},{"key":"99:4:4","position":4,"arabic":"٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"99:5","translation":"Because your Lord will inspire it.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"99:5:1","position":1,"arabic":"بِأَنَّ","kind":"word","gloss":"Because","transliteration":"bi-anna","lemma":"أَنّ","root":null,"entryId":"l-9a8e074398908017"},{"key":"99:5:2","position":2,"arabic":"رَبَّكَ","kind":"word","gloss":"your Lord","transliteration":"rabbaka","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"