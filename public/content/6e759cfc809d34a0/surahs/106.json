[{"ref":"106:1","translation":"(It is a great Grace from Allâh) for the protection of the Quraish,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"106:1:1","position":1,"arabic":"لِإِيلَـٰفِ","kind":"word","gloss":"For (the) familiarity","transliteration":"liīlāfi","lemma":"إِلَٰف","root":"الف","entryId":null},{"key":"106:1:2","position":2,"arabic":"قُرَيْشٍ","kind":"word","gloss":"(of the) Quraish","transliteration":"qurayshin","lemma":"قُرَيْش","root":null,"entryId":null},{"key":"106:1:3","position":3,"arabic":"١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"106:2","translation":"(And with all those Allâh’s Grace and Protections, We cause) the (Quraish) caravans to set forth safe in winter (to the south) and in summer (to the north without any fear),","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"106:2:1","position":1,"arabic":"إِۦلَـٰفِهِمْ","kind":"word","gloss":"Their familiarity","transliteration":"īlāfihim","lemma":"إِلَٰف","root":"الف","entryId":null},{"key":"106:2:2","position":2,"arabic":"رِحْلَةَ","kind":"word","gloss":"(with the) journey","transliteration":"riḥ'lata","lemma":"رِحْلَة","root":"رحل","entryId":null},{"key":"106:2:3","position":3,"arabic":"ٱلشِّتَآءِ","kind":"word","gloss":"(of) winter","transliteration":"l-shitāi","lemma":"شِّتَآء","root":"شتو","entryId":null},{"key":"106:2:4","position":4,"arabic":"وَٱلصَّيْفِ","kind":"word","gloss":"and summer","transliteration":"wal-ṣayfi","lemma":"صَّيْف","root":"صيف","entryId":null},{"key":"106:2:5","position":5,"arabic":"٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"106:3","translation":"So let them worship (Allâh) the Lord of this House (the Ka‘bah in Makkah),","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"106:3:1","position":1,"arabic":"فَلْيَعْبُدُوا۟","kind":"word","gloss":"So let them worship","transliteration":"falyaʿbudū","lemma":"عَبَدَ","root":"عبد","entryId":"l-0907d1b241c8dd03"},{"key":"106:3:2","position":2,"arabic":"رَبَّ","kind":"word","gloss":"(the) Lord","transliteration":"rabba","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"106:3:3","position":3,"arabic":"هَـٰذَا","kind":"word","gloss":"(of) this","transliteration":"hādhā","lemma":"هَٰذَا","root":null,"entryId":"l-a874a3c6f146e6a2"},{"key":"106:3:4","position":4,"arabic":"ٱلْبَيْتِ","kind":"word","gloss":"House","transliteration":"l-bayti","lemma":"بَيْت","root":"بيت","entryId":"l-ada981cdeedf44bb"},{"key":"106:3:5","position":5,"arabic":"٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"106:4","translation":"(He) Who has fed them against hunger, and has made them safe from fear.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"106:4:1","position":1,"arabic":"ٱلَّذِىٓ","kind":"word","gloss":"The One Who","transliteration":"alladhī","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"106:4:2","position":2,"arabic":"أَطْعَمَهُم","kind":"word","gloss":"feeds them","transliteration":"aṭʿamahum","lemma":"أَطْعَمَ","root":"طعم","entryId":null},{"key":"106:4:3","position":3,"arabic":"مِّن","kind":"word","gloss":"[from]","transliteration":"min","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"106:4:4","position":4,"arabic":"جُوعٍۢ","kind":"word","gloss":"(against) hunger","transliteration":"jūʿin","lemma":"جُوع","root":"جوع","entryId":null},{"key":"106:4:5","position":5,"arabic":"وَءَامَنَهُم","kind":"word","gloss":"and gives them security","transliteration":"waāmanahum","lemma":"ءَامَنَ","root":"امن","entryId":"l-f6ec3a6dc0f76aa6"},{"key":"106:4:6","position":6,"arabic":"مِّنْ","kind":"word","gloss":"from","transliteration":"min","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"106:4:7","position":7,"arabic":"خَوْفٍۭ","kind":"word","gloss":"fear","transliteration":"khawfin","lemma":"خَوْف","root":"خوف","entryId":null},{"key":"106:4:8","position":8,"arabic":"٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]}]