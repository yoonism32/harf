[{"ref":"75:1","translation":"I swear by the Day of Resurrection.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"75:1:1","position":1,"arabic":"لَآ","kind":"word","gloss":"Nay","transliteration":"lā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"75:1:2","position":2,"arabic":"أُقْسِمُ","kind":"word","gloss":"I swear","transliteration":"uq'simu","lemma":"أَقْسَمُ","root":"قسم","entryId":null},{"key":"75:1:3","position":3,"arabic":"بِيَوْمِ","kind":"word","gloss":"by (the) Day","transliteration":"biyawmi","lemma":"يَوْم","root":"يوم","entryId":"l-bd6f5747b4dfe79c"},{"key":"75:1:4","position":4,"arabic":"ٱلْقِيَـٰمَةِ","kind":"word","gloss":"(of) the Resurrection","transliteration":"l-qiyāmati","lemma":"قِيَٰمَة","root":"قوم","entryId":"l-6ab6edcd567ccd0c"},{"key":"75:1:5","position":5,"arabic":"١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"75:2","translation":"And I swear by the self-reproaching person (a believer).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"75:2:1","position":1,"arabic":"وَلَآ","kind":"word","gloss":"And nay","transliteration":"walā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"75:2:2","position":2,"arabic":"أُقْسِمُ","kind":"word","gloss":"I swear","transliteration":"uq'simu","lemma":"أَقْسَمُ","root":"قسم","entryId":null},{"key":"75:2:3","position":3,"arabic":"بِٱلنَّفْسِ","kind":"word","gloss":"by the soul","transliteration":"bil-nafsi","lemma":"نَفْس","root":"نفس","entryId":"l-95a2521e875a8b29"},{"key":"75:2:4","position":4,"arabic":"ٱللَّوَّامَةِ","kind":"word","gloss":"self-accusing","transliteration":"l-lawāmati","lemma":"لَّوَّامَة","root":"لوم","entryId":null},{"key":"75:2:5","position":5,"arabic":"٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"75:3","translation":"Does man (a disbeliever) think that We shall not assemble his bones?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"75:3:1","position":1,"arabic":"أَيَحْسَبُ","kind":"word","gloss":"Does think","transliteration":"ayaḥsabu","lemma":"حَسِبَ","root":"حسب","entryId":"l-717e0311dc7803f9"},{"key":"75:3:2","position":2,"arabic":"ٱلْإِنسَـٰنُ","kind":"word","gloss":"[the] man","transliteration":"l-insānu","lemma":"إِنسَٰن","root":"انس","entryId":"l-bec7f7166ce0ed1b"},{"key":"75:3:3","position":3,"arabic":"أَلَّن","kind":"word","gloss":"that not","transliteration":"allan","lemma":"لَن","root":null,"entryId":"l-3db5462128ff695e"},{"key":"75:3:4","position":4,"arabic":"نَّجْمَعَ","kind":"word","gloss":"We will assemble","transliteration":"najmaʿa","lemma":"جَمَعَ","root":"جمع","entryId":null},{"key":"75:3:5","position":5,"arabic":"عِظَامَهُۥ","kind":"word","gloss":"his bones","transliteration":"ʿiẓāmahu","lemma":"عَظِيم","root":"عظم","entryId":"l-4ac2f032da29eeff"},{"key":"75:3:6","position":6,"arabic":"٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"75:4","translation":"Yes, We are Able to put together in perfect order the tips of his fingers.","translationSource":"qul-301-hilali-khan","notes":[{"text":"Each human being has his or her own special finger prints not resembling anyone else, indicating that our Lord (Allâh) is the Most Superior Creator of everything: Lâ ilâha illâ Huwa (none has the right to be worshipped but He).","ref":null}],"tokens":[{"key":"75:4:1","position":1,"arabic":"بَلَىٰ","kind":"word","gloss":"Nay","transliteration":"balā","lemma":"بَلَىٰ","root":null,"entryId":null},{"key":"75:4:2","position":2,"arabic":"قَـٰدِرِينَ","kind":"word","gloss":"(We are) Able","transliteration":"qādirīna","lemma":"قَادِر","root":"قدر","entryId":null},{"key":"75:4:3","position":3,"arabic":"عَلَىٰٓ","kind":"word","gloss":"on","transliteration":"ʿalā","lemma":"عَلَىٰ","root":null,"entryId":"l-08dd9283adb70e54"},{"key":"75:4:4","position":4,"arabic":"أَن","kind":"word","gloss":"that","transliteration":"an","lemma":"أَن","root":null,"entryId":"l-6fb897ea8dfcda9d"},{"key":"75:4:5","position":5,"arabic":"نُّسَوِّىَ","kind":"word","gloss":"We can restore","transliteration":"nusawwiya","lemma":"سَوَّىٰ","root":"سوي","entryId":null},{"key":"75:4:6","position":6,"arabic":"بَنَانَهُۥ","kind":"word","gloss":"his fingertips","transliteration":"banānahu","lemma":"بَنَان","root":"بنن","entryId":null},{"key":"75:4:7","position":7,"arabic":"٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"75:5","translation":"Nay! Man (denies Resurrection and Reckoning. So he) desires to continue committing sins.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"75:5:1","position":1,"arabic":"بَلْ","kind":"word","gloss":"Nay","transliteration":"bal","lemma":"بَل","root":null,"entryId":"l-706f9c6eca0445cc"},{"key":"75:5:2","position":2,"arabic":"يُرِيدُ","kind":"word","gloss":"Desires","transliteration":"yurīdu","lemma":"أَرَادَ","root":"رود","entryId":"l-1eaa86c69a1267cc"},{"key":"75:5:3","position":3,"arabic":"ٱلْإِنسَـٰنُ","kind":"word","gloss":"[the] man","transliteration":"l-insānu","lemma":"إِنسَٰن","root":"انس","entryId":"l-bec7f7166ce0ed1b"},{"key":"75:5:4","position":4,"arabic":"لِيَفْجُرَ","kind":"word","gloss":"to give (the) lie","transliteration":"liyafjura","lemma":"يَفْجُرَ","root":"فجر","entryId":null},{"key":"75:5:5","position":5,"arabic":"أَمَامَهُۥ","kind":"word","gloss":"(to) what is before him","transliteration":"amāmahu","lemma":"أَمَام","root":"امم","entryId":null},{"key":"75:5:6","position":6,"arabic":"٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"75:6","translation":"He asks: \"When will be this Day of Resurrection?\"","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"75:6:1","position":1,"arabic":"يَسْـَٔلُ","kind":"word","gloss":"He asks","transliteration":"yasalu","lemma":"سَأَلَ","root":"سال","entryId":"l-ad7819fc39b763e0"},{"key":"75:6:2","position":2,"arabic":"أَيَّانَ","kind":"word","gloss":"When","transliteration":"ayyāna","lemma":"أَيَّان","root":null,"entryId":null},{"key":"75:6:3","position":3,"arabic":"يَوْمُ","kind":"word","gloss":"(is the) Day","transliteration":"yawmu","lemma":"يَوْم","root":"يوم","entryId":"l-bd6f5747b4dfe79c"},{"key":"75:6:4","position":4,"arabic":"ٱلْقِيَـٰمَةِ","kind":"word","gloss":"(of) the Resurrection","transliteration":"l-qiyāmati","lemma":"قِيَٰمَة","root":"قوم","entryId":"l-6ab6edcd567ccd0c"},{"key":"75:6:5","position":5,"arabic":"٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"75:7","translation":"So, when the sight shall be dazed.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"75:7:1","position":1,"arabic":"فَإِذَا","kind":"word","gloss":"So when","transliteration":"fa-idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"75:7:2","position":2,"arabic":"بَرِقَ","kind":"word","gloss":"is dazzled","transliteration":"bariqa","lemma":"بَرِقَ","root":"برق","entryId":null},{"key":"75:7:3","position":3,"arabic":"ٱلْبَصَرُ","kind":"word","gloss":"the vision","transliteration":"l-baṣaru","lemma":"بَصَر","root":"بصر","entryId":"l-45b52e84d9397d19"},{"key":"75:7:4","position":4,"arabic":"٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"75:8","translation":"And the moon will be eclipsed.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"75:8:1","position":1,"arabic":"وَخَسَفَ","kind":"word","gloss":"And becomes dark","transliteration":"wakhasafa","lemma":"خَسَفَ","root":"خسف","entryId":null},{"key":"75:8:2","position":2,"arabic":"ٱلْقَمَرُ","kind":"word","gloss":"the moon","transliteration":"l-qamaru","lemma":"قَمَر","root":"قمر","entryId":null},{"key":"75:8:3","position":3,"arabic":"٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"75:9","translation":"And the sun and moon will be joined together (by going one into the other or folded up or deprived of their light).","translationSource":"qul-301-hilali-khan","notes":[{"text":"Narrated Abu Hurairah رضي الله عنه : The Prophet صلى الله عليه وسلم said, \"The sun and the moon will be folded up (or joined together or deprived of their lights) on the Day of Resurrection.\" (See the Qur’ân 75:9) (Sahih Al-Bukhari, Vol.4, Hadith No.422).","ref":null}],"tokens":[{"key":"75:9:1","position":1,"arabic":"وَجُمِعَ","kind":"word","gloss":"And are joined","transliteration":"wajumiʿa","lemma":"جَمَعَ","root":"جمع","entryId":null},{"key":"75:9:2","position":2,"arabic":"ٱلشَّمْسُ","kind":"word","gloss":"the sun","transliteration":"l-shamsu","lemma":"شَمْس","root":"شمس","entryId":null},{"key":"75:9:3","position":3,"arabic":"وَٱلْقَمَرُ","kind":"word","gloss":"and the moon","transliteration":"wal-qamaru","lemma":"قَمَر","root":"قمر","entryId":null},{"key":"75:9:4","position":4,"arabic":"٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"75:10","translation":"On that Day man will say: \"Where (is the refuge) to flee?\"","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"75:10:1","position":1,"arabic":"يَقُولُ","kind":"word","gloss":"Will say","transliteration":"yaqūlu","lemma":"قَالَ","root":"قول","entryId":"l-effaf24a5c86c56f"},{"key":"75:10:2","position":2,"arabic":"ٱلْإِنسَـٰنُ","kind":"word","gloss":"[the] man","transliteration":"l-insānu","lemma":"إِنسَٰن","root":"انس","entryId":"l-bec7f7166ce0ed1b"},{"key":"75:10:3","position":3,"arabic":"يَوْمَئِذٍ","kind":"word","gloss":"that Day","transliteration":"yawma-idhin","lemma":"يَوْمَئِذ","root":"يوم","entryId":"l-675d35e3d4bddca4"},{"key":"75:10:4","position":4,"arabic":"أَيْنَ","kind":"word","gloss":"Where","transliteration":"ayna","lemma":"أَيْن","root":null,"entryId":null},{"key":"75:10:5","position":5,"arabic":"ٱلْمَفَرُّ","kind":"word","gloss":"(is) the escape","transliteration":"l-mafaru","lemma":"مَفَرّ","root":"فرر","entryId":null},{"key":"75:10:6","position":6,"arabic":"١٠","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"75:11","translation":"No! There is no refuge!","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"75:11:1","position":1,"arabic":"كَلَّا","kind":"word","gloss":"By no means","transliteration":"kallā","lemma":"كَلَّا","root":null,"entryId":null},{"key":"75:11:2","position":2,"arabic":"لَا","kind":"word","gloss":"(There is) no","transliteration":"lā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"75:11:3","position":3,"arabic":"وَزَرَ","kind":"word","gloss":"refuge","transliteration":"wazara","lemma":"وَزَر","root":"وزر","entryId":null},{"key":"75:11:4","position":4,"arabic":"١١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"75:12","translation":"Unto your Lord (Alone) will be the place of rest that Day.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"75:12:1","position":1,"arabic":"إِلَىٰ","kind":"word","gloss":"To","transliteration":"ilā","lemma":"إِلَىٰ","root":null,"entryId":"l-53539d2c3606b99e"},{"key":"75:12:2","position":2,"arabic":"رَبِّكَ","kind":"word","gloss":"your Lord","transliteration":"rabbika","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"75:12:3","position":3,"arabic":"يَوْمَئِذٍ","kind":"word","gloss":"that Day","transliteration":"yawma-idhin","lemma":"يَوْمَئِذ","root":"يوم","entryId":"l-675d35e3d4bddca4"},{"key":"75:12:4","position":4,"arabic":"ٱلْمُسْتَقَرُّ","kind":"word","gloss":"(is) the place of rest","transliteration":"l-mus'taqaru","lemma":"مُسْتَقَرّ","root":"قرر","entryId":null},{"key":"75:12:5","position":5,"arabic":"١٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"75:13","translation":"On that Day man will be informed of what he sent forward (of his evil good deeds), and what he left behind (of his good or evil traditions).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"75:13:1","position":1,"arabic":"يُنَبَّؤُا۟","kind":"word","gloss":"Will be informed","transliteration":"yunabba-u","lemma":"نَبَّأَ","root":"نبا","entryId":"l-86876698c3450922"},{"key":"75:13:2","position":2,"arabic":"ٱلْإِنسَـٰنُ","kind":"word","gloss":"[the] man","transliteration":"l-insānu","lemma":"إِنسَٰن","root":"انس","entryId":"l-bec7f7166ce0ed1b"},{"key":"75:13:3","position":3,"arabic":"يَوْمَئِذٍۭ","kind":"word","gloss":"that Day","transliteration":"yawma-idhin","lemma":"يَوْمَئِذ","root":"يوم","entryId":"l-675d35e3d4bddca4"},{"key":"75:13:4","position":4,"arabic":"بِمَا","kind":"word","gloss":"of what","transliteration":"bimā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"75:13:5","position":5,"arabic":"قَدَّمَ","kind":"word","gloss":"he sent forth","transliteration":"qaddama","lemma":"قَدَّمَ","root":"قدم","entryId":null},{"key":"75:13:6","position":6,"arabic":"وَأَخَّرَ","kind":"word","gloss":"and kept back","transliteration":"wa-akhara","lemma":"أَخَّرَ","root":"اخر","entryId":null},{"key":"75:13:7","position":7,"arabic":"١٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"75:14","translation":"Nay! Man will be a witness against himself [as his body parts (skin, hands, legs, etc.) will speak about his deeds],","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"75:14:1","position":1,"arabic":"بَلِ","kind":"word","gloss":"Nay","transliteration":"bali","lemma":"بَل","root":null,"entryId":"l-706f9c6eca0445cc"},{"key":"75:14:2","position":2,"arabic":"ٱلْإِنسَـٰنُ","kind":"word","gloss":"[The] man","transliteration":"l-insānu","lemma":"إِنسَٰن","root":"انس","entryId":"l-bec7f7166ce0ed1b"},{"key":"75:14:3","position":3,"arabic":"عَلَىٰ","kind":"word","gloss":"against","transliteration":"ʿalā","lemma":"عَلَىٰ","root":null,"entryId":"l-08dd9283adb70e54"},{"key":"75:14:4","position":4,"arabic":"نَفْسِهِۦ","kind":"word","gloss":"himself","transliteration":"nafsihi","lemma":"نَفْس","root":"نفس","entryId":"l-95a2521e875a8b29"},{"key":"75:14:5","position":5,"arabic":"بَصِيرَةٌۭ","kind":"word","gloss":"(will be) a witness","transliteration":"baṣīratun","lemma":"بَصِيرَة","root":"بصر","entryId":null},{"key":"75:14:6","position":6,"arabic":"١٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"75:15","translation":"Though he may put forth his excuses (to cover his evil deeds).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"75:15:1","position":1,"arabic":"وَلَوْ","kind":"word","gloss":"Even if","transliteration":"walaw","lemma":"لَو","root":null,"entryId":"l-9e02d9e1c2596c32"},{"key":"75:15:2","position":2,"arabic":"أَلْقَىٰ","kind":"word","gloss":"he presents","transliteration":"alqā","lemma":"أَلْقَىٰٓ","root":"لقي","entryId":"l-09920b7d63c6ad5f"},{"key":"75:15:3","position":3,"arabic":"مَعَاذِيرَهُۥ","kind":"word","gloss":"his excuses","transliteration":"maʿādhīrahu","lemma":"مَعَاذِير","root":"عذر","entryId":null},{"key":"75:15:4","position":4,"arabic":"١٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"75:16","translation":"Move not your tongue concerning (the Qur’ân, O Muhammad صلى الله عليه وسلم) to make haste therewith.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"75:16:1","position":1,"arabic":"لَا","kind":"word","gloss":"Not","transliteration":"lā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"75:16:2","position":2,"arabic":"تُحَرِّكْ","kind":"word","gloss":"move","transliteration":"tuḥarrik","lemma":"تُحَرِّكْ","root":"حرك","entryId":null},{"key":"75:16:3","position":3,"arabic":"بِهِ