han","notes":[],"tokens":[{"key":"75:20:1","position":1,"arabic":"كَلَّا","kind":"word","gloss":"No","transliteration":"kallā","lemma":"كَلَّا","root":null,"entryId":null},{"key":"75:20:2","position":2,"arabic":"بَلْ","kind":"word","gloss":"But","transliteration":"bal","lemma":"بَل","root":null,"entryId":"l-706f9c6eca0445cc"},{"key":"75:20:3","position":3,"arabic":"تُحِبُّونَ","kind":"word","gloss":"you love","transliteration":"tuḥibbūna","lemma":"أَحْبَبْ","root":"حبب","entryId":"l-43478ad8b9caa513"},{"key":"75:20:4","position":4,"arabic":"ٱلْعَاجِلَةَ","kind":"word","gloss":"the immediate","transliteration":"l-ʿājilata","lemma":"عَاجِلَةٌ","root":"عجل","entryId":null},{"key":"75:20:5","position":5,"arabic":"٢٠","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"75:21","translation":"And neglect the Hereafter.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"75:21:1","position":1,"arabic":"وَتَذَرُونَ","kind":"word","gloss":"And leave","transliteration":"watadharūna","lemma":"يَذَرَ","root":"وذر","entryId":"l-ec5f0f88a3e0b836"},{"key":"75:21:2","position":2,"arabic":"ٱلْـَٔاخِرَةَ","kind":"word","gloss":"the Hereafter","transliteration":"l-ākhirata","lemma":"آخِر","root":"اخر","entryId":"l-24868f08d279a095"},{"key":"75:21:3","position":3,"arabic":"٢١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"75:22","translation":"Some faces that Day shall be Nâdirah (shining and radiant).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"75:22:1","position":1,"arabic":"وُجُوهٌۭ","kind":"word","gloss":"Faces","transliteration":"wujūhun","lemma":"وَجْه","root":"وجه","entryId":"l-a02f5e824d673730"},{"key":"75:22:2","position":2,"arabic":"يَوْمَئِذٍۢ","kind":"word","gloss":"that Day","transliteration":"yawma-idhin","lemma":"يَوْمَئِذ","root":"يوم","entryId":"l-675d35e3d4bddca4"},{"key":"75:22:3","position":3,"arabic":"نَّاضِرَةٌ","kind":"word","gloss":"(will be) radiant","transliteration":"nāḍiratun","lemma":"نَّاضِرَة","root":"نضر","entryId":null},{"key":"75:22:4","position":4,"arabic":"٢٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"75:23","translation":"Looking at their Lord (Allâh).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"75:23:1","position":1,"arabic":"إِلَىٰ","kind":"word","gloss":"Towards","transliteration":"ilā","lemma":"إِلَىٰ","root":null,"entryId":"l-53539d2c3606b99e"},{"key":"75:23:2","position":2,"arabic":"رَبِّهَا","kind":"word","gloss":"their Lord","transliteration":"rabbihā","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"75:23:3","position":3,"arabic":"نَاظِرَةٌۭ","kind":"word","gloss":"looking","transliteration":"nāẓiratun","lemma":"نَاظِرَة","root":"نظر","entryId":null},{"key":"75:23:4","position":4,"arabic":"٢٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"75:24","translation":"And some faces, that Day, will be Bâsirah (dark, gloomy, frowning, and sad),","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"75:24:1","position":1,"arabic":"وَوُجُوهٌۭ","kind":"word","gloss":"And faces","transliteration":"wawujūhun","lemma":"وَجْه","root":"وجه","entryId":"l-a02f5e824d673730"},{"key":"75:24:2","position":2,"arabic":"يَوْمَئِذٍۭ","kind":"word","gloss":"that Day","transliteration":"yawma-idhin","lemma":"يَوْمَئِذ","root":"يوم","entryId":"l-675d35e3d4bddca4"},{"key":"75:24:3","position":3,"arabic":"بَاسِرَةٌۭ","kind":"word","gloss":"(will be) distorted","transliteration":"bāsiratun","lemma":"بَاسِرَة","root":"بسر","entryId":null},{"key":"75:24:4","position":4,"arabic":"٢٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"75:25","translation":"Thinking that some calamity is about to fall on them.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"75:25:1","position":1,"arabic":"تَظُنُّ","kind":"word","gloss":"Thinking","transliteration":"taẓunnu","lemma":"ظَنَّ","root":"ظنن","entryId":"l-34fadff01946a633"},{"key":"75:25:2","position":2,"arabic":"أَن","kind":"word","gloss":"that","transliteration":"an","lemma":"أَن","root":null,"entryId":"l-6fb897ea8dfcda9d"},{"key":"75:25:3","position":3,"arabic":"يُفْعَلَ","kind":"word","gloss":"will be done","transliteration":"yuf'ʿala","lemma":"فَعَلَ","root":"فعل","entryId":"l-b0a120934c602e5e"},{"key":"75:25:4","position":4,"arabic":"بِهَا","kind":"word","gloss":"to them","transliteration":"bihā","lemma":null,"root":null,"entryId":null},{"key":"75:25:5","position":5,"arabic":"فَاقِرَةٌۭ","kind":"word","gloss":"backbreaking","transliteration":"fāqiratun","lemma":"فَاقِرَة","root":"فقر","entryId":null},{"key":"75:25:6","position":6,"arabic":"٢٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"75:26","translation":"Nay, when (the soul) reaches to the collar bone (i.e. up to the throat in its exit),","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"75:26:1","position":1,"arabic":"كَلَّآ","kind":"word","gloss":"No","transliteration":"kallā","lemma":"كَلَّا","root":null,"entryId":null},{"key":"75:26:2","position":2,"arabic":"إِذَا","kind":"word","gloss":"When","transliteration":"idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"75:26:3","position":3,"arabic":"بَلَغَتِ","kind":"word","gloss":"it reaches","transliteration":"balaghati","lemma":"بَلَغَ","root":"بلغ","entryId":"l-105ab553299c1132"},{"key":"75:26:4","position":4,"arabic":"ٱلتَّرَاقِىَ","kind":"word","gloss":"the collar bones","transliteration":"l-tarāqiya","lemma":"تَّرَاقِى","root":"ترق","entryId":null},{"key":"75:26:5","position":5,"arabic":"٢٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"75:27","translation":"And it will be said: \"Who can cure him (and save him from death)?\"","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"75:27:1","position":1,"arabic":"وَقِيلَ","kind":"word","gloss":"And it is said","transliteration":"waqīla","lemma":"قَالَ","root":"قول","entryId":"l-effaf24a5c86c56f"},{"key":"75:27:2","position":2,"arabic":"مَنْ ۜ","kind":"word","gloss":"Who","transliteration":"man","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"75:27:3","position":3,"arabic":"رَاقٍۢ","kind":"word","gloss":"(will) cure","transliteration":"rāqin","lemma":"رَاق","root":"رقي","entryId":null},{"key":"75:27:4","position":4,"arabic":"٢٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"75:28","translation":"And he (the dying person) will conclude that it was (the time) of parting (death);","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"75:28:1","position":1,"arabic":"وَظَنَّ","kind":"word","gloss":"And he is certain","transliteration":"waẓanna","lemma":"ظَنَّ","root":"ظنن","entryId":"l-34fadff01946a633"},{"key":"75:28:2","position":2,"arabic":"أَنَّهُ","kind":"word","gloss":"that it","transliteration":"annahu","lemma":"أَنّ","root":null,"entryId":"l-9a8e074398908017"},{"key":"75:28:3","position":3,"arabic":"ٱلْفِرَاقُ","kind":"word","gloss":"(is) the parting","transliteration":"l-firāqu","lemma":"فِرَاق","root":"فرق","entryId":null},{"key":"75:28:4","position":4,"arabic":"٢٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"75:29","translation":"And one leg will be joined with another leg (shrouded).","translationSource":"qul-301-hilali-khan","notes":[{"text":"Or it may mean: hardship and distress will be joined with another hardship and distress (i.e. distress of death, and of the thought as to what is going to happen to him in the Hereafter). (Tafsîr At-Tabarî ).","ref":null}],"tokens":[{"key":"75:29:1","position":1,"arabic":"وَٱلْتَفَّتِ","kind":"word","gloss":"And is wound","transliteration":"wal-tafati","lemma":"الْتَفَّتِ","root":"لفف","entryId":null},{"key":"75:29:2","position":2,"arabic":"ٱلسَّاقُ","kind":"word","gloss":"the leg","transliteration":"l-sāqu","lemma":"سَاق","root":"سوق","entryId":null},{"key":"75:29:3","position":3,"arabic":"بِٱلسَّاقِ","kind":"word","gloss":"about the leg","transliteration":"bil-sāqi","lemma":"سَاق","root":"سوق","entryId":null},{"key":"75:29:4","position":4,"arabic":"٢٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"75:30","translation":"The drive will be, on that Day, to your Lord (Allâh)!","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"75:30:1","position":1,"arabic":"إِلَىٰ","kind":"word","gloss":"To","transliteration":"ilā","lemma":"إِلَىٰ","root":null,"entryId":"l-53539d2c3606b99e"},{"key":"75:30:2","position":2,"arabic":"رَبِّكَ","kind":"word","gloss":"your Lord","transliteration":"rabbika","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"75:30:3","position":3,"arabic":"يَوْمَئِذٍ","kind":"word","gloss":"that Day","transliteration":"yawma-idhin","lemma":"يَوْمَئِذ","root":"يوم","entryId":"l-675d35e3d4bddca4"},{"key":"75:30:4","position":4,"arabic":"ٱلْمَسَاقُ","kind":"word","gloss":"(will be) the driving","transliteration":"l-masāqu","lemma":"مَسَاق","root":"سوق","entryId":null},{"key":"75:30:5","position":5,"arabic":"٣٠","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"75:31","translation":"So he (the disbeliever) neither believed (in this Qur’ân and in the Message of Muhammad صلى الله عليه وسلم) nor prayed!","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"75:31:1","position":1,"arabic":"فَلَا","kind":"word","gloss":"And not","transliteration":"falā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"75:31:2","position":2,"arabic":"صَدَّقَ","kind":"word","gloss":"he accepted (the) truth","transliteration":"ṣaddaqa","lemma":"صَدَّقَ","root":"صدق","entryId":null},{"key":"75:31:3","position":3,"arabic":"وَلَا","kind":"word","gloss":"and not","transliteration":"walā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"75:31:4","position":4,"arabic":"صَلَّىٰ","kind":"word","gloss":"he prayed","transliteration":"ṣallā","lemma":"صَلَّىٰ","root":"صلو","entryId":null},{"key":"75:31:5","position":5,"arabic":"٣١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"75:32","translation":"But on the contrary, he belied (this Qur’ân and the Message of Muhammad صلى الله عليه وسلم) and turned away!","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"75:32:1","position":1,"arabic":"وَلَـٰكِن","kind":"word","gloss":"But","transliteration":"walākin","lemma":"لَٰكِن","root":null,"entryId":"l-7b6f1068619bff35"},{"key":"75:32:2","position":2,"arabic":"كَذَّبَ","kind":"word","gloss":"he denied","transliteration":"kadhaba","lemma":"كَذَّبَ","root":"كذب","entryId":"l-db86b0654d661fb2"},{"key":"75:32:3","position":3,"arabic":"وَتَوَلَّىٰ","kind":"word","gloss":"and turned away","transliteration":"watawallā","lemma":"تَوَلَّىٰ","root":"ولي","entryId":"l-f32564c74acc4226"},{"key":"75:32:4","position":4,"arabic":"٣٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"75:33","translation":"Then he walked in conceit (full pride) to his family admiring himself!","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"75:33:1","position":1,"arabic":"ثُمَّ","kind":"word","gloss":"Then","transliteration":"thumma","lemma":"ثُمّ","root":null,"entryId":"l-75b66396af12da75"},{"key":"75:33:2","position":2,"arabic":"ذَهَبَ","kind":"word","gloss":"he went","transliteration":"dhahaba","lemma":"ذَهَبَ","root":"ذهب","entryId":null},{"key":"75:33:3","position":3,"arabic":"إِلَىٰٓ","kind":"word","gloss":"to","transliteratio