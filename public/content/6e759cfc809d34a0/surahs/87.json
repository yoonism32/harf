[{"ref":"87:1","translation":"Glorify the Name of your Lord, the Most High,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"87:1:1","position":1,"arabic":"سَبِّحِ","kind":"word","gloss":"Glorify","transliteration":"sabbiḥi","lemma":"سَبَّحَ","root":"سبح","entryId":"l-2e7f33ad65358df7"},{"key":"87:1:2","position":2,"arabic":"ٱسْمَ","kind":"word","gloss":"(the) name","transliteration":"is'ma","lemma":"اسْم","root":"سمو","entryId":"l-5f4457e006a745d9"},{"key":"87:1:3","position":3,"arabic":"رَبِّكَ","kind":"word","gloss":"(of) your Lord","transliteration":"rabbika","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"87:1:4","position":4,"arabic":"ٱلْأَعْلَى","kind":"word","gloss":"the Most High","transliteration":"l-aʿlā","lemma":"أَعْلَىٰ","root":"علو","entryId":null},{"key":"87:1:5","position":5,"arabic":"١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"87:2","translation":"Who has created (everything), and then proportioned it.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"87:2:1","position":1,"arabic":"ٱلَّذِى","kind":"word","gloss":"The One Who","transliteration":"alladhī","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"87:2:2","position":2,"arabic":"خَلَقَ","kind":"word","gloss":"created","transliteration":"khalaqa","lemma":"خَلَقَ","root":"خلق","entryId":"l-9e7414ba00a88ddc"},{"key":"87:2:3","position":3,"arabic":"فَسَوَّىٰ","kind":"word","gloss":"then proportioned","transliteration":"fasawwā","lemma":"سَوَّىٰ","root":"سوي","entryId":null},{"key":"87:2:4","position":4,"arabic":"٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"87:3","translation":"And Who has measured (preordainments for everything even to be blessed or wretched); and then guided (i.e. showed mankind the right as well as the wrong paths, and guided the animals to pasture).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"87:3:1","position":1,"arabic":"وَٱلَّذِى","kind":"word","gloss":"And the One Who","transliteration":"wa-alladhī","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"87:3:2","position":2,"arabic":"قَدَّرَ","kind":"word","gloss":"measured","transliteration":"qaddara","lemma":"قَدَّرَ","root":"قدر","entryId":null},{"key":"87:3:3","position":3,"arabic":"فَهَدَىٰ","kind":"word","gloss":"then guided","transliteration":"fahadā","lemma":"هَدَى","root":"هدي","entryId":"l-e0ac61a274311deb"},{"key":"87:3:4","position":4,"arabic":"٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"87:4","translation":"And Who brings out the pasturage,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"87:4:1","position":1,"arabic":"وَٱلَّذِىٓ","kind":"word","gloss":"And the One Who","transliteration":"wa-alladhī","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"87:4:2","position":2,"arabic":"أَخْرَجَ","kind":"word","gloss":"brings forth","transliteration":"akhraja","lemma":"أَخْرَجَ","root":"خرج","entryId":"l-a25810044f12cf39"},{"key":"87:4:3","position":3,"arabic":"ٱلْمَرْعَىٰ","kind":"word","gloss":"the pasture","transliteration":"l-marʿā","lemma":"مَرْعَىٰ","root":"رعي","entryId":null},{"key":"87:4:4","position":4,"arabic":"٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"87:5","translation":"And then makes it dark stubble.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"87:5:1","position":1,"arabic":"فَجَعَلَهُۥ","kind":"word","gloss":"And then makes it","transliteration":"fajaʿalahu","lemma":"جَعَلَ","root":"جعل","entryId":"l-784f751d925aef34"},{"key":"87:5:2","position":2,"arabic":"غُثَآءً","kind":"word","gloss":"stubble","transliteration":"ghuthāan","lemma":"غُثَآء","root":"غثو","entryId":null},{"key":"87:5:3","position":3,"arabic":"أَحْوَىٰ","kind":"word","gloss":"dark","transliteration":"aḥwā","lemma":"أَحْوَىٰ","root":"حوي","entryId":null},{"key":"87:5:4","position":4,"arabic":"٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"87:6","translation":"We shall make you to recite (the Qur’ân), so you (O Muhammad صلى الله عليه وسلم) shall not forget (it),","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"87:6:1","position":1,"arabic":"سَنُقْرِئُكَ","kind":"word","gloss":"We will make you recite","transliteration":"sanuq'ri-uka","lemma":"نُقْرِئُ","root":"قرا","entryId":null},{"key":"87:6:2","position":2,"arabic":"فَلَا","kind":"word","gloss":"so not","transliteration":"falā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"87:6:3","position":3,"arabic":"تَنسَىٰٓ","kind":"word","gloss":"you will forget","transliteration":"tansā","lemma":"نَسِىَ","root":"نسي","entryId":null},{"key":"87:6:4","position":4,"arabic":"٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"87:7","translation":"Except what Allâh may will. He knows what is apparent and what is hidden.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"87:7:1","position":1,"arabic":"إِلَّا","kind":"word","gloss":"Except","transliteration":"illā","lemma":"إِلَّا","root":null,"entryId":"l-250ca4d5b58814dd"},{"key":"87:7:2","position":2,"arabic":"مَا","kind":"word","gloss":"what","transliteration":"mā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"87:7:3","position":3,"arabic":"شَآءَ","kind":"word","gloss":"wills","transliteration":"shāa","lemma":"شَآءَ","root":"شيا","entryId":"l-e6061b9230d95354"},{"key":"87:7:4","position":4,"arabic":"ٱللَّهُ ۚ","kind":"word","gloss":"Allah","transliteration":"l-lahu","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"87:7:5","position":5,"arabic":"إِنَّهُۥ","kind":"word","gloss":"Indeed, He","transliteration":"innahu","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"87:7:6","position":6,"arabic":"يَعْلَمُ","kind":"word","gloss":"knows","transliteration":"yaʿlamu","lemma":"عَلِمَ","root":"علم","entryId":"l-6de9979b254804ea"},{"key":"87:7:7","position":7,"arabic":"ٱلْجَهْرَ","kind":"word","gloss":"the manifest","transliteration":"l-jahra","lemma":"جَهْر","root":"جهر","entryId":null},{"key":"87:7:8","position":8,"arabic":"وَمَا","kind":"word","gloss":"and what","transliteration":"wamā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"87:7:9","position":9,"arabic":"يَخْفَىٰ","kind":"word","gloss":"is hidden","transliteration":"yakhfā","lemma":"يَخْفَىٰ","root":"خفي","entryId":null},{"key":"87:7:10","position":10,"arabic":"٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"87:8","translation":"And We shall make easy for you (O Muhammad صلى الله عليه وسلم) the easy way (i.e. the doing of righteous deeds).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"87:8:1","position":1,"arabic":"وَنُيَسِّرُكَ","kind":"word","gloss":"And We will ease you","transliteration":"wanuyassiruka","lemma":"يَسَّرَ","root":"يسر","entryId":null},{"key":"87:8:2","position":2,"arabic":"لِلْيُسْرَىٰ","kind":"word","gloss":"to the ease","transliteration":"lil'yus'rā","lemma":"يُسْرَىٰ","root":"يسر","entryId":null},{"key":"87:8:3","position":3,"arabic":"٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"87:9","translation":"Therefore remind (men) in case the reminder profits (them).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"87:9:1","position":1,"arabic":"فَذَكِّرْ","kind":"word","gloss":"So remind","transliteration":"fadhakkir","lemma":"ذُكِّرَ","root":"ذكر","entryId":null},{"key":"87:9:2","position":2,"arabic":"إِن","kind":"word","gloss":"if","transliteration":"in","lemma":"إِن","root":null,"entryId":"l-de626c6526849733"},{"key":"87:9:3","position":3,"arabic":"نَّفَعَتِ","kind":"word","gloss":"benefits","transliteration":"nafaʿati","lemma":"نَفَعَ","root":"نفع","entryId":null},{"key":"87:9:4","position":4,"arabic":"ٱلذِّكْرَىٰ","kind":"word","gloss":"the reminder","transliteration":"l-dhik'rā","lemma":"ذِكْرَىٰ","root":"ذكر","entryId":null},{"key":"87:9:5","position":5,"arabic":"٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"87:10","translation":"The reminder will be received by him who fears (Allâh),","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"87:10:1","position":1,"arabic":"سَيَذَّكَّرُ","kind":"word","gloss":"He will pay heed","transliteration":"sayadhakkaru","lemma":"تَذَكَّرَ","root":"ذكر","entryId":"l-9bc7d78e536db086"},{"key":"87:10:2","position":2,"arabic":"مَن","kind":"word","gloss":"(one) who","transliteration":"man","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"87:10:3","position":3,"arabic":"يَخْشَىٰ","kind":"word","gloss":"fears (Allah)","transliteration":"yakhshā","lemma":"خَشِىَ","root":"خشي","entryId":null},{"key":"87:10:4","position":4,"arabic":"١٠","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"87:11","translation":"But it will be avoided by the wretched,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"87:11:1","position":1,"arabic":"وَيَتَجَنَّبُهَا","kind":"word","gloss":"And will avoid it","transliteration":"wayatajannabuhā","lemma":"يَتَجَنَّبُ","root":"جنب","entryId":null},{"key":"87:11:2","position":2,"arabic":"ٱلْأَشْقَى","kind":"word","gloss":"the wretched one","transliteration":"l-ashqā","lemma":"أَشْقَى","root":"شقو","entryId":null},{"key":"87:11:3","position":3,"arabic":"١١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"87:12","translation":"Who will enter the great Fire (and will be made to taste its burning).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"87:12:1","position":1,"arabic":"ٱلَّذِى","kind":"word","gloss":"The one who","transliteration":"alladhī","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"87:12:2","position":2,"arabic":"يَصْلَى","kind":"word","gloss":"will burn","transliteration":"yaṣlā","lemma":"يَصْلَى","root":"صلي","entryId":null},{"key":"87:12:3","position":3,"arabic":"ٱلنَّارَ","kind":"word","gloss":"(in) the Fire","transliteration":"l-nāra","lemma":"نَار","root":"نور","entryId":"l-1f4c1e0172701e6e"},{"key":"87:12:4","position":4,"arabic":"ٱلْكُبْرَىٰ","kind":"word","gloss":"[the] great","transliteration":"l-kub'rā","lemma":"كُبْرَىٰ","root":"كبر","entryId":null},{"key":"87:12:5","position":5,"arabic":"١٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"87:13","translation":"There he will neither die (to be in rest) nor live (a good living).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"87:13:1","position":1,"arabic":"ثُمَّ","kind":"word","gloss":"Then","transliteration":"thumma","lemma":"ثُمّ","root":null,"entryId":"l-75b66396af12da75"},{"key":"87:13:2","position":2,"arabic":"لَا","kind":"word","gloss":"not","transliteration":"lā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"87:13:3","position":3,"arabic":"يَمُوتُ","kind":"word","gloss":"he will die","transliteration":"yamūtu","lemma":"مَّاتَ","root":"موت","entryId":"l-c476fd255a0b9db6"},{"key":"87:13:4","position":4,"arabic":"فِيهَا","kind":"word","gloss":"therein","transliteration":"fīhā","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"87:13:5","position":5,"arabic":"وَلَا","kind":"word","gloss":"and not","transliteration":"walā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"87:13:6","position":6,"arabic":"يَحْيَىٰ","kind":"word","gloss":"will live","transliteration":"yaḥyā","lemma":"حَىَّ","root":"حيي","entryId":null},{"key":"87:13:7","position":7,"arabic":"١٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"87:14","translation":"Indeed whosoever purifies himself (by avoiding polytheism and accepting Islâmic Monotheism) shall achieve success,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"87:14:1","position":1,"arabic":"قَدْ","kind":"word","gloss":"Certainly","transliteration":"qad","lemma":"قَد","root":null,"entryId":"l-11a59b67e56e7412"},{"key":"87:14:2","position":2,"arabic":"أَفْلَحَ","kind":"word","gloss":"has succeeded","transliteration":"aflaḥa","lemma":"أَفْلَحَ","root":"فلح","entryId":null},{"key":"87:14:3","position":3,"arabic":"مَن","kind":"word","gloss":"(one) who","transliteration":"man","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"87:14:4","position":4,"arabic":"تَزَكَّىٰ","kind":"word","gloss":"purifies (himself)","transliteration":"tazakkā","lemma":"تَزَكَّىٰ","root":"زكو","entryId":null},{"key":"87:14:5","position":5,"arabic":"١٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"87:15","translation":"And remembers (glorifies) the Name of his Lord (worships none but Allâh), and prays (five compulsory prayers and Nawâfil - additional prayers).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"87:15:1","position":1,"arabic":"وَذَكَرَ","kind":"word","gloss":"And remembers","transliteration":"wadhakara","lemma":"ذَكَرَ","root":"ذكر","entryId":"l-53d8783c59294aca"},{"key":"87:15:2","position":2,"arabic":"ٱسْمَ","kind":"word","gloss":"(the) name","transliteration":"is'ma","lemma":"اسْم","root":"سمو","entryId":"l-5f4457e006a745d9"},{"key":"87:15:3","position":3,"arabic":"رَبِّهِۦ","kind":"word","gloss":"(of) his Lord","transliteration":"rabbihi","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"87:15:4","position":4,"arabic":"فَصَلَّىٰ","kind":"word","gloss":"and prays","transliteration":"faṣallā","lemma":"صَلَّىٰ","root":"صلو","entryId":null},{"key":"87:15:5","position":5,"arabic":"١٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"87:16","translation":"Nay, you prefer the life of this world,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"87:16:1","position":1,"arabic":"بَلْ","kind":"word","gloss":"Nay","transliteration":"bal","lemma":"بَل","root":null,"entryId":"l-706f9c6eca0445cc"},{"key":"87:16:2","position":2,"arabic":"تُؤْثِرُونَ","kind":"word","gloss":"You prefer","transliteration":"tu'thirūna","lemma":"آثَرَ","root":"اثر","entryId":null},{"key":"87:16:3","position":3,"arabic":"ٱلْحَيَوٰةَ","kind":"word","gloss":"the life","transliteration":"l-ḥayata","lemma":"حَيَوٰة","root":"حيي","entryId":"l-854d7ef0b0abcef1"},{"key":"87:16:4","position":4,"arabic":"ٱلدُّنْيَا","kind":"word","gloss":"(of) the world","transliteration":"l-dun'yā","lemma":"دُّنْيَا","root":"دنو","entryId":"l-ab5bd4a6a062ee8c"},{"key":"87:16:5","position":5,"arabic":"١٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"87:17","translation":"Although the Hereafter is better and more lasting.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"87:17:1","position":1,"arabic":"وَٱلْـَٔاخِرَةُ","kind":"word","gloss":"While the Hereafter","transliteration":"wal-ākhiratu","lemma":"آخِر","root":"اخر","entryId":"l-24868f08d279a095"},{"key":"87:17:2","position":2,"arabic":"خَيْرٌۭ","kind":"word","gloss":"(is) better","transliteration":"khayrun","lemma":"خَيْر","root":"خير","entryId":"l-81db6cd6a46bd56c"},{"key":"87:17:3","position":3,"arabic":"وَأَبْقَىٰٓ","kind":"word","gloss":"and everlasting","transliteration":"wa-abqā","lemma":"أَبْقَىٰٓ","root":"بقي","entryId":null},{"key":"87:17:4","position":4,"arabic":"١٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"87:18","translation":"Verily, this is in the former Scriptures -","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"87:18:1","position":1,"arabic":"إِنَّ","kind":"word","gloss":"Indeed","transliteration":"inna","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"87:18:2","position":2,"arabic":"هَـٰذَا","kind":"word","gloss":"this","transliteration":"hādhā","lemma":"هَٰذَا","root":null,"entryId":"l-a874a3c6f146e6a2"},{"key":"87:18:3","position":3,"arabic":"لَفِى","kind":"word","gloss":"surely (is) in","transliteration":"lafī","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"87:18:4","position":4,"arabic":"ٱلصُّحُفِ","kind":"word","gloss":"the Scriptures","transliteration":"l-ṣuḥufi","lemma":"صُحُف","root":"صحف","entryId":null},{"key":"87:18:5","position":5,"arabic":"ٱلْأُولَىٰ","kind":"word","gloss":"[the] former","transliteration":"l-ūlā","lemma":"أَوَّل","root":"اول","entryId":"l-ecdf865520009f7c"},{"key":"87:18:6","position":6,"arabic":"١٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"87:19","translation":"The Scriptures of Ibrâhîm (Abraham) and Mûsâ (Moses) (عليهما السلام).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"87:19:1","position":1,"arabic":"صُحُفِ","kind":"word","gloss":"(The) Scriptures","transliteration":"ṣuḥufi","lemma":"صُحُف","root":"صحف","entryId":null},{"key":"87:19:2","position":2,"arabic":"إِبْرَٰهِيمَ","kind":"word","gloss":"(of) Ibrahim","transliteration":"ib'rāhīma","lemma":"إِبْرَاهِيم","root":null,"entryId":"l-6e38fe0f9a773b60"},{"key":"87:19:3","position":3,"arabic":"وَمُوسَىٰ","kind":"word","gloss":"and Musa","transliteration":"wamūsā","lemma":"مُوسَىٰ","root":null,"entryId":"l-60d7194527b68cdf"},{"key":"87:19:4","position":4,"arabic":"١٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]}]