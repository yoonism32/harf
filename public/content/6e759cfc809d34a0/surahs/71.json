[{"ref":"71:1","translation":"Verily, We sent Nûh (Noah) to his people (saying): \"Warn your people before there comes to them a painful torment.\"","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"71:1:1","position":1,"arabic":"إِنَّآ","kind":"word","gloss":"Indeed, We","transliteration":"innā","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"71:1:2","position":2,"arabic":"أَرْسَلْنَا","kind":"word","gloss":"[We] sent","transliteration":"arsalnā","lemma":"أَرْسَلَ","root":"رسل","entryId":"l-8b46fe6c57f84b97"},{"key":"71:1:3","position":3,"arabic":"نُوحًا","kind":"word","gloss":"Nuh","transliteration":"nūḥan","lemma":"نُوح","root":null,"entryId":"l-1b7f95b6702cd184"},{"key":"71:1:4","position":4,"arabic":"إِلَىٰ","kind":"word","gloss":"to","transliteration":"ilā","lemma":"إِلَىٰ","root":null,"entryId":"l-53539d2c3606b99e"},{"key":"71:1:5","position":5,"arabic":"قَوْمِهِۦٓ","kind":"word","gloss":"his people","transliteration":"qawmihi","lemma":"قَوْم","root":"قوم","entryId":"l-049e2cd6a60d39f0"},{"key":"71:1:6","position":6,"arabic":"أَنْ","kind":"word","gloss":"that","transliteration":"an","lemma":"أَن","root":null,"entryId":"l-6fb897ea8dfcda9d"},{"key":"71:1:7","position":7,"arabic":"أَنذِرْ","kind":"word","gloss":"Warn","transliteration":"andhir","lemma":"أَنذَرَ","root":"نذر","entryId":"l-a23c49777f73356e"},{"key":"71:1:8","position":8,"arabic":"قَوْمَكَ","kind":"word","gloss":"your people","transliteration":"qawmaka","lemma":"قَوْم","root":"قوم","entryId":"l-049e2cd6a60d39f0"},{"key":"71:1:9","position":9,"arabic":"مِن","kind":"word","gloss":"from","transliteration":"min","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"71:1:10","position":10,"arabic":"قَبْلِ","kind":"word","gloss":"before","transliteration":"qabli","lemma":"قَبْل","root":"قبل","entryId":"l-4bd70955def13ac7"},{"key":"71:1:11","position":11,"arabic":"أَن","kind":"word","gloss":"[that]","transliteration":"an","lemma":"أَن","root":null,"entryId":"l-6fb897ea8dfcda9d"},{"key":"71:1:12","position":12,"arabic":"يَأْتِيَهُمْ","kind":"word","gloss":"comes to them","transliteration":"yatiyahum","lemma":"أَتَى","root":"اتي","entryId":"l-491a40b1f8d047fe"},{"key":"71:1:13","position":13,"arabic":"عَذَابٌ","kind":"word","gloss":"a punishment","transliteration":"ʿadhābun","lemma":"عَذَاب","root":"عذب","entryId":"l-3eb7e15951d31876"},{"key":"71:1:14","position":14,"arabic":"أَلِيمٌۭ","kind":"word","gloss":"painful","transliteration":"alīmun","lemma":"أَلِيم","root":"الم","entryId":"l-e6db50422187d325"},{"key":"71:1:15","position":15,"arabic":"١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"71:2","translation":"He said: \"O my people! Verily, I am a plain warner to you,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"71:2:1","position":1,"arabic":"قَالَ","kind":"word","gloss":"He said","transliteration":"qāla","lemma":"قَالَ","root":"قول","entryId":"l-effaf24a5c86c56f"},{"key":"71:2:2","position":2,"arabic":"يَـٰقَوْمِ","kind":"word","gloss":"O my people","transliteration":"yāqawmi","lemma":"قَوْم","root":"قوم","entryId":"l-049e2cd6a60d39f0"},{"key":"71:2:3","position":3,"arabic":"إِنِّى","kind":"word","gloss":"Indeed, I am","transliteration":"innī","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"71:2:4","position":4,"arabic":"لَكُمْ","kind":"word","gloss":"to you","transliteration":"lakum","lemma":null,"root":null,"entryId":null},{"key":"71:2:5","position":5,"arabic":"نَذِيرٌۭ","kind":"word","gloss":"a warner","transliteration":"nadhīrun","lemma":"نَذِير","root":"نذر","entryId":"l-ef07d8dc455de03e"},{"key":"71:2:6","position":6,"arabic":"مُّبِينٌ","kind":"word","gloss":"clear","transliteration":"mubīnun","lemma":"مُّبِين","root":"بين","entryId":"l-0d597777bd2bba00"},{"key":"71:2:7","position":7,"arabic":"٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"71:3","translation":"\"That you should worship Allâh (Alone), fear (be dutiful to) Him, and obey me,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"71:3:1","position":1,"arabic":"أَنِ","kind":"word","gloss":"That","transliteration":"ani","lemma":"أَن","root":null,"entryId":"l-6fb897ea8dfcda9d"},{"key":"71:3:2","position":2,"arabic":"ٱعْبُدُوا۟","kind":"word","gloss":"Worship","transliteration":"uʿ'budū","lemma":"عَبَدَ","root":"عبد","entryId":"l-0907d1b241c8dd03"},{"key":"71:3:3","position":3,"arabic":"ٱللَّهَ","kind":"word","gloss":"Allah","transliteration":"l-laha","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"71:3:4","position":4,"arabic":"وَٱتَّقُوهُ","kind":"word","gloss":"and fear Him","transliteration":"wa-ittaqūhu","lemma":"اتَّقَىٰ","root":"وقي","entryId":"l-f72641a6cc6e53f2"},{"key":"71:3:5","position":5,"arabic":"وَأَطِيعُونِ","kind":"word","gloss":"and obey me","transliteration":"wa-aṭīʿūni","lemma":"أَطَاعَ","root":"طوع","entryId":"l-8913be9db3ca627d"},{"key":"71:3:6","position":6,"arabic":"٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"71:4","translation":"\"He (Allâh) will forgive you of your sins and respite you to an appointed term. Verily, the term of Allâh when it comes, cannot be delayed, if you but knew.\"","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"71:4:1","position":1,"arabic":"يَغْفِرْ","kind":"word","gloss":"He will forgive","transliteration":"yaghfir","lemma":"غَفَرَ","root":"غفر","entryId":"l-e2e4e54a6755dd20"},{"key":"71:4:2","position":2,"arabic":"لَكُم","kind":"word","gloss":"for you","transliteration":"lakum","lemma":null,"root":null,"entryId":null},{"key":"71:4:3","position":3,"arabic":"مِّن","kind":"word","gloss":"[of]","transliteration":"min","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"71:4:4","position":4,"arabic":"ذُنُوبِكُمْ","kind":"word","gloss":"your sins","transliteration":"dh