lemma":"لَو","root":null,"entryId":"l-9e02d9e1c2596c32"},{"key":"71:4:17","position":17,"arabic":"كُنتُمْ","kind":"word","gloss":"you","transliteration":"kuntum","lemma":"كَانَ","root":"كون","entryId":"l-4b2f9969a9af0d45"},{"key":"71:4:18","position":18,"arabic":"تَعْلَمُونَ","kind":"word","gloss":"know","transliteration":"taʿlamūna","lemma":"عَلِمَ","root":"علم","entryId":"l-6de9979b254804ea"},{"key":"71:4:19","position":19,"arabic":"٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"71:5","translation":"He said: \"O my Lord! Verily, I have called to my people night and day (i.e. secretly and openly to accept the doctrine of Islâmic Monotheism),","translationSource":"qul-301-hilali-khan","notes":[{"text":"See the footnote of (V.2:143).","ref":{"surah":2,"ayah":143}}],"tokens":[{"key":"71:5:1","position":1,"arabic":"قَالَ","kind":"word","gloss":"He said","transliteration":"qāla","lemma":"قَالَ","root":"قول","entryId":"l-effaf24a5c86c56f"},{"key":"71:5:2","position":2,"arabic":"رَبِّ","kind":"word","gloss":"My Lord","transliteration":"rabbi","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"71:5:3","position":3,"arabic":"إِنِّى","kind":"word","gloss":"Indeed, I","transliteration":"innī","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"71:5:4","position":4,"arabic":"دَعَوْتُ","kind":"word","gloss":"invited","transliteration":"daʿawtu","lemma":"دَعَا","root":"دعو","entryId":"l-f687b25395102e70"},{"key":"71:5:5","position":5,"arabic":"قَوْمِى","kind":"word","gloss":"my people","transliteration":"qawmī","lemma":"قَوْم","root":"قوم","entryId":"l-049e2cd6a60d39f0"},{"key":"71:5:6","position":6,"arabic":"لَيْلًۭا","kind":"word","gloss":"night","transliteration":"laylan","lemma":"لَيْل","root":"ليل","entryId":"l-d2e604e516a58959"},{"key":"71:5:7","position":7,"arabic":"وَنَهَارًۭا","kind":"word","gloss":"and day","transliteration":"wanahāran","lemma":"نَهَار","root":"نهر","entryId":"l-986a4c42272dc519"},{"key":"71:5:8","position":8,"arabic":"٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"71:6","translation":"\"But all my calling added nothing but to (their) flight (from the truth).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"71:6:1","position":1,"arabic":"فَلَمْ","kind":"word","gloss":"But not","transliteration":"falam","lemma":"لَم","root":null,"entryId":"l-a5ee2f54ca9bbf2c"},{"key":"71:6:2","position":2,"arabic":"يَزِدْهُمْ","kind":"word","gloss":"increased them","transliteration":"yazid'hum","lemma":"زَادَ","root":"زيد","entryId":null},{"key":"71:6:3","position":3,"arabic":"دُعَآءِىٓ","kind":"word","gloss":"my invitation","transliteration":"duʿāī","lemma":"دُعَآء","root":"دعو","entryId":null},{"key":"71:6:4","position":4,"arabic":"إِلَّا","kind":"word","gloss":"except","transliteration":"illā","lemma":"إِلَّا","root":null,"entryId":"l-250ca4d5b58814dd"},{"key":"71:6:5","position":5,"arabic":"فِرَارًۭا","kind":"word","gloss":"(in) flight","transliteration":"firāran","lemma":"فِرَار","root":"فرر","entryId":null},{"key":"71:6:6","position":6,"arabic":"٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"71:7","translation":"And verily, every time I called unto them that You might forgive them, they thrust their fingers into their ears, covered themselves up with their garments, and persisted (in their refusal), and magnified themselves in pride.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"71:7:1","position":1,"arabic":"وَإِنِّى","kind":"word","gloss":"And indeed, I","transliteration":"wa-innī","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"71:7:2","position":2,"arabic":"كُلَّمَا","kind":"word","gloss":"every time","transliteration":"kullamā","lemma":"كُلَّمَا","root":"كلل","entryId":null},{"key":"71:7:3","position":3,"arabic":"دَعَوْتُهُمْ","kind":"word","gloss":"I invited them","transliteration":"daʿawtuhum","lemma":"دَعَا","root":"دعو","entryId":"l-f687b25395102e70"},{"key":"71:7:4","position":4,"arabic":"لِتَغْفِرَ","kind":"word","gloss":"that You may forgive","transliteration":"litaghfira","lemma":"غَفَرَ","root":"غفر","entryId":"l-e2e4e54a6755dd20"},{"key":"71:7:5","position":5,"arabic":"لَهُمْ","kind":"word","gloss":"them","transliteration":"lahum","lemma":null,"root":null,"entryId":null},{"key":"71:7:6","position":6,"arabic":"جَعَلُوٓا۟","kind":"word","gloss":"they put","transliteration":"jaʿalū","lemma":"جَعَلَ","root":"جعل","entryId":"l-784f751d925aef34"},{"key":"71:7:7","position":7,"arabic":"أَصَـٰبِعَهُمْ","kind":"word","gloss":"their fingers","transliteration":"aṣābiʿahum","lemma":"أَصَٰبِع","root":"صبع","entryId":null},{"key":"71:7:8","position":8,"arabic":"فِىٓ","kind":"word","gloss":"in","transliteration":"fī","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"71:7:9","position":9,"arabic":"ءَاذَانِهِمْ","kind":"word","gloss":"their ears","transliteration":"ādhānihim","lemma":"أُذُنٌ","root":"اذن","entryId":null},{"key":"71:7:10","position":10,"arabic":"وَٱسْتَغْشَوْا۟","kind":"word","gloss":"and covered themselves","transliteration":"wa-is'taghshaw","lemma":"اسْتَغْشَ","root":"غشو","entryId":null},{"key":"71:7:11","position":11,"arabic":"ثِيَابَهُمْ","kind":"word","gloss":"(with) their garments","transliteration":"thiyābahum","lemma":"ثِيَاب","root":"ثوب","entryId":null},{"key":"71:7:12","position":12,"arabic":"وَأَصَرُّوا۟","kind":"word","gloss":"and persisted","transliteration":"wa-aṣarrū","lemma":"أَصَرُّ","root":"صرر","entryId":null},{"key":"71:7:13","position":13,"arabic":"وَٱسْتَكْبَرُوا۟","kind":"word","gloss":"and were arrogant","transliteration":"wa-is'takbarū","lemma":"اسْتَكْبَرَ","root":"كبر","entryId":"l-80b94c01baa78304"},{"key":"71:7:14","position":14,"arabic":"ٱسْتِكْبَارًۭا","kind":"word","gloss":"(with) pride","transliteration":"is'tik'bāran","lemma":"اسْتِكْبَار","root":"