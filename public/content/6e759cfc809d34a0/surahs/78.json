0d45"},{"key":"78:19:4","position":4,"arabic":"أَبْوَٰبًۭا","kind":"word","gloss":"gateways","transliteration":"abwāban","lemma":"بَاب","root":"بوب","entryId":null},{"key":"78:19:5","position":5,"arabic":"١٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"78:20","translation":"And the mountains shall be moved away from their places and they will be as if they were a mirage.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"78:20:1","position":1,"arabic":"وَسُيِّرَتِ","kind":"word","gloss":"And are moved","transliteration":"wasuyyirati","lemma":"سُيِّرَتْ","root":"سير","entryId":null},{"key":"78:20:2","position":2,"arabic":"ٱلْجِبَالُ","kind":"word","gloss":"the mountains","transliteration":"l-jibālu","lemma":"جَبَل","root":"جبل","entryId":"l-740cdd8405f7481e"},{"key":"78:20:3","position":3,"arabic":"فَكَانَتْ","kind":"word","gloss":"and become","transliteration":"fakānat","lemma":"كَانَ","root":"كون","entryId":"l-4b2f9969a9af0d45"},{"key":"78:20:4","position":4,"arabic":"سَرَابًا","kind":"word","gloss":"a mirage","transliteration":"sarāban","lemma":"سَرَاب","root":"سرب","entryId":null},{"key":"78:20:5","position":5,"arabic":"٢٠","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"78:21","translation":"Truly, Hell is a place of ambush -","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"78:21:1","position":1,"arabic":"إِنَّ","kind":"word","gloss":"Indeed","transliteration":"inna","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"78:21:2","position":2,"arabic":"جَهَنَّمَ","kind":"word","gloss":"Hell","transliteration":"jahannama","lemma":"جَهَنَّم","root":null,"entryId":"l-224d7d1540dd0042"},{"key":"78:21:3","position":3,"arabic":"كَانَتْ","kind":"word","gloss":"is","transliteration":"kānat","lemma":"كَانَ","root":"كون","entryId":"l-4b2f9969a9af0d45"},{"key":"78:21:4","position":4,"arabic":"مِرْصَادًۭا","kind":"word","gloss":"lying in wait","transliteration":"mir'ṣādan","lemma":"مِرْصَاد","root":"رصد","entryId":null},{"key":"78:21:5","position":5,"arabic":"٢١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"78:22","translation":"A dwelling place for the Tâghûn (those who transgress the boundary limits set by Allâh like polytheists, disbelievers in the Oneness of Allâh, hyprocrites, sinners, criminals),","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"78:22:1","position":1,"arabic":"لِّلطَّـٰغِينَ","kind":"word","gloss":"For the transgressors","transliteration":"lilṭṭāghīna","lemma":"طَٰغِين","root":"طغي","entryId":null},{"key":"78:22:2","position":2,"arabic":"مَـَٔابًۭا","kind":"word","gloss":"a place of return","transliteration":"maāban","lemma":"مَـَٔاب","root":"اوب","entryId":null},{"key":"78:22:3","position":3,"arabic":"٢٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"78:23","translation":"They will abide therein for ages.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"78:23:1","position":1,"arabic":"لَّـٰبِثِينَ","kind":"word","gloss":"(They will) be remaining","transliteration":"lābithīna","lemma":"لَّٰبِثِين","root":"لبث","entryId":null},{"key":"78:23:2","position":2,"arabic":"فِيهَآ","kind":"word","gloss":"therein","transliteration":"fīhā","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"78:23:3","position":3,"arabic":"أَحْقَابًۭا","kind":"word","gloss":"(for) ages","transliteration":"aḥqāban","lemma":"أَحْقَاب","root":"حقب","entryId":null},{"key":"78:23:4","position":4,"arabic":"٢٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"78:24","translation":"Nothing cool shall they taste therein, nor any drink.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"78:24:1","position":1,"arabic":"لَّا","kind":"word","gloss":"Not","transliteration":"lā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"78:24:2","position":2,"arabic":"يَذُوقُونَ","kind":"word","gloss":"they will taste","transliteration":"yadhūqūna","lemma":"ذَاقُ","root":"ذوق","entryId":"l-351649387efdb5df"},{"key":"78:24:3","position":3,"arabic":"فِيهَا","kind":"word","gloss":"therein","transliteration":"fīhā","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"78:24:4","position":4,"arabic":"بَرْدًۭا","kind":"word","gloss":"coolness","transliteration":"bardan","lemma":"بَرْد","root":"برد","entryId":null},{"key":"78:24:5","position":5,"arabic":"وَلَا","kind":"word","gloss":"and not","transliteration":"walā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"78:24:6","position":6,"arabic":"شَرَابًا","kind":"word","gloss":"any drink","transliteration":"sharāban","lemma":"شَرَاب","root":"شرب","entryId":null},{"key":"78:24:7","position":7,"arabic":"٢٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"78:25","translation":"Except boiling water, and dirty wound discharges -","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"78:25:1","position":1,"arabic":"إِلَّا","kind":"word","gloss":"Except","transliteration":"illā","lemma":"إِلَّا","root":null,"entryId":"l-250ca4d5b58814dd"},{"key":"78:25:2","position":2,"arabic":"حَمِيمًۭا","kind":"word","gloss":"scalding water","transliteration":"ḥamīman","lemma":"حَمِيم","root":"حمم","entryId":null},{"key":"78:25:3","position":3,"arabic":"وَغَسَّاقًۭا","kind":"word","gloss":"and purulence","transliteration":"waghassāqan","lemma":"غَسَّاق","root":"غسق","entryId":null},{"key":"78:25:4","position":4,"arabic":"٢٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"78:26","translation":"An exact recompense (according to their evil crimes).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"78:26:1","position":1,"arabic":"جَزَآءًۭ","kind":"word","gloss":"A recompense","transliteration":"jazāan","lemma":"جَزَآء","root":"جزي","entryId":"l-351280652e0741fc"},{"key":"78:26:2","position":2,"arabic":"وِفَاقًا","kind":"word","gloss":"appropriate","transliteration":"wifāqan","lemma":"وِفَاق","root":"وفق","entryId":null},{"key":"78:26:3","position":3,"arabic":"٢٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"78:27","translation":"For verily, they used not to look for a reckoning.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"78:27:1","position":1,"arabic":"إِنَّهُمْ","kind":"word","gloss":"Indeed, they","transliteration":"innahum","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"78:27:2","position":2,"arabic":"كَانُوا۟","kind":"word","gloss":"were","transliteration":"kānū","lemma":"كَانَ","root":"كون","entryId":"l-4b2f9969a9af0d45"},{"key":"78:27:3","position":3,"arabic":"لَا","kind":"word","gloss":"not","transliteration":"lā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"78:27:4","position":4,"arabic":"يَرْجُونَ","kind":"word","gloss":"expecting","transliteration":"yarjūna","lemma":"يَرْجُوا۟","root":"رجو","entryId":null},{"key":"78:27:5","position":5,"arabic":"حِسَابًۭا","kind":"word","gloss":"an account","transliteration":"ḥisāban","lemma":"حِسَاب","root":"حسب","entryId":"l-abc3684e3a67ce7a"},{"key":"78:27:6","position":6,"arabic":"٢٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"78:28","translation":"But they belied Our Ayât (proofs, evidence, verses, lessons, signs, revelations, and that which Our Prophet صلى الله عليه وسلم brought) completely.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"78:28:1","position":1,"arabic":"وَكَذَّبُوا۟","kind":"word","gloss":"And they denied","transliteration":"wakadhabū","lemma":"كَذَّبَ","root":"كذب","entryId":"l-db86b0654d661fb2"},{"key":"78:28:2","position":2,"arabic":"بِـَٔايَـٰتِنَا","kind":"word","gloss":"Our Signs","transliteration":"biāyātinā","lemma":"ءَايَة","root":"ايي","entryId":"l-5ab33552830ad5b5"},{"key":"78:28:3","position":3,"arabic":"كِذَّابًۭا","kind":"word","gloss":"(with) denial","transliteration":"kidhāban","lemma":"كِذَّاب","root":"كذب","entryId":null},{"key":"78:28:4","position":4,"arabic":"٢٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"78:29","translation":"And all things We have recorded in a Book.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"78:29:1","position":1,"arabic":"وَكُلَّ","kind":"word","gloss":"And every","transliteration":"wakulla","lemma":"كُلّ","root":"كلل","entryId":"l-6fac43bd71e38426"},{"key":"78:29:2","position":2,"arabic":"شَىْءٍ","kind":"word","gloss":"thing","transliteration":"shayin","lemma":"شَىْء","root":"شيا","entryId":"l-180c07cc91c0f47b"},{"key":"78:29:3","position":3,"arabic":"أَحْصَيْنَـٰهُ","kind":"word","gloss":"We have enumerated it","transliteration":"aḥṣaynāhu","lemma":"أَحْصَىٰ","root":"حصي","entryId":null},{"key":"78:29:4","position":4,"arabic":"كِتَـٰبًۭا","kind":"word","gloss":"(in) a Book","transliteration":"kitāban","lemma":"كِتَٰب","root":"كتب","entryId":"l-a68c915be321aa35"},{"key":"78:29:5","position":5,"arabic":"٢٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"78:30","translation":"So taste you (the results of your evil actions). No increase shall We give you, except in torment.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"78:30:1","position":1,"arabic":"فَذُوقُوا۟","kind":"word","gloss":"So taste","transliteration":"fadhūqū","lemma":"ذَاقُ","root":"ذوق","entryId":"l-351649387efdb5df"},{"key":"78:30:2","position":2,"arabic":"فَلَن","kind":"word","gloss":"and never","transliteration":"falan","lemma":"لَن","root":null,"entryId":"l-3db5462128ff695e"},{"key":"78:30:3","position":3,"arabic":"نَّزِيدَكُمْ","kind":"word","gloss":"We will increase you","transliteration":"nazīdakum","lemma":"زَادَ","root":"زيد","entryId":null},{"key":"78:30:4","position":4,"arabic":"إِلَّا","kind":"word","gloss":"except","transliteration":"illā","lemma":"إِلَّا","root":null,"entryId":"l-250ca4d5b58814dd"},{"key":"78:30:5","position":5,"arabic":"عَذَابًا","kind":"word","gloss":"(in) punishment","transliteration":"ʿadhāban","lemma":"عَذَاب","root":"عذب","entryId":"l-3eb7e15951d31876"},{"key":"78:30:6","position":6,"arabic":"٣٠","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"78:31","translation":"Verily, for the Muttaqûn, there will be a success (Paradise);","translationSource":"qul-301-hilali-khan","notes":[{"text":"Muttaqûn: means pious believer of Islamic Monotheism who fear Allâh much (abstain from all kinds of sins and evil deeds which He has forbidden) and love Allâh much (perform all kinds of good deeds which He has ordained).","ref":null}],"tokens":[{"key":"78:31:1","position":1,"arabic":"إِنَّ","kind":"word","gloss":"Indeed","transliteration":"inna","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"78:31:2","position":2,"arabic":"لِلْمُتَّقِينَ","kind":"word","gloss":"for the righteous","transliteration":"lil'muttaqīna","lemma":"مُتَّقِين","root":"وقي","entryId":"l-1eeefa856cd97454"},{"key":"78:31:3","position":3,"arabic":"مَفَازًا","kind":"word","gloss":"(is) success","transliteration":"mafāzan","lemma":"مَفَاز","root":"فوز","entryId":null},{"key":"78:31:4","position":4,"arabic":"٣١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"78:32","translation":"Gardens and vineyards,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"78:32:1","position":1,"arabic":"حَدَآئِقَ","kind":"word","gloss":"Gardens","transliteration":"ḥadāiqa","lemma":"حَدَآئِق","root":"حدق","entryId":null},{"key":"78:32:2","position":2,"arabic":"وَأَعْنَـٰبًۭا","kind":"word","gloss":"and grapevines","transliteration":"wa-aʿnāban","lemma":"عِنَب","root":"عنب","entryId":null},{"key":"78:32:3","position":3,"arabic":"٣٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"78:33","translation":"And young full-breasted (mature) maidens of equal age,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"78:33:1","position":1,"arabic":"وَكَوَاعِبَ","kind":"word","gloss":"And splendid companions","transliteration":"wakawāʿiba","lemma":"كَوَاعِب","root":"كعب","entryId":null},{"key":"78:33:2","position":2,"arabic":"أَتْرَابًۭا","kind":"word","gloss":"well-matched","transliteration":"atrāban","lemma":"أَتْرَاب","root":"ترب","entryId":null},{"key":"78:33:3","position":3,"arabic":"٣٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"78:34","translation":"And a full cup (of wine).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"78:34:1","position":1,"arabic":"وَكَأْسًۭا","kind":"word","gloss":"And a cup","transliteration":"wakasan","lemma":"كَأْس","root":"كاس","entryId":null},{"key":"78:34:2","position":2,"arabic":"دِهَاقًۭا","kind":"word","gloss":"full","transliteration":"dihāqan","lemma":"دِهَاق","root":"دهق","entryId":null},{"key":"78:34:3","position":3,"arabic":"٣٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"78:35","translation":"No Laghw (dirty, false, evil talk) shall they hear therein, nor lying;","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"78:35:1","position":1,"arabic":"لَّا","kind":"word","gloss":"Not","transliteration":"lā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"78:35:2","position":2,"arabic":"يَسْمَعُونَ","kind":"word","gloss":"they will hear","transliteration":"yasmaʿūna","lemma":"سَمِعَ","root":"سمع","entryId":"l-aaa366d4d080c5ed"},{"key":"78:35:3","position":3,"arabic":"فِيهَا","kind":"word","gloss":"therein","transliteration":"fīhā","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"78:35:4","position":4,"arabic":"لَغْوًۭا","kind":"word","gloss":"any vain talk","transliteration":"laghwan","lemma":"لَغْو","root":"لغو","entryId":null},{"key":"78:35:5","position":5,"arabic":"وَلَا","kind":"word","gloss":"and not","transliteration":"walā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"78:35:6","position":6,"arabic":"كِذَّٰبًۭا","kind":"word","gloss":"any falsehood","transliteration":"kidhāban","lemma":"كِذَّاب","root":"كذب","entryId":null},{"key":"78:35:7","position":7,"arabic":"٣٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"78:36","translation":"A reward from your Lord, an ample calculated gift (according to the best of their good deeds),","translationSource":"qul-301-hilali-khan","notes":[{"text":"a) Islâm demolishes all the previous evil deeds and so do migration (for Allâh’s sake) and Hajj (pilgrimage to Makkah). (Sahih Muslim, Vol.1, Chapter 52, Page 18). b) What is said regarding the superiority of a person who embraces Islâm sincerely: Narrated Abu Sa‘îd Al-Khudri رضي الله عنه: Allâh’s Messenger صلى الله عليه وسلم said, \"If a person embraces Islâm sincerely, then Allâh shall forgive all his past sins, and after that starts the settlement of accounts: the reward of his good deeds will be ten times to seven hundred times for each good deed, and an evil deed will be recorded as it is unless Allâh forgives it.\" (Sahih Al-Bukhari, Vol.1, Hadith No. 40A). Narrated Abu Hurairah رضي الله عنه: Allâh’s Messenger صلى الله عليه وسلم said: \"If any one of you improves (follows strictly) his Islâmic religion, then his good deeds will be rewarded ten times to seven hundred times for each good deed and a bad deed will be recorded as it is.\" (Sahih Al-Bukhari, Vol.1, Hadith No. 40B).","ref":null}],"tokens":[{"key":"78:36:1","position":1,"arabic":"جَزَآءًۭ","kind":"word","gloss":"(As) a reward","transliteration":"jazāan","lemma":"جَزَآء","root":"جزي","entryId":"l-351280652e0741fc"},{"key":"78:36:2","position":2,"arabic":"مِّن","kind":"word","gloss":"from","transliteration":"min","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"78:36:3","position":3,"arabic":"رَّبِّكَ","kind":"word","gloss":"your Lord","transliteration":"rabbika","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"78:36:4","position":4,"arabic":"عَطَآءً","kind":"word","gloss":"a gift","transliteration":"ʿaṭāan","lemma":"عَطَآء","root":"عطو","entryId":null},{"key":"78:36:5","position":5,"arabic":"حِسَابًۭا","kind":"word","gloss":"(according to) account","transliteration":"ḥisāban","lemma":"حِسَاب","root":"حسب","entryId":"l-abc3684e3a67ce7a"},{"key":"78:36:6","position":6,"arabic":"٣٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"78:37","translation":"(From) the Lord of the heavens and the earth, and whatsoever is in between them, the Most Gracious, with Whom they cannot dare to speak (on the Day of Resurrection except by His Leave).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"78:37:1","position":1,"arabic":"رَّبِّ","kind":"word","gloss":"Lord","transliteration":"rabbi","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"78:37:2","position":2,"arabic":"ٱلسَّمَـٰوَٰتِ","kind":"word","gloss":"(of) the heavens","transliteration":"l-samāwāti","lemma":"سَمَآء","root":"سمو","entryId":"l-e873a75addf25baf"},{"key":"78:37:3","position":3,"arabic":"وَٱلْأَرْضِ","kind":"word","gloss":"and the earth","transliteration":"wal-arḍi","lemma":"أَرْض","root":"ارض","entryId":"l-2c626a3b4c64dbc9"},{"key":"78:37:4","position":4,"arabic":"وَمَا","kind":"word","gloss":"and whatever","transliteration":"wamā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"78:37:5","position":5,"arabic":"بَيْنَهُمَا","kind":"word","gloss":"(is) between both of them","transliteration":"baynahumā","lemma":"بَيْن","root":"بين","entryId":"l-32db43d0920d28f8"},{"key":"78:37:6","position":6,"arabic":"ٱلرَّحْمَـٰنِ ۖ","kind":"word","gloss":"the Most Gracious","transliteration":"l-raḥmāni","lemma":"رَّحْمَٰن","root":"رحم","entryId":"l-42ee1a81d4fcd0c4"},{"key":"78:37:7","position":7,"arabic":"لَا","kind":"word","gloss":"not","transliteration":"lā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"78:37:8","position":8,"arabic":"يَمْلِكُونَ","kind":"word","gloss":"they have power","transliteration":"yamlikūna","lemma":"مَلَكَتْ","root":"ملك","entryId":"l-bd9ada6145881cc2"},{"key":"78:37:9","position":9,"arabic":"مِنْهُ","kind":"word","gloss":"from Him","transliteration":"min'hu","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"78:37:10","position":10,"arabic":"خِطَابًۭا","kind":"word","gloss":"(to) address","transliteration":"khiṭāban","lemma":"خِطَاب","root":"خطب","entryId":null},{"key":"78:37:11","position":11,"arabic":"٣٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"78:38","translation":"The Day that Ar-Rûh [Jibrîl (Gabriel) or another angel] and the angels will stand forth in rows, they will not speak except him whom the Most Gracious (Allâh) allows, and he will speak what is right.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"78:38:1","position":1,"arabic":"يَوْمَ","kind":"word","gloss":"(The) Day","transliteration":"yawma","lemma":"يَوْم","root":"يوم","entryId":"l-bd6f5747b4dfe79c"},{"key":"78:38:2","position":2,"arabic":"يَقُومُ","kind":"word","gloss":"will stand","transliteration":"yaqūmu","lemma":"قَامَ","root":"قوم","entryId":null},{"key":"78:38:3","position":3,"arabic":"ٱلرُّوحُ","kind":"word","gloss":"the Spirit","transliteration":"l-rūḥu","lemma":"رُوح","root":"روح","entryId":null},{"key":"78:38:4","position":4,"arabic":"وَٱل