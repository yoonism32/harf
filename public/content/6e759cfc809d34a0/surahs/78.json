[{"ref":"78:1","translation":"What are they asking (one another) about?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"78:1:1","position":1,"arabic":"عَمَّ","kind":"word","gloss":"About what","transliteration":"ʿamma","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"78:1:2","position":2,"arabic":"يَتَسَآءَلُونَ","kind":"word","gloss":"are they asking one another","transliteration":"yatasāalūna","lemma":"يَتَسَآءَلُ","root":"سال","entryId":null},{"key":"78:1:3","position":3,"arabic":"١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"78:2","translation":"About the great news, (i.e. Islâmic Monotheism, the Qur’ân, which Prophet Muhammad صلى الله عليه وسلم brought and the Day of Resurrection)","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"78:2:1","position":1,"arabic":"عَنِ","kind":"word","gloss":"About","transliteration":"ʿani","lemma":"عَن","root":null,"entryId":"l-f1109a78c8548754"},{"key":"78:2:2","position":2,"arabic":"ٱلنَّبَإِ","kind":"word","gloss":"the News","transliteration":"l-naba-i","lemma":"نَبَأ","root":"نبا","entryId":null},{"key":"78:2:3","position":3,"arabic":"ٱلْعَظِيمِ","kind":"word","gloss":"the Great","transliteration":"l-ʿaẓīmi","lemma":"عَظِيم","root":"عظم","entryId":"l-4ac2f032da29eeff"},{"key":"78:2:4","position":4,"arabic":"٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"78:3","translation":"About which they are in disagreement.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"78:3:1","position":1,"arabic":"ٱلَّذِى","kind":"word","gloss":"(About) which","transliteration":"alladhī","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"78:3:2","position":2,"arabic":"هُمْ","kind":"word","gloss":"they","transliteration":"hum","lemma":null,"root":null,"entryId":null},{"key":"78:3:3","position":3,"arabic":"فِيهِ","kind":"word","gloss":"(are) concerning it","transliteration":"fīhi","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"78:3:4","position":4,"arabic":"مُخْتَلِفُونَ","kind":"word","gloss":"(in) disagreement","transliteration":"mukh'talifūna","lemma":"مُّخْتَلِف","root":"خلف","entryId":null},{"key":"78:3:5","position":5,"arabic":"٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"78:4","translation":"Nay, they will come to know!","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"78:4:1","position":1,"arabic":"كَلَّا","kind":"word","gloss":"Nay","transliteration":"kallā","lemma":"كَلَّا","root":null,"entryId":null},{"key":"78:4:2","position":2,"arabic":"سَيَعْلَمُونَ","kind":"word","gloss":"(soon) they will know","transliteration":"sayaʿlamūna","lemma":"عَلِمَ","root":"علم","entryId":"l-6de9979b254804ea"},{"key":"78:4:3","position":3,"arabic":"٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"78:5","translation":"Nay, again, they will come to know!","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"78:5:1","position":1,"arabic":"ثُمَّ","kind":"word","gloss":"Then","transliteration":"thumma","lemma":"ثُمّ","root":null,"entryId":"l-75b66396af12da75"},{"key":"78:5:2","position":2,"arabic":"كَلَّا","kind":"word","gloss":"Nay","transliteration":"kallā","lemma":"كَلَّا","root":null,"entryId":null},{"key":"78:5:3","position":3,"arabic":"سَيَعْلَمُونَ","kind":"word","gloss":"(soon) they will know","transliteration":"sayaʿlamūna","lemma":"عَلِمَ","root":"علم","entryId":"l-6de9979b254804ea"},{"key":"78:5:4","position":4,"arabic":"٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"78:6","translation":"Have We not made the earth as a bed,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"78:6:1","position":1,"arabic":"أَلَمْ","kind":"word","gloss":"Have not","transliteration":"alam","lemma":"لَم","root":null,"entryId":"l-a5ee2f54ca9bbf2c"},{"key":"78:6:2","position":2,"arabic":"نَجْعَلِ","kind":"word","gloss":"We made","transliteration":"najʿali","lemma":"جَعَلَ","root":"جعل","entryId":"l-784f751d925aef34"},{"key":"78:6:3","position":3,"arabic":"ٱلْأَرْضَ","kind":"word","gloss":"the earth","transliteration":"l-arḍa","lemma":"أَرْض","root":"ارض","entryId":"l-2c626a3b4c64dbc9"},{"key":"78:6:4","position":4,"arabic":"مِهَـٰدًۭا","kind":"word","gloss":"a resting place","transliteration":"mihādan","lemma":"مِهَٰد","root":"مهد","entryId":null},{"key":"78:6:5","position":5,"arabic":"٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"78:7","translation":"And the mountains as pegs?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"78:7:1","position":1,"arabic":"وَٱلْجِبَالَ","kind":"word","gloss":"And the mountains","transliteration":"wal-jibāla","lemma":"جَبَل","root":"جبل","entryId":"l-740cdd8405f7481e"},{"key":"78:7:2","position":2,"arabic":"أَوْتَادًۭا","kind":"word","gloss":"(as) pegs","transliteration":"awtādan","lemma":"أَوْتَاد","root":"وتد","entryId":null},{"key":"78:7:3","position":3,"arabic":"٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"78:8","translation":"And We have created you in pairs (male and female, tall and short, good and bad, etc.).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"78:8:1","position":1,"arabic":"وَخَلَقْنَـٰكُمْ","kind":"word","gloss":"And We created you","transliteration":"wakhalaqnākum","lemma":"خَلَقَ","root":"خلق","entryId":"l-9e7414ba00a88ddc"},{"key":"78:8:2","position":2,"arabic":"أَزْوَٰجًۭا","kind":"word","gloss":"(in) pairs","transliteration":"azwājan","lemma":"زَوْج","root":"زوج","entryId":"l-93f3d3960cce24df"},{"key":"78:8:3","position":3,"arabic":"٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"78:9","translation":"And We have made your sleep as a thing for rest.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"78:9:1","position":1,"arabic":"وَجَعَلْنَا","kind":"word","gloss":"And We made","transliteration":"wajaʿalnā","lemma":"جَعَلَ","root":"جعل","entryId":"l-784f751d925aef34"},{"key":"78:9:2","position":2,"arabic":"نَوْمَكُمْ","kind":"word","gloss":"your sleep","transliteration":"nawmakum","lemma":"نَوْم","root":"نوم","entryId":null},{"key":"78:9:3","position":3,"arabic":"سُبَاتًۭا","kind":"word","gloss":"(for) rest","transliteration":"subātan","lemma":"سُبَات","root":"سبت","entryId":null},{"key":"78:9:4","position":4,"arabic":"٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"78:10","translation":"And We have made the night as a covering (through its darkness),","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"78:10:1","position":1,"arabic":"وَجَعَلْنَا","kind":"word","gloss":"And We made","transliteration":"wajaʿalnā","lemma":"جَعَلَ","root":"جعل","entryId":"l-784f751d925aef34"},{"key":"78:10:2","position":2,"arabic":"ٱلَّيْلَ","kind":"word","gloss":"the night","transliteration":"al-layla","lemma":"لَيْل","root":"ليل","entryId":"l-d2e604e516a58959"},{"key":"78:10:3","position":3,"arabic":"لِبَاسًۭا","kind":"word","gloss":"(as) covering","transliteration":"libāsan","lemma":"لِبَاس","root":"لبس","entryId":null},{"key":"78:10:4","position":4,"arabic":"١٠","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"78:11","translation":"And We have made the day for livelihood.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"78:11:1","position":1,"arabic":"وَجَعَلْنَا","kind":"word","gloss":"And We made","transliteration":"wajaʿalnā","lemma":"جَعَلَ","root":"جعل","entryId":"l-784f751d925aef34"},{"key":"78:11:2","position":2,"arabic":"ٱلنَّهَارَ","kind":"word","gloss":"the day","transliteration":"l-nahāra","lemma":"نَهَار","root":"نهر","entryId":"l-986a4c42272dc519"},{"key":"78:11:3","position":3,"arabic":"مَعَاشًۭا","kind":"word","gloss":"(for) livelihood","transliteration":"maʿāshan","lemma":"مَعَاش","root":"عيش","entryId":null},{"key":"78:11:4","position":4,"arabic":"١١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"78:12","translation":"And We have built above you seven strong (heavens),","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"78:12:1","position":1,"arabic":"وَبَنَيْنَا","kind":"word","gloss":"And We constructed","transliteration":"wabanaynā","lemma":"بَنَىٰ","root":"بني","entryId":null},{"key":"78:12:2","position":2,"arabic":"فَوْقَكُمْ","kind":"word","gloss":"over you","transliteration":"fawqakum","lemma":"فَوْق","root":"فوق","entryId":"l-d7e92e09eacd7b71"},{"key":"78:12:3","position":3,"arabic":"سَبْعًۭا","kind":"word","gloss":"seven","transliteration":"sabʿan","lemma":"سَبْع","root":"سبع","entryId":null},{"key":"78:12:4","position":4,"arabic":"شِدَادًۭا","kind":"word","gloss":"strong","transliteration":"shidādan","lemma":"شَدِيد","root":"شدد","entryId":"l-85c14b6882876cfc"},{"key":"78:12:5","position":5,"arabic":"١٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"78:13","translation":"And We have made (therein) a shining lamp (sun).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"78:13:1","position":1,"arabic":"وَجَعَلْنَا","kind":"word","gloss":"And We placed","transliteration":"wajaʿalnā","lemma":"جَعَلَ","root":"جعل","entryId":"l-784f751d925aef34"},{"key":"78:13:2","position":2,"arabic":"سِرَاجًۭا","kind":"word","gloss":"a lamp","transliteration":"sirājan","lemma":"سِرَاج","root":"سرج","entryId":null},{"key":"78:13:3","position":3,"arabic":"وَهَّاجًۭا","kind":"word","gloss":"burning","transliteration":"wahhājan","lemma":"وَهَّاج","root":"وهج","entryId":null},{"key":"78:13:4","position":4,"arabic":"١٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"78:14","translation":"And We have sent down from the rainy clouds abundant water.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"78:14:1","position":1,"arabic":"وَأَنزَلْنَا","kind":"word","gloss":"And We sent down","transliteration":"wa-anzalnā","lemma":"أَنزَلَ","root":"نزل","entryId":"l-81ead5682cb1835c"},{"key":"78:14:2","position":2,"arabic":"مِنَ","kind":"word","gloss":"from","transliteration":"mina","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"78:14:3","position":3,"arabic":"ٱلْمُعْصِرَٰتِ","kind":"word","gloss":"the rain clouds","transliteration":"l-muʿ'ṣirāti","lemma":"مُعْصِرَٰت","root":"عصر","entryId":null},{"key":"78:14:4","position":4,"arabic":"مَآءًۭ","kind":"word","gloss":"water","transliteration":"māan","lemma":"مَآء","root":"موه","entryId":"l-b8b1f8ed335826e5"},{"key":"78:14:5","position":5,"arabic":"ثَجَّاجًۭا","kind":"word","gloss":"pouring abundantly","transliteration":"thajjājan","lemma":"ثَجَّاج","root":"ثجج","entryId":null},{"key":"78:14:6","position":6,"arabic":"١٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"78:15","translation":"That We may produce therewith corn and vegetations,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"78:15:1","position":1,"arabic":"لِّنُخْرِجَ","kind":"word","gloss":"That We may bring forth","transliteration":"linukh'rija","lemma":"أَخْرَجَ","root":"خرج","entryId":"l-a25810044f12cf39"},{"key":"78:15:2","position":2,"arabic":"بِهِۦ","kind":"word","gloss":"thereby","transliteration":"bihi","lemma":null,"root":null,"entryId":null},{"key":"78:15:3","position":3,"arabic":"حَبًّۭا","kind":"word","gloss":"grain","transliteration":"ḥabban","lemma":"حَبّ","root":"حبب","entryId":null},{"key":"78:15:4","position":4,"arabic":"وَنَبَاتًۭا",