out doubt) the True Day. So, whosoever wills, let him seek a place with (or a way to) His Lord (by obeying Him in this worldly life)!","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"78:39:1","position":1,"arabic":"ذَٰلِكَ","kind":"word","gloss":"That","transliteration":"dhālika","lemma":"ذَٰلِك","root":null,"entryId":"l-096a9ad382db7640"},{"key":"78:39:2","position":2,"arabic":"ٱلْيَوْمُ","kind":"word","gloss":"(is) the Day","transliteration":"l-yawmu","lemma":"يَوْم","root":"يوم","entryId":"l-bd6f5747b4dfe79c"},{"key":"78:39:3","position":3,"arabic":"ٱلْحَقُّ ۖ","kind":"word","gloss":"the True","transliteration":"l-ḥaqu","lemma":"حَقّ","root":"حقق","entryId":"l-ab22afcdeb66ae98"},{"key":"78:39:4","position":4,"arabic":"فَمَن","kind":"word","gloss":"So whoever","transliteration":"faman","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"78:39:5","position":5,"arabic":"شَآءَ","kind":"word","gloss":"wills","transliteration":"shāa","lemma":"شَآءَ","root":"شيا","entryId":"l-e6061b9230d95354"},{"key":"78:39:6","position":6,"arabic":"ٱتَّخَذَ","kind":"word","gloss":"let him take","transliteration":"ittakhadha","lemma":"اتَّخَذَ","root":"اخذ","entryId":"l-ce6fef68e0607027"},{"key":"78:39:7","position":7,"arabic":"إِلَىٰ","kind":"word","gloss":"towards","transliteration":"ilā","lemma":"إِلَىٰ","root":null,"entryId":"l-53539d2c3606b99e"},{"key":"78:39:8","position":8,"arabic":"رَبِّهِۦ","kind":"word","gloss":"his Lord","transliteration":"rabbihi","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"78:39:9","position":9,"arabic":"مَـَٔابًا","kind":"word","gloss":"a return","transliteration":"maāban","lemma":"مَـَٔاب","root":"اوب","entryId":null},{"key":"78:39:10","position":10,"arabic":"٣٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"78:40","translation":"Verily, We have warned you of a near torment - the Day when man will see that (the deeds) which his hands have sent forth, and the disbeliever will say: \"Woe to me! Would that I were dust!\"","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"78:40:1","position":1,"arabic":"إِنَّآ","kind":"word","gloss":"Indeed We","transliteration":"innā","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"78:40:2","position":2,"arabic":"أَنذَرْنَـٰكُمْ","kind":"word","gloss":"[We] have warned you","transliteration":"andharnākum","lemma":"أَنذَرَ","root":"نذر","entryId":"l-a23c49777f73356e"},{"key":"78:40:3","position":3,"arabic":"عَذَابًۭا","kind":"word","gloss":"(of) a punishment","transliteration":"ʿadhāban","lemma":"عَذَاب","root":"عذب","entryId":"l-3eb7e15951d31876"},{"key":"78:40:4","position":4,"arabic":"قَرِيبًۭا","kind":"word","gloss":"near","transliteration":"qarīban","lemma":"قَرِيب","root":"قرب","entryId":null},{"key":"78:40:5","position":5,"arabic":"يَوْمَ","kind":"word","gloss":"(the) Day","transliteration":"yawma","lemma":"يَوْم","root":"يوم","entryId":"l-bd6f5747b4dfe79c"},{"key":"78:40:6","position":6,"arabic":"يَنظُرُ","kind":"word","gloss":"will see","transliteration":"yanẓuru","lemma":"نَّظَرَ","root":"نظر","entryId":"l-a8ed1f7d9aec33ac"},{"key":"78:40:7","position":7,"arabic":"ٱلْمَرْءُ","kind":"word","gloss":"the man","transliteration":"l-maru","lemma":"مَرْء","root":"مرا","entryId":null},{"key":"78:40:8","position":8,"arabic":"مَا","kind":"word","gloss":"what","transliteration":"mā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"78:40:9","position":9,"arabic":"قَدَّمَتْ","kind":"word","gloss":"have sent forth","transliteration":"qaddamat","lemma":"قَدَّمَ","root":"قدم","entryId":null},{"key":"78:40:10","position":10,"arabic":"يَدَاهُ","kind":"word","gloss":"his hands","transliteration":"yadāhu","lemma":"يَد","root":"يدي","entryId":"l-d6185269501ba306"},{"key":"78:40:11","position":11,"arabic":"وَيَقُولُ","kind":"word","gloss":"and will say","transliteration":"wayaqūlu","lemma":"قَالَ","root":"قول","entryId":"l-