[{"ref":"98:1","translation":"Those who disbelieve from among the people of the Scripture (Jews and Christians) and Al-Mushrikûn, were not going to leave (their disbelief) until there came to them clear evidence.","translationSource":"qul-301-hilali-khan","notes":[{"text":"Al-Mushrikûn: polytheists, pagans, idolaters and disbelievers in the Oneness of Allâh and His Messenger Muhammad صلى الله عليه وسلم.","ref":null}],"tokens":[{"key":"98:1:1","position":1,"arabic":"لَمْ","kind":"word","gloss":"Not","transliteration":"lam","lemma":"لَم","root":null,"entryId":"l-a5ee2f54ca9bbf2c"},{"key":"98:1:2","position":2,"arabic":"يَكُنِ","kind":"word","gloss":"were","transliteration":"yakuni","lemma":"كَانَ","root":"كون","entryId":"l-4b2f9969a9af0d45"},{"key":"98:1:3","position":3,"arabic":"ٱلَّذِينَ","kind":"word","gloss":"those who","transliteration":"alladhīna","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"98:1:4","position":4,"arabic":"كَفَرُوا۟","kind":"word","gloss":"disbelieved","transliteration":"kafarū","lemma":"كَفَرَ","root":"كفر","entryId":"l-f6f8e55e4806177f"},{"key":"98:1:5","position":5,"arabic":"مِنْ","kind":"word","gloss":"from","transliteration":"min","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"98:1:6","position":6,"arabic":"أَهْلِ","kind":"word","gloss":"(the) People","transliteration":"ahli","lemma":"أَهْل","root":"اهل","entryId":"l-5fd11f4d420d23ca"},{"key":"98:1:7","position":7,"arabic":"ٱلْكِتَـٰبِ","kind":"word","gloss":"of the Book","transliteration":"l-kitābi","lemma":"كِتَٰب","root":"كتب","entryId":"l-a68c915be321aa35"},{"key":"98:1:8","position":8,"arabic":"وَٱلْمُشْرِكِينَ","kind":"word","gloss":"and the polytheists","transliteration":"wal-mush'rikīna","lemma":"مُشْرِك","root":"شرك","entryId":"l-f1407d5b914fb36c"},{"key":"98:1:9","position":9,"arabic":"مُنفَكِّينَ","kind":"word","gloss":"to be abandoned","transliteration":"munfakkīna","lemma":"مُنفَكِّين","root":"فكك","entryId":null},{"key":"98:1:10","position":10,"arabic":"حَتَّىٰ","kind":"word","gloss":"until","transliteration":"ḥattā","lemma":"حَتَّىٰ","root":null,"entryId":"l-4bc225a19ba4f7d1"},{"key":"98:1:11","position":11,"arabic":"تَأْتِيَهُمُ","kind":"word","gloss":"(there) comes to them","transliteration":"tatiyahumu","lemma":"أَتَى","root":"اتي","entryId":"l-491a40b1f8d047fe"},{"key":"98:1:12","position":12,"arabic":"ٱلْبَيِّنَةُ","kind":"word","gloss":"the clear evidence","transliteration":"l-bayinatu","lemma":"بَيِّنَة","root":"بين","entryId":"l-3f748dc7c64d16bd"},{"key":"98:1:13","position":13,"arabic":"١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"98:2","translation":"A Messenger (Muhammad صلى الله عليه وسلم) from Allâh, reciting (the Qur’ân) purified pages [purified from Al-Bâtil (falsehood)].","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"98:2:1","position":1,"arabic":"رَسُولٌۭ","kind":"word","gloss":"A Messenger","transliteration":"rasūlun","lemma":"رَسُول","root":"رسل","entryId":"l-165e008d0f146d23"},{"key":"98:2:2","position":2,"arabic":"مِّنَ","kind":"word","gloss":"from","transliteration":"mina","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"98:2:3","position":3,"arabic":"ٱللَّهِ","kind":"word","gloss":"Allah","transliteration":"l-lahi","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"98:2:4","position":4,"arabic":"يَتْلُوا۟","kind":"word","gloss":"reciting","transliteration":"yatlū","lemma":"تَلَىٰ","root":"تلو","entryId":"l-a044b106004ffdee"},{"key":"98:2:5","position":5,"arabic":"صُحُفًۭا","kind":"word","gloss":"pages","transliteration":"ṣuḥufan","lemma":"صُحُف","root":"صحف","entryId":null},{"key":"98:2:6","position":6,"arabic":"مُّطَهَّرَةًۭ","kind":"word","gloss":"purified","transliteration":"muṭahharatan","lemma":"مُّطَهَّرَة","root":"طهر","entryId":null},{"key":"98:2:7","position":7,"arabic":"٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"98:3","translation":"Wherein are correct and straight laws from Allâh.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"98:3:1","position":1,"arabic":"فِيهَا","kind":"word","gloss":"Wherein","transliteration":"fīhā","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"98:3:2","position":2,"arabic":"كُتُبٌۭ","kind":"word","gloss":"(are) writings","transliteration":"kutubun","lemma":"كِتَٰب","root":"كتب","entryId":"l-a68c915be321aa35"},{"key":"98:3:3","position":3,"arabic":"قَيِّمَةٌۭ","kind":"word","gloss":"correct","transliteration":"qayyimatun","lemma":"قَيِّمَة","root":"قوم","entryId":null},{"key":"98:3:4","position":4,"arabic":"٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"98:4","translation":"And the people of the Scripture (Jews and Christians) differed not until after there came to them clear evidence (i.e. Prophet Muhammad صلى الله عليه وسلم and whatever was revealed to him).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"98:4:1","position":1,"arabic":"وَمَا","kind":"word","gloss":"And not","transliteration":"wamā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"98:4:2","position":2,"arabic":"تَفَرَّقَ","kind":"word","gloss":"became divided","transliteration":"tafarraqa","lemma":"تَفَرَّقَ","root":"فرق","entryId":null},{"key":"98:4:3","position":3,"arabic":"ٱلَّذِينَ","kind":"word","gloss":"those who","transliteration":"alladhīna","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"98:4:4","position":4,"arabic":"أُوتُوا۟","kind":"word","gloss":"were given","transliteration":"ūtū","lemma":"آتَى","root":"اتي","entryId":"l-45664741cd653ab4"},{"key":"98:4:5","position":5,"arabic":"ٱلْكِتَـٰبَ","kind":"word","gloss":"the Book","transliteration":"l-kitāba","lemma":"كِتَٰب","root":"كتب","entryId":"l-a68c915be321aa35"},{"key":"98:4:6","position":6,"arabic":"إِلَّا","kind":"word","gloss":"until","transliteration":"illā","lemma":"إِلَّا","root":null,"entryId":"l-250ca4d5b58814dd"},{"key":"98:4:7","position":7,"arabic":"مِنۢ","kind":"word","gloss":"from","transliteration":"min","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"98:4:8","position":8,"arabic":"بَعْدِ","kind":"word","gloss":"after","transliteration":"baʿdi","lemma":"بَعْد","root":"بعد","entryId":"l-8c0dc1d5dbc2a420"},{"key":"98:4:9","position":9,"arabic":"مَا","kind":"word","gloss":"what","transliteration":"mā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"98:4:10","position":10,"arabic":"جَآءَتْهُمُ","kind":"word","gloss":"came (to) them","transliteration":"jāathumu","lemma":"جَآءَ","root":"جيا","entryId":"l-1abf61bfcb8fdd4c"},{"key":"98:4:11","position":11,"arabic":"ٱلْبَيِّنَةُ","kind":"word","gloss":"(of) the clear evidence","transliteration":"l-bayinatu","lemma":"بَيِّنَة","root":"بين","entryId":"l-3f748dc7c64d16bd"},{"key":"98:4:12","position":12,"arabic":"٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"98:5","translation":"And they were commanded not, but that they should worship Allâh, and worship none but Him Alone (abstaining from ascribing partners to Him), and perform As-Salât (Iqâmat-as-Salât) and give Zakât, and that is the right religion.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"98:5:1","position":1,"arabic":"وَمَآ","kind":"word","gloss":"And not","transliteration":"wamā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"98:5:2","position":2,"arabic":"أُمِرُوٓا۟","kind":"word","gloss":"they were commanded","transliteration":"umirū","lemma":"أَمَرَ","root":"امر","entryId":"l-f3632d620dab7b3f"},{"key":"98:5:3","position":3,"arabic":"إِلَّا","kind":"word","gloss":"except","transliteration":"illā","lemma":"إِلَّا","root":null,"entryId":"l-250ca4d5b58814dd"},{"key":"98:5:4","position":4,"arabic":"لِيَعْبُدُوا۟","kind":"word","gloss":"to worship","transliteration":"liyaʿbudū","lemma":"عَبَدَ","root":"عبد","entryId":"l-0907d1b241c8dd03"},{"key":"98:5:5","position":5,"arabic":"ٱللَّهَ","kind":"word","gloss":"Allah","transliteration":"l-laha","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"98:5:6","position":6,"arabic":"مُخْلِصِينَ","kind":"word","gloss":"(being) sincere","transliteration":"mukh'liṣīna","lemma":"مُخْلِص","root":"خلص","entryId":null},{"key":"98:5:7","position":7,"arabic":"لَهُ","kind":"word","gloss":"to Him","transliteration":"lahu","lemma":null,"root":null,"entryId":null},{"key":"98:5:8","position":8,"arabic":"ٱلدِّينَ","kind":"word","gloss":"(in) the religion","transliteration":"l-dīna","lemma":"دِين","root":"دين","entryId":"l-869ef1d12b24f52a"},{"key":"98:5:9","position":9,"arabic":"حُنَفَآءَ","kind":"word","gloss":"upright","transliteration":"ḥunafāa","lemma":"حَنِيف","root":"حنف","entryId":null},{"key":"98:5:10","position":10,"arabic":"وَيُقِيمُوا۟","kind":"word","gloss":"and to establish","transliteration":"wayuqīmū","lemma":"أَقَامَ","root":"قوم","entryId":"l-88c394825790eb5d"},{"key":"98:5:11","position":11,"arabic":"ٱلصَّلَوٰةَ","kind":"word","gloss":"the prayer","transliteration":"l-ṣalata","lemma":"صَلَوٰة","root":"صلو","entryId":"l-7ecacdc275cdb0a8"},{"key":"98:5:12","position":12,"arabic":"وَيُؤْتُوا۟","kind":"word","gloss":"and to give","transliteration":"wayu'tū","lemma":"آتَى","root":"اتي","entryId":"l-45664741cd653ab4"},{"key":"98:5:13","position":13,"arabic":"ٱلزَّكَوٰةَ ۚ","kind":"word","gloss":"the zakah","transliteration":"l-zakata","lemma":"زَكَوٰة","root":"زكو","entryId":null},{"key":"98:5:14","position":14,"arabic":"وَذَٰلِكَ","kind":"word","gloss":"And that","transliteration":"wadhālika","lemma":"ذَٰلِك","root":null,"entryId":"l-096a9ad382db7640"},{"key":"98:5:15","position":15,"arabic":"دِينُ","kind":"word","gloss":"(is the) religion","transliteration":"dīnu","lemma":"دِين","root":"دين","entryId":"l-869ef1d12b24f52a"},{"key":"98:5:16","position":16,"arabic":"ٱلْقَيِّمَةِ","kind":"word","gloss":"the correct","transliteration":"l-qayimati","lemma":"قَيِّمَة","root":"قوم","entryId":null},{"key":"98:5:17","position":17,"arabic":"٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"98:6","translation":"Verily, those who disbelieve (in the religion of Islâm, the Qur’ân and Prophet Muhammad صلى الله عليه وسلم) from among the people of the Scripture (Jews and Christians) and Al-Mushrikûn will abide in the Fire of Hell. They are the worst of creatures.","translationSource":"qul-301-hilali-khan","notes":[{"text":"It is obligatory to have Belief in the Messengership of the Prophet (Muhammad صلى الله عليه وسلم). Narrated Abu Hurairah رضي الله عنه: Allâh’s Messenger صلى الله عليه وسلم said: \"By Him (Allâh) in Whose Hand Muhammad’s soul is, there is none from amongst the Jews and Christians (of these present nations) who hears about me and then dies without believing in the Message with which I have been sent (i.e. Islâmic Monotheism) but he will be from the dwellers of the (Hell) Fire.\" (Sahih Muslim, the Book of Faith, Vol.1, Chapter No.240). See also (V.3:85) and (V.3:116).","ref":null}],"tokens":[{"key":"98:6:1","position":1,"arabic":"إِنَّ","kind":"word","gloss":"Indeed","transliteration":"inna","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"98:6:2","position":2,"arabic":"ٱلَّذِينَ","kind":"word","gloss":"those who","transliteration":"alladhīna","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"98:6:3","position":3,"arabic":"كَفَرُوا۟","kind":"word","gloss":"disbelieve","transliteration":"kafarū","lemma":"كَفَرَ","root":"كفر","entryId":"l-f6f8e55e4806177f"},{"key":"98:6:4","position":4,"arabic":"مِنْ","kind":"word","gloss":"from","transliteration":"min","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"98:6:5","position":5,"arabic":"أَهْلِ","kind":"word","gloss":"(the) People","transliteration":"ahli","lemma":"أَهْل","root":"اهل","entryId":"l-5fd11f4d420d23ca"},{"key":"98:6:6","position":6,"arabic":"ٱلْكِتَـٰبِ","kind":"word","gloss":"(of) the Book","transliteration":"l-kitābi","lemma":"كِتَٰب","root":"كتب","entryId":"l-a68c915be321aa35"},{"key":"98:6:7","position":7,"arabic":"وَٱلْمُشْرِكِينَ","kind":"word","gloss":"and the polytheists","transliteration":"wal-mush'rikīna","lemma":"مُشْرِك","root":"شرك","entryId":"l-f1407d5b914fb36c"},{"key":"98:6:8","position":8,"arabic":"فِى","kind":"word","gloss":"(will be) in","transliteration":"fī","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"98:6:9","position":9,"arabic":"نَارِ","kind":"word","gloss":"(the) Fire","transliteration":"nāri","lemma":"نَار","root":"نور","entryId":"l-1f4c1e0172701e6e"},{"key":"98:6:10","position":10,"arabic":"جَهَنَّمَ","kind":"word","gloss":"(of) Hell","transliteration":"jahannama","lemma":"جَهَنَّم","root":null,"entryId":"l-224d7d1540dd0042"},{"key":"98:6:11","position":11,"arabic":"خَـٰلِدِينَ","kind":"word","gloss":"abiding eternally","transliteration":"khālidīna","lemma":"خَٰلِد","root":"خلد","entryId":"l-54cdf1073b2f0120"},{"key":"98:6:12","position":12,"arabic":"فِيهَآ ۚ","kind":"word","gloss":"therein","transliteration":"fīhā","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"98:6:13","position":13,"arabic":"أُو۟لَـٰٓئِكَ","kind":"word","gloss":"Those","transliteration":"ulāika","lemma":"أُولَٰٓئِك","root":null,"entryId":"l-9b2e48d460410286"},{"key":"98:6:14","position":14,"arabic":"هُمْ","kind":"word","gloss":"they","transliteration":"hum","lemma":null,"root":null,"entryId":null},{"key":"98:6:15","position":15,"arabic":"شَرُّ","kind":"word","gloss":"(are the) worst","transliteration":"sharru","lemma":"شَرّ","root":"شرر","entryId":null},{"key":"98:6:16","position":16,"arabic":"ٱلْبَرِيَّةِ","kind":"word","gloss":"(of) the creatures","transliteration":"l-bariyati","lemma":"بَرِيَّة","root":"برا","entryId":null},{"key":"98:6:17","position":17,"arabic":"٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"98:7","translation":"Verily, those who believe [in the Oneness of Allâh, and in His Messenger Muhammad صلى الله عليه وسلم) including all obligations ordered by Islâm] and do righteous good deeds, they are the best of creatures.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"98:7:1","position":1,"arabic":"إِنَّ","kind":"word","gloss":"Indeed","transliteration":"inna","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"98:7:2","position":2,"arabic":"ٱلَّذِينَ","kind":"word","gloss":"those who","transliteration":"alladhīna","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"98:7:3","position":3,"arabic":"ءَامَنُوا۟","kind":"word","gloss":"believe","transliteration":"āmanū","lemma":"ءَامَنَ","root":"امن","entryId":"l-f6ec3a6dc0f76aa6"},{"key":"98:7:4","position":4,"arabic":"وَعَمِلُوا۟","kind":"word","gloss":"and do","transliteration":"waʿamilū","lemma":"عَمِلَ","root":"عمل","entryId":"l-4fa22225cead4d92"},{"key":"98:7:5","position":5,"arabic":"ٱلصَّـٰلِحَـٰتِ","kind":"word","gloss":"righteous deeds","transliteration":"l-ṣāliḥāti","lemma":"صَّٰلِحَٰت","root":"صلح","entryId":"l-0248bd763dd1fd03"},{"key":"98:7:6","position":6,"arabic":"أُو۟لَـٰٓئِكَ","kind":"word","gloss":"those","transliteration":"ulāika","lemma":"أُولَٰٓئِك","root":null,"entryId":"l-9b2e48d460410286"},{"key":"98:7:7","position":7,"arabic":"هُمْ","kind":"word","gloss":"they","transliteration":"hum","lemma":null,"root":null,"entryId":null},{"key":"98:7:8","position":8,"arabic":"خَيْرُ","kind":"word","gloss":"(are the) best","transliteration":"khayru","lemma":"خَيْر","root":"خير","entryId":"l-81db6cd6a46bd56c"},{"key":"98:7:9","position":9,"arabic":"ٱلْبَرِيَّةِ","kind":"word","gloss":"(of) the creatures","transliteration":"l-bariyati","lemma":"بَرِيَّة","root":"برا","entryId":null},{"key":"98:7:10","position":10,"arabic":"٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"98:8","translation":"Their reward with their Lord is ‘Adn (Eden) Paradise (Gardens of Eternity), underneath which rivers flow. They will abide therein forever, Allâh will be pleased with them, and they with Him. That is for him who fears his Lord.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"98:8:1","position":1,"arabic":"جَزَآؤُهُمْ","kind":"word","gloss":"Their reward","transliteration":"jazāuhum","lemma":"جَزَآء","root":"جزي","entryId":"l-351280652e0741fc"},{"key":"98:8:2","position":2,"arabic":"عِندَ","kind":"word","gloss":"(is) with","transliteration":"ʿinda","lemma":"عِند","root":"عند","entryId":"l-30b61508aaa6b3fa"},{"key":"98:8:3","position":3,"arabic":"رَبِّهِمْ","kind":"word","gloss":"their Lord","transliteration":"rabbihim","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"98:8:4","position":4,"arabic":"جَنَّـٰتُ","kind":"word","gloss":"Gardens","transliteration":"jannātu","lemma":"جَنَّة","root":"جنن","entryId":"l-9f22ab6b78dd8a22"},{"key":"98:8:5","position":5,"arabic":"عَدْنٍۢ","kind":"word","gloss":"(of) Eternity","transliteration":"ʿadnin","lemma":"عَدْن","root":null,"entryId":null},{"key":"98:8:6","position":6,"arabic":"تَجْرِى","kind":"word","gloss":"flow","transliteration":"tajrī","lemma":"جَرَيْ","root":"جري","entryId":"l-b26851980b8e4ff2"},{"key":"98:8:7","position":7,"arabic":"مِن","kind":"word","gloss":"from","transliteration":"min","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"98:8:8","position":8,"arabic":"تَحْتِهَا","kind":"word","gloss":"underneath them","transliteration":"taḥtihā","lemma":"تَحْت","root":"تحت","entryId":"l-fdff76d28b83bc2d"},{"key":"98:8:9","position":9,"arabic":"ٱلْأَنْهَـٰرُ","kind":"word","gloss":"the rivers","transliteration":"l-anhāru","lemma":"نَهَر","root":"نهر","entryId":"l-71991cab21ea831c"},{"key":"98:8:10","position":10,"arabic":"خَـٰلِدِينَ","kind":"word","gloss":"will abide","transliteration":"khālidīna","lemma":"خَٰلِد","root":"خلد","entryId":"l-54cdf1073b2f0120"},{"key":"98:8:11","position":11,"arabic":"فِيهَآ","kind":"word","gloss":"therein","transliteration":"fīhā","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"98:8:12","position":12,"arabic":"أَبَدًۭا ۖ","kind":"word","gloss":"forever","transliteration":"abadan","lemma":"أَبَدًا","root":"ابد","entryId":null},{"key":"98:8:13","position":13,"arabic":"رَّضِىَ","kind":"word","gloss":"(will be) pleased","transliteration":"raḍiya","lemma":null,"root":"رضو","entryId":null},{"key":"98:8:14","position":14,"arabic":"ٱللَّهُ","kind":"word","gloss":"Allah","transliteration":"l-lahu","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"98:8:15","position":15,"arabic":"عَنْهُمْ","kind":"word","gloss":"with them","transliteration":"ʿanhum","lemma":"عَن","root":null,"entryId":"l-f1109a78c8548754"},{"key":"98:8:16","position":16,"arabic":"وَرَضُوا۟","kind":"word","gloss":"and they (will be) pleased","transliteration":"waraḍū","lemma":null,"root":"رضو","entryId":null},{"key":"98:8:17","position":17,"arabic":"عَنْهُ ۚ","kind":"word","gloss":"with Him","transliteration":"ʿanhu","lemma":"عَن","root":null,"entryId":"l-f1109a78c8548754"},{"key":"98:8:18","position":18,"arabic":"ذَٰلِكَ","kind":"word","gloss":"That","transliteration":"dhālika","lemma":"ذَٰلِك","root":null,"entryId":"l-096a9ad382db7640"},{"key":"98:8:19","position":19,"arabic":"لِمَنْ","kind":"word","gloss":"(is) for whoever","transliteration":"liman","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"98:8:20","position":20,"arabic":"خَشِىَ","kind":"word","gloss":"feared","transliteration":"khashiya","lemma":"خَشِىَ","root":"خشي","entryId":null},{"key":"98:8:21","position":21,"arabic":"رَبَّهُۥ","kind":"word","gloss":"his Lord","transliteration":"rabbahu","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"98:8:22","position":22,"arabic":"٨","kind":"