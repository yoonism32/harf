[{"ref":"92:1","translation":"By the night as it envelops.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"92:1:1","position":1,"arabic":"وَٱلَّيْلِ","kind":"word","gloss":"By the night","transliteration":"wa-al-layli","lemma":"لَيْل","root":"ليل","entryId":"l-d2e604e516a58959"},{"key":"92:1:2","position":2,"arabic":"إِذَا","kind":"word","gloss":"when","transliteration":"idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"92:1:3","position":3,"arabic":"يَغْشَىٰ","kind":"word","gloss":"it covers","transliteration":"yaghshā","lemma":"غَشِيَ","root":"غشو","entryId":null},{"key":"92:1:4","position":4,"arabic":"١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"92:2","translation":"By the day as it appears in brightness.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"92:2:1","position":1,"arabic":"وَٱلنَّهَارِ","kind":"word","gloss":"And the day","transliteration":"wal-nahāri","lemma":"نَهَار","root":"نهر","entryId":"l-986a4c42272dc519"},{"key":"92:2:2","position":2,"arabic":"إِذَا","kind":"word","gloss":"when","transliteration":"idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"92:2:3","position":3,"arabic":"تَجَلَّىٰ","kind":"word","gloss":"it shines in brightness","transliteration":"tajallā","lemma":"تَجَلَّىٰ","root":"جلو","entryId":null},{"key":"92:2:4","position":4,"arabic":"٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"92:3","translation":"By Him Who created male and female.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"92:3:1","position":1,"arabic":"وَمَا","kind":"word","gloss":"And He Who","transliteration":"wamā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"92:3:2","position":2,"arabic":"خَلَقَ","kind":"word","gloss":"created","transliteration":"khalaqa","lemma":"خَلَقَ","root":"خلق","entryId":"l-9e7414ba00a88ddc"},{"key":"92:3:3","position":3,"arabic":"ٱلذَّكَرَ","kind":"word","gloss":"the male","transliteration":"l-dhakara","lemma":"ذَكَر","root":"ذكر","entryId":null},{"key":"92:3:4","position":4,"arabic":"وَٱلْأُنثَىٰٓ","kind":"word","gloss":"and the female","transliteration":"wal-unthā","lemma":"أُنثَىٰ","root":"انث","entryId":null},{"key":"92:3:5","position":5,"arabic":"٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"92:4","translation":"Certainly, your efforts and deeds are diverse (different in aims and purposes);","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"92:4:1","position":1,"arabic":"إِنَّ","kind":"word","gloss":"Indeed","transliteration":"inna","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"92:4:2","position":2,"arabic":"سَعْيَكُمْ","kind":"word","gloss":"your efforts","transliteration":"saʿyakum","lemma":"سَعْي","root":"سعي","entryId":null},{"key":"92:4:3","position":3,"arabic":"لَشَتَّىٰ","kind":"word","gloss":"(are) surely diverse","transliteration":"lashattā","lemma":"شَتَّىٰ","root":"شتت","entryId":null},{"key":"92:4:4","position":4,"arabic":"٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"92:5","translation":"As for him who gives (in charity) and keeps his duty to Allâh and fears Him,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"92:5:1","position":1,"arabic":"فَأَمَّا","kind":"word","gloss":"Then as for","transliteration":"fa-ammā","lemma":"أَمَّا","root":null,"entryId":"l-6c43b34cf75dec4b"},{"key":"92:5:2","position":2,"arabic":"مَنْ","kind":"word","gloss":"(him) who","transliteration":"man","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"92:5:3","position":3,"arabic":"أَعْطَىٰ","kind":"word","gloss":"gives","transliteration":"aʿṭā","lemma":"أَعْطَىٰ","root":"عطو","entryId":null},{"key":"92:5:4","position":4,"arabic":"وَٱتَّقَىٰ","kind":"word","gloss":"and fears","transliteration":"wa-ittaqā","lemma":"اتَّقَىٰ","root":"وقي","entryId":"l-f72641a6cc6e53f2"},{"key":"92:5:5","position":5,"arabic":"٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"92:6","translation":"And believes in Al-Husnâ.","translationSource":"qul-301-hilali-khan","notes":[{"text":"(A) Al-Husnâ: The Best (i.e. either Lâ ilâha illallâh none has the right to be worshipped but Allâh) or a reward from Allâh (i.e. Allâh will compensate him for what he will spend in Allâh’s Way or bless him with Paradise). (B) See the footnote of (V.4:37).","ref":{"surah":4,"ayah":37}}],"tokens":[{"key":"92:6:1","position":1,"arabic":"وَصَدَّقَ","kind":"word","gloss":"And believes","transliteration":"waṣaddaqa","lemma":"صَدَّقَ","root":"صدق","entryId":null},{"key":"92:6:2","position":2,"arabic":"بِٱلْحُسْنَىٰ","kind":"word","gloss":"in the best","transliteration":"bil-ḥus'nā","lemma":"حُسْنَىٰ","root":"حسن","entryId":null},{"key":"92:6:3","position":3,"arabic":"٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"92:7","translation":"We will make smooth for him the path of ease (goodness).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"92:7:1","position":1,"arabic":"فَسَنُيَسِّرُهُۥ","kind":"word","gloss":"Then We will ease him","transliteration":"fasanuyassiruhu","lemma":"يَسَّرَ","root":"يسر","entryId":null},{"key":"92:7:2","position":2,"arabic":"لِلْيُسْرَىٰ","kind":"word","gloss":"towards [the] ease","transliteration":"lil'yus'rā","lemma":"يُسْرَىٰ","root":"يسر","entryId":null},{"key":"92:7:3","position":3,"arabic":"٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"92:8","translation":"But he who is greedy miser and thinks himself self-sufficient.","translationSource":"qul-301-hilali-khan","notes":[{"text":"Narrated ‘Alî رضي الله عنه : We were in the company of the Prophet صلى الله عليه وسلم and he said, \"There is none among you but has his place written for him, either in Paradise or in the Hell-fire.\" We said, \"O Allâh’s Messenger! Shall we depend (on this fact and give up work)?\" He replied, \"No! Carry on doing good deeds, for everybody will find easy (to do) such deeds as will lead him to his destined place.\" Then the Prophet صلى الله عليه وسلم recited: \"As for him who gives (in charity) and keeps his duty to Allâh and fears Him, and believes in Al-Husnâ. We will make smooth for him the path of ease...\" (V.92: 5-10) (Sahih Al-Bukhari, Vol.6, Hadith No.472).","ref":null}],"tokens":[{"key":"92:8:1","position":1,"arabic":"وَأَمَّا","kind":"word","gloss":"But as for","transliteration":"wa-ammā","lemma":"أَمَّا","root":null,"entryId":"l-6c43b34cf75dec4b"},{"key":"92:8:2","position":2,"arabic":"مَنۢ","kind":"word","gloss":"(him) who","transliteration":"man","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"92:8:3","position":3,"arabic":"بَخِلَ","kind":"word","gloss":"withholds","transliteration":"bakhila","lemma":"بَخِلَ","root":"بخل","entryId":null},{"key":"92:8:4","position":4,"arabic":"وَٱسْتَغْنَىٰ","kind":"word","gloss":"and considers himself free from need","transliteration":"wa-is'taghnā","lemma":"اسْتَغْنَىٰ","root":"غني","entryId":null},{"key":"92:8:5","position":5,"arabic":"٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"92:9","translation":"And belies Al-Husnâ (See the footnote of the Verse No.6)","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"92:9:1","position":1,"arabic":"وَكَذَّبَ","kind":"word","gloss":"And denies","transliteration":"wakadhaba","lemma":"كَذَّبَ","root":"كذب","entryId":"l-db86b0654d661fb2"},{"key":"92:9:2","position":2,"arabic":"بِٱلْحُسْنَىٰ","kind":"word","gloss":"the best","transliteration":"bil-ḥus'nā","lemma":"حُسْنَىٰ","root":"حسن","entryId":null},{"key":"92:9:3","position":3,"arabic":"٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"92:10","translation":"We will make smooth for him the path for evil.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"92:10:1","position":1,"arabic":"فَسَنُيَسِّرُهُۥ","kind":"word","gloss":"Then We will ease him","transliteration":"fasanuyassiruhu","lemma":"يَسَّرَ","root":"يسر","entryId":null},{"key":"92:10:2","position":2,"arabic":"لِلْعُسْرَىٰ","kind":"word","gloss":"towards [the] difficulty","transliteration":"lil'ʿus'rā","lemma":"عُسْرَىٰ","root":"عسر","entryId":null},{"key":"92:10:3","position":3,"arabic":"١٠","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"92:11","translation":"And what will his wealth avail him when he goes down (in destruction)?.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"92:11:1","position":1,"arabic":"وَمَا","kind":"word","gloss":"And not","transliteration":"wamā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"92:11:2","position":2,"arabic":"يُغْنِى","kind":"word","gloss":"will avail","transliteration":"yugh'nī","lemma":"أَغْنَتْ","root":"غني","entryId":null},{"key":"92:11:3","position":3,"arabic":"عَنْهُ","kind":"word","gloss":"him","transliteration":"ʿanhu","lemma":"عَن","root":null,"entryId":"l-f1109a78c8548754"},{"key":"92:11:4","position":4,"arabic":"مَالُهُۥٓ","kind":"word","gloss":"his wealth","transliteration":"māluhu","lemma":"مَال","root":"مول","entryId":"l-ae66a2452b005081"},{"key":"92:11:5","position":5,"arabic":"إِذَا","kind":"word","gloss":"when","transliteration":"idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"92:11:6","position":6,"arabic":"تَرَدَّىٰٓ","kind":"word","gloss":"he falls","transliteration":"taraddā","lemma":"تَرَدَّىٰٓ","root":"ردي","entryId":null},{"key":"92:11:7","position":7,"arabic":"١١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"92:12","translation":"Truly! On Us is (to give) guidance.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"92:12:1","position":1,"arabic":"إِنَّ","kind":"word","gloss":"Indeed","transliteration":"inna","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"92:12:2","position":2,"arabic":"عَلَيْنَا","kind":"word","gloss":"upon Us","transliteration":"ʿalaynā","lemma":"عَلَىٰ","root":null,"entryId":"l-08dd9283adb70e54"},{"key":"92:12:3","position":3,"arabic":"لَلْهُدَىٰ","kind":"word","gloss":"(is) the guidance","transliteration":"lalhudā","lemma":"هُدًى","root":"هدي","entryId":"l-5983c95b20790bb0"},{"key":"92:12:4","position":4,"arabic":"١٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"92:13","translation":"And truly, unto Us (belong) the last (Hereafter) and the first (this world).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"92:13:1","position":1,"arabic":"وَإِنَّ","kind":"word","gloss":"And indeed","transliteration":"wa-inna","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"92:13:2","position":2,"arabic":"لَنَا","kind":"word","gloss":"for Us","transliteration":"lanā","lemma":null,"root":null,"entryId":null},{"key":"92:13:3","position":3,"arabic":"لَلْـَٔاخِرَةَ","kind":"word","gloss":"(is) the Hereafter","transliteration":"lalākhirata","lemma":"آخِر","root":"اخر","entryId":"l-24868f08d279a095"},{"key":"92:13:4","position":4,"arabic":"وَٱلْأُولَىٰ","kind":"word","gloss":"and the first (life)","transliteration":"wal-ūlā","lemma":"أَوَّل","root":"اول","entryId":"l-ecdf865520009f7c"},{"key":"92:13:5","position":5,"arabic":"١٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"92:14","translation":"Therefore I have warned you of a blazing Fire (Hell).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"92:14:1","position":1,"arabic":"فَأَنذَرْتُكُمْ","kind":"word","gloss":"So I warn you","transliteration":"fa-andhartukum","lemma":"أَنذَرَ","root":"نذر","entryId":"l-a23c49777f73356e"},{"key":"92:14:2","position":2,"arabic":"نَارًۭا","kind":"word","gloss":"(of) a Fire","transliteration":"nāran","lemma":"نَار","root":"نور","entryId":"l-1f4c1e0172701e6e"},{"key":"92:14:3","position":3,"arabic":"تَلَظَّىٰ","kind":"word","gloss":"blazing","transliteration":"talaẓẓā","lemma":"تَلَظَّىٰ","root":"لظي","entryId":null},{"key":"92:14:4","position":4,"arabic":"١٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"92:15","translation":"None shall enter it save the most wretched.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"92:15:1","position":1,"arabic":"لَا","kind":"word","gloss":"Not","transliteration":"lā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"92:15:2","position":2,"arabic":"يَصْلَىٰهَآ","kind":"word","gloss":"will burn (in) it","transliteration":"yaṣlāhā","lemma":"يَصْلَى","root":"صلي","entryId":null},{"key":"92:15:3","position":3,"arabic":"إِلَّا","kind":"word","gloss":"except","transliteration":"illā","lemma":"إِلَّا","root":null,"entryId":"l-250ca4d5b58814dd"},{"key":"92:15:4","position":4,"arabic":"ٱلْأَشْقَى","kind":"word","gloss":"the most wretched","transliteration":"l-ashqā","lemma":"أَشْقَى","root":"شقو","entryId":null},{"key":"92:15:5","position":5,"arabic":"١٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"92:16","translation":"Who denies and turns away.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"92:16:1","position":1,"arabic":"ٱلَّذِى","kind":"word","gloss":"The one who","transliteration":"alladhī","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"92:16:2","position":2,"arabic":"كَذَّبَ","kind":"word","gloss":"denied","transliteration":"kadhaba","lemma":"كَذَّبَ","root":"كذب","entryId":"l-db86b0654d661fb2"},{"key":"92:16:3","position":3,"arabic":"وَتَوَلَّىٰ","kind":"word","gloss":"and turned away","transliteration":"watawallā","lemma":"تَوَلَّىٰ","root":"ولي","entryId":"l-f32564c74acc4226"},{"key":"92:16:4","position":4,"arabic":"١٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"92:17","translation":"And Al-Muttaqûn (the pious - See V.2:2) will be far removed from it (Hell).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"92:17:1","position":1,"arabic":"وَسَيُجَنَّبُهَا","kind":"word","gloss":"But will be removed from it","transliteration":"wasayujannabuhā","lemma":"يُجَنَّبُ","root":"جنب","entryId":null},{"key":"92:17:2","position":2,"arabic":"ٱلْأَتْقَى","kind":"word","gloss":"the righteous","transliteration":"l-atqā","lemma":"أَتْقَى","root":"وقي","entryId":null},{"key":"92:17:3","position":3,"arabic":"١٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"92:18","translation":"He who spends his wealth for increase in self-purification,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"92:18:1","position":1,"arabic":"ٱلَّذِى","kind":"word","gloss":"The one who","transliteration":"alladhī","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"92:18:2","position":2,"arabic":"يُؤْتِى","kind":"word","gloss":"gives","transliteration":"yu'tī","lemma":"آتَى","root":"اتي","entryId":"l-45664741cd653ab4"},{"key":"92:18:3","position":3,"arabic":"مَالَهُۥ","kind":"word","gloss":"his wealth","transliteration":"mālahu","lemma":"مَال","root":"مول","entryId":"l-ae66a2452b005081"},{"key":"92:18:4","position":4,"arabic":"يَتَزَكَّىٰ","kind":"word","gloss":"(to) purify himself","transliteration":"yatazakkā","lemma":"تَزَكَّىٰ","root":"زكو","entryId":null},{"key":"92:18:5","position":5,"arabic":"١٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"92:19","translation":"And who has (in mind) no favour from anyone to be paid back,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"92:19:1","position":1,"arabic":"وَمَا","kind":"word","gloss":"And not","transliteration":"wamā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"92:19:2","position":2,"arabic":"لِأَحَدٍ","kind":"word","gloss":"for anyone","transliteration":"li-aḥadin","lemma":"أَحَد","root":"احد","entryId":"l-4e0bd3447fb54c57"},{"key":"92:19:3","position":3,"arabic":"عِندَهُۥ","kind":"word","gloss":"with him","transliteration":"ʿindahu","lemma":"عِند","root":"عند","entryId":"l-30b61508aaa6b3fa"},{"key":"92:19:4","position":4,"arabic":"مِن","kind":"word","gloss":"any","transliteration":"min","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"92:19:5","position":5,"arabic":"نِّعْمَةٍۢ","kind":"word","gloss":"favor","transliteration":"niʿ'matin","lemma":"نِعْمَة","root":"نعم","entryId":"l-77a5904acef6acef"},{"key":"92:19:6","position":6,"arabic":"تُجْزَىٰٓ","kind":"word","gloss":"to be recompensed","transliteration":"tuj'zā","lemma":"جَزَىٰ","root":"جزي","entryId":"l-73cab29f9798ecaf"},{"key":"92:19:7","position":7,"arabic":"١٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"92:20","translation":"Except to seek the Countenance of his Lord, the Most High.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"92:20:1","position":1,"arabic":"إِلَّا","kind":"word","gloss":"Except","transliteration":"illā","lemma":"إِلَّا","root":null,"entryId":"l-250ca4d5b58814dd"},{"key":"92:20:2","position":2,"arabic":"ٱبْتِغَآءَ","kind":"word","gloss":"seeking","transliteration":"ib'tighāa","lemma":"ابْتِغَآء","root":"بغي","entryId":null},{"key":"92:20:3","position":3,"arabic":"وَجْهِ","kind":"word","gloss":"(the) Countenance","transliteration":"wajhi","lemma":"وَجْه","root":"وجه","entryId":"l-a02f5e824d673730"},{"key":"92:20:4","position":4,"arabic":"رَبِّهِ","kind":"word","gloss":"(of) his Lord","transliteration":"rabbihi","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"92:20:5","position":5,"arabic":"ٱلْأَعْلَىٰ","kind":"word","gloss":"the Most High","transliteration":"l-aʿlā","lemma":"أَعْلَىٰ","root":"علو","entryId":null},{"key":"92:20:6","position":6,"arabic":"٢٠","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"92:21","translation":"He surely will be pleased (when he enters Paradise).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"92:21:1","position":1,"arabic":"وَلَسَوْفَ","kind":"word","gloss":"And soon, surely","transliteration":"walasawfa","lemma":"سَوْف","root":null,"entryId":"l-0e28987d8e8dbefa"},{"key":"92:21:2","position":2,"arabic":"يَرْضَىٰ","kind":"word","gloss":"he will be pleased","transliteration":"yarḍā","lemma":"رَّضِىَ","root":"رضو","entryId":null},{"key":"92:21:3","position":3,"arabic":"٢١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]}]