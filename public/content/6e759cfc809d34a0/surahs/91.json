[{"ref":"91:1","translation":"By the sun and its brightness.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"91:1:1","position":1,"arabic":"وَٱلشَّمْسِ","kind":"word","gloss":"By the sun","transliteration":"wal-shamsi","lemma":"شَمْس","root":"شمس","entryId":null},{"key":"91:1:2","position":2,"arabic":"وَضُحَىٰهَا","kind":"word","gloss":"and its brightness","transliteration":"waḍuḥāhā","lemma":"ضُحًى","root":"ضحو","entryId":null},{"key":"91:1:3","position":3,"arabic":"١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"91:2","translation":"By the moon as it follows it (the sun).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"91:2:1","position":1,"arabic":"وَٱلْقَمَرِ","kind":"word","gloss":"And the moon","transliteration":"wal-qamari","lemma":"قَمَر","root":"قمر","entryId":null},{"key":"91:2:2","position":2,"arabic":"إِذَا","kind":"word","gloss":"when","transliteration":"idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"91:2:3","position":3,"arabic":"تَلَىٰهَا","kind":"word","gloss":"it follows it","transliteration":"talāhā","lemma":"تَلَىٰ","root":"تلو","entryId":"l-a044b106004ffdee"},{"key":"91:2:4","position":4,"arabic":"٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"91:3","translation":"By the day as it shows up (the sun’s) brightness.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"91:3:1","position":1,"arabic":"وَٱلنَّهَارِ","kind":"word","gloss":"And the day","transliteration":"wal-nahāri","lemma":"نَهَار","root":"نهر","entryId":"l-986a4c42272dc519"},{"key":"91:3:2","position":2,"arabic":"إِذَا","kind":"word","gloss":"when","transliteration":"idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"91:3:3","position":3,"arabic":"جَلَّىٰهَا","kind":"word","gloss":"it displays it","transliteration":"jallāhā","lemma":"جَلَّىٰ","root":"جلو","entryId":null},{"key":"91:3:4","position":4,"arabic":"٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"91:4","translation":"By the night as it conceals it (the sun).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"91:4:1","position":1,"arabic":"وَٱلَّيْلِ","kind":"word","gloss":"And the night","transliteration":"wa-al-layli","lemma":"لَيْل","root":"ليل","entryId":"l-d2e604e516a58959"},{"key":"91:4:2","position":2,"arabic":"إِذَا","kind":"word","gloss":"when","transliteration":"idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"91:4:3","position":3,"arabic":"يَغْشَىٰهَا","kind":"word","gloss":"it covers it","transliteration":"yaghshāhā","lemma":"غَشِيَ","root":"غشو","entryId":null},{"key":"91:4:4","position":4,"arabic":"٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"91:5","translation":"By the heaven and Him Who built it.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"91:5:1","position":1,"arabic":"وَٱلسَّمَآءِ","kind":"word","gloss":"And the heaven","transliteration":"wal-samāi","lemma":"سَمَآء","root":"سمو","entryId":"l-e873a75addf25baf"},{"key":"91:5:2","position":2,"arabic":"وَمَا","kind":"word","gloss":"and (He) Who","transliteration":"wamā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"91:5:3","position":3,"arabic":"بَنَىٰهَا","kind":"word","gloss":"constructed it","transliteration":"banāhā","lemma":"بَنَىٰ","root":"بني","entryId":null},{"key":"91:5:4","position":4,"arabic":"٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"91:6","translation":"By the earth and Him Who spread it.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"91:6:1","position":1,"arabic":"وَٱلْأَرْضِ","kind":"word","gloss":"And the earth","transliteration":"wal-arḍi","lemma":"أَرْض","root":"ارض","entryId":"l-2c626a3b4c64dbc9"},{"key":"91:6:2","position":2,"arabic":"وَمَا","kind":"word","gloss":"and by (He) Who","transliteration":"wamā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"91:6:3","position":3,"arabic":"طَحَىٰهَا","kind":"word","gloss":"spread it","transliteration":"ṭaḥāhā","lemma":"طَحَىٰ","root":"طحو","entryId":null},{"key":"91:6:4","position":4,"arabic":"٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"91:7","translation":"By Nafs (Adam or a person or a soul), and Him Who perfected him in proportion;","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"91:7:1","position":1,"arabic":"وَنَفْسٍۢ","kind":"word","gloss":"And (the) soul","transliteration":"wanafsin","lemma":"نَفْس","root":"نفس","entryId":"l-95a2521e875a8b29"},{"key":"91:7:2","position":2,"arabic":"وَمَا","kind":"word","gloss":"and (He) Who","transliteration":"wamā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"91:7:3","position":3,"arabic":"سَوَّىٰهَا","kind":"word","gloss":"proportioned it","transliteration":"sawwāhā","lemma":"سَوَّىٰ","root":"سوي","entryId":null},{"key":"91:7:4","position":4,"arabic":"٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"91:8","translation":"Then He showed him what is wrong for him and what is right for him.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"91:8:1","position":1,"arabic":"فَأَلْهَمَهَا","kind":"word","gloss":"And He inspired it","transliteration":"fa-alhamahā","lemma":"أَلْهَمَ","root":"لهم","entryId":null},{"key":"91:8:2","position":2,"arabic":"فُجُورَهَا","kind":"word","gloss":"(to distinguish) its wickedness","transliteration":"fujūrahā","lemma":"فُجُور","root":"فجر","entryId":null},{"key":"91:8:3","position":3,"arabic":"وَتَقْوَىٰهَا","kind":"word","gloss":"and its righteousness","transliteration":"wataqwāhā","lemma":"تَقْوَى","root":"وقي","entryId":null},{"key":"91:8:4","position":4,"arabic":"٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"91:9","translation":"Indeed he succeeds who purifies his ownself (i.e. obeys and performs all that Allâh ordered, by following the true Faith of Islâmic Monotheism and by doing righteous good deeds).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"91:9:1","position":1,"arabic":"قَدْ","kind":"word","gloss":"Indeed","transliteration":"qad","lemma":"قَد","root":null,"entryId":"l-11a59b67e56e7412"},{"key":"91:9:2","position":2,"arabic":"أَفْلَحَ","kind":"word","gloss":"he succeeds","transliteration":"aflaḥa","lemma":"أَفْلَحَ","root":"فلح","entryId":null},{"key":"91:9:3","position":3,"arabic":"مَن","kind":"word","gloss":"who","transliteration":"man","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"91:9:4","position":4,"arabic":"زَكَّىٰهَا","kind":"word","gloss":"purifies it","transliteration":"zakkāhā","lemma":"زَكَّىٰ","root":"زكو","entryId":null},{"key":"91:9:5","position":5,"arabic":"٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"91:10","translation":"And indeed he fails who corrupts his ownself (i.e. disobeys what Allâh has ordered by rejecting the true Faith of Islâmic Monotheism or by following polytheism or by doing every kind of evil wicked deeds).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"91:10:1","position":1,"arabic":"وَقَدْ","kind":"word","gloss":"And indeed","transliteration":"waqad","lemma":"قَد","root":null,"entryId":"l-11a59b67e56e7412"},{"key":"91:10:2","position":2,"arabic":"خَابَ","kind":"word","gloss":"he fails","transliteration":"khāba","lemma":"خَابَ","root":"خيب","entryId":null},{"key":"91:10:3","position":3,"arabic":"مَن","kind":"word","gloss":"who","transliteration":"man","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"91:10:4","position":4,"arabic":"دَسَّىٰهَا","kind":"word","gloss":"buries it","transliteration":"dassāhā","lemma":"دَسَّىٰ","root":"دسو","entryId":null},{"key":"91:10:5","position":5,"arabic":"١٠","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"91:11","translation":"Thamûd (people) denied (their Prophet) through their transgression (by rejecting the true Faith of Islâmic Monotheism, and by following polytheism, and by committing every kind of sin).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"91:11:1","position":1,"arabic":"كَذَّبَتْ","kind":"word","gloss":"Denied","transliteration":"kadhabat","lemma":"كَذَّبَ","root":"كذب","entryId":"l-db86b0654d661fb2"},{"key":"91:11:2","position":2,"arabic":"ثَمُودُ","kind":"word","gloss":"Thamud","transliteration":"thamūdu","lemma":"ثَمُود","root":null,"entryId":null},{"key":"91:11:3","position":3,"arabic":"بِطَغْوَىٰهَآ","kind":"word","gloss":"by their transgression","transliteration":"biṭaghwāhā","lemma":"طَغْوَىٰ","root":"طغي","entryId":null},{"key":"91:11:4","position":4,"arabic":"١١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"91:12","translation":"When the most wicked man among them went forth (to kill the she-camel).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"91:12:1","position":1,"arabic":"إِذِ","kind":"word","gloss":"When","transliteration":"idhi","lemma":"إِذ","root":null,"entryId":"l-70d1b6a3b74582a2"},{"key":"91:12:2","position":2,"arabic":"ٱنۢبَعَثَ","kind":"word","gloss":"(was) sent forth","transliteration":"inbaʿatha","lemma":"انۢبَعَثَ","root":"بعث","entryId":null},{"key":"91:12:3","position":3,"arabic":"أَشْقَىٰهَا","kind":"word","gloss":"(the) most wicked of them","transliteration":"ashqāhā","lemma":"أَشْقَى","root":"شقو","entryId":null},{"key":"91:12:4","position":4,"arabic":"١٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"91:13","translation":"But the Messenger of Allâh [Sâlih عليه السلام] said to them: \"Be cautious! (Fear the evil end). That is the she-camel of Allâh! (Do not harm it) and bar it not from having its drink!\"","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"91:13:1","position":1,"arabic":"فَقَالَ","kind":"word","gloss":"But said","transliteration":"faqāla","lemma":"قَالَ","root":"قول","entryId":"l-effaf24a5c86c56f"},{"key":"91:13:2","position":2,"arabic":"لَهُمْ","kind":"word","gloss":"to them","transliteration":"lahum","lemma":null,"root":null,"entryId":null},{"key":"91:13:3","position":3,"arabic":"رَسُولُ","kind":"word","gloss":"(the) Messenger","transliteration":"rasūlu","lemma":"رَسُول","root":"رسل","entryId":"l-165e008d0f146d23"},{"key":"91:13:4","position":4,"arabic":"ٱللَّهِ","kind":"word","gloss":"(of) Allah","transliteration":"l-lahi","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"91:13:5","position":5,"arabic":"نَاقَةَ","kind":"word","gloss":"(It is the) she-camel","transliteration":"nāqata","lemma":"نَاقَة","root":"نوق","entryId":null},{"key":"91:13:6","position":6,"arabic":"ٱللَّهِ","kind":"word","gloss":"(of) Allah","transliteration":"l-lahi","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"91:13:7","position":7,"arabic":"وَسُقْيَـٰهَا","kind":"word","gloss":"and her drink","transliteration":"wasuq'yāhā","lemma":"سُقْيَٰ","root":"سقي","entryId":null},{"key":"91:13:8","position":8,"arabic":"١٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"91:14","translation":"Then they denied him and they killed it. So their Lord destroyed them because of their sin, and made them equal in destruction (i.e. all grades of people, rich and poor, strong and weak, etc.)!","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"91:14:1","position":1,"arabic":"فَكَذَّبُوهُ","kind":"word","gloss":"But they denied him","transliteration":"fakadhabūhu","lemma":"كَذَّبَ","root":"كذب","entryId":"l-db86b0654d661fb2"},{"key":"91:14:2","position":2,"arabic":"فَعَقَرُوهَا","kind":"word","gloss":"and they hamstrung her","transliteration":"faʿaqarūhā","lemma":"عَقَرَ","root":"عقر","entryId":null},{"key":"91:14:3","position":3,"arabic":"فَدَمْدَمَ","kind":"word","gloss":"So destroyed","transliteration":"fadamdama","lemma":"دَمْدَمَ","root":"دمدم","entryId":null},{"key":"91:14:4","position":4,"arabic":"عَلَيْهِمْ","kind":"word","gloss":"them","transliteration":"ʿalayhim","lemma":"عَلَىٰ","root":null,"entryId":"l-08dd9283adb70e54"},{"key":"91:14:5","position":5,"arabic":"رَبُّهُم","kind":"word","gloss":"their Lord","transliteration":"rabbuhum","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"91:14:6","position":6,"arabic":"بِذَنۢبِهِمْ","kind":"word","gloss":"for their sin","transliteration":"bidhanbihim","lemma":"ذَنب","root":"ذنب","entryId":"l-4f826b1de82e9b9d"},{"key":"91:14:7","position":7,"arabic":"فَسَوَّىٰهَا","kind":"word","gloss":"and leveled them","transliteration":"fasawwāhā","lemma":"سَوَّىٰ","root":"سوي","entryId":null},{"key":"91:14:8","position":8,"arabic":"١٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"91:15","translation":"And He (Allâh) feared not the consequences thereof.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"91:15:1","position":1,"arabic":"وَلَا","kind":"word","gloss":"And not","transliteration":"walā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"91:15:2","position":2,"arabic":"يَخَافُ","kind":"word","gloss":"He fears","transliteration":"yakhāfu","lemma":"خَافَ","root":"خوف","entryId":"l-987e65cf85f6e297"},{"key":"91:15:3","position":3,"arabic":"عُقْبَـٰهَا","kind":"word","gloss":"its consequences","transliteration":"ʿuq'bāhā","lemma":"عُقْبَى","root":"عقب","entryId":null},{"key":"91:15:4","position":4,"arabic":"١٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]}]