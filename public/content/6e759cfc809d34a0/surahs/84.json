[{"ref":"84:1","translation":"When the heaven is split asunder,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"84:1:1","position":1,"arabic":"إِذَا","kind":"word","gloss":"When","transliteration":"idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"84:1:2","position":2,"arabic":"ٱلسَّمَآءُ","kind":"word","gloss":"the sky","transliteration":"l-samāu","lemma":"سَمَآء","root":"سمو","entryId":"l-e873a75addf25baf"},{"key":"84:1:3","position":3,"arabic":"ٱنشَقَّتْ","kind":"word","gloss":"is split asunder","transliteration":"inshaqqat","lemma":"انشَقَّ","root":"شقق","entryId":null},{"key":"84:1:4","position":4,"arabic":"١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"84:2","translation":"And listens to and obeys its Lord - and it must do so.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"84:2:1","position":1,"arabic":"وَأَذِنَتْ","kind":"word","gloss":"And has listened","transliteration":"wa-adhinat","lemma":"أَذِنَ","root":"اذن","entryId":null},{"key":"84:2:2","position":2,"arabic":"لِرَبِّهَا","kind":"word","gloss":"to its Lord","transliteration":"lirabbihā","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"84:2:3","position":3,"arabic":"وَحُقَّتْ","kind":"word","gloss":"and was obligated","transliteration":"waḥuqqat","lemma":"حَقَّ","root":"حقق","entryId":null},{"key":"84:2:4","position":4,"arabic":"٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"84:3","translation":"And when the earth is stretched forth,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"84:3:1","position":1,"arabic":"وَإِذَا","kind":"word","gloss":"And when","transliteration":"wa-idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"84:3:2","position":2,"arabic":"ٱلْأَرْضُ","kind":"word","gloss":"the earth","transliteration":"l-arḍu","lemma":"أَرْض","root":"ارض","entryId":"l-2c626a3b4c64dbc9"},{"key":"84:3:3","position":3,"arabic":"مُدَّتْ","kind":"word","gloss":"is spread","transliteration":"muddat","lemma":"مَدَّ","root":"مدد","entryId":null},{"key":"84:3:4","position":4,"arabic":"٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"84:4","translation":"And has cast out all that was in it and became empty.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"84:4:1","position":1,"arabic":"وَأَلْقَتْ","kind":"word","gloss":"And has cast out","transliteration":"wa-alqat","lemma":"أَلْقَىٰٓ","root":"لقي","entryId":"l-09920b7d63c6ad5f"},{"key":"84:4:2","position":2,"arabic":"مَا","kind":"word","gloss":"what","transliteration":"mā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"84:4:3","position":3,"arabic":"فِيهَا","kind":"word","gloss":"(is) in it","transliteration":"fīhā","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"84:4:4","position":4,"arabic":"وَتَخَلَّتْ","kind":"word","gloss":"and becomes empty","transliteration":"watakhallat","lemma":"تَخَلَّتْ","root":"خلو","entryId":null},{"key":"84:4:5","position":5,"arabic":"٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"84:5","translation":"And listens to and obeys its Lord - and it must do so.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"84:5:1","position":1,"arabic":"وَأَذِنَتْ","kind":"word","gloss":"And has listened","transliteration":"wa-adhinat","lemma":"أَذِنَ","root":"اذن","entryId":null},{"key":"84:5:2","position":2,"arabic":"لِرَبِّهَا","kind":"word","gloss":"to its Lord","transliteration":"lirabbihā","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"84:5:3","position":3,"arabic":"وَحُقَّتْ","kind":"word","gloss":"and was obligated","transliteration":"waḥuqqat","lemma":"حَقَّ","root":"حقق","entryId":null},{"key":"84:5:4","position":4,"arabic":"٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"84:6","translation":"O man! Verily, you are returning towards your Lord with your deeds and actions (good or bad), a sure returning, and you will meet (the results of your deeds which you did).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"84:6:1","position":1,"arabic":"يَـٰٓأَيُّهَا","kind":"word","gloss":"O","transliteration":"yāayyuhā","lemma":"أَيُّهَا","root":"ايي","entryId":"l-a3fa5dd17841b221"},{"key":"84:6:2","position":2,"arabic":"ٱلْإِنسَـٰنُ","kind":"word","gloss":"mankind","transliteration":"l-insānu","lemma":"إِنسَٰن","root":"انس","entryId":"l-bec7f7166ce0ed1b"},{"key":"84:6:3","position":3,"arabic":"إِنَّكَ","kind":"word","gloss":"Indeed, you","transliteration":"innaka","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"84:6:4","position":4,"arabic":"كَادِحٌ","kind":"word","gloss":"(are) laboring","transliteration":"kādiḥun","lemma":"كَادِح","root":"كدح","entryId":null},{"key":"84:6:5","position":5,"arabic":"إِلَىٰ","kind":"word","gloss":"to","transliteration":"ilā","lemma":"إِلَىٰ","root":null,"entryId":"l-53539d2c3606b99e"},{"key":"84:6:6","position":6,"arabic":"رَبِّكَ","kind":"word","gloss":"your Lord","transliteration":"rabbika","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"84:6:7","position":7,"arabic":"كَدْحًۭا","kind":"word","gloss":"(with) exertion","transliteration":"kadḥan","lemma":"كَدْح","root":"كدح","entryId":null},{"key":"84:6:8","position":8,"arabic":"فَمُلَـٰقِيهِ","kind":"word","gloss":"and you (will) meet Him","transliteration":"famulāqīhi","lemma":"مُلَٰقِي","root":"لقي","entryId":null},{"key":"84:6:9","position":9,"arabic":"٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"84:7","translation":"Then as for him who will be given his Record in his right hand,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"84:7:1","position":1,"arabic":"فَأَمَّا","kind":"word","gloss":"Then as for","transliteration":"fa-ammā","lemma":"أَمَّا","root":null,"entryId":"l-6c43b34cf75dec4b"},{"key":"84:7:2","position":2,"arabic":"مَنْ","kind":"word","gloss":"(him) who","transliteration":"man","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"84:7:3","position":3,"arabic":"أُوتِىَ","kind":"word","gloss":"is given","transliteration":"ūtiya","lemma":"آتَى","root":"اتي","entryId":"l-45664741cd653ab4"},{"key":"84:7:4","position":4,"arabic":"كِتَـٰبَهُۥ","kind":"word","gloss":"his record","transliteration":"kitābahu","lemma":"كِتَٰب","root":"كتب","entryId":"l-a68c915be321aa35"},{"key":"84:7:5","position":5,"arabic":"بِيَمِينِهِۦ","kind":"word","gloss":"in his right (hand)","transliteration":"biyamīnihi","lemma":"يَمِين","root":"يمن","entryId":"l-695d4655ac0b67a4"},{"key":"84:7:6","position":6,"arabic":"٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"84:8","translation":"He surely will receive an easy reckoning,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"84:8:1","position":1,"arabic":"فَسَوْفَ","kind":"word","gloss":"Then soon","transliteration":"fasawfa","lemma":"سَوْف","root":null,"entryId":"l-0e28987d8e8dbefa"},{"key":"84:8:2","position":2,"arabic":"يُحَاسَبُ","kind":"word","gloss":"his account will be taken","transliteration":"yuḥāsabu","lemma":"حَاسَبْ","root":"حسب","entryId":null},{"key":"84:8:3","position":3,"arabic":"حِسَابًۭا","kind":"word","gloss":"an account","transliteration":"ḥisāban","lemma":"حِسَاب","root":"حسب","entryId":"l-abc3684e3a67ce7a"},{"key":"84:8:4","position":4,"arabic":"يَسِيرًۭا","kind":"word","gloss":"easy","transliteration":"yasīran","lemma":"يَسِير","root":"يسر","entryId":null},{"key":"84:8:5","position":5,"arabic":"٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"84:9","translation":"And will return to his family in joy!","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"84:9:1","position":1,"arabic":"وَيَنقَلِبُ","kind":"word","gloss":"And he will return","transliteration":"wayanqalibu","lemma":"انقَلَبَ","root":"قلب","entryId":null},{"key":"84:9:2","position":2,"arabic":"إِلَىٰٓ","kind":"word","gloss":"to","transliteration":"ilā","lemma":"إِلَىٰ","root":null,"entryId":"l-53539d2c3606b99e"},{"key":"84:9:3","position":3,"arabic":"أَهْلِهِۦ","kind":"word","gloss":"his people","transliteration":"ahlihi","lemma":"أَهْل","root":"اهل","entryId":"l-5fd11f4d420d23ca"},{"key":"84:9:4","position":4,"arabic":"مَسْرُورًۭا","kind":"word","gloss":"happily","transliteration":"masrūran","lemma":"مَسْرُور","root":"سرر","entryId":null},{"key":"84:9:5","position":5,"arabic":"٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"84:10","translation":"But whosoever is given his Record behind his back,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"84:10:1","position":1,"arabic":"وَأَمَّا","kind":"word","gloss":"But as for","transliteration":"wa-ammā","lemma":"أَمَّا","root":null,"entryId":"l-6c43b34cf75dec4b"},{"key":"84:10:2","position":2,"arabic":"مَنْ","kind":"word","gloss":"(him) who","transliteration":"man","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"84:10:3","position":3,"arabic":"أُوتِىَ","kind":"word","gloss":"is given","transliteration":"ūtiya","lemma":"آتَى","root":"اتي","entryId":"l-45664741cd653ab4"},{"key":"84:10:4","position":4,"arabic":"كِتَـٰبَهُۥ","kind":"word","gloss":"his record","transliteration":"kitābahu","lemma":"كِتَٰب","root":"كتب","entryId":"l-a68c915be321aa35"},{"key":"84:10:5","position":5,"arabic":"وَرَآءَ","kind":"word","gloss":"behind","transliteration":"warāa","lemma":"وَرَآء","root":"وري","entryId":null},{"key":"84:10:6","position":6,"arabic":"ظَهْرِهِۦ","kind":"word","gloss":"his back","transliteration":"ẓahrihi","lemma":"ظَهْر","root":"ظهر","entryId":null},{"key":"84:10:7","position":7,"arabic":"١٠","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"84:11","translation":"He will invoke (for his) destruction,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"84:11:1","position":1,"arabic":"فَسَوْفَ","kind":"word","gloss":"Then soon","transliteration":"fasawfa","lemma":"سَوْف","root":null,"entryId":"l-0e28987d8e8dbefa"},{"key":"84:11:2","position":2,"arabic":"يَدْعُوا۟","kind":"word","gloss":"he will call","transliteration":"yadʿū","lemma":"دَعَا","root":"دعو","entryId":"l-f687b25395102e70"},{"key":"84:11:3","position":3,"arabic":"ثُبُورًۭا","kind":"word","gloss":"(for) destruction","transliteration":"thubūran","lemma":"ثُبُور","root":"ثبر","entryId":null},{"key":"84:11:4","position":4,"arabic":"١١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"84:12","translation":"And he shall enter a blazing Fire, and be made to taste its burning.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"84:12:1","position":1,"arabic":"وَيَصْلَىٰ","kind":"word","gloss":"And he will burn","transliteration":"wayaṣlā","lemma":"يَصْلَى","root":"صلي","entryId":null},{"key":"84:12:2","position":2,"arabic":"سَعِيرًا","kind":"word","gloss":"(in) a Blaze","transliteration":"saʿīran","lemma":"سَعِير","root":"سعر","entryId":null},{"key":"84:12:3","position":3,"arabic":"١٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"84:13","translation":"Verily, he was among his people in joy!","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"84:13:1","position":1,"arabic":"إِنَّهُۥ","kind":"word","gloss":"Indeed, he","transliteration":"innahu","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"84:13:2","position":2,"arabic":"كَانَ","kind":"word","gloss":"had been","transliteration":"kāna","lemma":"كَانَ","root":"كون","entryId":"l-4b2f9969a9af0d45"},{"key":"84:13:3","position":3,"arabic":"فِىٓ","kind":"word","gloss":"among","transliteration":"fī","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"84:13:4","position":4,"arabic":"أَهْلِهِۦ","kind":"word","gloss":"his people","transliteration":"ahlihi","lemma":"أَهْل","root":"اهل","entryId":"l-5fd11f4d420d23ca"},{"key":"84:13:5","position":5,"arabic":"مَسْرُورًا","kind":"word","gloss":"happy","transliteration":"masrūran","lemma":"مَسْرُور","root":"سرر","entryId":null},{"key":"84:13:6","position":6,"arabic":"١٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"84:14","translation":"Verily, he thought that he would never come back (to Us)!","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"84:14:1","position":1,"arabic":"إِنَّهُۥ","kind":"word","gloss":"Indeed, he","transliteration":"innahu","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"84:14:2","position":2,"arabic":"ظَنَّ","kind":"word","gloss":"(had) thought","transliteration":"ẓanna","lemma":"ظَنَّ","root":"ظنن","entryId":"l-34fadff01946a633"},{"key":"84:14:3","position":3,"arabic":"أَن","kind":"word","gloss":"that","transliteration":"an","lemma":"أَن","root":null,"entryId":"l-6fb897ea8dfcda9d"},{"key":"84:14:4","position":4,"arabic":"لَّن","kind":"word","gloss":"never","transliteration":"lan","lemma":"لَن","root":null,"entryId":"l-3db5462128ff695e"},{"key":"84:14:5","position":5,"arabic":"يَحُورَ","kind":"word","gloss":"he would return","transliteration":"yaḥūra","lemma":"يَحُورَ","root":"حور","entryId":null},{"key":"84:14:6","position":6,"arabic":"١٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"84:15","translation":"Yes! Verily, his Lord has been ever beholding him!","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"84:15:1","position":1,"arabic":"بَلَىٰٓ","kind":"word","gloss":"Yes","transliteration":"balā","lemma":"بَلَىٰ","root":null,"entryId":null},{"key":"84:15:2","position":2,"arabic":"إِنَّ","kind":"word","gloss":"Indeed","transliteration":"inna","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"84:15:3","position":3,"arabic":"رَبَّهُۥ","kind":"word","gloss":"his Lord","transliteration":"rabbahu","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"84:15:4","position":4,"arabic":"كَانَ","kind":"word","gloss":"was","transliteration":"kāna","lemma":"كَانَ","root":"كون","entryId":"l-4b2f9969a9af0d45"},{"key":"84:15:5","position":5,"arabic":"بِهِۦ","kind":"word","gloss":"of him","transliteration":"bihi","lemma":null,"root":null,"entryId":null},{"key":"84:15:6","position":6,"arabic":"بَصِيرًۭا","kind":"word","gloss":"All-Seer","transliteration":"baṣīran","lemma":"بَصِير","root":"بصر","entryId":"l-93fa5871f325f4d8"},{"key":"84:15:7","position":7,"arabic":"١٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"84:16","translation":"So I swear by the afterglow of sunset;","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"84:16:1","position":1,"arabic":"فَلَآ","kind":"word","gloss":"But nay","transliteration":"falā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"84:16:2","position":2,"arabic":"أُقْسِمُ","kind":"word","gloss":"I swear","transliteration":"uq'simu","lemma":"أَقْسَمُ","root":"قسم","entryId":null},{"key":"84:16:3","position":3,"arabic":"بِٱلشَّفَقِ","kind":"word","gloss":"by the twilight glow","transliteration":"bil-shafaqi","lemma":"شَّفَق","root":"شفق","entryId":null},{"key":"84:16:4","position":4,"arabic":"١٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"84:17","translation":"And by the night and whatever it gathers in its darkness,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"84:17:1","position":1,"arabic":"وَٱلَّيْلِ","kind":"word","gloss":"And the night","transliteration":"wa-al-layli","lemma":"لَيْل","root":"ليل","entryId":"l-d2e604e516a58959"},{"key":"84:17:2","position":2,"arabic":"وَمَا","kind":"word","gloss":"and what","transliteration":"wamā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"84:17:3","position":3,"arabic":"وَسَقَ","kind":"word","gloss":"it envelops","transliteration":"wasaqa","lemma":"وَسَقَ","root":"وسق","entryId":null},{"key":"84:17:4","position":4,"arabic":"١٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"84:18","translation":"And by the moon when it is at the full.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"84:18:1","position":1,"arabic":"وَٱلْقَمَرِ","kind":"word","gloss":"And the moon","transliteration":"wal-qamari","lemma":"قَمَر","root":"قمر","entryId":null},{"key":"84:18:2","position":2,"arabic":"إِذَا","kind":"word","gloss":"when","transliteration":"idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"84:18:3","position":3,"arabic":"ٱتَّسَقَ","kind":"word","gloss":"it becomes full","transliteration":"ittasaqa","lemma":"اتَّسَقَ","root":"وسق","entryId":null},{"key":"84:18:4","position":4,"arabic":"١٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"84:19","translation":"You shall certainly travel from stage to stage (in this life and in the Hereafter).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"84:19:1","position":1,"arabic":"لَتَرْكَبُنَّ","kind":"word","gloss":"You will surely embark","transliteration":"latarkabunna","lemma":"رَكِبَ","root":"ركب","entryId":null},{"key":"84:19:2","position":2,"arabic":"طَبَقًا","kind":"word","gloss":"(to) stage","transliteration":"ṭabaqan","lemma":"طَبَق","root":"طبق","entryId":null},{"key":"84:19:3","position":3,"arabic":"عَن","kind":"word","gloss":"from","transliteration":"ʿan","lemma":"عَن","root":null,"entryId":"l-f1109a78c8548754"},{"key":"84:19:4","position":4,"arabic":"طَبَقٍۢ","kind":"word","gloss":"stage","transliteration":"ṭabaqin","lemma":"طَبَق","root":"طبق","entryId":null},{"key":"84:19:5","position":5,"arabic":"١٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"84:20","translation":"What is the matter with them, that they believe not?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"84:20:1","position":1,"arabic":"فَمَا","kind":"word","gloss":"So what","transliteration":"famā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"84:20:2","position":2,"arabic":"لَهُمْ","kind":"word","gloss":"(is) for them","transliteration":"lahum","lemma":null,"root":null,"entryId":null},{"key":"84:20:3","position":3,"arabic":"لَا","kind":"word","gloss":"not","transliteration":"lā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"84:20:4","position":4,"arabic":"يُؤْمِنُونَ","kind":"word","gloss":"they believe","transliteration":"yu'minūna","lemma":"ءَامَنَ","root":"امن","entryId":"l-f6ec3a6dc0f76aa6"},{"key":"84:20:5","position":5,"arabic":"٢٠","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"84:21","translation":"And when the Qur’ân is recited to them, they fall not prostrate.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"84:21:1","position":1,"arabic":"وَإِذَا","kind":"word","gloss":"And when","transliteration":"wa-idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"84:21:2","position":2,"arabic":"قُرِئَ","kind":"word","gloss":"is recited","transliteration":"quri-a","lemma":"قَرَأَ","root":"قرا","entryId":null},{"key":"84:21:3","position":3,"arabic":"عَلَيْهِمُ","kind":"word","gloss":"to them","transliteration":"ʿalayhimu","lemma":"عَلَىٰ","root":null,"entryId":"l-08dd9283adb70e54"},{"key":"84:21:4","position":4,"arabic":"ٱلْقُرْءَانُ","kind":"word","gloss":"the Quran","transliteration":"l-qur'ānu","lemma":"قُرْءَان","root":"قرا","entryId":"l-5ff4c6fce3db7bd6"},{"key":"84:21:5","position":5,"arabic":"لَا","kind":"word","gloss":"not","transliteration":"lā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"84:21:6","position":6,"arabic":"يَسْجُدُونَ ۩","kind":"word","gloss":"they prostrate","transliteration":"yasjudūna","lemma":"سَجَدَ","root":"سجد","entryId":null},{"key":"84:21:7","position":7,"arabic":"٢١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"84:22","translation":"Nay, those who disbelieve belie (Prophet Muhammad صلى الله عليه وسلم and whatever he brought, i.e. this Qur’ân and Islâmic Monotheism, etc.).","translationSource":"qul-301-hilali-khan","notes":[{"text":"It is obligatory to have Belief in the Messengership of the Prophet (Muhammad صلى الله عليه وسلم). Narrated Abu Hurairah رضي الله عنه : Allâh’s Messenger صلى الله عليه وسلم said: \"By Him (Allâh) in Whose Hand Muhammad’s soul is, there is none from amongst the Jews and Christians (of these present nations) who hears about me and then dies without believing in the Message with which I have been sent (i.e. Islâmic Monotheism), but he will be from the dwellers of the (Hell) Fire.\" (Sahih Muslim, the Book of Faith, Vol. 1, Chapter No.240). See also (V.3:85) and (V.3:116).","ref":null}],"tokens":[{"key":"84:22:1","position":1,"arabic":"بَلِ","kind":"word","gloss":"Nay","transliteration":"bali","lemma":"بَل","root":null,"entryId":"l-706f9c6eca0445cc"},{"key":"84:22:2","position":2,"arabic":"ٱلَّذِينَ","kind":"word","gloss":"Those who","transliteration":"alladhīna","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"84:22:3","position":3,"arabic":"كَفَرُوا۟","kind":"word","gloss":"disbelieved","transliteration":"kafarū","lemma":"كَفَرَ","root":"كفر","entryId":"l-f6f8e55e4806177f"},{"key":"84:22:4","position":4,"arabic":"يُكَذِّبُونَ","kind":"word","gloss":"deny","transliteration":"yukadhibūna","lemma":"كَذَّبَ","root":"كذب","entryId":"l-db86b0654d661fb2"},{"key":"84:22:5","position":5,"arabic":"٢٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"84:23","translation":"And Allâh knows best what they gather (of good and bad deeds),","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"84:23:1","position":1,"arabic":"وَٱللَّهُ","kind":"word","gloss":"And Allah","transliteration":"wal-lahu","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"84:23:2","position":2,"arabic":"أَعْلَمُ","kind":"word","gloss":"(is) most knowing","transliteration":"aʿlamu","lemma":"أَعْلَم","root":"علم","entryId":"l-a0cce42e527d844f"},{"key":"84:23:3","position":3,"arabic":"بِمَا","kind":"word","gloss":"of what","transliteration":"bimā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"84:23:4","position":4,"arabic":"يُوعُونَ","kind":"word","gloss":"they keep within themselves","transliteration":"yūʿūna","lemma":"أَوْعَىٰٓ","root":"وعي","entryId":null},{"key":"84:23:5","position":5,"arabic":"٢٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"84:24","translation":"So announce to them a painful torment.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"84:24:1","position":1,"arabic":"فَبَشِّرْهُم","kind":"word","gloss":"so give them tidings","transliteration":"fabashir'hum","lemma":"بُشِّرَ","root":"بشر","entryId":"l-9c60048cd90e63bd"},{"key":"84:24:2","position":2,"arabic":"بِعَذَابٍ","kind":"word","gloss":"of a punishment","transliteration":"biʿadhābin","lemma":"عَذَاب","root":"عذب","entryId":"l-3eb7e15951d31876"},{"key":"84:24:3","position":3,"arabic":"أَلِيمٍ","kind":"word","gloss":"painful","transliteration":"alīmin","lemma":"أَلِيم","root":"الم","entryId":"l-e6db50422187d325"},{"key":"84:24:4","position":4,"arabic":"٢٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"84:25","translation":"Save those who believe and do righteous good deeds, for them is a reward that will never come to an end (i.e. Paradise).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"84:25:1","position":1,"arabic":"إِلَّا","kind":"word","gloss":"Except","transliteration":"illā","lemma":"إِلَّا","root":null,"entryId":"l-250ca4d5b58814dd"},{"key":"84:25:2","position":2,"arabic":"ٱلَّذِينَ","kind":"word","gloss":"those who","transliteration":"alladhīna","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"84:25:3","position":3,"arabic":"ءَامَنُوا۟","kind":"word","gloss":"believe","transliteration":"āmanū","lemma":"ءَامَنَ","root":"امن","entryId":"l-f6ec3a6dc0f76aa6"},{"key":"84:25:4","position":4,"arabic":"وَعَمِلُوا۟","kind":"word","gloss":"and do","transliteration":"waʿamilū","lemma":"عَمِلَ","root":"عمل","entryId":"l-4fa22225cead4d92"},{"key":"84:25:5","position":5,"arabic":"ٱلصَّـٰلِحَـٰتِ","kind":"word","gloss":"righteous deeds","transliteration":"l-ṣāliḥāti","lemma":"صَّٰلِحَٰت","root":"صلح","entryId":"l-0248bd763dd1fd03"},{"key":"84:25:6","position":6,"arabic":"لَهُمْ","kind":"word","gloss":"For them","transliteration":"lahum","lemma":null,"root":null,"entryId":null},{"key":"84:25:7","position":7,"arabic":"أَجْرٌ","kind":"word","gloss":"(is) a reward","transliteration":"ajrun","lemma":"أَجْر","root":"اجر","entryId":"l-f6132363e87a7dae"},{"key":"84:25:8","position":8,"arabic":"غَيْرُ","kind":"word","gloss":"never","transliteration":"ghayru","lemma":"غَيْر","root":"غير","entryId":"l-68dc6c0e2c3e7795"},{"key":"84:25:9","position":9,"arabic":"مَمْنُونٍۭ","kind":"word","gloss":"ending","transliteration":"mamnūnin","lemma":"مَمْنُون","root":"منن","entryId":null},{"key":"84:25:10","position":10,"arabic":"٢٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]}]