[{"ref":"114:1","translation":"Say: \"I seek refuge with (Allâh) the Lord of mankind,","translationSource":"qul-301-hilali-khan","notes":[{"text":"Narrated ‘Âishah رضي الله عنها: whenever Allâh’s Messenger صلى الله عليه وسلم went to bed, he used to recite Sûrat Al-Ikhlâs (112), Sûrat Al-Falaq (113) and Sûrat An-Nâs (114) and then blow on his palms and pass them over his face and those parts of his body that his hands could reach. And when he fell ill, he used to order me to do like that for him. (Sahih Al-Bukhari, Vol.7, Hadith No.644).","ref":null}],"tokens":[{"key":"114:1:1","position":1,"arabic":"قُلْ","kind":"word","gloss":"Say","transliteration":"qul","lemma":"قَالَ","root":"قول","entryId":"l-effaf24a5c86c56f"},{"key":"114:1:2","position":2,"arabic":"أَعُوذُ","kind":"word","gloss":"I seek refuge","transliteration":"aʿūdhu","lemma":"عُذْ","root":"عوذ","entryId":null},{"key":"114:1:3","position":3,"arabic":"بِرَبِّ","kind":"word","gloss":"in (the) Lord","transliteration":"birabbi","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"114:1:4","position":4,"arabic":"ٱلنَّاسِ","kind":"word","gloss":"(of) mankind","transliteration":"l-nāsi","lemma":"نَّاس","root":"نوس","entryId":"l-490d7f2d4cbaf6d4"},{"key":"114:1:5","position":5,"arabic":"١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"114:2","translation":"\"The King of mankind -","translationSource":"qul-301-hilali-khan","notes":[{"text":"The Statement of Allâh عز وجل: ‘The King of mankind.’ Narrated Abu Hurairah رضي الله عنه: The Prophet صلى الله عليه وسلم said, \"On the Day of Resurrection Allâh will grasp the whole (planet of) earth (by His Hand) and shall roll up the heaven with His Right Hand and say, ‘I am the King. Where are the kings of the earth?’\" (Sahih Al-Bukhari, Vol.9, Hadith No.479).","ref":null}],"tokens":[{"key":"114:2:1","position":1,"arabic":"مَلِكِ","kind":"word","gloss":"(The) King","transliteration":"maliki","lemma":"مَلِك","root":"ملك","entryId":null},{"key":"114:2:2","position":2,"arabic":"ٱلنَّاسِ","kind":"word","gloss":"(of) mankind","transliteration":"l-nāsi","lemma":"نَّاس","root":"نوس","entryId":"l-490d7f2d4cbaf6d4"},{"key":"114:2:3","position":3,"arabic":"٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"114:3","translation":"\"The Ilâh (God) of mankind,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"114:3:1","position":1,"arabic":"إِلَـٰهِ","kind":"word","gloss":"(The) God","transliteration":"ilāhi","lemma":"إِلَٰه","root":"اله","entryId":"l-c5bb2aebfa35aadd"},{"key":"114:3:2","position":2,"arabic":"ٱلنَّاسِ","kind":"word","gloss":"(of) mankind","transliteration":"l-nāsi","lemma":"نَّاس","root":"نوس","entryId":"l-490d7f2d4cbaf6d4"},{"key":"114:3:3","position":3,"arabic":"٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"114:4","translation":"\"From the evil of the whisperer (devil who whispers evil in the hearts of men) who withdraws (from his whispering in one’s heart after one remembers Allâh).","translationSource":"qul-301-hilali-khan","notes":[{"text":"Narrated Abu Hurairah رضي الله عنه: Allâh’s Messenger صلى الله عليه وسلم said, \"The (Hell) Fire is surrounded by all kinds of desires and passions, while Paradise is surrounded by all kinds of disliked undesirable things.\"* (Sahih Al-Bukhari, Vol. 8, Hadith No.494). * Inordinate desires and animalistic passions lead to the Fire while self-control, perseverance, chastity and all other virtues, and the obedience to Allâh and His Messengerصلى الله عليه وسلم lead to Paradise. What leads to Hell is easy to do while what leads to Paradise is difficult to do.","ref":null}],"tokens":[{"key":"114:4:1","position":1,"arabic":"مِن","kind":"word","gloss":"From","transliteration":"min","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"114:4:2","position":2,"arabic":"شَرِّ","kind":"word","gloss":"(the) evil","transliteration":"sharri","lemma":"شَرّ","root":"شرر","entryId":null},{"key":"114:4:3","position":3,"arabic":"ٱلْوَسْوَاسِ","kind":"word","gloss":"(of) the whisperer","transliteration":"l-waswāsi","lemma":"وَسْوَاس","root":"وسوس","entryId":null},{"key":"114:4:4","position":4,"arabic":"ٱلْخَنَّاسِ","kind":"word","gloss":"the one who withdraws","transliteration":"l-khanāsi","lemma":"خَنَّاس","root":"خنس","entryId":null},{"key":"114:4:5","position":5,"arabic":"٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"114:5","translation":"\"Who whispers in the breasts of mankind.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"114:5:1","position":1,"arabic":"ٱلَّذِى","kind":"word","gloss":"The one who","transliteration":"alladhī","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"114:5:2","position":2,"arabic":"يُوَسْوِسُ","kind":"word","gloss":"whispers","transliteration":"yuwaswisu","lemma":"وَسْوَسَ","root":"وسوس","entryId":null},{"key":"114:5:3","position":3,"arabic":"فِى","kind":"word","gloss":"in","transliteration":"fī","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"114:5:4","position":4,"arabic":"صُدُورِ","kind":"word","gloss":"(the) breasts","transliteration":"ṣudūri","lemma":"صَدْر","root":"صدر","entryId":"l-81254b818b8d6bbf"},{"key":"114:5:5","position":5,"arabic":"ٱلنَّاسِ","kind":"word","gloss":"(of) mankind","transliteration":"l-nāsi","lemma":"نَّاس","root":"نوس","entryId":"l-490d7f2d4cbaf6d4"},{"key":"114:5:6","position":6,"arabic":"٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"114:6","translation":"\"Of jinn and men.\"","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"114:6:1","position":1,"arabic":"مِنَ","kind":"word","gloss":"From","transliteration":"mina","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"114:6:2","position":2,"arabic":"ٱلْجِنَّةِ","kind":"word","gloss":"the jinn","transliteration":"l-jinati","lemma":"جِنَّة","root":"جنن","entryId":null},{"key":"114:6:3","position":3,"arabic":"وَٱلنَّاسِ","kind":"word","gloss":"and men","transliteration":"wal-nāsi","lemma":"نَّاس","root":"نوس","entryId":"l-490d7f2d4cbaf6d4"},{"key":"114:6:4","position":4,"arabic":"٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]}]