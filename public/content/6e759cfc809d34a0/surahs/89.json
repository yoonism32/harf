[{"ref":"89:1","translation":"By the dawn;","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"89:1:1","position":1,"arabic":"وَٱلْفَجْرِ","kind":"word","gloss":"By the dawn","transliteration":"wal-fajri","lemma":"فَجْر","root":"فجر","entryId":null},{"key":"89:1:2","position":2,"arabic":"١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"89:2","translation":"By the ten nights (i.e. the first ten days of the month of Dhul-Hijjah),","translationSource":"qul-301-hilali-khan","notes":[{"text":"Narrated Ibn ‘Abbâs رضي الله عنهما: The Prophet صلى الله عليه وسلم said, \"No good deeds done on other days are superior to those done on these (first ten days of Dhul-Hijjah).\" Then some Companions of the Prophet صلى الله عليه وسلم said, \"Not even Jihâd ?\" He replied, \"Not even Jihâd, except that of a man who does it by putting himself and his property in danger (for Allâh’s sake) and does not return with any of those things.\" (Sahih Al-Bukhari, Vol.2, Hadith No.86).","ref":null}],"tokens":[{"key":"89:2:1","position":1,"arabic":"وَلَيَالٍ","kind":"word","gloss":"And the nights","transliteration":"walayālin","lemma":"لَيْل","root":"ليل","entryId":"l-d2e604e516a58959"},{"key":"89:2:2","position":2,"arabic":"عَشْرٍۢ","kind":"word","gloss":"ten","transliteration":"ʿashrin","lemma":"عَشْر","root":"عشر","entryId":null},{"key":"89:2:3","position":3,"arabic":"٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"89:3","translation":"And by the even and the odd (of all the creations of Allâh).","translationSource":"qul-301-hilali-khan","notes":[{"text":"\"Even\" and \"Odd\" is interpreted differently by different religious scholars. Some say: Even is the Day of Slaughtering of the Sacrifices, i.e. 10th of Dhul-Hijjah, and Odd is the Day of ‘Arafah (Hajj ), i.e. 9th of Dhul-Hijjah. Others say: Even is all the creatures and Odd is Allâh. Some say it is the compulsory congregational prayer, i.e. Maghrib is Witr , and the other four prayers are Shaf‘","ref":null}],"tokens":[{"key":"89:3:1","position":1,"arabic":"وَٱلشَّفْعِ","kind":"word","gloss":"And the even","transliteration":"wal-shafʿi","lemma":"شَّفْع","root":"شفع","entryId":null},{"key":"89:3:2","position":2,"arabic":"وَٱلْوَتْرِ","kind":"word","gloss":"and the odd","transliteration":"wal-watri","lemma":"وَتْر","root":"وتر","entryId":null},{"key":"89:3:3","position":3,"arabic":"٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"89:4","translation":"And by the night when it departs.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"89:4:1","position":1,"arabic":"وَٱلَّيْلِ","kind":"word","gloss":"And the night","transliteration":"wa-al-layli","lemma":"لَيْل","root":"ليل","entryId":"l-d2e604e516a58959"},{"key":"89:4:2","position":2,"arabic":"إِذَا","kind":"word","gloss":"when","transliteration":"idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"89:4:3","position":3,"arabic":"يَسْرِ","kind":"word","gloss":"it passes","transliteration":"yasri","lemma":"يَسْرِ","root":"سري","entryId":null},{"key":"89:4:4","position":4,"arabic":"٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"89:5","translation":"There is indeed in them (the above oaths) sufficient proofs for men of understanding (and that, they should avoid all kinds of sins and disbeliefs)!","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"89:5:1","position":1,"arabic":"هَلْ","kind":"word","gloss":"Is","transliteration":"hal","lemma":"هَل","root":null,"entryId":"l-acd15f3532f2b613"},{"key":"89:5:2","position":2,"arabic":"فِى","kind":"word","gloss":"in","transliteration":"fī","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"89:5:3","position":3,"arabic":"ذَٰلِكَ","kind":"word","gloss":"that","transliteration":"dhālika","lemma":"ذَٰلِك","root":null,"entryId":"l-096a9ad382db7640"},{"key":"89:5:4","position":4,"arabic":"قَسَمٌۭ","kind":"word","gloss":"(not) an oath","transliteration":"qasamun","lemma":"قَسَم","root":"قسم","entryId":null},{"key":"89:5:5","position":5,"arabic":"لِّذِى","kind":"word","gloss":"for those","transliteration":"lidhī","lemma":"ذُو","root":null,"entryId":"l-ea5c5c22a86c9f67"},{"key":"89:5:6","position":6,"arabic":"حِجْرٍ","kind":"word","gloss":"who understand","transliteration":"ḥij'rin","lemma":"حِجْر","root":"حجر","entryId":null},{"key":"89:5:7","position":7,"arabic":"٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"89:6","translation":"Saw you (O Muhammad صلى الله عليه وسلم) not how your Lord dealt with ‘Âd (people)","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"89:6:1","position":1,"arabic":"أَلَمْ","kind":"word","gloss":"Did not","transliteration":"alam","lemma":"لَم","root":null,"entryId":"l-a5ee2f54ca9bbf2c"},{"key":"89:6:2","position":2,"arabic":"تَرَ","kind":"word","gloss":"you see","transliteration":"tara","lemma":"رَءَا","root":"راي","entryId":"l-6b7f279dfcd3ea58"},{"key":"89:6:3","position":3,"arabic":"كَيْفَ","kind":"word","gloss":"how","transliteration":"kayfa","lemma":"كَيْف","root":"كيف","entryId":"l-9ae8af732625ada5"},{"key":"89:6:4","position":4,"arabic":"فَعَلَ","kind":"word","gloss":"dealt","transliteration":"faʿala","lemma":"فَعَلَ","root":"فعل","entryId":"l-b0a120934c602e5e"},{"key":"89:6:5","position":5,"arabic":"رَبُّكَ","kind":"word","gloss":"your Lord","transliteration":"rabbuka","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"89:6:6","position":6,"arabic":"بِعَادٍ","kind":"word","gloss":"with Aad","transliteration":"biʿādin","lemma":"عَاد","root":"عود","entryId":null},{"key":"89:6:7","position":7,"arabic":"٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"89:7","translation":"Of Iram (who were very tall) like (lofty) pillars,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"89:7:1","position":1,"arabic":"إِرَمَ","kind":"word","gloss":"Iram","transliteration":"irama","lemma":"إِرَم","root":null,"entryId":null},{"key":"89:7:2","position":2,"arabic":"ذَاتِ","kind":"word","gloss":"possessors (of)","transliteration":"dhāti","lemma":"ذُو","root":null,"entryId":"l-ea5c5c22a86c9f67"},{"key":"89:7:3","position":3,"arabic":"ٱلْعِمَادِ","kind":"word","gloss":"lofty pillars","transliteration":"l-ʿimādi","lemma":"عِمَاد","root":"عمد","entryId":null},{"key":"89:7:4","position":4,"arabic":"٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"89:8","translation":"The like of which were not created in the land?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"89:8:1","position":1,"arabic":"ٱلَّتِى","kind":"word","gloss":"Which","transliteration":"allatī","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"89:8:2","position":2,"arabic":"لَمْ","kind":"word","gloss":"not","transliteration":"lam","lemma":"لَم","root":null,"entryId":"l-a5ee2f54ca9bbf2c"},{"key":"89:8:3","position":3,"arabic":"يُخْلَقْ","kind":"word","gloss":"had been created","transliteration":"yukh'laq","lemma":"خَلَقَ","root":"خلق","entryId":"l-9e7414ba00a88ddc"},{"key":"89:8:4","position":4,"arabic":"مِثْلُهَا","kind":"word","gloss":"like them","transliteration":"mith'luhā","lemma":"مِثْل","root":"مثل","entryId":"l-81f137731af180e3"},{"key":"89:8:5","position":5,"arabic":"فِى","kind":"word","gloss":"in","transliteration":"fī","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"89:8:6","position":6,"arabic":"ٱلْبِلَـٰدِ","kind":"word","gloss":"the cities","transliteration":"l-bilādi","lemma":"بَلَد","root":"بلد","entryId":null},{"key":"89:8:7","position":7,"arabic":"٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"89:9","translation":"And (with) Thamûd (people), who hewed out rocks in the valley (to make dwellings)?","translationSource":"qul-301-hilali-khan","notes":[{"text":"\"And you hew out in the mountains, houses with great skill.\" [The Qur’ân, Verse 26:149].","ref":null}],"tokens":[{"key":"89:9:1","position":1,"arabic":"وَثَمُودَ","kind":"word","gloss":"And Thamud","transliteration":"wathamūda","lemma":"ثَمُود","root":null,"entryId":null},{"key":"89:9:2","position":2,"arabic":"ٱلَّذِينَ","kind":"word","gloss":"who","transliteration":"alladhīna","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"89:9:3","position":3,"arabic":"جَابُوا۟","kind":"word","gloss":"carved out","transliteration":"jābū","lemma":"جَابُ","root":"جوب","entryId":null},{"key":"89:9:4","position":4,"arabic":"ٱلصَّخْرَ","kind":"word","gloss":"the rocks","transliteration":"l-ṣakhra","lemma":"صَّخْر","root":"صخر","entryId":null},{"key":"89:9:5","position":5,"arabic":"بِٱلْوَادِ","kind":"word","gloss":"in the valley","transliteration":"bil-wādi","lemma":"وَاد","root":"ودي","entryId":null},{"key":"89:9:6","position":6,"arabic":"٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"89:10","translation":"And (with) Fir‘aun (Pharaoh) who had the stakes (to torture men by binding them to the stakes)?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"89:10:1","position":1,"arabic":"وَفِرْعَوْنَ","kind":"word","gloss":"And Firaun","transliteration":"wafir'ʿawna","lemma":"فِرْعَوْن","root":null,"entryId":"l-59e880136eb31a4d"},{"key":"89:10:2","position":2,"arabic":"ذِى","kind":"word","gloss":"owner of","transliteration":"dhī","lemma":"ذُو","root":null,"entryId":"l-ea5c5c22a86c9f67"},{"key":"89:10:3","position":3,"arabic":"ٱلْأَوْتَادِ","kind":"word","gloss":"stakes","transliteration":"l-awtādi","lemma":"أَوْتَاد","root":"وتد","entryId":null},{"key":"89:10:4","position":4,"arabic":"١٠","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"89:11","translation":"Who did transgress beyond bounds in the lands (in the disobedience of Allâh).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"89:11:1","position":1,"arabic":"ٱلَّذِينَ","kind":"word","gloss":"Who","transliteration":"alladhīna","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"89:11:2","position":2,"arabic":"طَغَوْا۟","kind":"word","gloss":"transgressed","transliteration":"ṭaghaw","lemma":"طَغَىٰ","root":"طغي","entryId":null},{"key":"89:11:3","position":3,"arabic":"فِى","kind":"word","gloss":"in","transliteration":"fī","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"89:11:4","position":4,"arabic":"ٱلْبِلَـٰدِ","kind":"word","gloss":"the lands","transliteration":"l-bilādi","lemma":"بَلَد","root":"بلد","entryId":null},{"key":"89:11:5","position":5,"arabic":"١١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"89:12","translation":"And made therein much mischief.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"89:12:1","position":1,"arabic":"فَأَكْثَرُوا۟","kind":"word","gloss":"And (made) much","transliteration":"fa-aktharū","lemma":"أَكْثَرُ","root":"كثر","entryId":null},{"key":"89:12:2","position":2,"arabic":"فِيهَا","kind":"word","gloss":"therein","transliteration":"fīhā","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"89:12:3","position":3,"arabic":"ٱلْفَسَادَ","kind":"word","gloss":"corruption","transliteration":"l-fasāda","lemma":"فَسَاد","root":"فسد","entryId":null},{"key":"89:12:4","position":4,"arabic":"١٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"89:13","translation":"So your Lord poured on them different kinds of severe torment.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"89:13:1","position":1,"arabic":"فَصَبَّ","kind":"word","gloss":"So poured","transliteration":"faṣabba","lemma":"صَبَّ","root":"صبب","entryId":null},{"key":"89:13:2","position":2,"arabic":"عَلَيْهِمْ","kind":"word","gloss":"on them","transliteration":"ʿalayhim","lemma":"عَلَىٰ","root":null,"entryId":"l-08dd9283adb70e54"},{"key":"89:13:3","position":3,"arabic":"رَبُّكَ","kind":"word","gloss":"your Lord","transliteration":"rabbuka","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"89:13:4","position":4,"arabic":"سَوْطَ","kind":"word","gloss":"scourge","transliteration":"sawṭa","lemma":"سَوْط","root":"سوط","entryId":null},{"key":"89:13:5","position":5,"arabic":"عَذَابٍ","kind":"word","gloss":"(of) punishment","transliteration":"ʿadhābin","lemma":"عَذَاب","root":"عذب","entryId":"l-3eb7e15951d31876"},{"key":"89:13:6","position":6,"arabic":"١٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"89:14","translation":"Verily, your Lord is Ever Watchful (over them).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"89:14:1","position":1,"arabic":"إِنَّ","kind":"word","gloss":"Indeed","transliteration":"inna","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"89:14:2","position":2,"arabic":"رَبَّكَ","kind":"word","gloss":"your Lord","transliteration":"rabbaka","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"89:14:3","position":3,"arabic":"لَبِٱلْمِرْصَادِ","kind":"word","gloss":"(is) surely Ever Watchful","transliteration":"labil-mir'ṣādi","lemma":"مِرْصَاد","root":"رصد","entryId":null},{"key":"89:14:4","position":4,"arabic":"١٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"89:15","translation":"As for man, when his Lord tries him by giving him honour and bounties, then he says (in exultation): \"My Lord has honoured me.\"","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"89:15:1","position":1,"arabic":"فَأَمَّا","kind":"word","gloss":"And as for","transliteration":"fa-ammā","lemma":"أَمَّا","root":null,"entryId":"l-6c43b34cf75dec4b"},{"key":"89:15:2","position":2,"arabic":"ٱلْإِنسَـٰنُ","kind":"word","gloss":"man","transliteration":"l-insānu","lemma":"إِنسَٰن","root":"انس","entryId":"l-bec7f7166ce0ed1b"},{"key":"89:15:3","position":3,"arabic":"إِذَا","kind":"word","gloss":"when","transliteration":"idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"89:15:4","position":4,"arabic":"مَا","kind":"word","gloss":"does","transliteration":"mā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"89:15:5","position":5,"arabic":"ٱبْتَلَىٰهُ","kind":"word","gloss":"try him","transliteration":"ib'talāhu","lemma":"ابْتَلَىٰٓ","root":"بلو","entryId":null},{"key":"89:15:6","position":6,"arabic":"رَبُّهُۥ","kind":"word","gloss":"his Lord","transliteration":"rabbuhu","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"89:15:7","position":7,"arabic":"فَأَكْرَمَهُۥ","kind":"word","gloss":"and is generous to him","transliteration":"fa-akramahu","lemma":"أَكْرَمَ","root":"كرم","entryId":null},{"key":"89:15:8","position":8,"arabic":"وَنَعَّمَهُۥ","kind":"word","gloss":"and favors him","transliteration":"wanaʿʿamahu","lemma":"نَعَّمَ","root":"نعم","entryId":null},{"key":"89:15:9","position":9,"arabic":"فَيَقُولُ","kind":"word","gloss":"he says","transliteration":"fayaqūlu","lemma":"قَالَ","root":"قول","entryId":"l-effaf24a5c86c56f"},{"key":"89:15:10","position":10,"arabic":"رَبِّىٓ","kind":"word","gloss":"My Lord","transliteration":"rabbī","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"89:15:11","position":11,"arabic":"أَكْرَمَنِ","kind":"word","gloss":"has honored me","transliteration":"akramani","lemma":"أَكْرَمَ","root":"كرم","entryId":null},{"key":"89:15:12","position":12,"arabic":"١٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"89:16","translation":"But when He tries him by straitening his means of life, he says: \"My Lord has humiliated me!\"","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"89:16:1","position":1,"arabic":"وَأَمَّآ","kind":"word","gloss":"But","transliteration":"wa-ammā","lemma":"أَمَّا","root":null,"entryId":"l-6c43b34cf75dec4b"},{"key":"89:16:2","position":2,"arabic":"إِذَا","kind":"word","gloss":"when","transliteration":"idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"89:16:3","position":3,"arabic":"مَا","kind":"word","gloss":"does","transliteration":"mā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"89:16:4","position":4,"arabic":"ٱبْتَلَىٰهُ","kind":"word","gloss":"He try him","transliteration":"ib'talāhu","lemma":"ابْتَلَىٰٓ","root":"بلو","entryId":null},{"key":"89:16:5","position":5,"arabic":"فَقَدَرَ","kind":"word","gloss":"and restricts","transliteration":"faqadara","lemma":"قَدَرَ","root":"قدر","entryId":null},{"key":"89:16:6","position":6,"arabic":"عَلَيْهِ","kind":"word","gloss":"for him","transliteration":"ʿalayhi","lemma":"عَلَىٰ","root":null,"entryId":"l-08dd9283adb70e54"},{"key":"89:16:7","position":7,"arabic":"رِزْقَهُۥ","kind":"word","gloss":"his provision","transliteration":"riz'qahu","lemma":"رِزْق","root":"رزق","entryId":"l-57ceb895860a7c5b"},{"key":"89:16:8","position":8,"arabic":"فَيَقُولُ","kind":"word","gloss":"then he says","transliteration":"fayaqūlu","lemma":"قَالَ","root":"قول","entryId":"l-effaf24a5c86c56f"},{"key":"89:16:9","position":9,"arabic":"رَبِّىٓ","kind":"word","gloss":"My Lord","transliteration":"rabbī","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"89:16:10","position":10,"arabic":"أَهَـٰنَنِ","kind":"word","gloss":"(has) humiliated me","transliteration":"ahānani","lemma":"أَهَٰنَ","root":"هون","entryId":null},{"key":"89:16:11","position":11,"arabic":"١٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"89:17","translation":"Nay! But you treat not the orphans with kindness and generosity (i.e. you neither treat them well, nor give them their exact right of inheritance)!","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"89:17:1","position":1,"arabic":"كَلَّا ۖ","kind":"word","gloss":"Nay","transliteration":"kallā","lemma":"كَلَّا","root":null,"entryId":null},{"key":"89:17:2","position":2,"arabic":"بَل","kind":"word","gloss":"But","transliteration":"bal","lemma":"بَل","root":null,"entryId":"l-706f9c6eca0445cc"},{"key":"89:17:3","position":3,"arabic":"لَّا","kind":"word","gloss":"not","transliteration":"lā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"89:17:4","position":4,"arabic":"تُكْرِمُونَ","kind":"word","gloss":"you honor","transliteration":"tuk'rimūna","lemma":"أَكْرَمَ","root":"كرم","entryId":null},{"key":"89:17:5","position":5,"arabic":"ٱلْيَتِيمَ","kind":"word","gloss":"the orphan","transliteration":"l-yatīma","lemma":"يَتِيم","root":"يتم","entryId":null},{"key":"89:17:6","position":6,"arabic":"١٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"89:18","translation":"And urge not one another on the feeding of Al-Miskîn (the poor)!","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"89:18:1","position":1,"arabic":"وَلَا","kind":"word","gloss":"And not","transliteration":"walā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"89:18:2","position":2,"arabic":"تَحَـٰٓضُّونَ","kind":"word","gloss":"you feel the urge","transliteration":"taḥāḍḍūna","lemma":"تَحَٰٓضُّ","root":"حضض","entryId":null},{"key":"89:18:3","position":3,"arabic":"عَلَىٰ","kind":"word","gloss":"to","transliteration":"ʿalā","lemma":"عَلَىٰ","root":null,"entryId":"l-08dd9283adb70e54"},{"key":"89:18:4","position":4,"arabic":"طَعَامِ","kind":"word","gloss":"feed","transliteration":"ṭaʿāmi","lemma":"طَعَام","root":"طعم","entryId":null},{"key":"89:18:5","position":5,"arabic":"ٱلْمِسْكِينِ","kind":"word","gloss":"the poor","transliteration":"l-mis'kīni","lemma":"مِسْكِين","root":"سكن","entryId":null},{"key":"89:18:6","position":6,"arabic":"١٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"89:19","translation":"And you devour the inheritance all with greed.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"89:19:1","position":1,"arabic":"وَتَأْكُلُونَ","kind":"word","gloss":"And you consume","transliteration":"watakulūna","lemma":"أَكَلَ","root":"اكل","entryId":"l-dd3887135f91e5c7"},{"key":"89:19:2","position":2,"arabic":"ٱلتُّرَاثَ","kind":"word","gloss":"the inheritance","transliteration":"l-turātha","lemma":"تُّرَاث","root":"ورث","entryId":null},{"key":"89:19:3","position":3,"arabic":"أَكْلًۭا","kind":"word","gloss":"devouring","transliteration":"aklan","lemma":"أَكْل","root":"اكل","entryId":null},{"key":"89:19:4","position":4,"arabic":"لَّمًّۭا","kind":"word","gloss":"altogether","transliteration":"lamman","lemma":"لَّمّ","root":"لمم","entryId":null},{"key":"89:19:5","position":5,"arabic":"١٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"89:20","translation":"And you love wealth with much love.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"89:20:1","position":1,"arabic":"وَتُحِبُّونَ","kind":"word","gloss":"And you love","transliteration":"watuḥibbūna","lemma":"أَحْبَبْ","root":"حبب","entryId":"l-43478ad8b9caa513"},{"key":"89:20:2","position":2,"arabic":"ٱلْمَالَ","kind":"word","gloss":"wealth","transliteration":"l-māla","lemma":"مَال","root":"مول","entryId":"l-ae66a2452b005081"},{"key":"89:20:3","position":3,"arabic":"حُبًّۭا","kind":"word","gloss":"(with) love","transliteration":"ḥubban","lemma":"حُبّ","root":"حبب","entryId":null},{"key":"89:20:4","position":4,"arabic":"جَمًّۭا","kind":"word","gloss":"immense","transliteration":"jamman","lemma":"جَمّ","root":"جمم","entryId":null},{"key":"89:20:5","pos