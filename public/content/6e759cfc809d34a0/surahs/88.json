:"وجه","entryId":"l-a02f5e824d673730"},{"key":"88:8:2","position":2,"arabic":"يَوْمَئِذٍۢ","kind":"word","gloss":"that Day","transliteration":"yawma-idhin","lemma":"يَوْمَئِذ","root":"يوم","entryId":"l-675d35e3d4bddca4"},{"key":"88:8:3","position":3,"arabic":"نَّاعِمَةٌۭ","kind":"word","gloss":"(will be) joyful","transliteration":"nāʿimatun","lemma":"نَّاعِمَة","root":"نعم","entryId":null},{"key":"88:8:4","position":4,"arabic":"٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"88:9","translation":"Glad with their endeavour (for their good deeds which they did in this world, along with the true Faith of Islâmic Monotheism).","translationSource":"qul-301-hilali-khan","notes":[{"text":"See footnote of (V.18:104).","ref":{"surah":18,"ayah":104}}],"tokens":[{"key":"88:9:1","position":1,"arabic":"لِّسَعْيِهَا","kind":"word","gloss":"With their effort","transliteration":"lisaʿyihā","lemma":"سَعْي","root":"سعي","entryId":null},{"key":"88:9:2","position":2,"arabic":"رَاضِيَةٌۭ","kind":"word","gloss":"satisfied","transliteration":"rāḍiyatun","lemma":"رَاضِيَة","root":"رضو","entryId":null},{"key":"88:9:3","position":3,"arabic":"٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"88:10","translation":"In a lofty Paradise.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"88:10:1","position":1,"arabic":"فِى","kind":"word","gloss":"In","transliteration":"fī","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"88:10:2","position":2,"arabic":"جَنَّةٍ","kind":"word","gloss":"a garden","transliteration":"jannatin","lemma":"جَنَّة","root":"جنن","entryId":"l-9f22ab6b78dd8a22"},{"key":"88:10:3","position":3,"arabic":"عَالِيَةٍۢ","kind":"word","gloss":"elevated","transliteration":"ʿāliyatin","lemma":"عَالِيَة","root":"علو","entryId":null},{"key":"88:10:4","position":4,"arabic":"١٠","kind":"end-marker","gloss":"","transliteration":"","lemma":nul