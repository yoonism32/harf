d","gloss":"the sky","transliteration":"l-samāi","lemma":"سَمَآء","root":"سمو","entryId":"l-e873a75addf25baf"},{"key":"88:18:3","position":3,"arabic":"كَيْفَ","kind":"word","gloss":"how","transliteration":"kayfa","lemma":"كَيْف","root":"كيف","entryId":"l-9ae8af732625ada5"},{"key":"88:18:4","position":4,"arabic":"رُفِعَتْ","kind":"word","gloss":"it is raised","transliteration":"rufiʿat","lemma":"رَفَعَ","root":"رفع","entryId":null},{"key":"88:18:5","position":5,"arabic":"١٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"88:19","translation":"And at the mountains, how they are rooted (and fixed firm)?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"88:19:1","position":1,"arabic":"وَإِلَى","kind":"word","gloss":"And towards","transliteration":"wa-ilā","lemma":"إِلَىٰ","root":null,"entryId":"l-53539d2c3606b99e"},{"key":"88:19:2","position":2,"arabic":"ٱلْجِبَالِ","kind":"word","gloss":"the mountains","transliteration":"l-jibāli","lemma":"جَبَل","root":"جبل","entryId":"l-740cdd8405f7481e"},{"key":"88:19:3","position":3,"arabic":"كَيْفَ","kind":"word","gloss":"how","transliteration":"kayfa","lemma":"كَيْف","root":"كيف","entryId":"l-9ae8af732625ada5"},{"key":"88:19:4","position":4,"arabic":"نُصِبَتْ","kind":"word","gloss":"they are fixed","transliteration":"nuṣibat","lemma":"نُصِبَتْ","root":"نصب","entryId":null},{"key":"88:19:5","position":5,"arabic":"١٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"88:20","translation":"And at the earth, how it is outspread?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"88:20:1","position":1,"arabic":"وَإِلَى","kind":"word","gloss":"And towards","transliteration":"wa-ilā","lemma":"إِلَىٰ","root":null,"entryId":"l-53539d2c3606b99e"},{"key":"88:20:2","position":2,"arabic":"ٱلْأَرْضِ","kind":"word","gloss":"the earth","transliteration":"l-arḍi","lemma":"أَرْض","root":"ارض","entr