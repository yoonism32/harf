[{"ref":"88:1","translation":"Has there come to you the narration of the overwhelming (i.e. the Day of Resurrection)?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"88:1:1","position":1,"arabic":"هَلْ","kind":"word","gloss":"Has","transliteration":"hal","lemma":"هَل","root":null,"entryId":"l-acd15f3532f2b613"},{"key":"88:1:2","position":2,"arabic":"أَتَىٰكَ","kind":"word","gloss":"(there) come to you","transliteration":"atāka","lemma":"أَتَى","root":"اتي","entryId":"l-491a40b1f8d047fe"},{"key":"88:1:3","position":3,"arabic":"حَدِيثُ","kind":"word","gloss":"(the) news","transliteration":"ḥadīthu","lemma":"حَدِيث","root":"حدث","entryId":null},{"key":"88:1:4","position":4,"arabic":"ٱلْغَـٰشِيَةِ","kind":"word","gloss":"(of) the Overwhelming","transliteration":"l-ghāshiyati","lemma":"غَٰشِيَة","root":"غشو","entryId":null},{"key":"88:1:5","position":5,"arabic":"١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"88:2","translation":"Some faces, that Day will be humiliated (in the Hell-fire, i.e. the faces of all disbelievers, Jews and Christians).","translationSource":"qul-301-hilali-khan","notes":[{"text":"It is obligatory to have Belief in the Messengership of the Prophet (Muhammad صلى الله عليه وسلم). Narrated Abu Hurairah رضي الله عنه: Allâh’s Messenger صلى الله عليه وسلم said: \"By Him (Allâh) in Whose Hand Muhammad’s soul is, there is none from amongst the Jews and Christians (of these present nations) who hears about me and then dies without believing in the Message with which I have been sent (i.e. Islâmic Monotheism), but he will be from the dwellers of the (Hell) Fire.\" (Sahih Muslim , the Book of Faith, Vol.1, Chapter No.240). See also the footnotes of (V.3:85) and (V.41:46).","ref":null}],"tokens":[{"key":"88:2:1","position":1,"arabic":"وُجُوهٌۭ","kind":"word","gloss":"Faces","transliteration":"wujūhun","lemma":"وَجْه","root":"وجه","entryId":"l-a02f5e824d673730"},{"key":"88:2:2","position":2,"arabic":"يَوْمَئِذٍ","kind":"word","gloss":"that Day","transliteration":"yawma-idhin","lemma":"يَوْمَئِذ","root":"يوم","entryId":"l-675d35e3d4bddca4"},{"key":"88:2:3","position":3,"arabic":"خَـٰشِعَةٌ","kind":"word","gloss":"(will be) humbled","transliteration":"khāshiʿatun","lemma":"خَاشِع","root":"خشع","entryId":null},{"key":"88:2:4","position":4,"arabic":"٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"88:3","translation":"Labouring (hard in the worldly life by worshipping others besides Allâh), weary (in the Hereafter with humility and disgrace).","translationSource":"qul-301-hilali-khan","notes":[{"text":"Narrated ‘Abdullâh رضي الله عنه: \"The Prophet صلى الله عليه وسلم said one statement and I said another. The Prophet صلى الله عليه وسلم said: \"Whoever dies while still invoking anything other than Allâh as a rival to Allâh, will enter Hell (Fire).’ And I said, ‘Whoever dies without invoking anything as a rival to Allâh, will enter Paradise.’\" (Sahih Al-Bukhari, Vol.6, Hadith No.24).","ref":null}],"tokens":[{"key":"88:3:1","position":1,"arabic":"عَامِلَةٌۭ","kind":"word","gloss":"Laboring","transliteration":"ʿāmilatun","lemma":"عَامِلَة","root":"عمل","entryId":null},{"key":"88:3:2","position":2,"arabic":"نَّاصِبَةٌۭ","kind":"word","gloss":"exhausted","transliteration":"nāṣibatun","lemma":"نَّاصِبَة","root":"نصب","entryId":null},{"key":"88:3:3","position":3,"arabic":"٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"88:4","translation":"They will enter in the hot blazing Fire.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"88:4:1","position":1,"arabic":"تَصْلَىٰ","kind":"word","gloss":"They will burn","transliteration":"taṣlā","lemma":"يَصْلَى","root":"صلي","entryId":null},{"key":"88:4:2","position":2,"arabic":"نَارًا","kind":"word","gloss":"(in) a Fire","transliteration":"nāran","lemma":"نَار","root":"نور","entryId":"l-1f4c1e0172701e6e"},{"key":"88:4:3","position":3,"arabic":"حَامِيَةًۭ","kind":"word","gloss":"intensely hot","transliteration":"ḥāmiyatan","lemma":"حَامِيَة","root":"حمي","entryId":null},{"key":"88:4:4","position":4,"arabic":"٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"88:5","translation":"They will be given to drink from a boiling spring,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"88:5:1","position":1,"arabic":"تُسْقَىٰ","kind":"word","gloss":"They will be given to drink","transliteration":"tus'qā","lemma":"سَقَىٰ","root":"سقي","entryId":null},{"key":"88:5:2","position":2,"arabic":"مِنْ","kind":"word","gloss":"from","transliteration":"min","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"88:5:3","position":3,"arabic":"عَيْنٍ","kind":"word","gloss":"a spring","transliteration":"ʿaynin","lemma":"عَيْن","root":"عين","entryId":"l-1b5ec51c16058996"},{"key":"88:5:4","position":4,"arabic":"ءَانِيَةٍۢ","kind":"word","gloss":"boiling","transliteration":"āniyatin","lemma":"ءَانِيَة","root":"اني","entryId":null},{"key":"88:5:5","position":5,"arabic":"٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"88:6","translation":"No food will there be for them but a poisonous thorny plant,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"88:6:1","position":1,"arabic":"لَّيْسَ","kind":"word","gloss":"Not is","transliteration":"laysa","lemma":"لَّيْسَ","root":"ليس","entryId":"l-58baf429de13c405"},{"key":"88:6:2","position":2,"arabic":"لَهُمْ","kind":"word","gloss":"for them","transliteration":"lahum","lemma":null,"root":null,"entryId":null},{"key":"88:6:3","position":3,"arabic":"طَعَامٌ","kind":"word","gloss":"food","transliteration":"ṭaʿāmun","lemma":"طَعَام","root":"طعم","entryId":null},{"key":"88:6:4","position":4,"arabic":"إِلَّا","kind":"word","gloss":"except","transliteration":"illā","lemm