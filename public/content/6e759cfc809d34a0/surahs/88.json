ma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"88:13:2","position":2,"arabic":"سُرُرٌۭ","kind":"word","gloss":"(will be) thrones","transliteration":"sururun","lemma":"سُرُر","root":"سرر","entryId":null},{"key":"88:13:3","position":3,"arabic":"مَّرْفُوعَةٌۭ","kind":"word","gloss":"raised high","transliteration":"marfūʿatun","lemma":"مَّرْفُوعَة","root":"رفع","entryId":null},{"key":"88:13:4","position":4,"arabic":"١٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"88:14","translation":"And cups set at hand.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"88:14:1","position":1,"arabic":"وَأَكْوَابٌۭ","kind":"word","gloss":"And cups","transliteration":"wa-akwābun","lemma":"أَكْوَاب","root":"كوب","entryId":null},{"key":"88:14:2","position":2,"arabic":"مَّوْضُوعَةٌۭ","kind":"word","gloss":"put in place","transliteration":"mawḍūʿatun","lemma":"مَّوْضُوعَة","root":"وضع","entryId":null},{"key":"88:14:3","position":3,"arabic":"١٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"88:15","translation":"And cushions set in rows.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"88:15:1","position":1,"arabic":"وَنَمَارِقُ","kind":"word","gloss":"And cushions","transliteration":"wanamāriqu","lemma":"نَمَارِق","root":null,"entryId":null},{"key":"88:15:2","position":2,"arabic":"مَصْفُوفَةٌۭ","kind":"word","gloss":"lined up","transliteration":"maṣfūfatun","lemma":"مَصْفُوفَة","root":"صفف","entryId":null},{"key":"88:15:3","position":3,"arabic":"١٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"88:16","translation":"And rich carpets (all) spread out.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"88:16:1","position":1,"arabic":"وَزَرَابِىُّ","kind":"word","gloss":"And carpets","transliteration":"wazarābiyyu","lemma":"زَرَابِىّ","root":nu