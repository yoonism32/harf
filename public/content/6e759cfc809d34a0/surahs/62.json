Then when the (Jumu‘ah) Salât (prayer) is ended, you may disperse through the land, and seek the Bounty of Allâh (by working, etc.), and remember Allâh much: that you may be successful.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"62:10:1","position":1,"arabic":"فَإِذَا","kind":"word","gloss":"Then when","transliteration":"fa-idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"62:10:2","position":2,"arabic":"قُضِيَتِ","kind":"word","gloss":"is concluded","transliteration":"quḍiyati","lemma":"قَضَىٰٓ","root":"قضي","entryId":"l-032afbffebf8e33d"},{"key":"62:10:3","position":3,"arabic":"ٱلصَّلَوٰةُ","kind":"word","gloss":"the prayer","transliteration":"l-ṣalatu","lemma":"صَلَوٰة","root":"صلو","entryId":"l-7ecacdc275cdb0a8"},{"key":"62:10:4","position":4,"arabic":"فَٱنتَشِرُوا۟","kind":"word","gloss":"then disperse","transliteration":"fa-intashirū","lemma":"تَنتَشِرُ","root":"نشر","entryId":null},{"key":"62:10:5","position":5,"arabic":"فِى","kind":"word","gloss":"in","transliteration":"fī","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"62:10:6","position":6,"arabic":"ٱلْأَرْضِ","kind":"word","gloss":"the land","transliteration":"l-arḍi","lemma":"أَرْض","root":"ارض","entryId":"l-2c626a3b4c64dbc9"},{"key":"62:10:7","position":7,"arabic":"وَٱبْتَغُوا۟","kind":"word","gloss":"and seek","transliteration":"wa-ib'taghū","lemma":"ابْتَغَىٰ","root":"بغي","entryId":null},{"key":"62:10:8","position":8,"arabic":"مِن","kind":"word","gloss":"from","transliteration":"min","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"62:10:9","position":9,"arabic":"فَضْلِ","kind":"word","gloss":"(the) Bounty","transliteration":"faḍli","lemma":"فَضْل","root":"فضل","entryId":"l-b99133c7988741eb"},{"key":"62:10:10","position":10,"arabic":"ٱللَّهِ","kind":"word","gloss":"(of) Allah","transliteration":"l-lahi","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"62:10:11","position":11,"arabic":"وَٱذْكُ