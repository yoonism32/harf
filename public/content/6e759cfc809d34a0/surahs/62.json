 Friday (Jumu‘ah prayer), come to the remembrance of Allâh [Jumu‘ah religious talk (Khutbah) and Salât (prayer)] and leave off business (and every other thing). That is better for you if you did but know!","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"62:9:1","position":1,"arabic":"يَـٰٓأَيُّهَا","kind":"word","gloss":"O you","transliteration":"yāayyuhā","lemma":"أَيُّهَا","root":"ايي","entryId":"l-a3fa5dd17841b221"},{"key":"62:9:2","position":2,"arabic":"ٱلَّذِينَ","kind":"word","gloss":"those who(believe)","transliteration":"alladhīna","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"62:9:3","position":3,"arabic":"ءَامَنُوٓا۟","kind":"word","gloss":"believe","transliteration":"āmanū","lemma":"ءَامَنَ","root":"امن","entryId":"l-f6ec3a6dc0f76aa6"},{"key":"62:9:4","position":4,"arabic":"إِذَا","kind":"word","gloss":"When","transliteration":"idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"62:9:5","position":5,"arabic":"نُودِىَ","kind":"word","gloss":"(the) call is made","transliteration":"nūdiya","lemma":"نَادَىٰ","root":"ندو","entryId":"l-8deac0887cc12444"},{"key":"62:9:6","position":6,"arabic":"لِلصَّلَوٰةِ","kind":"word","gloss":"for (the) prayer","transliteration":"lilṣṣalati","lemma":"صَلَوٰة","root":"صلو","entryId":"l-7ecacdc275cdb0a8"},{"key":"62:9:7","position":7,"arabic":"مِن","kind":"word","gloss":"on","transliteration":"min","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"62:9:8","position":8,"arabic":"يَوْمِ","kind":"word","gloss":"(the) day","transliteration":"yawmi","lemma":"يَوْم","root":"يوم","entryId":"l-bd6f5747b4dfe79c"},{"key":"62:9:9","position":9,"arabic":"ٱلْجُمُعَةِ","kind":"word","gloss":"(of) Friday","transliteration":"l-jumuʿati","lemma":"جُمُعَة","root":"جمع","entryId":null},{"key":"62:9:10","position":10,"arabic":"فَٱسْعَوْا۟","kind":"word","gloss":"then hasten","transliteration":"fa-is'ʿaw","lemma":"سَعَىٰ","root":"سعي","entryId":null},{"key":"62:9:1