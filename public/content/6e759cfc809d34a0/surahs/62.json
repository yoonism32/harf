[{"ref":"62:1","translation":"Whatsoever is in the heavens and whatsoever is on the earth glorifies Allâh, the King (of everything), the Holy, the All-Mighty, the All-Wise.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"62:1:1","position":1,"arabic":"يُسَبِّحُ","kind":"word","gloss":"Glorifies","transliteration":"yusabbiḥu","lemma":"سَبَّحَ","root":"سبح","entryId":"l-2e7f33ad65358df7"},{"key":"62:1:2","position":2,"arabic":"لِلَّهِ","kind":"word","gloss":"Allah","transliteration":"lillahi","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"62:1:3","position":3,"arabic":"مَا","kind":"word","gloss":"whatever","transliteration":"mā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"62:1:4","position":4,"arabic":"فِى","kind":"word","gloss":"(is) in","transliteration":"fī","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"62:1:5","position":5,"arabic":"ٱلسَّمَـٰوَٰتِ","kind":"word","gloss":"the heavens","transliteration":"l-samāwāti","lemma":"سَمَآء","root":"سمو","entryId":"l-e873a75addf25baf"},{"key":"62:1:6","position":6,"arabic":"وَمَا","kind":"word","gloss":"and whatever","transliteration":"wamā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"62:1:7","position":7,"arabic":"فِى","kind":"word","gloss":"(is) in","transliteration":"fī","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"62:1:8","position":8,"arabic":"ٱلْأَرْضِ","kind":"word","gloss":"the earth","transliteration":"l-arḍi","lemma":"أَرْض","root":"ارض","entryId":"l-2c626a3b4c64dbc9"},{"key":"62:1:9","position":9,"arabic":"ٱلْمَلِكِ","kind":"word","gloss":"the Sovereign","transliteration":"l-maliki","lemma":"مَلِك","root":"ملك","entryId":null},{"key":"62:1:10","position":10,"arabic":"ٱلْقُدُّوسِ","kind":"word","gloss":"the Holy","transliteration":"l-qudūsi","lemma":"قُدُّوس","root":"قدس","entryId":null},{"key":"62:1:11","position":11,"arabic":"ٱلْعَزِيزِ","kind":"word","gloss":"the All-Mighty","transliteration":"l-ʿazīzi","lemma":"عَزِيز","root":"عزز","entryId":"l-da1ac3fcbe3eed57"},{"key":"62:1:12","position":12,"arabic":"ٱلْحَكِيمِ","kind":"word","gloss":"the All-Wise","transliteration":"l-ḥakīmi","lemma":"حَكِيم","root":"حكم","entryId":"l-a583e31fa7264499"},{"key":"62:1:13","position":13,"arabic":"١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"62:2","translation":"He it is Who sent among the unlettered ones a Messenger (Muhammad صلى الله عليه وسلم) from among themselves, reciting to them His Verses, purifying them (from the filth of disbelief and polytheism), and teaching them the Book (this Qur’ân, Islâmic laws and Islâmic jurisprudence) and Al-Hikmah (As-Sunnah: legal ways, orders, acts of worship of Prophet Muhammad صلى الله عليه وسلم). And verily, they had been before in manifest error;","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"62:2:1","position":1,"arabic":"هُوَ","kind":"word","gloss":"He","transliteration":"huwa","lemma":null,"root":null,"entryId":null},{"key":"62:2:2","position":2,"arabic":"ٱلَّذِى","kind":"word","gloss":"(is) the One Who","transliteration":"alladhī","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"62:2:3","position":3,"arabic":"بَعَثَ","kind":"word","gloss":"sent","transliteration":"baʿatha","lemma":"بَعَثَ","root":"بعث","entryId":"l-8167acd93c52740b"},{"key":"62:2:4","position":4,"arabic":"فِى","kind":"word","gloss":"among","transliteration":"fī","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"62:2:5","position":5,"arabic":"ٱلْأُمِّيِّـۧنَ","kind":"word","gloss":"the unlettered","transliteration":"l-umiyīna","lemma":"أُمِّىّ","root":"امم","entryId":null},{"key":"62:2:6","position":6,"arabic":"رَسُولًۭا","kind":"word","gloss":"a Messenger","transliteration":"rasūlan","lemma":"رَسُول","root":"رسل","entryId":"l-165e008d0f146d23"},{"key":"62:2:7","position":7,"arabic":"مِّنْهُمْ","kind":"word","gloss":"from them