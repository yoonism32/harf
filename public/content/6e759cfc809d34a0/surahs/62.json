":"word","gloss":"you are","transliteration":"kuntum","lemma":"كَانَ","root":"كون","entryId":"l-4b2f9969a9af0d45"},{"key":"62:6:17","position":17,"arabic":"صَـٰدِقِينَ","kind":"word","gloss":"truthful","transliteration":"ṣādiqīna","lemma":"صَادِق","root":"صدق","entryId":"l-bd83ae72c191f98b"},{"key":"62:6:18","position":18,"arabic":"٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"62:7","translation":"But they will never long for it (death), because of what (deeds) their hands have sent before them! And Allâh knows well the Zâlimûn (polytheists, wrong-doers, disbelievers).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"62:7:1","position":1,"arabic":"وَلَا","kind":"word","gloss":"But not","transliteration":"walā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"62:7:2","position":2,"arabic":"يَتَمَنَّوْنَهُۥٓ","kind":"word","gloss":"they will wish for it","transliteration":"yatamannawnahu","lemma":"يَتَمَنَّ","root":"مني","entryId":null},{"key":"62:7:3","position":3,"arabic":"أَبَدًۢا","kind":"word","gloss":"ever","transliteration":"abadan","lemma":"أَبَدًا","root":"ابد","entryId":null},{"key":"62:7:4","position":4,"arabic":"بِمَا","kind":"word","gloss":"for what","transliteration":"bimā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"62:7:5","position":5,"arabic":"قَدَّمَتْ","kind":"word","gloss":"(have) sent forth","transliteration":"qaddamat","lemma":"قَدَّمَ","root":"قدم","entryId":null},{"key":"62:7:6","position":6,"arabic":"أَيْدِيهِمْ ۚ","kind":"word","gloss":"their hands","transliteration":"aydīhim","lemma":"يَد","root":"يدي","entryId":"l-d6185269501ba306"},{"key":"62:7:7","position":7,"arabic":"وَٱللَّهُ","kind":"word","gloss":"And Allah","transliteration":"wal-lahu","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"62:7:8","position":8,"arabic":"عَلِيمٌۢ","kind":"word","gloss":"(is) All-Knowing","transliteration":"ʿalīmun"