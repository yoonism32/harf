[{"ref":"94:1","translation":"Have We not opened your breast for you (O Muhammad صلى الله عليه وسلم)?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"94:1:1","position":1,"arabic":"أَلَمْ","kind":"word","gloss":"Have not","transliteration":"alam","lemma":"لَم","root":null,"entryId":"l-a5ee2f54ca9bbf2c"},{"key":"94:1:2","position":2,"arabic":"نَشْرَحْ","kind":"word","gloss":"We expanded","transliteration":"nashraḥ","lemma":"شَرَحَ","root":"شرح","entryId":null},{"key":"94:1:3","position":3,"arabic":"لَكَ","kind":"word","gloss":"for you","transliteration":"laka","lemma":null,"root":null,"entryId":null},{"key":"94:1:4","position":4,"arabic":"صَدْرَكَ","kind":"word","gloss":"your breast","transliteration":"ṣadraka","lemma":"صَدْر","root":"صدر","entryId":"l-81254b818b8d6bbf"},{"key":"94:1:5","position":5,"arabic":"١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"94:2","translation":"And removed from you your burden.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"94:2:1","position":1,"arabic":"وَوَضَعْنَا","kind":"word","gloss":"And We removed","transliteration":"wawaḍaʿnā","lemma":"وَضَعَ","root":"وضع","entryId":null},{"key":"94:2:2","position":2,"arabic":"عَنكَ","kind":"word","gloss":"from you","transliteration":"ʿanka","lemma":"عَن","root":null,"entryId":"l-f1109a78c8548754"},{"key":"94:2:3","position":3,"arabic":"وِزْرَكَ","kind":"word","gloss":"your burden","transliteration":"wiz'raka","lemma":"وِزْر","root":"وزر","entryId":null},{"key":"94:2:4","position":4,"arabic":"٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"94:3","translation":"Which weighed down your back?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"94:3:1","position":1,"arabic":"ٱلَّذِىٓ","kind":"word","gloss":"Which","transliteration":"alladhī","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"94:3:2","position":2,"arabic":"أَنقَضَ","kind":"word","gloss":"weighed upon","transliteration":"anqaḍa","lemma":"أَنقَضَ","root":"نقض","entryId":null},{"key":"94:3:3","position":3,"arabic":"ظَهْرَكَ","kind":"word","gloss":"your back","transliteration":"ẓahraka","lemma":"ظَهْر","root":"ظهر","entryId":null},{"key":"94:3:4","position":4,"arabic":"٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"94:4","translation":"And have We not raised high your fame?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"94:4:1","position":1,"arabic":"وَرَفَعْنَا","kind":"word","gloss":"And We raised high","transliteration":"warafaʿnā","lemma":"رَفَعَ","root":"رفع","entryId":null},{"key":"94:4:2","position":2,"arabic":"لَكَ","kind":"word","gloss":"for you","transliteration":"laka","lemma":null,"root":null,"entryId":null},{"key":"94:4:3","position":3,"arabic":"ذِكْرَكَ","kind":"word","gloss":"your reputation","transliteration":"dhik'raka","lemma":"ذِكْر","root":"ذكر","entryId":"l-b273b8ee66c296d9"},{"key":"94:4:4","position":4,"arabic":"٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"94:5","translation":"Verily, along with every hardship is relief,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"94:5:1","position":1,"arabic":"فَإِنَّ","kind":"word","gloss":"So indeed","transliteration":"fa-inna","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"94:5:2","position":2,"arabic":"مَعَ","kind":"word","gloss":"with","transliteration":"maʿa","lemma":"مَع","root":null,"entryId":"l-cabe6b125cb73679"},{"key":"94:5:3","position":3,"arabic":"ٱلْعُسْرِ","kind":"word","gloss":"the hardship","transliteration":"l-ʿus'ri","lemma":"عُسْر","root":"عسر","entryId":null},{"key":"94:5:4","position":4,"arabic":"يُسْرًا","kind":"word","gloss":"(is) ease","transliteration":"yus'ran","lemma":"يُسْر","root":"يسر","entryId":null},{"key":"94:5:5","p