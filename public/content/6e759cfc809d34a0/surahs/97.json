[{"ref":"97:1","translation":"Verily, We have sent it (this Qur’ân) down in the night of Al-Qadr (Decree).","translationSource":"qul-301-hilali-khan","notes":[{"text":"\"Therein (that night) is decreed every matter of ordainments.\" [The Qur’ân, (Verse 44:4)]** ** i.e., the matters of deaths, births, provisions, calamities for the whole (coming) year as decreed by Allâh.","ref":null}],"tokens":[{"key":"97:1:1","position":1,"arabic":"إِنَّآ","kind":"word","gloss":"Indeed, We","transliteration":"innā","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"97:1:2","position":2,"arabic":"أَنزَلْنَـٰهُ","kind":"word","gloss":"revealed it","transliteration":"anzalnāhu","lemma":"أَنزَلَ","root":"نزل","entryId":"l-81ead5682cb1835c"},{"key":"97:1:3","position":3,"arabic":"فِى","kind":"word","gloss":"in","transliteration":"fī","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"97:1:4","position":4,"arabic":"لَيْلَةِ","kind":"word","gloss":"(the) Night","transliteration":"laylati","lemma":"لَيْلَة","root":"ليل","entryId":null},{"key":"97:1:5","position":5,"arabic":"ٱلْقَدْرِ","kind":"word","gloss":"(of) Power","transliteration":"l-qadri","lemma":"قَدْر","root":"قدر","entryId":null},{"key":"97:1:6","position":6,"arabic":"١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"97:2","translation":"And what will make you know what the night of Al-Qadr (Decree) is?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"97:2:1","position":1,"arabic":"وَمَآ","kind":"word","gloss":"And what","transliteration":"wamā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"97:2:2","position":2,"arabic":"أَدْرَىٰكَ","kind":"word","gloss":"can make you know","transliteration":"adrāka","lemma":"أَدْرَىٰ","root":"دري","entryId":null},{"key":"97:2:3","position":3,"arabic":"مَا","kind":"word","gloss":"what","transliteration":"mā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"97:2:4","position":4,"arabic":"لَيْلَةُ","kind":"word","gloss":"(the) Night","transliteration":"laylatu","lemma":"لَيْلَة","root":"ليل","entryId":null},{"key":"97:2:5","position":5,"arabic":"ٱلْقَدْرِ","kind":"word","gloss":"(of) Power (is)","transliteration":"l-qadri","lemma":"قَدْر","root":"قدر","entryId":null},{"key":"97:2:6","position":6,"arabic":"٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"97:3","translation":"The night of Al-Qadr (Decree) is better than a thousand months (i.e. worshipping Allâh in that night is better than worshipping Him a thousand months, i.e. 83 years and 4 months).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"97:3:1","position":1,"arabic":"لَيْلَةُ","kind":"word","gloss":"(The) Night","transliteration":"laylatu","lemma":"لَيْلَة","root":"ليل","entryId":null},{"key":"97:3:2","position":2,"arabic":"ٱلْقَدْرِ","kind":"word","gloss":"(of) Power","transliteration":"l-qadri","lemma":"قَدْر","root":"قدر","entryId":null},{"key":"97:3:3","position":3,"arabic":"خَيْرٌۭ","kind":"word","gloss":"(is) better","transliteration":"khayrun","lemma":"خَيْر","root":"خير","entryId":"l-81db6cd6a46bd56c"},{"key":"97:3:4","position":4,"arabic":"مِّنْ","kind":"word","gloss":"than","transliteration":"min","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"97:3:5","position":5,"arabic":"أَلْفِ","kind":"word","gloss":"a thousand","transliteration":"alfi","lemma":"أَلْف","root":"الف","entryId":null},{"key":"97:3:6","position":6,"arabic":"شَهْرٍۢ","kind":"word","gloss":"month(s)","transliteration":"shahrin","lemma":"شَهْر","root":"شهر","entryId":null},{"key":"97:3:7","position":7,"arabic":"٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"97:4","translation":"Therein descend the angels and the Rûh [Jibrîl (Gabrîl)] by Allâh’s Permission with all Decrees,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"97:4:1","position":1,"arabic":"تَنَزَّلُ","kind":"word","gloss":"Descend","transliteration":"tanazzalu","lemma":"تَنَزَّلَتْ","root":"نزل","entryId":null},{"key":"97:4:2","position":2,"arabic":"ٱلْمَلَـٰٓئِكَةُ","kind":"word","gloss":"the Angels","transliteration":"l-malāikatu","lemma":"مَلَك","root":"ملك","entryId":"l-9408993e44e9d815"},{"key":"97:4:3","position":3,"arabic":"وَٱلرُّوحُ","kind":"word","gloss":"and the Spirit","transliteration":"wal-rūḥu","lemma":"رُوح","root":"روح","entryId":null},{"key":"97:4:4","position":4,"arabic":"فِيهَا","kind":"word","gloss":"therein","transliteration":"fīhā","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"97:4:5","position":5,"arabic":"بِإِذْنِ","kind":"word","gloss":"by (the) permission","transliteration":"bi-idh'ni","lemma":"إِذْن","root":"اذن","entryId":"l-7f1ecaf8fa6242d4"},{"key":"97:4:6","position":6,"arabic":"رَبِّهِم","kind":"word","gloss":"(of) their Lord","transliteration":"rabbihim","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"97:4:7","position":7,"arabic":"مِّن","kind":"word","gloss":"for","transliteration":"min","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"97:4:8","position":8,"arabic":"كُلِّ","kind":"word","gloss":"every","transliteration":"kulli","lemma":"كُلّ","root":"كلل","entryId":"l-6fac43bd71e38426"},{"key":"97:4:9","position":9,"arabic":"أَمْرٍۢ","kind":"word","gloss":"affair","transliteration":"amrin","lemma":"أَمْر","root":"امر","entryId":"l-a1fcf2fe7f0b10ef"},{"key":"97:4:10","position":10,"arabic":"٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"97:5","translation":"(All that night), there is Peace (and Goodness from Allâh to His believing slaves) until the appearance of dawn.","translationSource":"qul-301-hilali-khan","notes":[{"text":"Narrated ‘Âishah رضي الله عنها: Allâh’s Messenger صلى الله عليه وسلم said, \"Search for the Night of Qadr in the odd nights of the last ten nights of Ramadan.\" (Sahih Al-Bukhari, Vol. 3, Hadith No.234).","ref":null}],"tokens":[{"key":"97:5:1","position":1,"arabic":"سَلَـٰمٌ","kind":"word","gloss":"Peace","transliteration":"salāmun","lemma":"سَلَٰم","root":"سلم","entryId":"l-ab8f4fde6b48751f"},{"key":"97:5:2","position":2,"arabic":"هِىَ","kind":"word","gloss":"it (is)","transliteration":"hiya","lemma":null,"root":null,"entryId":null},{"key":"97:5:3","position":3,"arabic":"حَتَّىٰ","kind":"word","gloss":"until","transliteration":"ḥattā","lemma":"حَتَّىٰ","root":null,"entryId":"l-4bc225a19ba4f7d1"},{"key":"97:5:4","position":4,"arabic":"مَطْلَعِ","kind":"word","gloss":"(the) emergence","transliteration":"maṭlaʿi","lemma":"مَطْلَع","root":"طلع","entryId":null},{"key":"97:5:5","position":5,"arabic":"ٱلْفَجْرِ","kind":"word","gloss":"(of) the dawn","transliteration":"l-fajri","lemma":"فَجْر","root":"فجر","entryId":null},{"key":"97:5:6","position":6,"arabic":"٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]}]