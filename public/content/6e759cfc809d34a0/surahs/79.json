,"position":3,"arabic":"فِرْعَوْنَ","kind":"word","gloss":"Firaun","transliteration":"fir'ʿawna","lemma":"فِرْعَوْن","root":null,"entryId":"l-59e880136eb31a4d"},{"key":"79:17:4","position":4,"arabic":"إِنَّهُۥ","kind":"word","gloss":"Indeed, he","transliteration":"innahu","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"79:17:5","position":5,"arabic":"طَغَىٰ","kind":"word","gloss":"(has) transgressed","transliteration":"ṭaghā","lemma":"طَغَىٰ","root":"طغي","entryId":null},{"key":"79:17:6","position":6,"arabic":"١٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:18","translation":"And say to him: \"Would you purify yourself (from the sin of disbelief by becoming a believer)?\"","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:18:1","position":1,"arabic":"فَقُلْ","kind":"word","gloss":"And say","transliteration":"faqul","lemma":"قَالَ","root":"قول","entryId":"l-effaf24a5c86c56f"},{"key":"79:18:2","position":2,"arabic":"هَل","kind":"word","gloss":"Would","transliteration":"hal","lemma":"هَل","root":null,"entryId":"l-acd15f3532f2b613"},{"key":"79:18:3","position":3,"arabic":"لَّكَ","kind":"word","gloss":"[for] you","transliteration":"laka","lemma":null,"root":null,"entryId":null},{"key":"79:18:4","position":4,"arabic":"إِلَىٰٓ","kind":"word","gloss":"[to]","transliteration":"ilā","lemma":"إِلَىٰ","root":null,"entryId":"l-53539d2c3606b99e"},{"key":"79:18:5","position":5,"arabic":"أَن","kind":"word","gloss":"[that]","transliteration":"an","lemma":"أَن","root":null,"entryId":"l-6fb897ea8dfcda9d"},{"key":"79:18:6","position":6,"arabic":"تَزَكَّىٰ","kind":"word","gloss":"purify yourself","transliteration":"tazakkā","lemma":"تَزَكَّىٰ","root":"زكو","entryId":null},{"key":"79:18:7","position":7,"arabic":"١٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:19","translation":"\"And that I guide you to your Lord, so you should fear Him?\"","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:19:1","position":1,"arabic":"وَأَهْدِيَكَ","kind":"word","gloss":"And I will guide you","transliteration":"wa-ahdiyaka","lemma":"هَدَى","root":"هدي","entryId":"l-e0ac61a274311deb"},{"key":"79:19:2","position":2,"arabic":"إِلَىٰ","kind":"word","gloss":"to","transliteration":"ilā","lemma":"إِلَىٰ","root":null,"entryId":"l-53539d2c3606b99e"},{"key":"79:19:3","position":3,"arabic":"رَبِّكَ","kind":"word","gloss":"your Lord","transliteration":"rabbika","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"79:19:4","position":4,"arabic":"فَتَخْشَىٰ","kind":"word","gloss":"so you would fear","transliteration":"fatakhshā","lemma":"خَشِىَ","root":"خشي","entryId":null},{"key":"79:19:5","position":5,"arabic":"١٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:20","translation":"Then [Mûsâ (Moses)] showed him the great sign (miracles).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:20:1","position":1,"arabic":"فَأَرَىٰهُ","kind":"word","gloss":"Then he showed him","transliteration":"fa-arāhu","lemma":"رَءَا","root":"راي","entryId":"l-6b7f279dfcd3ea58"},{"key":"79:20:2","position":2,"arabic":"ٱلْـَٔايَةَ","kind":"word","gloss":"the sign","transliteration":"l-āyata","lemma":"ءَايَة","root":"ايي","entryId":"l-5ab33552830ad5b5"},{"key":"79:20:3","position":3,"arabic":"ٱلْكُبْرَىٰ","kind":"word","gloss":"the great","transliteration":"l-kub'rā","lemma":"كُبْرَىٰ","root":"كبر","entryId":null},{"key":"79:20:4","position":4,"arabic":"٢٠","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:21","translation":"But [Fir‘aun (Pharaoh)] belied and disobeyed.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:21:1","position":1,"arabic":"فَكَذَّبَ","kind":"word","gloss":"But he denied","transliteration":"fakadhaba","lemma":"كَذَّبَ","root":"كذب","entryId":"l-db86b0654d661fb2"},{"key":"79:21:2","position":2,"arabic":"وَعَصَىٰ","kind":"word","gloss":"and disobeyed","transliteration":"waʿaṣā","lemma":"عَصَا","root":"عصي","entryId":null},{"key":"79:21:3","position":3,"arabic":"٢١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:22","translation":"Then he turned his back, striving (against Allâh).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:22:1","position":1,"arabic":"ثُمَّ","kind":"word","gloss":"Then","transliteration":"thumma","lemma":"ثُمّ","root":null,"entryId":"l-75b66396af12da75"},{"key":"79:22:2","position":2,"arabic":"أَدْبَرَ","kind":"word","gloss":"he turned his back","transliteration":"adbara","lemma":"أَدْبَرَ","root":"دبر","entryId":null},{"key":"79:22:3","position":3,"arabic":"يَسْعَىٰ","kind":"word","gloss":"striving","transliteration":"yasʿā","lemma":"سَعَىٰ","root":"سعي","entryId":null},{"key":"79:22:4","position":4,"arabic":"٢٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:23","translation":"Then he gathered (his people) and cried aloud,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:23:1","position":1,"arabic":"فَحَشَرَ","kind":"word","gloss":"And he gathered","transliteration":"faḥashara","lemma":"حَشَرَ","root":"حشر","entryId":"l-f0c6902f4c937a12"},{"key":"79:23:2","position":2,"arabic":"فَنَادَىٰ","kind":"word","gloss":"and called out","transliteration":"fanādā","lemma":"نَادَىٰ","root":"ندو","entryId":"l-8deac0887cc12444"},{"key":"79:23:3","position":3,"arabic":"٢٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:24","translation":"Saying: \"I am your lord, most high.\"","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:24:1","position":1,"arabic":"فَقَالَ","kind":"word","gloss":"Then he said","transliteration":"f