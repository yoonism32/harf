5:6","position":6,"arabic":"٢٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:26","translation":"Verily, in this is an instructive admonition for whosoever fears Allâh.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:26:1","position":1,"arabic":"إِنَّ","kind":"word","gloss":"Indeed","transliteration":"inna","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"79:26:2","position":2,"arabic":"فِى","kind":"word","gloss":"in","transliteration":"fī","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"79:26:3","position":3,"arabic":"ذَٰلِكَ","kind":"word","gloss":"that","transliteration":"dhālika","lemma":"ذَٰلِك","root":null,"entryId":"l-096a9ad382db7640"},{"key":"79:26:4","position":4,"arabic":"لَعِبْرَةًۭ","kind":"word","gloss":"surely (is) a lesson","transliteration":"laʿib'ratan","lemma":"عِبْرَة","root":"عبر","entryId":null},{"key":"79:26:5","position":5,"arabic":"لِّمَن","kind":"word","gloss":"for whoever","transliteration":"liman","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"79:26:6","position":6,"arabic":"يَخْشَىٰٓ","kind":"word","gloss":"fears","transliteration":"yakhshā","lemma":"خَشِىَ","root":"خشي","entryId":null},{"key":"79:26:7","position":7,"arabic":"٢٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:27","translation":"Are you more difficult to create or is the heaven that He constructed?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:27:1","position":1,"arabic":"ءَأَنتُمْ","kind":"word","gloss":"Are you","transliteration":"a-antum","lemma":null,"root":null,"entryId":null},{"key":"79:27:2","position":2,"arabic":"أَشَدُّ","kind":"word","gloss":"a more difficult","transliteration":"ashaddu","lemma":"أَشَدّ","root":"شدد","entryId":null},{"key":"79:27:3","position":3,"arabic":"خَلْقًا","kind":"word","gloss":"creation","transliteration":"khalqan","lemma":"خَلَقَ","root":"خلق","entryId":"l-9e7414ba00a88ddc"},{"key":"79:27:4","position":4,"arabic":"أَمِ","kind":"word","gloss":"or","transliteration":"ami","lemma":"أَم","root":null,"entryId":"l-4e40bd84c441ff6d"},{"key":"79:27:5","position":5,"arabic":"ٱلسَّمَآءُ ۚ","kind":"word","gloss":"the heaven","transliteration":"l-samāu","lemma":"سَمَآء","root":"سمو","entryId":"l-e873a75addf25baf"},{"key":"79:27:6","position":6,"arabic":"بَنَىٰهَا","kind":"word","gloss":"He constructed it","transliteration":"banāhā","lemma":"بَنَىٰ","root":"بني","entryId":null},{"key":"79:27:7","position":7,"arabic":"٢٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:28","translation":"He raised its height, and has perfected it.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:28:1","position":1,"arabic":"رَفَعَ","kind":"word","gloss":"He raised","transliteration":"rafaʿa","lemma":"رَفَعَ","root":"رفع","entryId":null},{"key":"79:28:2","position":2,"arabic":"سَمْكَهَا","kind":"word","gloss":"its ceiling","transliteration":"samkahā","lemma":"سَمْك","root":"سمك","entryId":null},{"key":"79:28:3","position":3,"arabic":"فَسَوَّىٰهَا","kind":"word","gloss":"and proportioned it","transliteration":"fasawwāhā","lemma":"سَوَّىٰ","root":"سوي","entryId":null},{"key":"79:28:4","position":4,"arabic":"٢٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:29","translation":"Its night He covers with darkness and its forenoon He brings out (with light)","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:29:1","position":1,"arabic":"وَأَغْطَشَ","kind":"word","gloss":"And He darkened","transliteration":"wa-aghṭasha","lemma":"أَغْطَشَ","root":"غطش","entryId":null},{"key":"79:29:2","position":2,"arabic":"لَيْلَهَا","kind":"word","gloss":"its night","transliteration":"laylahā","lemma":"لَيْل","root":"ليل","entryId":"l-d2e604e516a58959"},{"key":"79:29:3","position":3,"arabic":"وَأَخْرَجَ","kind":"word","gloss":"and brought out","transliteration":"wa-akhraja","lemma":"أَخْرَجَ","root":"خرج","entryId":"l-a25810044f12cf39"},{"key":"79:29:4","position":4,"arabic":"ضُحَىٰهَا","kind":"word","gloss":"its brightness","transliteration":"ḍuḥāhā","lemma":"ضُحًى","root":"ضحو","entryId":null},{"key":"79:29:5","position":5,"arabic":"٢٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:30","translation":"And after that He spread the earth,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:30:1","position":1,"arabic":"وَٱلْأَرْضَ","kind":"word","gloss":"And the earth","transliteration":"wal-arḍa","lemma":"أَرْض","root":"ارض","entryId":"l-2c626a3b4c64dbc9"},{"key":"79:30:2","position":2,"arabic":"بَعْدَ","kind":"word","gloss":"after","transliteration":"baʿda","lemma":"بَعْد","root":"بعد","entryId":"l-8c0dc1d5dbc2a420"},{"key":"79:30:3","position":3,"arabic":"ذَٰلِكَ","kind":"word","gloss":"that","transliteration":"dhālika","lemma":"ذَٰلِك","root":null,"entryId":"l-096a9ad382db7640"},{"key":"79:30:4","position":4,"arabic":"دَحَىٰهَآ","kind":"word","gloss":"He spread it","transliteration":"daḥāhā","lemma":"دَحَىٰ","root":"دحو","entryId":null},{"key":"79:30:5","position":5,"arabic":"٣٠","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:31","translation":"And brought forth therefrom its water and its pasture.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:31:1","position":1,"arabic":"أَخْرَجَ","kind":"word","gloss":"He brought forth","transliteration":"akhraja","lemma":"أَخْرَجَ","root":"خرج","entryId":"l-a25810044f12cf39"},{"key":"79:31:2","position":2,"arabic":"مِنْهَا","kind":"word","gloss":"from it","transliteration":"min'hā","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"79:31:3","position":3,"arabic":"مَآءَهَا","kind":"word","gloss":"its water","transliteration":"māahā","lemma":"مَآء","root":"موه","entryId":"l-b8b1f8ed335826e5"},{"key":"79:31:4","position":4,"arabic":"وَمَرْعَىٰهَا","kind":"word","gloss":"and its pasture","transliteration":"wamarʿāhā","lemma":"مَرْعَىٰ","root":"رعي","entryId":null},{"key":"79:31:5","position":5,"arabic":"٣١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:32","translation":"And the mountains He has fixed firmly,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:32:1","position":1,"arabic":"وَٱلْجِبَالَ","kind":"word","gloss":"And the mountains","transliteration":"wal-jibāla","lemma":"جَبَل","root":"جبل","entryId":"l-740cdd8405f7481e"},{"key":"79:32:2","position":2,"arabic":"أَرْسَىٰهَا","kind":"word","gloss":"He made them firm","transliteration":"arsāhā","lemma":"أَرْسَىٰ","root":"رسو","entryId":null},{"key":"79:32:3","position":3,"arabic":"٣٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:33","translation":"(To be) a provision and benefit for you and your cattle.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:33:1","position":1,"arabic":"مَتَـٰعًۭا","kind":"word","gloss":"(As) a provision","transliteration":"matāʿan","lemma":"مَتَٰع","root":"متع","entryId":null},{"key":"79:33:2","position":2,"arabic":"لَّكُمْ","kind":"word","gloss":"for you","transliteration":"lakum","lemma":null,"root":null,"entryId":null},{"key":"79:33:3","position":3,"arabic":"وَلِأَنْعَـٰمِكُمْ","kind":"word","gloss":"and for your cattle","transliteration":"wali-anʿāmikum","lemma":"نَّعَم","root":"نعم","entryId":null},{"key":"79:33:4","position":4,"arabic":"٣٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:34","translation":"But when there comes the greatest catastrophe (i.e. the Day of Recompense) -","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:34:1","position":1,"arabic":"فَإِذَا","kind":"word","gloss":"But when","transliteration":"fa-idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"79:34:2","position":2,"arabic":"جَآءَتِ","kind":"word","gloss":"comes","transliteration":"jāati","lemma":"جَآءَ","root":"جيا","entryId":"l-1abf61bfcb8fdd4c"},{"key":"79:34:3","position":3,"arabic":"ٱلطَّآمَّةُ","kind":"word","gloss":"the Overwhelming Calamity","transliteration":"l-ṭāmatu","lemma":"طَّآمَّة","root":"طمم","entryId":null},{"key":"79:34:4","position":4,"arabic":"ٱلْكُبْرَىٰ","kind":"word","gloss":"the great","transliteration":"l-kub'rā","lemma":"كُبْرَىٰ","root":"كبر","entryId":null},{"key":"79:34:5","position":5,"arabic":"٣٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:35","translation":"The Day when man shall remember what he strove for.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:35:1","position":1,"arabic":"يَوْمَ","kind":"word","gloss":"(The) Day","transliteration":"yawma","lemma":"يَوْم","root":"يوم","entryId":"l-bd6f5747b4dfe79c"},{"key":"79:35:2","position":2,"arabic":"يَتَذَكَّرُ","kind":"word","gloss":"will remember","transliteration":"yatadhakkaru","lemma":"تَذَكَّرَ","root":"ذكر","entryId":"l-9bc7d78e536db086"},{"key":"79:35:3","position":3,"arabic":"ٱلْإِنسَـٰنُ","kind":"word","gloss":"man","transliteration":"l-insānu","lemma":"إِنسَٰن","root":"انس","entryId":"l-bec7f7166ce0ed1b"},{"key":"79:35:4","position":4,"arabic":"مَا","kind":"word","gloss":"what","transliteration":"mā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"79:35:5","position":5,"arabic":"سَعَىٰ","kind":"word","gloss":"he strove (for)","transliteration":"saʿā","lemma":"سَعَىٰ","root":"سعي","entryId":null},{"key":"79:35:6","position":6,"arabic":"٣٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:36","translation":"And Hell-fire shall be made apparent in full view for (every) one who sees.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:36:1","position":1,"arabic":"وَبُرِّزَتِ","kind":"word","gloss":"And will be made manifest","transliteration":"waburrizati","lemma":"بُرِّزَتِ","root":"برز","entryId":null},{"key":"79:36:2","position":2,"arabic":"ٱلْجَحِيمُ","kind":"word","gloss":"the Hellfire","transliteration":"l-jaḥīmu","lemma":"جَحِيم","root":"جحم","entryId":null},{"key":"79:36:3","position":3,"arabic":"لِمَن","kind":"word","gloss":"to (him) who","transliteration":"liman","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"79:36:4","position":4,"arabic":"يَرَىٰ","kind":"word","gloss":"sees","transliteration":"yarā","lemma":"رَءَا","root":"راي","entryId":"l-6b7f279dfcd3ea58"},{"key":"79:36:5","position":5,"arabic":"٣٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:37","translation":"Then for him who transgressed all bounds, (in disbelief, oppression and evil deeds of disobedience to Allâh).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:37:1","position":1,"arabic":"فَأَمَّا","kind":"word","gloss":"Then as for","transliteration":"fa-ammā","lemma":"أَمَّا","root":null,"entryId":"l-6c43b34cf75dec4b"},{"key":"79:37:2","position":2,"arabic":"مَن","kind":"word","gloss":"(him) who","transliteration":"man","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"79:37:3","position":3,"arabic":"طَغَىٰ","kind":"word","gloss":"transgressed","transliteration":"ṭaghā","lemma":"طَغَىٰ","root":"طغي","entryId":null},{"key":"79:37:4","position":4,"arabic":"٣٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:38","translation":"And preferred the life of this world (by following his evil desires and lusts),","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:38:1","position":1,"arabic":"وَءَاثَرَ","kind":"word","gloss":"And preferred","transliteration":"waāthara","lemma":"آثَرَ","root":"اثر","entryId":null},{"key":"79:38:2","position":2,"arabic":"ٱلْحَيَوٰةَ","kind":"word","gloss":"the life","transliteration":"l-ḥayata","lemma":"حَيَوٰة","root":"حيي","entryId":"l-854d7ef0b0abcef1"},{"key":"79:38:3","position":3,"arabic":"ٱلدُّنْيَا","kind":"word","gloss":"(of) the world","transliteration":"l-dun'yā","lemma":"دُّنْيَا","root":"دنو","entryId":"l-ab5bd4a6a062ee8c"},{"key":"79:38:4","position":4,"arabic":"٣٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:39","translation":"Verily, his abode will be Hell-fire;","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:39:1","position":1,"arabic":"فَإِنَّ","kind":"word","gloss":"Then indeed","transliteration":"fa-inna","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"79:39:2","position":2,"arabic":"ٱلْجَحِيمَ","kind":"word","gloss":"the Hellfire","transliteration":"l-jaḥīma","lemma":"جَحِيم","root":"جحم","entryId":null},{"key":"79:39:3","position":3,"arabic":"هِىَ","kind":"word","gloss":"it","transliteration":"hiya","lemma":null,"root":null,"entryId":null},{"key":"79:39:4","position":4,"arabic":"ٱلْمَأْوَىٰ","kind":"word","gloss":"(is) the refuge","transliteration":"l-mawā","lemma":"مَأْوَىٰ","root":"اوي","entryId":null},{"key":"79:39:5","position":5,"arabic":"٣٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:40","translation":"But as for him who feared standing before his Lord, and restrained himself from impure evil desires and lusts.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:40:1","position":1,"arabic":"وَأَمَّا","kind":"word","gloss":"But as for","transliteration":"wa-ammā","lemma":"أَمَّا","root":null,"entryId":"l-6c43b34cf75dec4b"},{"key":"79:40:2","position":2,"arabic":"مَنْ","kind":"word","gloss":"(him) who","transliteration":