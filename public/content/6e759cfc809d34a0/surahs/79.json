,"position":4,"arabic":"ٱلْمَأْوَىٰ","kind":"word","gloss":"the refuge","transliteration":"l-mawā","lemma":"مَأْوَىٰ","root":"اوي","entryId":null},{"key":"79:41:5","position":5,"arabic":"٤١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:42","translation":"They ask you (O Muhammad صلى الله عليه وسلم) about the Hour - when will be its appointed time?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:42:1","position":1,"arabic":"يَسْـَٔلُونَكَ","kind":"word","gloss":"They ask you","transliteration":"yasalūnaka","lemma":"سَأَلَ","root":"سال","entryId":"l-ad7819fc39b763e0"},{"key":"79:42:2","position":2,"arabic":"عَنِ","kind":"word","gloss":"about","transliteration":"ʿani","lemma":"عَن","root":null,"entryId":"l-f1109a78c8548754"},{"key":"79:42:3","position":3,"arabic":"ٱلسَّاعَةِ","kind":"word","gloss":"the Hour","transliteration":"l-sāʿati","lemma":"سَاعَة","root":"سوع","entryId":"l-d74bbc36bff7ccce"},{"key":"79:42:4","position":4,"arabic":"أَيَّانَ","kind":"word","gloss":"when","transliteration":"ayyāna","lemma":"أَيَّان","root":null,"entryId":null},{"key":"79:42:5","position":5,"arabic":"مُرْسَىٰهَا","kind":"word","gloss":"(is) its arrival","transliteration":"mur'sāhā","lemma":"مُرْسَىٰ","root":"رسو","entryId":null},{"key":"79:42:6","position":6,"arabic":"٤٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:43","translation":"You have no knowledge to say anything about it.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:43:1","position":1,"arabic":"فِيمَ","kind":"word","gloss":"In what","transliteration":"fīma","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"79:43:2","position":2,"arabic":"أَنتَ","kind":"word","gloss":"(are) you","transliteration":"anta","lemma":null,"root":null,"entryId":null},{"key":"79:43:3","position":3,"arabic":"مِن","kind":"word","gloss":"[of]","transliteration"