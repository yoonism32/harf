[{"ref":"79:1","translation":"By those (angels) who pull out (the souls of the disbelievers and the wicked) with great violence.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:1:1","position":1,"arabic":"وَٱلنَّـٰزِعَـٰتِ","kind":"word","gloss":"By those who extract","transliteration":"wal-nāziʿāti","lemma":"نَّٰزِعَٰت","root":"نزع","entryId":null},{"key":"79:1:2","position":2,"arabic":"غَرْقًۭا","kind":"word","gloss":"violently","transliteration":"gharqan","lemma":"غَرْق","root":"غرق","entryId":null},{"key":"79:1:3","position":3,"arabic":"١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:2","translation":"By those (angels) who gently take out (the souls of the believers).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:2:1","position":1,"arabic":"وَٱلنَّـٰشِطَـٰتِ","kind":"word","gloss":"And those who draw out","transliteration":"wal-nāshiṭāti","lemma":"نَّٰشِطَٰت","root":"نشط","entryId":null},{"key":"79:2:2","position":2,"arabic":"نَشْطًۭا","kind":"word","gloss":"gently","transliteration":"nashṭan","lemma":"نَشْط","root":"نشط","entryId":null},{"key":"79:2:3","position":3,"arabic":"٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:3","translation":"And by those that swim along (i.e. angels or planets in their orbits).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:3:1","position":1,"arabic":"وَٱلسَّـٰبِحَـٰتِ","kind":"word","gloss":"And those who glide","transliteration":"wal-sābiḥāti","lemma":"سَّٰبِحَٰت","root":"سبح","entryId":null},{"key":"79:3:2","position":2,"arabic":"سَبْحًۭا","kind":"word","gloss":"swimming","transliteration":"sabḥan","lemma":"سَبْح","root":"سبح","entryId":null},{"key":"79:3:3","position":3,"arabic":"٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:4","translation":"And by those that press forward as in a race (i.e. the angels or stars or the horses).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:4:1","position":1,"arabic":"فَٱلسَّـٰبِقَـٰتِ","kind":"word","gloss":"And those who race each other","transliteration":"fal-sābiqāti","lemma":"سَّٰبِقَٰت","root":"سبق","entryId":null},{"key":"79:4:2","position":2,"arabic":"سَبْقًۭا","kind":"word","gloss":"(in) a race","transliteration":"sabqan","lemma":"سَبْق","root":"سبق","entryId":null},{"key":"79:4:3","position":3,"arabic":"٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:5","translation":"And by those angels who arrange to do the Commands of their Lord, (so verily, you disbelievers will be called to account).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:5:1","position":1,"arabic":"فَٱلْمُدَبِّرَٰتِ","kind":"word","gloss":"And those who arrange","transliteration":"fal-mudabirāti","lemma":"مُدَبِّرَٰت","root":"دبر","entryId":null},{"key":"79:5:2","position":2,"arabic":"أَمْرًۭا","kind":"word","gloss":"(the) matter","transliteration":"amran","lemma":"أَمْر","root":"امر","entryId":"l-a1fcf2fe7f0b10ef"},{"key":"79:5:3","position":3,"arabic":"٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:6","translation":"On the Day (when the first blowing of the Trumpet is blown), the earth and the mountains will shake violently (and everybody will die).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:6:1","position":1,"arabic":"يَوْمَ","kind":"word","gloss":"(The) Day","transliteration":"yawma","lemma":"يَوْم","root":"يوم","entryId":"l-bd6f5747b4dfe79c"},{"key":"79:6:2","position":2,"arabic":"تَرْجُفُ","kind":"word","gloss":"will quake","transliteration":"tarjufu","lemma":"تَرْجُفُ","root":"رجف","entryId":null},{"key":"79:6:3","position":3,"arabic":"ٱلرَّاجِفَةُ","kind":"word","gloss":"the quaking one","transliteration":"l-rājifatu","lemma":"رَّاجِفَة","root":"رجف","entryId":null},{"key":"79:6:4","position":4,"arabic":"٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:7","translation":"The second blowing of the Trumpet follows it (and everybody will be resurrected).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:7:1","position":1,"arabic":"تَتْبَعُهَا","kind":"word","gloss":"Follows it","transliteration":"tatbaʿuhā","lemma":"تَبِعَ","root":"تبع","entryId":null},{"key":"79:7:2","position":2,"arabic":"ٱلرَّادِفَةُ","kind":"word","gloss":"the subsequent","transliteration":"l-rādifatu","lemma":"رَّادِفَة","root":"ردف","entryId":null},{"key":"79:7:3","position":3,"arabic":"٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:8","translation":"(Some) hearts that Day will shake with fear and anxiety.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:8:1","position":1,"arabic":"قُلُوبٌۭ","kind":"word","gloss":"Hearts","transliteration":"qulūbun","lemma":"قَلْب","root":"قلب","entryId":"l-4fe27e415bdd53be"},{"key":"79:8:2","position":2,"arabic":"يَوْمَئِذٍۢ","kind":"word","gloss":"that Day","transliteration":"yawma-idhin","lemma":"يَوْمَئِذ","root":"يوم","entryId":"l-675d35e3d4bddca4"},{"key":"79:8:3","position":3,"arabic":"وَاجِفَةٌ","kind":"word","gloss":"will palpitate","transliteration":"wājifatun","lemma":"وَاجِفَة","root":"وجف","entryId":null},{"key":"79:8:4","position":4,"arabic":"٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:9","translation":"Their eyes will be downcast.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:9:1","position":1,"arabic":"أَبْصَـٰرُهَا","kind":"word","gloss":"Their eyes","transliteration":"abṣāruhā","lemma":"بَصَر","root":"بصر","entryId":"l-45b52e84d9397d19"},{"key":"79:9:2","position":2,"arabic":"خَـٰشِعَةٌۭ","kind":"word","gloss":"humbled","transliteration":"khāshiʿatun","lemma":"خَاشِع","root":"خشع","entryId":null},{"key":"79:9:3","position":3,"arabic":"٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:10","translation":"They say: \"Shall we indeed be returned to (our) former state of life?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:10:1","position":1,"arabic":"يَقُولُونَ","kind":"word","gloss":"They say","transliteration":"yaqūlūna","lemma":"قَالَ","root":"قول","entryId":"l-effaf24a5c86c56f"},{"key":"79:10:2","position":2,"arabic":"أَءِنَّا","kind":"word","gloss":"Will we","transliteration":"a-innā","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"79:10:3","position":3,"arabic":"لَمَرْدُودُونَ","kind":"word","gloss":"indeed be returned","transliteration":"lamardūdūna","lemma":"مَرْدُود","root":"ردد","entryId":null},{"key":"79:10:4","position":4,"arabic":"فِى","kind":"word","gloss":"to","transliteration":"fī","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"79:10:5","position":5,"arabic":"ٱلْحَافِرَةِ","kind":"word","gloss":"the former state","transliteration":"l-ḥāfirati","lemma":"حَافِرَة","root":"حفر","entryId":null},{"key":"79:10:6","position":6,"arabic":"١٠","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:11","translation":"\"Even after we are crumbled bones?\"","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:11:1","position":1,"arabic":"أَءِذَا","kind":"word","gloss":"What! When","transliteration":"a-idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"79:11:2","position":2,"arabic":"كُنَّا","kind":"word","gloss":"we are","transliteration":"kunnā","lemma":"كَانَ","root":"كون","entryId":"l-4b2f9969a9af0d45"},{"key":"79:11:3","position":3,"arabic":"عِظَـٰمًۭا","kind":"word","gloss":"bones","transliteration":"ʿiẓāman","lemma":"عَظِيم","root":"عظم","entryId":"l-4ac2f032da29eeff"},{"key":"79:11:4","position":4,"arabic":"نَّخِرَةًۭ","kind":"word","gloss":"decayed","transliteration":"nakhiratan","lemma":"نَّخِرَة","root":"نخر","entryId":null},{"key":"79:11:5","position":5,"arabic":"١١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:12","translation":"They say: \"It would in that case, be a return with loss!\"","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:12:1","position":1,"arabic":"قَالُوا۟","kind":"word","gloss":"They say","transliteration":"qālū","lemma":"قَالَ","root":"قول","entryId":"l-effaf24a5c86c56f"},{"key":"79:12:2","position":2,"arabic":"تِلْكَ","kind":"word","gloss":"This","transliteration":"til'ka","lemma":"ذَٰلِك","root":null,"entryId":"l-096a9ad382db7640"},{"key":"79:12:3","position":3,"arabic":"إِذًۭا","kind":"word","gloss":"then","transliteration":"idhan","lemma":"إِذًا","root":null,"entryId":null},{"key":"79:12:4","position":4,"arabic":"كَرَّةٌ","kind":"word","gloss":"(would be) a return","transliteration":"karratun","lemma":"كَرَّة","root":"كرر","entryId":null},{"key":"79:12:5","position":5,"arabic":"خَاسِرَةٌۭ","kind":"word","gloss":"losing","transliteration":"khāsiratun","lemma":"خَاسِرَة","root":"خسر","entryId":null},{"key":"79:12:6","position":6,"arabic":"١٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:13","translation":"But it will be only a single Zajrah [shout (i.e., the second blowing of the Trumpet)], (See Verse 37:19).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:13:1","position":1,"arabic":"فَإِنَّمَا","kind":"word","gloss":"Then only","transliteration":"fa-innamā","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"79:13:2","position":2,"arabic":"هِىَ","kind":"word","gloss":"it","transliteration":"hiya","lemma":null,"root":null,"entryId":null},{"key":"79:13:3","position":3,"arabic":"زَجْرَةٌۭ","kind":"word","gloss":"(will be) a shout","transliteration":"zajratun","lemma":"زَجْرَة","root":"زجر","entryId":null},{"key":"79:13:4","position":4,"arabic":"وَٰحِدَةٌۭ","kind":"word","gloss":"single","transliteration":"wāḥidatun","lemma":"وَٰحِدَة","root":"وحد","entryId":null},{"key":"79:13:5","position":5,"arabic":"١٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:14","translation":"When behold, they find themselves on the surface of the earth alive after their death,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:14:1","position":1,"arabic":"فَإِذَا","kind":"word","gloss":"And behold","transliteration":"fa-idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"79:14:2","position":2,"arabic":"هُم","kind":"word","gloss":"They","transliteration":"hum","lemma":null,"root":null,"entryId":null},{"key":"79:14:3","position":3,"arabic":"بِٱلسَّاهِرَةِ","kind":"word","gloss":"(will be) awakened","transliteration":"bil-sāhirati","lemma":"سَّاهِرَة","root":"سهر","entryId":null},{"key":"79:14:4","position":4,"arabic":"١٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"79:15","translation":"Has there come to you the story of Mûsâ (Moses)?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"79:15:1","position":1,"arabic":"هَلْ","kind":"word","gloss":"Has","transliteration":"hal","lemma":"هَل","root":null,"entryId":"l-acd15f3532f2b613"},{"key":"79:15:2","position":2,"arabic":"أَتَىٰكَ","kind":"word","gloss":"(there) come to you","transliteration":"atāka","lemma":"أَتَى","root":"اتي","entryId":"l-491a40b1f8d047fe"},{"key":"79:15:3","position":3,"arabic":"حَدِيثُ","kind":"word","gloss":"(the) story","transliteration":"ḥadīthu","lemma":"حَدِيث","root":"حدث","entryId":null},{"key":"79:15:4","position":4,"arabic":"مُوسَىٰٓ","kind":"word","gloss":"(of) Musa","transliteration":"mūsā","