[{"ref":"90:1","translation":"I swear by this city (Makkah);","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"90:1:1","position":1,"arabic":"لَآ","kind":"word","gloss":"Nay","transliteration":"lā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"90:1:2","position":2,"arabic":"أُقْسِمُ","kind":"word","gloss":"I swear","transliteration":"uq'simu","lemma":"أَقْسَمُ","root":"قسم","entryId":null},{"key":"90:1:3","position":3,"arabic":"بِهَـٰذَا","kind":"word","gloss":"by this","transliteration":"bihādhā","lemma":"هَٰذَا","root":null,"entryId":"l-a874a3c6f146e6a2"},{"key":"90:1:4","position":4,"arabic":"ٱلْبَلَدِ","kind":"word","gloss":"city","transliteration":"l-baladi","lemma":"بَلَد","root":"بلد","entryId":null},{"key":"90:1:5","position":5,"arabic":"١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"90:2","translation":"And you are free (from sin, and to punish the enemies of Islâm on the Day of the conquest) in this city (Makkah).","translationSource":"qul-301-hilali-khan","notes":[{"text":"a) Narrated Ibn ‘Abbâs رضي الله عنهما: On the day of the conquest of Makkah, Allâh’s Messenger صلى الله عليه وسلم said, \"Allâh has made this town a sanctuary. Its thorny bushes should not be cut, its game should not be chased, and its fallen things should not be picked up except by one who would announce them publicly.\" (Sahih Al-Bukhari, Vol.2, Hadith No. 657) b) See the footnote of (V.2:191).","ref":{"surah":2,"ayah":191}}],"tokens":[{"key":"90:2:1","position":1,"arabic":"وَأَنتَ","kind":"word","gloss":"And you","transliteration":"wa-anta","lemma":null,"root":null,"entryId":null},{"key":"90:2:2","position":2,"arabic":"حِلٌّۢ","kind":"word","gloss":"(are) free (to dwell)","transliteration":"ḥillun","lemma":"حِلّ","root":"حلل","entryId":null},{"key":"90:2:3","position":3,"arabic":"بِهَـٰذَا","kind":"word","gloss":"in this","transliteration":"bihādhā","lemma":"هَٰذَا","root":null,"entryId":"l-a874a3c6f146e6a2"},{"key":"90:2:4","position":4,"arabic":"ٱلْبَلَدِ","kind":"word","gloss":"city","transliteration":"l-baladi","lemma":"بَلَد","root":"بلد","entryId":null},{"key":"90:2:5","position":5,"arabic":"٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"90:3","translation":"And by the begetter (i.e. Adam عليه السلام) and that which he begot (i.e. his progeny).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"90:3:1","position":1,"arabic":"وَوَالِدٍۢ","kind":"word","gloss":"And the begetter","transliteration":"wawālidin","lemma":"وَالِد","root":"ولد","entryId":null},{"key":"90:3:2","position":2,"arabic":"وَمَا","kind":"word","gloss":"and what","transliteration":"wamā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"90:3:3","position":3,"arabic":"وَلَدَ","kind":"word","gloss":"he begot","transliteration":"walada","lemma":"وَلَدَ","root":"ولد","entryId":null},{"key":"90:3:4","position":4,"arabic":"٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"90:4","translation":"Verily, We have created man in toil.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"90:4:1","position":1,"arabic":"لَقَدْ","kind":"word","gloss":"Certainly","transliteration":"laqad","lemma":"قَد","root":null,"entryId":"l-11a59b67e56e7412"},{"key":"90:4:2","position":2,"arabic":"خَلَقْنَا","kind":"word","gloss":"We have created","transliteration":"khalaqnā","lemma":"خَلَقَ","root":"خلق","entryId":"l-9e7414ba00a88ddc"},{"key":"90:4:3","position":3,"arabic":"ٱلْإِنسَـٰنَ","kind":"word","gloss":"man","transliteration":"l-insāna","lemma":"إِنسَٰن","root":"انس","entryId":"l-bec7f7166ce0ed1b"},{"key":"90:4:4","position":4,"arabic":"فِى","kind":"word","gloss":"(to be) in","transliteration":"fī","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"90:4:5","position":5,"arabic":"كَبَدٍ","kind":"word","gloss":"hardship","transliteration":"kabadin","lemma":"كَبَد","root":"كبد","entryId":null},{"key":"90:4:6","position":6,"arabic":"٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"90:5","translation":"Does he think that none can overcome him?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"90:5:1","position":1,"arabic":"أَيَحْسَبُ","kind":"word","gloss":"Does he think","transliteration":"ayaḥsabu","lemma":"حَسِبَ","root":"حسب","entryId":"l-717e0311dc7803f9"},{"key":"90:5:2","position":2,"arabic":"أَن","kind":"word","gloss":"that","transliteration":"an","lemma":"أَن","root":null,"entryId":"l-6fb897ea8dfcda9d"},{"key":"90:5:3","position":3,"arabic":"لَّن","kind":"word","gloss":"not","transliteration":"lan","lemma":"لَن","root":null,"entryId":"l-3db5462128ff695e"},{"key":"90:5:4","position":4,"arabic":"يَقْدِرَ","kind":"word","gloss":"has power","transliteration":"yaqdira","lemma":"قَدَرَ","root":"قدر","entryId":null},{"key":"90:5:5","position":5,"arabic":"عَلَيْهِ","kind":"word","gloss":"over him","transliteration":"ʿalayhi","lemma":"عَلَىٰ","root":null,"entryId":"l-08dd9283adb70e54"},{"key":"90:5:6","position":6,"arabic":"أَحَدٌۭ","kind":"word","gloss":"anyone","transliteration":"aḥadun","lemma":"أَحَد","root":"احد","entryId":"l-4e0bd3447fb54c57"},{"key":"90:5:7","position":7,"arabic":"٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"90:6","translation":"He says (boastfully): \"I have wasted wealth in abundance!\"","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"90:6:1","position":1,"arabic":"يَقُولُ","kind":"word","gloss":"He will say","transliteration":"yaqūlu","lemma":"قَالَ","root":"قول","entryId":"l-effaf24a5c86c56f"},{"key":"90:6:2","position":2,"arabic":"أَهْلَكْتُ","kind":"word","gloss":"I have squandered","transliteration":"ahlaktu","lemma":"أَهْلَكَ","root":"هلك","entryId":"l-ef683ef1293fcd06"},{"key":"90:6:3","position":3,"arabic":"مَالًۭا","kind":"word","gloss":"wealth","transliteration":"mālan","lemma":"مَال","root":"مول","entryId":"l-ae66a2452b005081"},{"key":"90:6:4","position":4,"arabic":"لُّبَدًا","kind":"word","gloss":"abundant","transliteration":"lubadan","lemma":"لُّبَد","root":"لبد","entryId":null},{"key":"90:6:5","position":5,"arabic":"٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"90:7","translation":"Does he think that none sees him?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"90:7:1","position":1,"arabic":"أَيَحْسَبُ","kind":"word","gloss":"Does he think","transliteration":"ayaḥsabu","lemma":"حَسِبَ","root":"حسب","entryId":"l-717e0311dc7803f9"},{"key":"90:7:2","position":2,"arabic":"أَن","kind":"word","gloss":"that","transliteration":"an","lemma":"أَن","root":null,"entryId":"l-6fb897ea8dfcda9d"},{"key":"90:7:3","position":3,"arabic":"لَّمْ","kind":"word","gloss":"not","transliteration":"lam","lemma":"لَم","root":null,"entryId":"l-a5ee2f54ca9bbf2c"},{"key":"90:7:4","position":4,"arabic":"يَرَهُۥٓ","kind":"word","gloss":"sees him","transliteration":"yarahu","lemma":"رَءَا","root":"راي","entryId":"l-6b7f279dfcd3ea58"},{"key":"90:7:5","position":5,"arabic":"أَحَدٌ","kind":"word","gloss":"anyone","transliteration":"aḥadun","lemma":"أَحَد","root":"احد","entryId":"l-4e0bd3447fb54c57"},{"key":"90:7:6","position":6,"arabic":"٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"90:8","translation":"Have We not made for him two eyes,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"90:8:1","position":1,"arabic":"أَلَمْ","kind":"word","gloss":"Have not","transliteration":"alam","lemma":"لَم","root":null,"entryId":"l-a5ee2f54ca9bbf2c"},{"key":"90:8:2","position":2,"arabic":"نَجْعَل","kind":"word","gloss":"We made","transliteration":"najʿal","lemma":"جَعَلَ","root":"جعل","entryId":"l-784f751d925aef34"},{"key":"90:8:3","position":3,"arabic":"لَّهُۥ","kind":"word","gloss":"for him","transliteration":"lahu","lemma":null,"root":null,"entryId":null},{"key":"90:8:4","position":4,"arabic":"عَيْنَيْنِ","kind":"word","gloss":"two eyes","transliteration":"ʿaynayni","lemma":"عَيْن","root":"عين","entryId":"l-1b5ec51c16058996"},{"key":"90:8:5","position":5,"arabic":"٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"90:9","translation":"And a tongue and two lips?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"90:9:1","position":1,"arabic":"وَلِسَانًۭا","kind":"word","gloss":"And a tongue","transliteration":"walisānan","lemma":"لِسَان","root":"لسن","entryId":null},{"key":"90:9:2","position":2,"arabic":"وَشَفَتَيْنِ","kind":"word","gloss":"and two lips","transliteration":"washafatayni","lemma":"شَفَتَيْن","root":"شفه","entryId":null},{"key":"90:9:3","position":3,"arabic":"٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"90:10","translation":"And shown him the two ways (good and evil)?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"90:10:1","position":1,"arabic":"وَهَدَيْنَـٰهُ","kind":"word","gloss":"And shown him","transliteration":"wahadaynāhu","lemma":"هَدَى","root":"هدي","entryId":"l-e0ac61a274311deb"},{"key":"90:10:2","position":2,"arabic":"ٱلنَّجْدَيْنِ","kind":"word","gloss":"the two ways","transliteration":"l-najdayni","lemma":"نَّجْدَيْن","root":"نجد","entryId":null},{"key":"90:10:3","position":3,"arabic":"١٠","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"90:11","translation":"But he has not attempted to pass on the path that is steep (i.e. the path which will lead to goodness and success).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"90:11:1","position":1,"arabic":"فَلَا","kind":"word","gloss":"But not","transliteration":"falā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"90:11:2","position":2,"arabic":"ٱقْتَحَمَ","kind":"word","gloss":"he has attempted","transliteration":"iq'taḥama","lemma":"اقْتَحَمَ","root":"قحم","entryId":null},{"key":"90:11:3","position":3,"arabic":"ٱلْعَقَبَةَ","kind":"word","gloss":"the steep path","transliteration":"l-ʿaqabata","lemma":"عَقَبَة","root":"عقب","entryId":null},{"key":"90:11:4","position":4,"arabic":"١١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"90:12","translation":"And what will make you know the path that is steep?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"90:12:1","position":1,"arabic":"وَمَآ","kind":"word","gloss":"And what","transliteration":"wamā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"90:12:2","position":2,"arabic":"أَدْرَىٰكَ","kind":"word","gloss":"can make you know","transliteration":"adrāka","lemma":"أَدْرَىٰ","root":"دري","entryId":null},{"key":"90:12:3","position":3,"arabic":"مَا","kind":"word","gloss":"what","transliteration":"mā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"90:12:4","position":4,"arabic":"ٱلْعَقَبَةُ","kind":"word","gloss":"the steep path (is)","transliteration":"l-ʿaqabatu","lemma":"عَقَبَة","root":"عقب","entryId":null},{"key":"90:12:5","position":5,"arabic":"١٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"90:13","translation":"(It is) freeing a neck (slave)","translationSource":"qul-301-hilali-khan","notes":[{"text":"Narrated Abu Hurairah رضي الله عنه: The Prophet صلى الله عليه وسلم said: \"Whoever frees a Muslim slave, Allâh will save all the parts of his body from the (Hell) Fire, as he has freed the body-parts of the slave.\" (Sahih Al-Bukhari, Vol.3, Hadith No.693).","ref":null}],"tokens":[{"key":"90:13:1","position":1,"arabic":"فَكُّ","kind":"word","gloss":"(It is) freeing","transliteration":"fakku","lemma":"فَكّ","root":"فكك","entryId":null},{"key":"90:13:2","position":2,"arabic":"رَقَبَةٍ","kind":"word","gloss":"a neck","transliteration":"raqabatin","lemma":"رَقَبَة","root":"رقب","entryId":null},{"key":"90:13:3","position":3,"arabic":"١٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"90:14","translation":"Or giving food in a day of hunger (famine),","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"90:14:1","position":1,"arabic":"أَوْ","kind":"word","gloss":"Or","transliteration":"aw","lemma":"أَو","root":null,"entryId":"l-338778252179b4e1"},{"key":"90:14:2","position":2,"arabic":"إِطْعَـٰمٌۭ","kind":"word","gloss":"feeding","transliteration":"iṭ'ʿāmun","lemma":"إِطْعَٰم","root":"طعم","entryId":null},{"key":"90:14:3","position":3,"arabic":"فِى","kind":"word","gloss":"in","transliteration":"fī","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"90:14:4","position":4,"arabic":"يَوْمٍۢ","kind":"word","gloss":"a day","transliteration":"yawmin","lemma":"يَوْم","root":"يوم","entryId":"l-bd6f5747b4dfe79c"},{"key":"90:14:5","position":5,"arabic":"ذِى","kind":"word","gloss":"of","transliteration":"dhī","lemma":"ذُو","root":null,"entryId":"l-ea5c5c22a86c9f67"},{"key":"90:14:6","position":6,"arabic":"مَسْغَبَةٍۢ","kind":"word","gloss":"severe hunger","transliteration":"masghabatin","lemma":"مَسْغَبَة","root":"سغب","entryId":null},{"key":"90:14:7","position":7,"arabic":"١٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"90:15","translation":"To an orphan near of kin.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"90:15:1","position":1,"arabic":"يَتِيمًۭا","kind":"word","gloss":"An orphan","transliteration":"yatīman","lemma":"يَتِيم","root":"يتم","entryId":null},{"key":"90:15:2","position":2,"arabic":"ذَا","kind":"word","gloss":"of","transliteration":"dhā","lemma":"ذَا","root":null,"entryId":null},{"key":