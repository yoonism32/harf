[{"ref":"110:1","translation":"When there comes the Help of Allâh (to you, O Muhammad صلى الله عليه وسلم against your enemies) and the conquest (of Makkah).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"110:1:1","position":1,"arabic":"إِذَا","kind":"word","gloss":"When","transliteration":"idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"110:1:2","position":2,"arabic":"جَآءَ","kind":"word","gloss":"comes","transliteration":"jāa","lemma":"جَآءَ","root":"جيا","entryId":"l-1abf61bfcb8fdd4c"},{"key":"110:1:3","position":3,"arabic":"نَصْرُ","kind":"word","gloss":"(the) Help","transliteration":"naṣru","lemma":"نَصْر","root":"نصر","entryId":null},{"key":"110:1:4","position":4,"arabic":"ٱللَّهِ","kind":"word","gloss":"(of) Allah","transliteration":"l-lahi","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"110:1:5","position":5,"arabic":"وَٱلْفَتْحُ","kind":"word","gloss":"and the Victory","transliteration":"wal-fatḥu","lemma":"فَتْح","root":"فتح","entryId":null},{"key":"110:1:6","position":6,"arabic":"١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"110:2","translation":"And you see that the people enter Allah’s religion (Islâm) in crowds.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"110:2:1","position":1,"arabic":"وَرَأَيْتَ","kind":"word","gloss":"And you see","transliteration":"wara-ayta","lemma":"رَءَا","root":"راي","entryId":"l-6b7f279dfcd3ea58"},{"key":"110:2:2","position":2,"arabic":"ٱلنَّاسَ","kind":"word","gloss":"the people","transliteration":"l-nāsa","lemma":"نَّاس","root":"نوس","entryId":"l-490d7f2d4cbaf6d4"},{"key":"110:2:3","position":3,"arabic":"يَدْخُلُونَ","kind":"word","gloss":"entering","transliteration":"yadkhulūna","lemma":"دَخَلَ","root":"دخل","entryId":"l-c4eb37281e378020"},{"key":"110:2:4","position":4,"arabic":"فِى","kind":"word","gloss":"into","transliteration":"fī","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"110:2:5","position":5,"arabic":"دِينِ","kind":"word","gloss":"(the) religion","transliteration":"dīni","lemma":"دِين","root":"دين","entryId":"l-869ef1d12b24f52a"},{"key":"110:2:6","position":6,"arabic":"ٱللَّهِ","kind":"word","gloss":"(of) Allah","transliteration":"l-lahi","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"110:2:7","position":7,"arabic":"أَفْوَاجًۭا","kind":"word","gloss":"(in) multitudes","transliteration":"afwājan","lemma":"فَوْج","root":"فوج","entryId":null},{"key":"110:2:8","position":8,"arabic":"٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"110:3","translation":"So glorify the Praises of your Lord, and ask His Forgiveness. Verily, He is the One Who accepts the repentance and Who forgives.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"110:3:1","position":1,"arabic":"فَسَبِّحْ","kind":"word","gloss":"Then glorify","transliteration":"fasabbiḥ","lemma":"سَبَّحَ","root":"سبح","entryId":"l-2e7f33ad65358df7"},{"key":"110:3:2","position":2,"arabic":"بِحَمْدِ","kind":"word","gloss":"with (the) praises","transliteration":"biḥamdi","lemma":"حَمْد","root":"حمد","entryId":"l-2021dc67831a62d4"},{"key":"110:3:3","position":3,"arabic":"رَبِّكَ","kind":"word","gloss":"(of) your Lord","transliteration":"rabbika","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"110:3:4","position":4,"arabic":"وَٱسْتَغْفِرْهُ ۚ","kind":"word","gloss":"and ask His forgiveness","transliteration":"wa-is'taghfir'hu","lemma":"اسْتَغْفَرَ","root":"غفر","entryId":"l-a814227928267cba"},{"key":"110:3:5","position":5,"arabic":"إِنَّهُۥ","kind":"word","gloss":"Indeed, He","transliteration":"innahu","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"110:3:6","position":6,"arabic":"كَانَ","kind":"word","gloss":"is","transliteration":"kāna","lemma":"كَانَ","root":"كون","entryId":"l-4b2f9969a9af0d45"},{"key":"110:3:7","position":7,"arabic":"تَوَّابًۢا","kind":"word","gloss":"Oft-Returning","transliteration":"tawwāban","lemma":"تَوَّاب","root":"توب","entryId":null},{"key":"110:3:8","position":8,"arabic":"٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]}]