[{"ref":"103:1","translation":"By Al-‘Asr (the time).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"103:1:1","position":1,"arabic":"وَٱلْعَصْرِ","kind":"word","gloss":"By the time","transliteration":"wal-ʿaṣri","lemma":"عَصْر","root":"عصر","entryId":null},{"key":"103:1:2","position":2,"arabic":"١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"103:2","translation":"Verily, man is in loss,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"103:2:1","position":1,"arabic":"إِنَّ","kind":"word","gloss":"Indeed","transliteration":"inna","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"103:2:2","position":2,"arabic":"ٱلْإِنسَـٰنَ","kind":"word","gloss":"mankind","transliteration":"l-insāna","lemma":"إِنسَٰن","root":"انس","entryId":"l-bec7f7166ce0ed1b"},{"key":"103:2:3","position":3,"arabic":"لَفِى","kind":"word","gloss":"(is) surely, in","transliteration":"lafī","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"103:2:4","position":4,"arabic":"خُسْرٍ","kind":"word","gloss":"loss","transliteration":"khus'rin","lemma":"خُسْر","root":"خسر","entryId":null},{"key":"103:2:5","position":5,"arabic":"٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"103:3","translation":"Except those who believe (in Islâmic Monotheism) and do righteous good deeds, and recommend one another to the truth [i.e. order one another to perform all kinds of good deeds (Al-Ma‘ruf) which Allâh has ordained, and abstain from all kinds of sins and evil deeds (Al-Munkar which Allâh has forbidden], and recommend one another to patience (for the sufferings, harms, and injuries which one may encounter in Allâh’s Cause during preaching His religion of Islâmic Monotheism or Jihâd).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"103:3:1","position":1,"arabic":"إِلَّا","kind":"word","gloss":"Except","tra