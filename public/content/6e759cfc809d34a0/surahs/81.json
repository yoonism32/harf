[{"ref":"81:1","translation":"When the sun is wound round and its light is lost and is overthrown.","translationSource":"qul-301-hilali-khan","notes":[{"text":"Narrated Abu Hurairah رضي الله عنه: The Prophet صلى الله عليه وسلم said, \"The sun and the moon will be folded up (or joined together or deprived of their lights) on the Day of Resurrection.\" [See the Qur’ân (V.75:9)] (Sahih Al-Bukhari, Vol.4, Hadith No.422).","ref":null}],"tokens":[{"key":"81:1:1","position":1,"arabic":"إِذَا","kind":"word","gloss":"When","transliteration":"idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"81:1:2","position":2,"arabic":"ٱلشَّمْسُ","kind":"word","gloss":"the sun","transliteration":"l-shamsu","lemma":"شَمْس","root":"شمس","entryId":null},{"key":"81:1:3","position":3,"arabic":"كُوِّرَتْ","kind":"word","gloss":"is wrapped up","transliteration":"kuwwirat","lemma":"كُوِّرَتْ","root":"كور","entryId":null},{"key":"81:1:4","position":4,"arabic":"١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"81:2","translation":"And when the stars fall.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"81:2:1","position":1,"arabic":"وَإِذَا","kind":"word","gloss":"And when","transliteration":"wa-idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"81:2:2","position":2,"arabic":"ٱلنُّجُومُ","kind":"word","gloss":"the stars","transliteration":"l-nujūmu","lemma":"نَّجْم","root":"نجم","entryId":null},{"key":"81:2:3","position":3,"arabic":"ٱنكَدَرَتْ","kind":"word","gloss":"fall, losing their luster","transliteration":"inkadarat","lemma":"انكَدَرَتْ","root":"كدر","entryId":null},{"key":"81:2:4","position":4,"arabic":"٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"81:3","translation":"And when the mountains are made to pass away;","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"81:3:1","position":1,"arabic":"وَإِذَا","kind":"word","gloss":"And when","transliteration":"wa-idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"81:3:2","position":2,"arabic":"ٱلْجِبَالُ","kind":"word","gloss":"the mountains","transliteration":"l-jibālu","lemma":"جَبَل","root":"جبل","entryId":"l-740cdd8405f7481e"},{"key":"81:3:3","position":3,"arabic":"سُيِّرَتْ","kind":"word","gloss":"are moved away","transliteration":"suyyirat","lemma":"سُيِّرَتْ","root":"سير","entryId":null},{"key":"81:3:4","position":4,"arabic":"٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"81:4","translation":"And when the pregnant she-camels are neglected;","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"81:4:1","position":1,"arabic":"وَإِذَا","kind":"word","gloss":"And when","transliteration":"wa-idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"81:4:2","position":2,"arabic":"ٱلْعِشَارُ","kind":"word","gloss":"the full-term she-camels","transliteration":"l-ʿishāru","lemma":"عِشَار","root":"عشر","entryId":null},{"key":"81:4:3","position":3,"arabic":"عُطِّلَتْ","kind":"word","gloss":"(are) left untended","transliteration":"ʿuṭṭilat","lemma":"عُطِّلَتْ","root":"عطل","entryId":null},{"key":"81:4:4","position":4,"arabic":"٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"81:5","translation":"And when the wild beasts are gathered together.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"81:5:1","position":1,"arabic":"وَإِذَا","kind":"word","gloss":"And when","transliteration":"wa-idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"81:5:2","position":2,"arabic":"ٱلْوُحُوشُ","kind":"word","gloss":"the wild beasts","transliteration":"l-wuḥūshu","lemma":"وُحُوش","root":"وحش","entryId":null},{"key":"81:5:3","position":3,"arabic":"حُشِرَتْ","kind":"word","gloss":"are gathered","transliteration":"ḥushirat","lemma":"حَشَرَ","root":"حشر","entryId":"l-f0c6902f4c937a12"},{"key":"81:5:4","position":4,"arabic":"٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"81:6","translation":"And when the seas become as blazing Fire or overflow.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"81:6:1","position":1,"arabic":"وَإِذَا","kind":"word","gloss":"And when","transliteration":"wa-idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"81:6:2","position":2,"arabic":"ٱلْبِحَارُ","kind":"word","gloss":"the seas","transliteration":"l-biḥāru","lemma":"بَحْر","root":"بحر","entryId":"l-2d6cae9206a34f68"},{"key":"81:6:3","position":3,"arabic":"سُجِّرَتْ","kind":"word","gloss":"are made to overflow","transliteration":"sujjirat","lemma":"سُجِّرَتْ","root":"سجر","entryId":null},{"key":"81:6:4","position":4,"arabic":"٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"81:7","translation":"And when the souls are joined with their bodies, (the good with the good and the bad with the bad).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"81:7:1","position":1,"arabic":"وَإِذَا","kind":"word","gloss":"And when","transliteration":"wa-idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"81:7:2","position":2,"arabic":"ٱلنُّفُوسُ","kind":"word","gloss":"the souls","transliteration":"l-nufūsu","lemma":"نَفْس","root":"نفس","entryId":"l-95a2521e875a8b29"},{"key":"81:7:3","position":3,"arabic":"زُوِّجَتْ","kind":"word","gloss":"are paired","transliteration":"zuwwijat","lemma":"زُوِّجَتْ","root":"زوج","entryId":null},{"key":"81:7:4","position":4,"arabic":"٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"81:8","translation":"And when the female (infant) buried alive (as the pagan Arabs used to do) is questioned:","translationSource":"qul-301-hilali-khan","notes":[{"text":"Narrated Al-Mughîrah bin Shu‘bah رضي الله عنه: The Prophet صلى الله عليه وسلم said, \"Allâh has forbidden for you: (1) to be undutiful to your mothers, (2) to bury your daughters alive, (3) not to pay the rights of the others (e.g., charity), and (4) to beg of men (i.e., begging). And Allâh hates for you: (1) sinful and useless talk like backbiting, or that you talk too much about others, (2) to ask too many questions (in disputed religious matters), and (3) to waste the wealth (by extravagance with lack of wisdom and thinking).\" (Sahih Al-Bukhari, Vol.3, Hadith No.591).","ref":null}],"tokens":[{"key":"81:8:1","position":1,"arabic":"وَإِذَا","kind":"word","gloss":"And when","transliteration":"wa-idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"81:8:2","position":2,"arabic":"ٱلْمَوْءُۥدَةُ","kind":"word","gloss":"the female infant buried alive","transliteration":"l-mawūdatu","lemma":"مَوْءُدَة","root":"واد","entryId":null},{"key":"81:8:3","position":3,"arabic":"سُئِلَتْ","kind":"word","gloss":"is asked","transliteration":"su-ilat","lemma":"سَأَلَ","root":"سال","entryId":"l-ad7819fc39b763e0"},{"key":"81:8:4","position":4,"arabic":"٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"81:9","translation":"For what sin, was she killed?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"81:9:1","position":1,"arabic":"بِأَىِّ","kind":"word","gloss":"For what","transliteration":"bi-ayyi","lemma":"أَىّ","root":"ايي","entryId":"l-1b17d6cf8e714c6a"},{"key":"81:9:2","position":2,"arabic":"ذَنۢبٍۢ","kind":"word","gloss":"sin","transliteration":"dhanbin","lemma":"ذَنب","root":"ذنب","entryId":"l-4f826b1de82e9b9d"},{"key":"81:9:3","position":3,"arabic":"قُتِلَتْ","kind":"word","gloss":"she was killed","transliteration":"qutilat","lemma":"قَتَلَ","root":"قتل","entryId":"l-12fa2efc8330d476"},{"key":"81:9:4","position":4,"arabic":"٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"81:10","translation":"And when the (written) pages [of deeds (good and bad) of every person] are laid open.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"81:10:1","position":1,"arabic":"وَإِذَا","kind":"word","gloss":"And when","transliteration":"wa-idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"81:10:2","position":2,"arabic":"ٱلصُّحُفُ","kind":"word","gloss":"the pages","transliteration":"l-ṣuḥufu","lemma":"صُحُف","root":"صحف","entryId":null},{"key":"81:10:3","position":3,"arabic":"نُشِرَتْ","kind":"word","gloss":"are laid open","transliteration":"nushirat","lemma":"نُشِرَتْ","root":"نشر","entryId":null},{"key":"81:10:4","position":4,"arabic":"١٠","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"81:11","translation":"And when the heaven is stripped off and taken away from its place;","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"81:11:1","position":1,"arabic":"وَإِذَا","kind":"word","gloss":"And when","transliteration":"wa-idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"81:11:2","position":2,"arabic":"ٱلسَّمَآءُ","kind":"word","gloss":"the sky","transliteration":"l-samāu","lemma":"سَمَآء","root":"سمو","entryId":"l-e873a75addf25baf"},{"key":"81:11:3","position":3,"arabic":"كُشِطَتْ","kind":"word","gloss":"is stripped away","transliteration":"kushiṭat","lemma":"كُشِطَتْ","root":"كشط","entryId":null},{"key":"81:11:4","position":4,"arabic":"١١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"81:12","translation":"And when Hell-fire is set ablaze.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"81:12:1","position":1,"arabic":"وَإِذَا","kind":"word","gloss":"And when","transliteration":"wa-idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"81:12:2","position":2,"arabic":"ٱلْجَحِيمُ","kind":"word","gloss":"the Hellfire","transliteration":"l-jaḥīmu","lemma":"جَحِيم","root":"جحم","entryId":null},{"key":"81:12:3","position":3,"arabic":"سُعِّرَتْ","kind":"word","gloss":"is set ablaze","transliteration":"suʿʿirat","lemma":"سُعِّرَتْ","root":"سعر","entryId":null},{"key":"81:12:4","position":4,"arabic":"١٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"81:13","translation":"And when Paradise is brought near.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"81:13:1","position":1,"arabic":"وَإِذَا","kind":"word","gloss":"And when","transliteration":"wa-idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"81:13:2","position":2,"arabic":"ٱلْجَنَّةُ","kind":"word","gloss":"Paradise","transliteration":"l-janatu","lemma":"جَنَّة","root":"جنن","entryId":"l-9f22ab6b78dd8a22"},{"key":"81:13:3","position":3,"arabic":"أُزْلِفَتْ","kind":"word","gloss":"is brought near","transliteration":"uz'lifat","lemma":"أُزْلِفَتْ","root":"زلف","entryId":null},{"key":"81:13:4","position":4,"arabic":"١٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"81:14","translation":"(Then) every person will know what he has brought (of good and evil).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"81:14:1","position":1,"arabic":"عَلِمَتْ","kind":"word","gloss":"Will know","transliteration":"ʿalimat","lemma":"عَلِمَ","root":"علم","entryId":"l-6de9979b254804ea"},{"key":"81:14:2","position":2,"arabic":"نَفْسٌۭ","kind":"word","gloss":"a soul","transliteration":"nafsun","lemma":"نَفْس","root":"نفس","entryId":"l-95a2521e875a8b29"},{"key":"81:14:3","position":3,"arabic":"مَّآ","kind":"word","gloss":"what","transliteration":"mā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"81:14:4","position":4,"arabic":"أَحْضَرَتْ","kind":"word","gloss":"it has brought","transliteration":"aḥḍarat","lemma":"أَحْضَرَتْ","root":"حضر","entryId":null},{"key":"81:14:5","position":5,"arabic":"١٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"81:15","translation":"So verily, I swear by the planets that recede (i.e. disappear during the day and appear during the night).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"81:15:1","position":1,"arabic":"فَلَآ","kind":"word","gloss":"But nay","transliteration":"falā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"81:15:2","position":2,"arabic":"أُقْسِمُ","kind":"word","gloss":"I swear","transliteration":"uq'simu","lemma":"أَقْسَمُ","root":"قسم","entryId":null},{"key":"81:15:3","position":3,"arabic":"بِٱلْخُنَّسِ","kind":"word","gloss":"by the retreating planets","transliteration":"bil-khunasi","lemma":"خُنَّس","root":"خنس","entryId":null},{"key":"81:15:4","position":4,"arabic":"١٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"81:16","translation":"And by the planets that move swiftly and hide themselves.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"81:16:1","position":1,"arabic":"ٱلْجَوَارِ","kind":"word","gloss":"Those that run","transliteration":"al-jawāri","lemma":"جَوَار","root":"جري","entryId":null},{"key":"81:16:2","position":2,"arabic":"ٱلْكُنَّسِ","kind":"word","gloss":"(and) disappear","transliteration":"l-kunasi","lemma":"كُنَّس","root":"كنس","entryId":null},{"key":"81:16:3","position":3,"arabic":"١٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"81:17","translation":"And by the night as it departs.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"81:17:1","position":1,"arabic":"وَٱلَّيْلِ","kind":"word","gloss":"And the night","transliteration":"wa-al-layli","lemma":"لَيْل","root":"ليل","entryId":"l-d2e604e516a58959"},{"key":"81:17:2","position":2,"arabic":"إِذَا","kind":"word","gloss":"when","transliteration":"idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"81:17:3","position":3,"arabic":"عَسْعَسَ","kind":"word","gloss":"it departs","transliteration":"ʿasʿasa","lemma":"عَسْعَسَ","root":"عسعس","entryId":null},{"key":"81:17:4","position":4,"arabic":"١٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"81:18","translation":"And by the dawn as it brightens.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"81:18:1","position":1,"arabic":"وَٱلصُّبْحِ","kind":"word","gloss":"And the dawn","transliteration":"wal-ṣub'ḥi","lemma":"صُبْح","root":"صبح","entryId":null},{"key":"81:18:2","position":2,"arabic":"إِذَا","kind":"word","gloss":"when","transliteration":"idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"81:18:3","position":3,"arabic":"تَنَفَّسَ","kind":"word","gloss":"it breathes","transliteration":"tanaffasa","lemma":"تَنَفَّسَ","root":"نفس","entryId":null},{"key":"81:18:4","position":4,"arabic":"١٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"81:19","translation":"Verily, this is the Word (this Qur’ân brought by) a most honourable messenger [Jibrîl (Gabrîl), from Allâh to Prophet Muhammad صلى الله عليه وسلم].","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"81:19:1","position":1,"arabic":"إِنَّهُۥ","kind":"word","gloss":"Indeed, it","transliteration":"innahu","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"81:19:2","position":2,"arabic":"لَقَوْلُ","kind":"word","gloss":"(is) surely a word","transliteration":"laqawlu","lemma":"قَوْل","root":"قول","entryId":"l-5fc9c7afcefb8aa7"},{"key":"81:19:3","position":3,"arabic":"رَسُولٍۢ","kind":"word","gloss":"(of) a Messenger","transliteration":"rasūlin","lemma":"رَسُول","root":"رسل","entryId":"l-165e008d0f146d23"},{"key":"81:19:4","position":4,"arabic":"كَرِيمٍۢ","kind":"word","gloss":"noble","transliteration":"karīmin","lemma":"كَرِيم","root":"كرم","entryId":null},{"key":"81:19:5","position":5,"arabic":"١٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"81:20","translation":"Owner of power, (and high rank) with (Allâh), the Lord of the Throne,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"81:20:1","position":1,"arabic":"ذِى","kind":"word","gloss":"Possessor of","transliteration":"dhī","lemma":"ذُو","root":null,"entryId":"l-ea5c5c22a86c9f67"},{"key":"81:20:2","position":2,"arabic":"قُوَّةٍ","kind":"word","gloss":"power","transliteration":"quwwatin","lemma":"قُوَّة","root":"قوي","entryId":null},{"key":"81:20:3","position":3,"arabic":"عِندَ","kind":"word","gloss":"with","transliteration":"ʿinda","lemma":"عِند","root":"عند","entryId":"l-30b61508aaa6b3fa"},{"key":"81:20:4","position":4,"arabic":"ذِى","kind":"word","gloss":"(the) Owner of","transliteration":"dhī","lemma":"ذُو","root":null,"entryId":"l-ea5c5c22a86c9f67"},{"key":"81:20:5","position":5,"arabic":"ٱلْعَرْشِ","kind":"word","gloss":"the Throne","transliteration":"l-ʿarshi","lemma":"عَرْش","root":"عرش","entryId":null},{"key":"81:20:6","position":6,"arabic":"مَكِينٍۢ","kind":"word","gloss":"secure","transliteration":"makīnin","lemma":"مَّكِين","root":"مكن","entryId":null},{"key":"81:20:7","position":7,"arabic":"٢٠","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"81:21","translation":"Obeyed (by the angels in the heavens), and trustworthy.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"81:21:1","position":1,"arabic":"مُّطَاعٍۢ","kind":"word","gloss":"One to be obeyed","transliteration":"muṭāʿin","lemma":"مُّطَاع","root":"طوع","entryId":null},{"key":"81:21:2","position":2,"arabic":"ثَمَّ","kind":"word","gloss":"and","transliteration":"thamma","lemma":"ثَمّ","root":null,"entryId":null},{"key":"81:21:3","position":3,"arabic":"أَمِينٍۢ","kind":"word","gloss":"trustworthy","transliteration":"amīnin","lemma":"أَمِين","root":"امن","entryId":null},{"key":"81:21:4","position":4,"arabic":"٢١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"81:22","translation":"And (O people) your companion (Muhammad صلى الله عليه وسلم) is not a madman.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"81:22:1","position":1,"arabic":"وَمَا","kind":"word","gloss":"And not","transliteration":"wamā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"81:22:2","position":2,"arabic":"صَاحِبُكُم","kind":"word","gloss":"(is) your companion","transliteration":"ṣāḥibukum","lemma":"صَاحِب","root":"صحب","entryId":null},{"key":"81:22:3","position":3,"arabic":"بِمَجْنُونٍۢ","kind":"word","gloss":"mad","transliteration":"bimajnūnin","lemma":"مَجْنُون","root":"جنن","entryId":null},{"key":"81:22:4","position":4,"arabic":"٢٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"81:23","translation":"And indeed he (Muhammad صلى الله عليه وسلم) saw him [Jibrîl (Gabriel)] in the clear horizon (towards the east).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"81:23:1","position":1,"arabic":"وَلَقَدْ","kind":"word","gloss":"And certainly","transliteration":"walaqad","lemma":"قَد","root":null,"entryId":"l-11a59b67e56e7412"},{"key":"81:23:2","position":2,"arabic":"رَءَاهُ","kind":"word","gloss":"he saw him","transliteration":"raāhu","lemma":"رَءَا","root":"راي","entryId":"l-6b7f279dfcd3ea58"},{"key":"81:23:3","position":3,"arabic":"بِٱلْأُفُقِ","kind":"word","gloss":"in the horizon","transliteration":"bil-ufuqi","lemma":"أُفُق","root":"افق","entryId":null},{"key":"81:23:4","position":4,"arabic":"ٱلْمُبِينِ","kind":"word","gloss":"the clear","transliteration":"l-mubīni","lemma":"مُّبِين","root":"بين","entryId":"l-0d597777bd2bba00"},{"key":"81:23:5","position":5,"arabic":"٢٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"81:24","translation":"And he (Muhammad صلى الله عليه وسلم) withholds not a knowledge of the Unseen.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"81:24:1","position":1,"arabic":"وَمَا","kind":"word","gloss":"And not","transliteration":"wamā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"81:24:2","position":2,"arabic":"هُوَ","kind":"word","gloss":"he (is)","transliteration":"huwa","lemma":null,"root":null,"entryId":null},{"key":"81:24:3","position":3,"arabic":"عَلَى","kind":"word","gloss":"on","transliteration":"ʿalā","lemma":"عَلَىٰ","root":null,"entryId":"l-08dd9283adb70e54"},{"key":"81:24:4","position":4,"arabic":"ٱلْغَيْبِ","kind":"word","gloss":"the unseen","transliteration":"l-ghaybi","lemma":"غَيْب","root":"غيب","entryId":null},{"key":"81:24:5","position":5,"arabic":"بِضَنِينٍۢ","kind":"word","gloss":"a withholder","transliteration":"biḍanīnin","lemma":"ضَنِين","root":"ضنن","entryId":null},{"key":"81:24:6","position":6,"arabic":"٢٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"81:25","translation":"And it (the Qur’ân) is not the word of the outcast Shaitân (Satan).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"81:25:1","position":1,"arabic":"وَمَا","kind":"word","gloss":"And not","transliteration":"wamā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"81:25:2","position":2,"arabic":"هُوَ","kind":"word","gloss":"it","transliteration":"huwa","lemma":null,"root":null,"entryId":null},{"key":"81:25:3","position":3,"arabic":"بِقَوْلِ","kind":"word","gloss":"(is the) word","transliteration":"biqawli","lemma":"قَوْل","root":"قول","entryId":"l-5fc9c7afcefb8aa7"},{"key":"81:25:4","position":4,"arabic":"شَيْطَـٰنٍۢ","kind":"word","gloss":"(of) Shaitaan","transliteration":"shayṭānin","lemma":"شَيْطَٰن","root":"شطن","entryId":"l-1edf2a3c0afdde81"},{"key":"81:25:5","position":5,"arabic":"رَّجِيمٍۢ","kind":"word","gloss":"accursed","transliteration":"rajīmin","lemma":"رَجِيم","root":"رجم","entryId":null},{"key":"81:25:6","position":6,"arabic":"٢٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"81:26","translation":"Then where are you going?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"81:26:1","position":1,"arabic":"فَأَيْنَ","kind":"word","gloss":"So where","transliteration":"fa-ayna","lemma":"أَيْن","root":null,"entryId":null},{"key":"81:26:2","position":2,"arabic":"تَذْهَبُونَ","kind":"word","gloss":"are you going","transliteration":"tadhhabūna","lemma":"ذَهَبَ","root":"ذهب","entryId":null},{"key":"81:26:3","position":3,"arabic":"٢٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"81:27","translation":"Verily, this (the Qur’ân) is no less than a Reminder to (all) the ‘Âlamîn (mankind and jinn)","translationSource":"qul-301-hilali-khan","notes":[{"text":"a) Narrated Abu Hurairah رضي الله عنه: The Prophet صلى الله عليه وسلم said, \"There was no Prophet among the Prophets but was given miracles because of which people had security or had belief, but what I have been given is the Divine Revelation which Allâh has revealed to me. So I hope that my followers will be more than those of any other Prophet on the Day of Resurrection.\" (Sahih Al-Bukhari, Vol.9, Hadith No.379) b) It is obligatory to have Belief in the Messengership of the Prophet (Muhammad صلى الله عليه وسلم). Narrated Abu Hurairah رضي الله عنه: Allâh’s Messenger صلى الله عليه وسلم said: \"By Him (Allâh) in Whose Hand Muhammad’s soul is, there is none from amongst the Jews and Christians (of these present nations) who hears about me and then dies without believing in the Message with which I have been sent (i.e. Islâmic Monotheism), but he will be from the dwellers of the (Hell) Fire.\" (Sahih Muslim , the Book of Faith, Vol.1, Chapter No.240). See also (V.3:85) and (V.3:116).","ref":null}],"tokens":[{"key":"81:27:1","position":1,"arabic":"إِنْ","kind":"word","gloss":"Not","transliteration":"in","lemma":"إِن","root":null,"entryId":"l-de626c6526849733"},{"key":"81:27:2","position":2,"arabic":"هُوَ","kind":"word","gloss":"it","transliteration":"huwa","lemma":null,"root":null,"entryId":null},{"key":"81:27:3","position":3,"arabic":"إِلَّا","kind":"word","gloss":"(is) except","transliteration":"illā","lemma":"إِلَّا","root":null,"entryId":"l-250ca4d5b58814dd"},{"key":"81:27:4","position":4,"arabic":"ذِكْرٌۭ","kind":"word","gloss":"a reminder","transliteration":"dhik'run","lemma":"ذِكْر","root":"ذكر","entryId":"l-b273b8ee66c296d9"},{"key":"81:27:5","position":5,"arabic":"لِّلْعَـٰلَمِينَ","kind":"word","gloss":"to the worlds","transliteration":"lil'ʿālamīna","lemma":"عَٰلَمِين","root":"علم","entryId":"l-d169321b3c553d43"},{"key":"81:27:6","position":6,"arabic":"٢٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"81:28","translation":"To whomsoever among you who wills to walk straight.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"81:28:1","position":1,"arabic":"لِمَن","kind":"word","gloss":"For whoever","transliteration":"liman","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"81:28:2","position":2,"arabic":"شَآءَ","kind":"word","gloss":"wills","transliteration":"shāa","lemma":"شَآءَ","root":"شيا","entryId":"l-e6061b9230d95354"},{"key":"81:28:3","position":3,"arabic":"مِنكُمْ","kind":"word","gloss":"among you","transliteration":"minkum","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"81:28:4","position":4,"arabic":"أَن","kind":"word","gloss":"to","transliteration":"an","lemma":"أَن","root":null,"entryId":"l-6fb897ea8dfcda9d"},{"key":"81:28:5","position":5,"arabic":"يَسْتَقِيمَ","kind":"word","gloss":"take a straight way","transliteration":"yastaqīma","lemma":"اسْتَقَٰمُ","root":"قوم","entryId":null},{"key":"81:28:6","position":6,"arabic":"٢٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"81:29","translation":"And you cannot will unless (it be) that Allâh wills - the Lord of the ‘Âlamîn (mankind, jinn and all that exists).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"81:29:1","position":1,"arabic":"وَمَا","kind":"word","gloss":"And not","transliteration":"wamā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"81:29:2","position":2,"arabic":"تَشَآءُونَ","kind":"word","gloss":"you will","transliteration":"tashāūna","lemma":"شَآءَ","root":"شيا","entryId":"l-e6061b9230d95354"},{"key":"81:29:3","position":3,"arabic":"إِلَّآ","kind":"word","gloss":"except","transliteration":"illā","lemma":"إِلَّا","root":null,"entryId":"l-250ca4d5b58814dd"},{"key":"81:29:4","position":4,"arabic":"أَن","kind":"word","gloss":"that","transliteration":"an","lemma":"أَن","root":null,"entryId":"l-6fb897ea8dfcda9d"},{"key":"81:29:5","position":5,"arabic":"يَشَآءَ","kind":"word","gloss":"wills","transliteration":"yashāa","lemma":"شَآءَ","root":"شيا","entryId":"l-e6061b9230d95354"},{"key":"81:29:6","position":6,"arabic":"ٱللَّهُ","kind":"word","gloss":"Allah","transliteration":"l-lahu","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"81:29:7","position":7,"arabic":"رَبُّ","kind":"word","gloss":"Lord","transliteration":"rabbu","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"81:29:8","position":8,"arabic":"ٱلْعَـٰلَمِينَ","kind":"word","gloss":"(of) the worlds","transliteration":"l-ʿālamīna","lemma":"عَٰلَمِين","root":"علم","entryId":"l-d169321b3c553d43"},{"key":"81:29:9","position":9,"arabic":"٢٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]}]