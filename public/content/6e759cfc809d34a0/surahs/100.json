[{"ref":"100:1","translation":"By the (steeds) that run, with panting.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"100:1:1","position":1,"arabic":"وَٱلْعَـٰدِيَـٰتِ","kind":"word","gloss":"By the racers","transliteration":"wal-ʿādiyāti","lemma":"عَٰدِيَٰت","root":"عدو","entryId":null},{"key":"100:1:2","position":2,"arabic":"ضَبْحًۭا","kind":"word","gloss":"panting","transliteration":"ḍabḥan","lemma":"ضَبْح","root":"ضبح","entryId":null},{"key":"100:1:3","position":3,"arabic":"١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"100:2","translation":"Striking sparks of fire (by their hooves).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"100:2:1","position":1,"arabic":"فَٱلْمُورِيَـٰتِ","kind":"word","gloss":"And the producers of sparks","transliteration":"fal-mūriyāti","lemma":"مُورِيَٰت","root":"وري","entryId":null},{"key":"100:2:2","position":2,"arabic":"قَدْحًۭا","kind":"word","gloss":"striking","transliteration":"qadḥan","lemma":"قَدْح","root":"قدح","entryId":null},{"key":"100:2:3","position":3,"arabic":"٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"100:3","translation":"And scouring to the raid at dawn.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"100:3:1","position":1,"arabic":"فَٱلْمُغِيرَٰتِ","kind":"word","gloss":"And the chargers","transliteration":"fal-mughīrāti","lemma":"مُغِيرَٰت","root":"غير","entryId":null},{"key":"100:3:2","position":2,"arabic":"صُبْحًۭا","kind":"word","gloss":"(at) dawn","transliteration":"ṣub'ḥan","lemma":"صُبْح","root":"صبح","entryId":null},{"key":"100:3:3","position":3,"arabic":"٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"100:4","translation":"And raise the dust in clouds the while.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"100:4:1","position":1,"arabic":"فَأَثَرْنَ","kind":"word","gloss":"Then raise","transliteration":"fa-atharna","lemma":"أَثَارُ","root":"ثور","entryId":null},{"key":"100:4:2","position":2,"arabic":"بِهِۦ","kind":"word","gloss":"thereby","transliteration":"bihi","lemma":null,"root":null,"entryId":null},{"key":"100:4:3","position":3,"arabic":"نَقْعًۭا","kind":"word","gloss":"dust","transliteration":"naqʿan","lemma":"نَقْع","root":"نقع","entryId":null},{"key":"100:4:4","position":4,"arabic":"٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"100:5","translation":"And penetrating forthwith as one into the midst (of the foe).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"100:5:1","position":1,"arabic":"فَوَسَطْنَ","kind":"word","gloss":"Then penetrate (in the) center","transliteration":"fawasaṭna","lemma":"وَسَطْ","root":"وسط","entryId":null},{"key":"100:5:2","position":2,"arabic":"بِهِۦ","kind":"word","gloss":"thereby","transliteration":"bihi","lemma":null,"root":null,"entryId":null},{"key":"100:5:3","position":3,"arabic":"جَمْعًا","kind":"word","gloss":"collectively","transliteration":"jamʿan","lemma":"جَمْع","root":"جمع","entryId":null},{"key":"100:5:4","position":4,"arabic":"٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"100:6","translation":"Verily, man (disbeliever) is ungrateful to his Lord.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"100:6:1","position":1,"arabic":"إِنَّ","kind":"word","gloss":"Indeed","transliteration":"inna","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"100:6:2","position":2,"arabic":"ٱلْإِنسَـٰنَ","kind":"word","gloss":"mankind","transliteration":"l-insāna","lemma":"إِنسَٰن","root":"انس","entryId":"l-bec7f7166ce0ed1b"},{"key":"100:6:3","position":3,"arabic":"لِرَبِّهِۦ","kind":"word","gloss":"to his Lord","transliteration":"lirabbihi","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"100:6:4","position":4,"arabic":"لَكَنُودٌۭ","kind":"word","gloss":"(is) surely ungrateful","transliteration":"lakanūdun","lemma":"كَنُود","root":"كند","entryId":null},{"key":"100:6:5","position":5,"arabic":"٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"100:7","translation":"And to that he bears witness (by his deeds).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"100:7:1","position":1,"arabic":"وَإِنَّهُۥ","kind":"word","gloss":"And indeed, he","transliteration":"wa-innahu","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"100:7:2","position":2,"arabic":"عَلَىٰ","kind":"word","gloss":"on","transliteration":"ʿalā","lemma":"عَلَىٰ","root":null,"entryId":"l-08dd9283adb70e54"},{"key":"100:7:3","position":3,"arabic":"ذَٰلِكَ","kind":"word","gloss":"that","transliteration":"dhālika","lemma":"ذَٰلِك","root":null,"entryId":"l-096a9ad382db7640"},{"key":"100:7:4","position":4,"arabic":"لَشَهِيدٌۭ","kind":"word","gloss":"surely (is) a witness","transliteration":"lashahīdun","lemma":"شَهِيد","root":"شهد","entryId":"l-edf9ede56169becf"},{"key":"100:7:5","position":5,"arabic":"٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"100:8","translation":"And verily, he is violent in the love of wealth.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"100:8:1","position":1,"arabic":"وَإِنَّهُۥ","kind":"word","gloss":"And indeed he","transliteration":"wa-innahu","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"100:8:2","position":2,"arabic":"لِحُبِّ","kind":"word","gloss":"in (the) love","transliteration":"liḥubbi","lemma":"حُبّ","root":"حبب","entryId":null},{"key":"100:8:3","position":3,"arabic":"ٱلْخَيْرِ","kind":"word","gloss":"(of) wealth","transliteration":"l-khayri","lemma":"خَيْر","root":"خير","entryId":"l-81db6cd6a46bd56c"},{"key":"100:8:4","position":4,"arabic":"لَشَدِيدٌ","kind":"word","gloss":"(is) surely intense","transliteration":"lashadīdun","lemma":"شَدِيد","root":"شدد","entryId":"l-85c14b6882876cfc"},{"key":"100:8:5","position":5,"arabic":"٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"100:9","translation":"Knows he not that when the contents of the graves are poured forth (all mankind is resurrected)?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"100:9:1","position":1,"arabic":"۞ أَفَلَا","kind":"word","gloss":"But does not","transliteration":"afalā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"100:9:2","position":2,"arabic":"يَعْلَمُ","kind":"word","gloss":"he know","transliteration":"yaʿlamu","lemma":"عَلِمَ","root":"علم","entryId":"l-6de9979b254804ea"},{"key":"100:9:3","position":3,"arabic":"إِذَا","kind":"word","gloss":"when","transliteration":"idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"100:9:4","position":4,"arabic":"بُعْثِرَ","kind":"word","gloss":"will be scattered","transliteration":"buʿ'thira","lemma":"بُعْثِرَ","root":"بعثر","entryId":null},{"key":"100:9:5","position":5,"arabic":"مَا","kind":"word","gloss":"what","transliteration":"mā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"100:9:6","position":6,"arabic":"فِى","kind":"word","gloss":"(is) in","transliteration":"fī","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"100:9:7","position":7,"arabic":"ٱلْقُبُورِ","kind":"word","gloss":"the graves","transliteration":"l-qubūri","lemma":"قَبْر","root":"قبر","entryId":null},{"key":"100:9:8","position":8,"arabic":"٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"100:10","translation":"And that which is in the breasts (of men) is made known?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"100:10:1","position":1,"arabic":"وَحُصِّلَ","kind":"word","gloss":"And is made apparent","transliteration":"waḥuṣṣila","lemma":"حُصِّلَ","root":"حصل","entryId":null},{"key":"100:10:2","position":2,"arabic":"مَا","kind":"word","gloss":"what","transliteration":"mā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"100:10:3","position":3,"arabic":"فِى","kind":"word","gloss":"(is) in","transliteration":"fī","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"100:10:4","position":4,"arabic":"ٱلصُّدُورِ","kind":"word","gloss":"the breasts","transliteration":"l-ṣudūri","lemma":"صَدْر","root":"صدر","entryId":"l-81254b818b8d6bbf"},{"key":"100:10:5","position":5,"arabic":"١٠","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"100:11","translation":"Verily, that Day (i.e. the Day of Resurrection) their Lord will be Well-Acquainted with them (as to their deeds and will reward them for their deeds).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"100:11:1","position":1,"arabic":"إِنَّ","kind":"word","gloss":"Indeed","transliteration":"inna","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"100:11:2","position":2,"arabic":"رَبَّهُم","kind":"word","gloss":"their Lord","transliteration":"rabbahum","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"100:11:3","position":3,"arabic":"بِهِمْ","kind":"word","gloss":"about them","transliteration":"bihim","lemma":null,"root":null,"entryId":null},{"key":"100:11:4","position":4,"arabic":"يَوْمَئِذٍۢ","kind":"word","gloss":"that Day","transliteration":"yawma-idhin","lemma":"يَوْمَئِذ","root":"يوم","entryId":"l-675d35e3d4bddca4"},{"key":"100:11:5","position":5,"arabic":"لَّخَبِيرٌۢ","kind":"word","gloss":"(is) surely All-Aware","transliteration":"lakhabīrun","lemma":"خَبِير","root":"خبر","entryId":"l-02aba742ff3692bf"},{"key":"100:11:6","position":6,"arabic":"١١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]}]