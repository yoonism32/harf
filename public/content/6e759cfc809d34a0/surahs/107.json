[{"ref":"107:1","translation":"Have you seen him who denies the Recompense?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"107:1:1","position":1,"arabic":"أَرَءَيْتَ","kind":"word","gloss":"Have you seen","transliteration":"ara-ayta","lemma":"رَءَا","root":"راي","entryId":"l-6b7f279dfcd3ea58"},{"key":"107:1:2","position":2,"arabic":"ٱلَّذِى","kind":"word","gloss":"the one who","transliteration":"alladhī","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"107:1:3","position":3,"arabic":"يُكَذِّبُ","kind":"word","gloss":"denies","transliteration":"yukadhibu","lemma":"كَذَّبَ","root":"كذب","entryId":"l-db86b0654d661fb2"},{"key":"107:1:4","position":4,"arabic":"بِٱلدِّينِ","kind":"word","gloss":"the Judgment","transliteration":"bil-dīni","lemma":"دِين","root":"دين","entryId":"l-869ef1d12b24f52a"},{"key":"107:1:5","position":5,"arabic":"١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"107:2","translation":"That is he who repulses the orphan (harshly),","translationSource":"qul-301-hilali-khan","notes":[{"text":"Narrated Sahl bin Sa‘d رضي الله عنهما : The Prophet صلى الله عليه وسلم said, \"I and the person who looks after an orphan and provides for him, will be in Paradise like this,\" putting his index and middle fingers together. (Sahih Al-Bukhari, Vol.8, Hadith No.34).","ref":null}],"tokens":[{"key":"107:2:1","position":1,"arabic":"فَذَٰلِكَ","kind":"word","gloss":"Then that","transliteration":"fadhālika","lemma":"ذَٰلِك","root":null,"entryId":"l-096a9ad382db7640"},{"key":"107:2:2","position":2,"arabic":"ٱلَّذِى","kind":"word","gloss":"(is) the one who","transliteration":"alladhī","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"107:2:3","position":3,"arabic":"يَدُعُّ","kind":"word","gloss":"repulses","transliteration":"yaduʿʿu","lemma":"يَدُعُّ","root":"دعع","entryId":null},{"key":"107:2:4","position":4,"arabic":"ٱلْيَتِيمَ","kind":"word","gloss":"the orphan","transliteration":"l-yatīma","lemma":"يَتِيم","root":"يتم","entryId":null},{"key":"107:2:5","position":5,"arabic":"٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"107:3","translation":"And urges not on the feeding of Al-Miskîn (the poor),","translationSource":"qul-301-hilali-khan","notes":[{"text":"Narrated Abû Hurairah رضي الله عنه: The Prophet صلى الله عليه وسلم said, \"The one who looks after a widow or a poor person is like a Mujâhid (fighter) who fights for Allâh’s Cause, or like him who performs prayers all the night and fasts all the day.\" (Sahih Al-Bukhari, Vol.7, Hadith No.265).","ref":null}],"tokens":[{"key":"107:3:1","position":1,"arabic":"وَلَا","kind":"word","gloss":"And (does) not","transliteration":"walā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"107:3:2","position":2,"arabic":"يَحُضُّ","kind":"word","gloss":"feel the urge","transliteration":"yaḥuḍḍu","lemma":"يَحُضُّ","root":"حضض","entryId":null},{"key":"107:3:3","position":3,"arabic":"عَلَىٰ","kind":"word","gloss":"to","transliteration":"ʿalā","lemma":"عَلَىٰ","root":null,"entryId":"l-08dd9283adb70e54"},{"key":"107:3:4","position":4,"arabic":"طَعَامِ","kind":"word","gloss":"feed","transliteration":"ṭaʿāmi","lemma":"طَعَام","root":"طعم","entryId":null},{"key":"107:3:5","position":5,"arabic":"ٱلْمِسْكِينِ","kind":"word","gloss":"the poor","transliteration":"l-mis'kīni","lemma":"مِسْكِين","root":"سكن","entryId":null},{"key":"107:3:6","position":6,"arabic":"٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"107:4","translation":"So woe unto those performers of Salât (prayers) (hypocrites),","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"107:4:1","position":1,"arabic":"فَوَيْلٌۭ","kind":"word","gloss":"So woe","transliteration":"fawaylun","lemma":"وَيْل","root":null,"entryId":"l-d11f2adf827dd758"},{"key":"107:4:2","position":2,"arabic":"لِّلْمُصَلِّينَ","kind":"word","gloss":"to those who pray","transliteration":"lil'muṣallīna","lemma":"مُصَلِّين","root":"صلو","entryId":null},{"key":"107:4:3","position":3,"arabic":"٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"107:5","translation":"Those who delay their Salât (prayer from their stated fixed times).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"107:5:1","position":1,"arabic":"ٱلَّذِينَ","kind":"word","gloss":"Those who","transliteration":"alladhīna","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"107:5:2","position":2,"arabic":"هُمْ","kind":"word","gloss":"[they]","transliteration":"hum","lemma":null,"root":null,"entryId":null},{"key":"107:5:3","position":3,"arabic":"عَن","kind":"word","gloss":"about","transliteration":"ʿan","lemma":"عَن","root":null,"entryId":"l-f1109a78c8548754"},{"key":"107:5:4","position":4,"arabic":"صَلَاتِهِمْ","kind":"word","gloss":"their prayers","transliteration":"ṣalātihim","lemma":"صَلَوٰة","root":"صلو","entryId":"l-7ecacdc275cdb0a8"},{"key":"107:5:5","position":5,"arabic":"سَاهُونَ","kind":"word","gloss":"(are) neglectful","transliteration":"sāhūna","lemma":"سَاهُون","root":"سهو","entryId":null},{"key":"107:5:6","position":6,"arabic":"٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"107:6","translation":"Those who do good deeds only to be seen (of men),","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"107:6:1","position":1,"arabic":"ٱلَّذِينَ","kind":"word","gloss":"Those who","transliteration":"alladhīna","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"107:6:2","position":2,"arabic":"هُمْ","kind":"word","gloss":"[they]","transliteration":"hum","lemma":null,"root":null,"entryId":null},{"key":"107:6:3","position":3,"arabic":"يُرَآءُونَ","kind":"word","gloss":"make show","transliteration":"yurāūna","lemma":"يُرَآءُ","root":"راي","entryId":null},{"key":"107:6:4","position":4,"arabic":"٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"107:7","translation":"And prevent Al-Mâ‘ûn (small kindnesses like salt, sugar, water).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"107:7:1","position":1,"arabic":"وَيَمْنَعُونَ","kind":"word","gloss":"And they deny","transliteration":"wayamnaʿūna","lemma":"مَّنَعَ","root":"منع","entryId":null},{"key":"107:7:2","position":2,"arabic":"ٱلْمَاعُونَ","kind":"word","gloss":"[the] small kindnesses","transliteration":"l-māʿūna","lemma":"مَاعُون","root":"معن","entryId":null},{"key":"107:7:3","position":3,"arabic":"٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]}]