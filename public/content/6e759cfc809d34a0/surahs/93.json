[{"ref":"93:1","translation":"By the forenoon (after sunrise).","translationSource":"qul-301-hilali-khan","notes":[{"text":"a) Narrated Ibn Abî Lailâ: Only Umm Hânî told us that she had seen the Prophet صلى الله عليه وسلم offering the Duha (Forenoon prayer). She said. \"On the day of the conquest of Makkah, the Prophet صلى الله عليه وسلم took a bath in my house and offered eight Raka‘ât. I never saw him praying such a light prayer but he performed perfect prostrations and bowings\". (Sahih Al-Bukhari, Vol.2, Hadith No.207A). b) Narrated Abu Hurairah رضي الله عنه : My friend (the Prophet) advised me to observe three things: to fast three days a month; (2) to pray two Raka‘ât of Duha prayer (Forenoon prayer); and (3) to pray Witr before sleeping. (Sahih Al-Bukhari, Vol.3, Hadith No.202).","ref":null}],"tokens":[{"key":"93:1:1","position":1,"arabic":"وَٱلضُّحَىٰ","kind":"word","gloss":"By the morning brightness","transliteration":"wal-ḍuḥā","lemma":"ضُحًى","root":"ضحو","entryId":null},{"key":"93:1:2","position":2,"arabic":"١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"93:2","translation":"By the night when it darkens (and stand still).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"93:2:1","position":1,"arabic":"وَٱلَّيْلِ","kind":"word","gloss":"And the night","transliteration":"wa-al-layli","lemma":"لَيْل","root":"ليل","entryId":"l-d2e604e516a58959"},{"key":"93:2:2","position":2,"arabic":"إِذَا","kind":"word","gloss":"when","transliteration":"idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"93:2:3","position":3,"arabic":"سَجَىٰ","kind":"word","gloss":"it covers with darkness","transliteration":"sajā","lemma":"سَجَىٰ","root":"سجو","entryId":null},{"key":"93:2:4","position":4,"arabic":"٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"93:3","translation":"Your Lord (O Muhammad صلى الله عليه وسلم) has neither forsaken you nor hates you.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"93:3:1","position":1,"arabic":"مَا","kind":"word","gloss":"Not","transliteration":"mā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"93:3:2","position":2,"arabic":"وَدَّعَكَ","kind":"word","gloss":"has forsaken you","transliteration":"waddaʿaka","lemma":"وَدَّعَ","root":"ودع","entryId":null},{"key":"93:3:3","position":3,"arabic":"رَبُّكَ","kind":"word","gloss":"your Lord","transliteration":"rabbuka","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"93:3:4","position":4,"arabic":"وَمَا","kind":"word","gloss":"and not","transliteration":"wamā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"93:3:5","position":5,"arabic":"قَلَىٰ","kind":"word","gloss":"He is displeased","transliteration":"qalā","lemma":"قَلَىٰ","root":"قلي","entryId":null},{"key":"93:3:6","position":6,"arabic":"٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"93:4","translation":"And indeed the Hereafter is better for you than the present (life of this world).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"93:4:1","position":1,"arabic":"وَلَلْـَٔاخِرَةُ","kind":"word","gloss":"And surely the Hereafter","transliteration":"walalākhiratu","lemma":"آخِر","root":"اخر","entryId":"l-24868f08d279a095"},{"key":"93:4:2","position":2,"arabic":"خَيْرٌۭ","kind":"word","gloss":"(is) better","transliteration":"khayrun","lemma":"خَيْر","root":"خير","entryId":"l-81db6cd6a46bd56c"},{"key":"93:4:3","position":3,"arabic":"لَّكَ","kind":"word","gloss":"for you","transliteration":"laka","lemma":null,"root":null,"entryId":null},{"key":"93:4:4","position":4,"arabic":"مِنَ","kind":"word","gloss":"than","transliteration":"mina","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"93:4:5","position":5,"arabic":"ٱلْأُولَىٰ","kind":"word","gloss":"the first","transliteration":"l-ūlā","lemma":"أَوَّل","root":"اول","entryId":"l-ecdf865520009f7c"},{"key":"93:4:6","position":6,"arabic":"٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"93:5","translation":"And verily, your Lord will give you (all good) so that you shall be well-pleased.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"93:5:1","position":1,"arabic":"وَلَسَوْفَ","kind":"word","gloss":"And soon","transliteration":"walasawfa","lemma":"سَوْف","root":null,"entryId":"l-0e28987d8e8dbefa"},{"key":"93:5:2","position":2,"arabic":"يُعْطِيكَ","kind":"word","gloss":"will give you","transliteration":"yuʿ'ṭīka","lemma":"أَعْطَىٰ","root":"عطو","entryId":null},{"key":"93:5:3","position":3,"arabic":"رَبُّكَ","kind":"word","gloss":"your Lord","transliteration":"rabbuka","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"93:5:4","position":4,"arabic":"فَتَرْضَىٰٓ","kind":"word","gloss":"then you will be satisfied","transliteration":"fatarḍā","lemma":"رَّضِىَ","root":"رضو","entryId":null},{"key":"93:5:5","position":5,"arabic":"٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"93:6","translation":"Did He not find you (O Muhammad صلى الله عليه وسلم) an orphan and gave you a refuge?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"93:6:1","position":1,"arabic":"أَلَمْ","kind":"word","gloss":"Did not","transliteration":"alam","lemma":"لَم","root":null,"entryId":"l-a5ee2f54ca9bbf2c"},{"key":"93:6:2","position":2,"arabic":"يَجِدْكَ","kind":"word","gloss":"He find you","transliteration":"yajid'ka","lemma":"وَجَدَ","root":"وجد","entryId":"l-31a74be8171572e5"},{"key":"93:6:3","position":3,"arabic":"يَتِيمًۭا","kind":"word","gloss":"an orphan","transliteration":"yatīman","lemma":"يَتِيم","root":"يتم","entryId":null},{"key":"93:6:4","position":4,"arabic":"فَـَٔاوَىٰ","kind":"word","gloss":"and give shelter","transliteration":"faāwā","lemma":"ءَاوَىٰٓ","root":"اوي","entryId":null},{"key":"93:6:5","position":5,"arabic":"٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"93:7","translation":"And He found you unaware (of the Qur’ân, its laws, and Prophethood) and guided you?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"93:7:1","position":1,"arabic":"وَوَجَدَكَ","kind":"word","gloss":"And He found you","transliteration":"wawajadaka","lemma":"وَجَدَ","root":"وجد","entryId":"l-31a74be8171572e5"},{"key":"93:7:2","position":2,"arabic":"ضَآلًّۭا","kind":"word","gloss":"lost","transliteration":"ḍāllan","lemma":"ضَآلّ","root":"ضلل","entryId":null},{"key":"93:7:3","position":3,"arabic":"فَهَدَىٰ","kind":"word","gloss":"so He guided","transliteration":"fahadā","lemma":"هَدَى","root":"هدي","entryId":"l-e0ac61a274311deb"},{"key":"93:7:4","position":4,"arabic":"٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"93:8","translation":"And He found you poor and made you rich (self-sufficient with self-contentment)?","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"93:8:1","position":1,"arabic":"وَوَجَدَكَ","kind":"word","gloss":"And He found you","transliteration":"wawajadaka","lemma":"وَجَدَ","root":"وجد","entryId":"l-31a74be8171572e5"},{"key":"93:8:2","position":2,"arabic":"عَآئِلًۭا","kind":"word","gloss":"in need","transliteration":"ʿāilan","lemma":"عَآئِل","root":"عيل","entryId":null},{"key":"93:8:3","position":3,"arabic":"فَأَغْنَىٰ","kind":"word","gloss":"so He made self-sufficient","transliteration":"fa-aghnā","lemma":"أَغْنَىٰ","root":"غني","entryId":null},{"key":"93:8:4","position":4,"arabic":"٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"93:9","translation":"Therefore, treat not the orphan with oppression.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"93:9:1","position":1,"arabic":"فَأَمَّا","kind":"word","gloss":"So as for","transliteration":"fa-ammā","lemma":"أَمَّا","root":null,"entryId":"l-6c43b34cf75dec4b"},{"key":"93:9:2","position":2,"arabic":"ٱلْيَتِيمَ","kind":"word","gloss":"the orphan","transliteration":"l-yatīma","lemma":"يَتِيم","root":"يتم","entryId":null},{"key":"93:9:3","position":3,"arabic":"فَلَا","kind":"word","gloss":"then (do) not","transliteration":"falā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"93:9:4","position":4,"arabic":"تَقْهَرْ","kind":"word","gloss":"oppress","transliteration":"taqhar","lemma":"تَقْهَرْ","root":"قهر","entryId":null},{"key":"93:9:5","position":5,"arabic":"٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"93:10","translation":"And repulse not the beggar.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"93:10:1","position":1,"arabic":"وَأَمَّا","kind":"word","gloss":"And as for","transliteration":"wa-ammā","lemma":"أَمَّا","root":null,"entryId":"l-6c43b34cf75dec4b"},{"key":"93:10:2","position":2,"arabic":"ٱلسَّآئِلَ","kind":"word","gloss":"one who asks","transliteration":"l-sāila","lemma":"سَآئِل","root":"سال","entryId":null},{"key":"93:10:3","position":3,"arabic":"فَلَا","kind":"word","gloss":"then (do) not","transliteration":"falā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"93:10:4","position":4,"arabic":"تَنْهَرْ","kind":"word","gloss":"repel","transliteration":"tanhar","lemma":"تَنْهَرْ","root":"نهر","entryId":null},{"key":"93:10:5","position":5,"arabic":"١٠","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"93:11","translation":"And proclaim the Grace of your Lord (i.e. the Prophethood and all other Graces).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"93:11:1","position":1,"arabic":"وَأَمَّا","kind":"word","gloss":"But as for","transliteration":"wa-ammā","lemma":"أَمَّا","root":null,"entryId":"l-6c43b34cf75dec4b"},{"key":"93:11:2","position":2,"arabic":"بِنِعْمَةِ","kind":"word","gloss":"(the) Favor","transliteration":"biniʿ'mati","lemma":"نِعْمَة","root":"نعم","entryId":"l-77a5904acef6acef"},{"key":"93:11:3","position":3,"arabic":"رَبِّكَ","kind":"word","gloss":"(of) your Lord","transliteration":"rabbika","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"93:11:4","position":4,"arabic":"فَحَدِّثْ","kind":"word","gloss":"narrate","transliteration":"faḥaddith","lemma":"تُحَدِّثُ","root":"حدث","entryId":null},{"key":"93:11:5","position":5,"arabic":"١١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]}]