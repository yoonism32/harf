âh a goodly loan (i.e. spend in Allâh’s Cause), He will double it for you, and will forgive you. And Allâh is Most Ready to appreciate and to reward, Most Forbearing,","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"64:17:1","position":1,"arabic":"إِن","kind":"word","gloss":"If","transliteration":"in","lemma":"إِن","root":null,"entryId":"l-de626c6526849733"},{"key":"64:17:2","position":2,"arabic":"تُقْرِضُوا۟","kind":"word","gloss":"you loan","transliteration":"tuq'riḍū","lemma":"أَقْرَضُ","root":"قرض","entryId":null},{"key":"64:17:3","position":3,"arabic":"ٱللَّهَ","kind":"word","gloss":"(to) Allah","transliteration":"l-laha","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"64:17:4","position":4,"arabic":"قَرْضًا","kind":"word","gloss":"a loan","transliteration":"qarḍan","lemma":"قَرْض","root":"قرض","entryId":null},{"key":"64:17:5","position":5,"arabic":"حَسَنًۭا","kind":"word","gloss":"goodly","transliteration":"ḥasanan","lemma":"حَسَن","root":"حسن","entryId":null},{"key":"64:17:6","position":6,"arabic":"يُضَـٰعِفْهُ","kind":"word","gloss":"He will multiply it","transliteration":"yuḍāʿif'hu","lemma":"يُضَٰعِفُ","root":"ضعف","entryId":null},{"key":"64:17:7","position":7,"arabic":"لَكُمْ","kind":"word","gloss":"for you","transliteration":"lakum","lemma":null,"root":null,"entryId":null},{"key":"64:17:8","position":8,"arabic":"وَيَغْفِرْ","kind":"word","gloss":"and will forgive","transliteration":"wayaghfir","lemma":"غَفَرَ","root":"غفر","entryId":"l-e2e4e54a6755dd20"},{"key":"64:17:9","position":9,"arabic":"لَكُمْ ۚ","kind":"word","gloss":"you","transliteration":"lakum","lemma":null,"root":null,"entryId":null},{"key":"64:17:10","position":10,"arabic":"وَٱللَّهُ","kind":"word","gloss":"And Allah","transliteration":"wal-lahu","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"64:17:11","position":11,"arabic":"شَكُورٌ","kind":"word","gloss":"(is) Most Appreciative","transliteration":"shakūrun","lemma":"شَكُو