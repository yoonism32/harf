"entryId":"l-f6f8e55e4806177f"},{"key":"64:10:3","position":3,"arabic":"وَكَذَّبُوا۟","kind":"word","gloss":"and denied","transliteration":"wakadhabū","lemma":"كَذَّبَ","root":"كذب","entryId":"l-db86b0654d661fb2"},{"key":"64:10:4","position":4,"arabic":"بِـَٔايَـٰتِنَآ","kind":"word","gloss":"[in] Our Verses","transliteration":"biāyātinā","lemma":"ءَايَة","root":"ايي","entryId":"l-5ab33552830ad5b5"},{"key":"64:10:5","position":5,"arabic":"أُو۟لَـٰٓئِكَ","kind":"word","gloss":"those","transliteration":"ulāika","lemma":"أُولَٰٓئِك","root":null,"entryId":"l-9b2e48d460410286"},{"key":"64:10:6","position":6,"arabic":"أَصْحَـٰبُ","kind":"word","gloss":"(are the) companions","transliteration":"aṣḥābu","lemma":"أَصْحَٰب","root":"صحب","entryId":"l-ab241d9510e7e8aa"},{"key":"64:10:7","position":7,"arabic":"ٱلنَّارِ","kind":"word","gloss":"(of) the Fire","transliteration":"l-nāri","lemma":"نَار","root":"نور","entryId":"l-1f4c1e0172701e6e"},{"key":"64:10:8","position":8,"arabic":"خَـٰلِدِينَ","kind":"word","gloss":"abiding forever","transliteration":"khālidīna","lemma":"خَٰلِد","root":"خلد","entryId":"l-54cdf1073b2f0120"},{"key":"64:10:9","position":9,"arabic":"فِيهَا ۖ","kind":"word","gloss":"therein","transliteration":"fīhā","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"64:10:10","position":10,"arabic":"وَبِئْسَ","kind":"word","gloss":"And wretched is","transliteration":"wabi'sa","lemma":"بِئْسَ","root":"باس","entryId":"l-25da1d328b1175d9"},{"key":"64:10:11","position":11,"arabic":"ٱلْمَصِيرُ","kind":"word","gloss":"the destination","transliteration":"l-maṣīru","lemma":"مَصِير","root":"صير","entryId":null},{"key":"64:10:12","position":12,"arabic":"١٠","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"64:11","translation":"No calamity befalls, but by the Leave [i.e. Decision and Qadar (Divine Preordainments)] of Allâh, and whosoever believes in Allâh, He guides his heart [to the true Faith with certainty, i.e. what has befallen him was already written for him by Allâh from the Qadar (Divine Preordainments)]. And Allâh is the All-Knower of everything.","translationSource":"qul-301-hilali-khan","notes":[{"text":"See the footnote of (V.57:22).","ref":{"surah":57,"ayah":22}}],"tokens":[{"key":"64:11:1","position":1,"arabic":"مَآ","kind":"word","gloss":"Not","transliteration":"mā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"64:11:2","position":2,"arabic":"أَصَابَ","kind":"word","gloss":"strikes","transliteration":"aṣāba","lemma":"أَصَابَ","root":"صوب","entryId":"l-2ce3c57c5193eb7a"},{"key":"64:11:3","position":3,"arabic":"مِن","kind":"word","gloss":"any","transliteration":"min","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"64:11:4","position":4,"arabic":"مُّصِيبَةٍ","kind":"word","gloss":"disaster","transliteration":"muṣībatin","lemma":"مُّصِيبَة","root":"صوب","entryId":null},{"key":"64:11:5","position":5,"arabic":"إِلَّا","kind":"word","gloss":"except","transliteration":"illā","lemma":"إِلَّا","root":null,"entryId":"l-250ca4d5b58814dd"},{"key":"64:11:6","position":6,"arabic":"بِإِذْنِ","kind":"word","gloss":"by (the) permission","transliteration":"bi-idh'ni","lemma":"إِذْن","root":"اذن","entryId":"l-7f1ecaf8fa6242d4"},{"key":"64:11:7","position":7,"arabic":"ٱللَّهِ ۗ","kind":"word","gloss":"(of) Allah","transliteration":"l-lahi","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"64:11:8","position":8,"arabic":"وَمَن","kind":"word","gloss":"And whoever","transliteration":"waman","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"64:11:9","position":9,"arabic":"يُؤْمِنۢ","kind":"word","gloss":"believes","transliteration":"yu'min","lemma":null,"root":"امن","entryId":null},{"key":"64:11:10","position":10,"arabic":"بِٱللَّهِ","kind":"word","gloss":"in Allah","transliteration":"bil-lahi","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"64:11:11","position":11,"arabic":"يَهْدِ","