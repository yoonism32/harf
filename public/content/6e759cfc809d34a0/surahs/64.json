[{"ref":"64:1","translation":"Whatsoever is in the heavens and whatsoever is on the earth glorifies Allâh. His is the dominion, and to Him belong all the praises and thanks, and He is Able to do all things.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"64:1:1","position":1,"arabic":"يُسَبِّحُ","kind":"word","gloss":"Glorifies","transliteration":"yusabbiḥu","lemma":"سَبَّحَ","root":"سبح","entryId":"l-2e7f33ad65358df7"},{"key":"64:1:2","position":2,"arabic":"لِلَّهِ","kind":"word","gloss":"[to] Allah","transliteration":"lillahi","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"64:1:3","position":3,"arabic":"مَا","kind":"word","gloss":"whatever","transliteration":"mā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"64:1:4","position":4,"arabic":"فِى","kind":"word","gloss":"(is) in","transliteration":"fī","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"64:1:5","position":5,"arabic":"ٱلسَّمَـٰوَٰتِ","kind":"word","gloss":"the heavens","transliteration":"l-samāwāti","lemma":"سَمَآء","root":"سمو","entryId":"l-e873a75addf25baf"},{"key":"64:1:6","position":6,"arabic":"وَمَا","kind":"word","gloss":"and whatever","transliteration":"wamā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"64:1:7","position":7,"arabic":"فِى","kind":"word","gloss":"(is) in","transliteration":"fī","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"64:1:8","position":8,"arabic":"ٱلْأَرْضِ ۖ","kind":"word","gloss":"the earth","transliteration":"l-arḍi","lemma":"أَرْض","root":"ارض","entryId":"l-2c626a3b4c64dbc9"},{"key":"64:1:9","position":9,"arabic":"لَهُ","kind":"word","gloss":"For Him","transliteration":"lahu","lemma":null,"root":null,"entryId":null},{"key":"64:1:10","position":10,"arabic":"ٱلْمُلْكُ","kind":"word","gloss":"(is the) dominion","transliteration":"l-mul'ku","lemma":"مُلْك","root":"ملك","entryId":"l-d594bdb481116e3d"},{"key":"64:1:11","position":11,"arabic":"وَلَهُ","kind":"word","gloss":"and for Him","transliteration":"walahu","lemma":null,"root":null,"entryId":null},{"key":"64:1:12","position":12,"arabic":"ٱلْحَمْدُ ۖ","kind":"word","gloss":"(is) the praise","transliteration":"l-ḥamdu","lemma":"حَمْد","root":"حمد","entryId":"l-2021dc67831a62d4"},{"key":"64:1:13","position":13,"arabic":"وَهُوَ","kind":"word","gloss":"And He","transliteration":"wahuwa","lemma":null,"root":null,"entryId":null},{"key":"64:1:14","position":14,"arabic":"عَلَىٰ","kind":"word","gloss":"(is) on","transliteration":"ʿalā","lemma":"عَلَىٰ","root":null,"entryId":"l-08dd9283adb70e54"},{"key":"64:1:15","position":15,"arabic":"كُلِّ","kind":"word","gloss":"every","transliteration":"kulli","lemma":"كُلّ","root":"كلل","entryId":"l-6fac43bd71e38426"},{"key":"64:1:16","position":16,"arabic":"شَىْءٍۢ","kind":"word","gloss":"thing","transliteration":"shayin","lemma":"شَىْء","root":"شيا","entryId":"l-180c07cc91c0f47b"},{"key":"64:1:17","position":17,"arabic":"قَدِيرٌ","kind":"word","gloss":"All-Powerful","transliteration":"qadīrun","lemma":"قَدِير","root":"قدر","entryId":"l-75eb12aa4d87567b"},{"key":"64:1:18","position":18,"arabic":"١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"64:2","translation":"He it is Who created you, then some of you are disbelievers and some of you are believers. And Allâh is All-Seer of what you do.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"64:2:1","position":1,"arabic":"هُوَ","kind":"word","gloss":"He","transliteration":"huwa","lemma":null,"root":null,"entryId":null},{"key":"64:2:2","position":2,"arabic":"ٱلَّذِى","kind":"word","gloss":"(is) the One Who","transliteration":"alladhī","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"64:2:3","position":3,"arabic":"خَلَقَكُمْ","kind":"word","gloss":"created you","transliteration":"khalaqakum","lemma":"خَلَقَ","root":"خلق","entryId":"l-9e7414ba00a88ddc"},{"key":"64:2:4","position":4,"arabic":"فَمِنكُمْ","kind":"word","gloss":"and among you","transliteration":"faminkum","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"64:2:5","position":5,"arabic":"كَافِرٌۭ","kind":"word","gloss":"(is) a disbeliever","transliteration":"kāfirun","lemma":"كَافِر","root":"كفر","entryId":null},{"key":"64:2:6","position":6,"arabic":"وَمِنكُم","kind":"word","gloss":"and among you","transliteration":"waminkum","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"64:2:7","position":7,"arabic":"مُّؤْمِنٌۭ ۚ","kind":"word","gloss":"(is) a believer","transliteration":"mu'minun","lemma":"مُؤْمِن","root":"امن","entryId":"l-e50e89ab6c1d4965"},{"key":"64:2:8","position":8,"arabic":"وَٱللَّهُ","kind":"word","gloss":"And Allah","transliteration":"wal-lahu","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"64:2:9","position":9,"arabic":"بِمَا","kind":"word","gloss":"of what","transliteration":"bimā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"64:2:10","position":10,"arabic":"تَعْمَلُونَ","kind":"word","gloss":"you do","transliteration":"taʿmalūna","lemma":"عَمِلَ","root":"عمل","entryId":"l-4fa22225cead4d92"},{"key":"64:2:11","position":11,"arabic":"بَصِيرٌ","kind":"word","gloss":"(is) All-Seer","transliteration":"baṣīrun","lemma":"بَصِير","root":"بصر","entryId":"l-93fa5871f325f4d8"},{"key":"64:2:12","position":12,"arabic":"٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"64:3","translation":"He has created the heavens and the earth with truth, and He shaped you and made good your shapes. And to Him is the final Return.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"64:3:1","position":1,"arabic":"خَلَقَ","kind":"word","gloss":"He created","transliteration":"khalaqa","lemma":"خَلَقَ","root":"خلق","entryId":"l-9e7414ba00a88ddc"},{"key":"64:3:2","position":2,"arabic":"ٱلسَّمَـٰوَٰتِ","kind":"word","gloss":"the heavens","transliteration":"l-samāwāti","lemma":"سَمَآء","root":"سمو","entryId":"l-e873a75addf25baf"},{"key":"64:3:3","position":3,"arabic":"وَٱلْأَرْضَ","kind":"word","gloss":"and the earth","transliteration":"wal-arḍa","lemma":"أَرْض","root":"ارض","entryId":"l-2c626a3b4c64dbc9"},{"key":"64:3:4","position":4,"arabic":"بِٱلْحَقِّ","kind":"word","gloss":"with truth","transliteration":"bil-ḥaqi","lemma":"حَقّ","root":"حقق","entryId":"l-ab22afcdeb66ae98"},{"key":"64:3:5","position":5,"arabic":"وَصَوَّرَكُمْ","kind":"word","gloss":"and He formed you","transliteration":"waṣawwarakum","lemma":"صَوَّرَ","root":"صور","entryId":null},{"key":"64:3:6","position":6,"arabic":"فَأَحْسَنَ","kind":"word","gloss":"and made good","transliteration":"fa-aḥsana","lemma":"أَحْسَنَ","root":"حسن","entryId":null},{"key":"64:3:7","position":7,"arabic":"صُوَرَكُمْ ۖ","kind":"word","gloss":"your forms","transliteration":"ṣuwarakum","lemma":"صُورَة","root":"صور","entryId":null},{"key":"64:3:8","position":8,"arabic":"وَإِلَيْهِ","kind":"word","gloss":"and to Him","transliteration":"wa-ilayhi","lemma":"إِلَىٰ","root":null,"entryId":"l-53539d2c3606b99e"},{"key":"64:3:9","position":9,"arabic":"ٱلْمَصِيرُ","kind":"word","gloss":"(is) the final return","transliteration":"l-maṣīru","lemma":"مَصِير","root":"صير","entryId":null},{"key":"64:3:10","position":10,"arabic":"٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"64:4","translation":"He knows what is in the heavens and on earth, and He knows what you conceal and what you reveal. And Allâh is the All-Knower of what is in the breasts (of men).","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"64:4:1","position":1,"arabic":"يَعْلَمُ","kind":"word","gloss":"He knows","transliteration":"yaʿlamu","lemma":"عَلِمَ","root":"علم","entryId":"l-6de9979b254804ea"},{"key":"64:4:2","position":2,"arabic":"مَا","kind":"word","gloss":"what","transliteration":"mā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"64:4:3","position":3,"arabic":"فِى","kind":"word","gloss":"(is) in","transliteration":"fī","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"64:4:4","position":4,"arabic":"ٱلسَّمَـٰوَٰتِ","kind":"word","gloss":"the heavens","transliteration":"l-samāwāti","lemma":"سَمَآء","root":"سمو","entryId":"l-e873a75addf25baf"},{"key":"64:4:5","position":5,"arabic":"وَٱلْأَرْضِ","kind":"word","gloss":"and the earth","transliteration":"wal-arḍi","lemma":"أَرْض","root":"ارض","entryId":"l-2c626a3b4c64dbc9"},{"key":"64:4:6","position":6,"arabic":"وَيَعْلَمُ","kind":"word","gloss":"and He knows","transliteration":"wayaʿlamu","lemma":"عَلِمَ","root":"علم","entryId":"l-6de9979b254804ea"},{"key":"64:4:7","position":7,"arabic":"مَا","kind":"word","gloss":"what","transliteration":"mā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"64:4:8","position":8,"arabic":"تُسِرُّونَ","kind":"word","gloss":"you conceal","transliteration":"tusirrūna","lemma":"أَسَرَّ","root":"سرر","entryId":null},{"key":"64:4:9","position":9,"arabic":"وَمَا","kind":"word","gloss":"and what","transliteration":"wamā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"64:4:10","position":10,"arabic":"تُعْلِنُونَ ۚ","kind":"word","gloss":"you declare","transliteration":"tuʿ'linūna","lemma":"أَعْلَن","root":"علن","entryId":null},{"key":"64:4:11","position":11,"arabic":"وَٱللَّهُ","kind":"word","gloss":"And Allah","transliteration":"wal-lahu","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"64:4:12","position":12,"arabic":"عَلِيمٌۢ","kind":"word","gloss":"(is) All-Knowing","transliteration":"ʿalīmun","lemma":"عَلِيم","root":"علم","entryId":"l-14c09db1ee92cbbe"},{"key":"64:4:13","position":13,"arabic":"بِذَاتِ","kind":"word","gloss":"of what","transliteration":"bidhāti","lemma":"ذُو","root":null,"entryId":"l-ea5c5c22a86c9f67"},{"key":"64:4:14","position":14,"arabic":"ٱلصُّدُورِ","kind":"word","gloss":"(is in) the breasts","transliteration":"l-ṣudūri","lemma":"صَدْر","root":"صدر","entryId":"l-81254b818b8d6bbf"},{"key":"64:4:15","position":15,"arabic":"٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"64:5","translation":"Has not the news reached you of those who disbelieved aforetime? And so they tasted the evil result of their disbelief, and theirs will be a painful torment.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"64:5:1","position":1,"arabic":"أَلَمْ","kind":"word","gloss":"Has not","transliteration":"alam","lemma":"لَم","root":null,"entryId":"l-a5ee2f54ca9bbf2c"},{"key":"64:5:2","position":2,"arabic":"يَأْتِكُمْ","kind":"word","gloss":"come to you","transliteration":"yatikum","lemma":"أَتَى","root":"اتي","entryId":"l-491a40b1f8d047fe"},{"key":"64:5:3","position":3,"arabic":"نَبَؤُا۟","kind":"word","gloss":"(the) news","transliteration":"naba-u","lemma":"نَبَأ","root":"نبا","entryId":null},{"key":"64:5:4","position":4,"arabic":"ٱلَّذِينَ","kind":"word","gloss":"(of) those who","transliteration":"alladhīna","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"64:5:5","position":5,"arabic":"كَفَرُوا۟","kind":"word","gloss":"disbelieved","transliteration":"kafarū","lemma":"كَفَرَ","root":"كفر","entryId":"l-f6f8e55e4806177f"},{"key":"64:5:6","position":6,"arabic":"مِن","kind":"word","gloss":"from","transliteration":"min","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"64:5:7","position":7,"arabic":"قَبْلُ","kind":"word","gloss":"before","transliteration":"qablu","lemma":"قَبْل","root":"قبل","entryId":"l-4bd70955def13ac7"},{"key":"64:5:8","position":8,"arabic":"فَذَاقُوا۟","kind":"word","gloss":"So they tasted","transliteration":"fadhāqū","lemma":"ذَاقُ","root":"ذوق","entryId":"l-351649387efdb5df"},{"key":"64:5:9","position":9,"arabic":"وَبَالَ","kind":"word","gloss":"(the bad) consequence","transliteration":"wabāla","lemma":"وَبَال","root":"وبل","entryId":null},{"key":"64:5:10","position":10,"arabic":"أَمْرِهِمْ","kind":"word","gloss":"(of) their affair","transliteration":"amrihim","lemma":"أَمْر","root":"امر","entryId":"l-a1fcf2fe7f0b10ef"},{"key":"64:5:11","position":11,"arabic":"وَلَهُمْ","kind":"word","gloss":"and for them","transliteration":"walahum","lemma":null,"root":null,"entryId":null},{"key":"64:5:12","position":12,"arabic":"عَذَابٌ","kind":"word","gloss":"(is) a punishment","transliteration":"ʿadhābun","lemma":"عَذَاب","root":"عذب","entryId":"l-3eb7e15951d31876"},{"key":"64:5:13","position":13,"arabic":"أَلِيمٌۭ","kind":"word","gloss":"painful","transliteration":"alīmun","lemma":"أَلِيم","root":"الم","entryId":"l-e6db50422187d325"},{"key":"64:5:14","position":14,"arabic":"٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"64:6","translation":"That was because there came to them their Messengers with clear proofs (signs), but they said: \"Shall mere men guide us?\" So they disbelieved and turned away (from the truth). But Allâh was not in need (of them). And Allâh is Rich (Free of all needs), Worthy of all praise.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"64:6:1","position":1,"arabic":"ذَٰلِكَ","kind":"word","gloss":"That","transliteration":"dhālika","lemma":"ذَٰلِك","root":null,"entryId":"l-096a9ad382db7640"},{"key":"64:6:2","position":2,"arabic":"بِأَنَّهُۥ","kind":"word","gloss":"(is) because","transliteration":"bi-annahu","lemma":"أَنّ","root":null,"entryId":"l-9a8e074398908017"},{"key":"64:6:3","position":3,"arabic":"كَانَت","kind":"word","gloss":"had","transliteration":"kānat","lemma":"كَانَ","root":"كون","entryId":"l-4b2f9969a9af0d45"},{"key":"64:6:4","position":4,"arabic":"تَّأْتِيهِمْ","kind":"word","gloss":"come to them","transliteration":"tatīhim","lemma":"أَتَى","root":"اتي","entryId":"l-491a40b1f8d047fe"},{"key":"64:6:5","position":5,"arabic":"رُسُلُهُم","kind":"word","gloss":"their Messengers","transliteration":"rusuluhum","lemma":"رَسُول","root":"رسل","entryId":"l-165e008d0f146d23"},{"key":"64:6:6","position":6,"arabic":"بِٱلْبَيِّنَـٰتِ","kind":"word","gloss":"with clear proofs","transliteration":"bil-bayināti","lemma":"بَيِّنَة","root":"بين","entryId":"l-3f748dc7c64d16bd"},{"key":"64:6:7","position":7,"arabic":"فَقَالُوٓا۟","kind":"word","gloss":"but they said","transliteration":"faqālū","lemma":"قَالَ","root":"قول","entryId":"l-effaf24a5c86c56f"},{"key":"64:6:8","position":8,"arabic":"أَبَشَرٌۭ","kind":"word","gloss":"Shall human beings","transliteration":"abasharun","lemma":"بَشَر","root":"بشر","entryId":"l-491430ab75fcaa78"},{"key":"64:6:9","position":9,"arabic":"يَهْدُونَنَا","kind":"word","gloss":"guide us","transliteration":"yahdūnanā","lemma":"هَدَى","root":"هدي","entryId":"l-e0ac61a274311deb"},{"key":"64:6:10","position":10,"arabic":"فَكَفَرُوا۟","kind":"word","gloss":"So they disbelieved","transliteration":"fakafarū","lemma":"كَفَرَ","root":"كفر","entryId":"l-f6f8e55e4806177f"},{"key":"64:6:11","position":11,"arabic":"وَتَوَلَّوا۟ ۚ","kind":"word","gloss":"and turned away","transliteration":"watawallaw","lemma":"تَوَلَّىٰ","root":"ولي","entryId":"l-f32564c74acc4226"},{"key":"64:6:12","position":12,"arabic":"وَّٱسْتَغْنَى","kind":"word","gloss":"And can do without them","transliteration":"wa-is'taghnā","lemma":"اسْتَغْنَىٰ","root":"غني","entryId":null},{"key":"64:6:13","position":13,"arabic":"ٱللَّهُ ۚ","kind":"word","gloss":"Allah","transliteration":"l-lahu","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"64:6:14","position":14,"arabic":"وَٱللَّهُ","kind":"word","gloss":"And Allah","transliteration":"wal-lahu","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"64:6:15","position":15,"arabic":"غَنِىٌّ","kind":"word","gloss":"(is) Self-sufficient","transliteration":"ghaniyyun","lemma":"غَنِىّ","root":"غني","entryId":null},{"key":"64:6:16","position":16,"arabic":"حَمِيدٌۭ","kind":"word","gloss":"Praiseworthy","transliteration":"ḥamīdun","lemma":"حَمِيد","root":"حمد","entryId":null},{"key":"64:6:17","position":17,"arabic":"٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"64:7","translation":"The disbelievers pretend that they will never be resurrected (for the Account). Say (O Muhammad صلى الله عليه وسلم): Yes! By my Lord, you will certainly be resurrected, then you will be informed of (and recompensed for) what you did; and that is easy for Allâh.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"64:7:1","position":1,"arabic":"زَعَمَ","kind":"word","gloss":"Claim","transliteration":"zaʿama","lemma":"زَعَمَ","root":"زعم","entryId":null},{"key":"64:7:2","position":2,"arabic":"ٱلَّذِينَ","kind":"word","gloss":"those who","transliteration":"alladhīna","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"64:7:3","position":3,"arabic":"كَفَرُوٓا۟","kind":"word","gloss":"disbelieve","transliteration":"kafarū","lemma":"كَفَرَ","root":"كفر","entryId":"l-f6f8e55e4806177f"},{"key":"64:7:4","position":4,"arabic":"أَن","kind":"word","gloss":"that","transliteration":"an","lemma":"أَن","root":null,"entryId":"l-6fb897ea8dfcda9d"},{"key":"64:7:5","position":5,"arabic":"لَّن","kind":"word","gloss":"never","transliteration":"lan","lemma":"لَن","root":null,"entryId":"l-3db5462128ff695e"},{"key":"64:7:6","position":6,"arabic":"يُبْعَثُوا۟ ۚ","kind":"word","gloss":"will they be raised","transliteration":"yub'ʿathū","lemma":"بَعَثَ","root":"بعث","entryId":"l-8167acd93c52740b"},{"key":"64:7:7","position":7,"arabic":"قُلْ","kind":"word","gloss":"Say","transliteration":"qul","lemma":"قَالَ","root":"قول","entryId":"l-effaf24a5c86c56f"},{"key":"64:7:8","position":8,"arabic":"بَلَىٰ","kind":"word","gloss":"Yes","transliteration":"balā","lemma":"بَلَىٰ","root":null,"entryId":null},{"key":"64:7:9","position":9,"arabic":"وَرَبِّى","kind":"word","gloss":"by my Lord","transliteration":"warabbī","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"64:7:10","position":10,"arabic":"لَتُبْعَثُنَّ","kind":"word","gloss":"surely you will be raised","transliteration":"latub'ʿathunna","lemma":"بَعَثَ","root":"بعث","entryId":"l-8167acd93c52740b"},{"key":"64:7:11","position":11,"arabic":"ثُمَّ","kind":"word","gloss":"then","transliteration":"thumma","lemma":"ثُمّ","root":null,"entryId":"l-75b66396af12da75"},{"key":"64:7:12","position":12,"arabic":"لَتُنَبَّؤُنَّ","kind":"word","gloss":"surely you will be informed","transliteration":"latunabba-unna","lemma":"نَبَّأَ","root":"نبا","entryId":"l-86876698c3450922"},{"key":"64:7:13","position":13,"arabic":"بِمَا","kind":"word","gloss":"of what","transliteration":"bimā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"64:7:14","position":14,"arabic":"عَمِلْتُمْ ۚ","kind":"word","gloss":"you did","transliteration":"ʿamil'tum","lemma":"عَمِلَ","root":"عمل","entryId":"l-4fa22225cead4d92"},{"key":"64:7:15","position":15,"arabic":"وَذَٰلِكَ","kind":"word","gloss":"And that","transliteration":"wadhālika","lemma":"ذَٰلِك","root":null,"entryId":"l-096a9ad382db7640"},{"key":"64:7:16","position":16,"arabic":"عَلَى","kind":"word","gloss":"for","transliteration":"ʿalā","lemma":"عَلَىٰ","root":null,"entryId":"l-08dd9283adb70e54"},{"key":"64:7:17","position":17,"arabic":"ٱللَّهِ","kind":"word","gloss":"Allah","transliteration":"l-lahi","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"64:7:18","position":18,"arabic":"يَسِيرٌۭ","kind":"word","gloss":"(is) easy","transliteration":"yasīrun","lemma":"يَسِير","root":"يسر","entryId":null},{"key":"64:7:19","position":19,"arabic":"٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"64:8","translation":"Therefore, believe in Allâh and His Messenger (Muhammad صلى الله عليه وسلم) and in the Light (this Qur’ân) which We have sent down. And Allâh is All-Aware of what you do.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"64:8:1","position":1,"arabic":"فَـَٔامِنُوا۟","kind":"word","gloss":"So believe","transliteration":"faāminū","lemma":"ءَامَنَ","root":"امن","entryId":"l-f6ec3a6dc0f76aa6"},{"key":"64:8:2","position":2,"arabic":"بِٱللَّهِ","kind":"word","gloss":"in Allah","transliteration":"bil-lahi","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"64:8:3","position":3,"arabic":"وَرَسُولِهِۦ","kind":"word","gloss":"and His Messenger","transliteration":"warasūlihi","lemma":"رَسُول","root":"رسل","entryId":"l-165e008d0f146d23"},{"key":"64:8:4","position":4,"arabic":"وَٱلنُّورِ","kind":"word","gloss":"and the Light","transliteration":"wal-nūri","lemma":"نُور","root":"نور","entryId":"l-192bc5e7c1fe2bcb"},{"key":"64:8:5","position":5,"arabic":"ٱلَّذِىٓ","kind":"word","gloss":"which","transliteration":"alladhī","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"64:8:6","position":6,"arabic":"أَنزَلْنَا ۚ","kind":"word","gloss":"We have sent down","transliteration":"anzalnā","lemma":"أَنزَلَ","root":"نزل","entryId":"l-81ead5682cb1835c"},{"key":"64:8:7","position":7,"arabic":"وَٱللَّهُ","kind":"word","gloss":"And Allah","transliteration":"wal-lahu","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"64:8:8","position":8,"arabic":"بِمَا","kind":"word","gloss":"of what","transliteration":"bimā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"64:8:9","position":9,"arabic":"تَعْمَلُونَ","kind":"word","gloss":"you do","transliteration":"taʿmalūna","lemma":"عَمِلَ","root":"عمل","entryId":"l-4fa22225cead4d92"},{"key":"64:8:10","position":10,"arabic":"خَبِيرٌۭ","kind":"word","gloss":"(is) All-Aware","transliteration":"khabīrun","lemma":"خَبِير","root":"خبر","entryId":"l-02aba742ff3692bf"},{"key":"64:8:11","position":11,"arabic":"٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}]},{"ref":"64:9","translation":"(And remember) the Day when He will gather you (all) on the Day of Gathering, - that will be the Day of mutual loss and gain (i.e. loss for the disbelievers as they will enter the Hell-fire and gain for the believers as they will enter Paradise). And whosoever believes in Allâh and performs righteous good deeds, He will expiate from him his sins, and will admit him to Gardens under which rivers flow (Paradise) to dwell therein forever; that will be the great success.","translationSource":"qul-301-hilali-khan","notes":[],"tokens":[{"key":"64:9:1","position":1,"arabic":"يَوْمَ","kind":"word","gloss":"(The) Day","transliteration":"yawma","lemma":"يَوْم","root":"يوم","entryId":"l-bd6f5747b4dfe79c"},{"key":"64:9:2","position":2,"arabic":"يَجْمَعُكُمْ","kind":"word","gloss":"He will assemble you","transliteration":"yajmaʿukum","lemma":"جَمَعَ","root":"جمع","entryId":null},{"key":"64:9:3","position":3,"arabic":"لِيَوْمِ","kind":"word","gloss":"for (the) Day","transliteration":"liyawmi","lemma":"يَوْم","root":"يوم","entryId":"l-bd6f5747b4dfe79c"},{"key":"64:9:4","position":4,"arabic":"ٱلْجَمْعِ ۖ","kind":"word","gloss":"(of) the Assembly","transliteration":"l-jamʿi","lemma":"جَمْع","root":"جمع","entryId":null},{"key":"64:9:5","position":5,"arabic":"ذَٰلِكَ","kind":"word","gloss":"that","transliteration":"dhālika","lemma":"ذَٰلِك","root":null,"entryId":"l-096a9ad382db7640"},{"key":"64:9:6","position":6,"arabic":"يَوْمُ","kind":"word","gloss":"(will be the) Day","transliteration":"yawmu","lemma":"يَوْم","root":"يوم","entryId":"l-bd6f5747b4dfe79c"},{"key":"64:9:7","position":7,"arabic":"ٱلتَّغَابُنِ ۗ","kind":"word","gloss":"(of) mutual loss and gain","transliteration":"l-taghābuni","lemma":"تَّغَابُن","root":"غبن","entryId":null},{"key":"64:9:8","position":8,"arabic":"وَمَن","kind":"word","gloss":"And whoever","transliteration":"waman","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"64:9:9","position":9,"arabic":"يُؤْمِنۢ","kind":"word","gloss":"believes","transliteration":"yu'min","lemma":null,"root":"امن","entryId":null},{"key":"64:9:1