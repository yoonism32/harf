{"entry":{"id":"l-f12e6ea449342e8c","lemma":"سُبْحَٰن","root":"سبح","arabic":"سُبْحَـٰنَ","gloss":"Glory be","transliteration":"sub'ḥāna","representativeKey":"37:159:1","exampleKeys":["37:159:1","17:43:1","30:17:1"],"occurrenceCount":41,"courseOrder":261,"sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"],"rootId":"r-4cb586c8f887c3ed","approval":{"status":"pending"}},"examples":[{"ref":"37:159","tokens":[{"key":"37:159:1","position":1,"arabic":"سُبْحَـٰنَ","kind":"word","gloss":"Glory be","transliteration":"sub'ḥāna","lemma":"سُبْحَٰن","root":"سبح","entryId":"l-f12e6ea449342e8c"},{"key":"37:159:2","position":2,"arabic":"ٱللَّهِ","kind":"word","gloss":"(to) Allah","transliteration":"l-lahi","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"37:159:3","position":3,"arabic":"عَمَّا","kind":"word","gloss":"above what","transliteration":"ʿammā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"37:159:4","position":4,"arabic":"يَصِفُونَ","kind":"word","gloss":"they attribute","transliteration":"yaṣifūna","lemma":"يَصِفُ","root":"وصف","entryId":null},{"key":"37:159:5","position":5,"arabic":"١٥٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"Glorified be Allâh! (He is free) from what they attribute unto Him!","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"37:159:1","targetGloss":"Glory be","targetTransliteration":"sub'ḥāna","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]},{"ref":"17:43","tokens":[{"key":"17:43:1","position":1,"arabic":"سُبْحَـٰنَهُۥ","kind":"word","gloss":"Glorified is He","transliteration":"sub'ḥānahu","lemma":"سُبْحَٰن","root":"سبح","entryId":"l-f12e6ea449342e8c"},{"key":"17:43:2","position":2,"arabic":"وَتَعَـٰلَىٰ","kind":"word","gloss":"and Exalted is He","transliteration":"wataʿālā","lemma":"تَعَٰلَىٰ","root":"علو","entryId":null},{"key":"17:43:3","position":3,"arabic":"عَمَّا","kind":"word","gloss":"above what","transliteration":"ʿammā","lemma":"عَن","root":null,"entryId":"l-f1109a78c8548754"},{"key":"17:43:4","position":4,"arabic":"يَقُولُونَ","kind":"word","gloss":"they say","transliteration":"yaqūlūna","lemma":"قَالَ","root":"قول","entryId":"l-effaf24a5c86c56f"},{"key":"17:43:5","position":5,"arabic":"عُلُوًّۭا","kind":"word","gloss":"(by) height","transliteration":"ʿuluwwan","lemma":"عُلُوّ","root":"علو","entryId":null},{"key":"17:43:6","position":6,"arabic":"كَبِيرًۭا","kind":"word","gloss":"great","transliteration":"kabīran","lemma":"كَبِير","root":"كبر","entryId":"l-9f30b74ee08bd80b"},{"key":"17:43:7","position":7,"arabic":"٤٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"Glorified and Exalted be He! High above (the great falsehood) that they say! (i.e. forged statements that there are other gods along with Allâh, but He is Allâh, the One, the Self-Sufficient Master, Whom all creatures need. He begets not, nor was He begotten, and there is none comparable or coequal unto Him).","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"17:43:1","targetGloss":"Glorified is He","targetTransliteration":"sub'ḥānahu","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]},{"ref":"30:17","tokens":[{"key":"30:17:1","position":1,"arabic":"فَسُبْحَـٰنَ","kind":"word","gloss":"So glory be to","transliteration":"fasub'ḥāna","lemma":"سُبْحَٰن","root":"سبح","entryId":"l-f12e6ea449342e8c"},{"key":"30:17:2","position":2,"arabic":"ٱللَّهِ","kind":"word","gloss":"Allah","transliteration":"l-lahi","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"30:17:3","position":3,"arabic":"حِينَ","kind":"word","gloss":"when","transliteration":"ḥīna","lemma":"حِين","root":"حين","entryId":null},{"key":"30:17:4","position":4,"arabic":"تُمْسُونَ","kind":"word","gloss":"you reach the evening","transliteration":"tum'sūna","lemma":"تُمْسُ","root":"مسو","entryId":null},{"key":"30:17:5","position":5,"arabic":"وَحِينَ","kind":"word","gloss":"and when","transliteration":"waḥīna","lemma":"حِين","root":"حين","entryId":null},{"key":"30:17:6","position":6,"arabic":"تُصْبِحُونَ","kind":"word","gloss":"you reach the morning","transliteration":"tuṣ'biḥūna","lemma":"أَصْبَحَ","root":"صبح","entryId":null},{"key":"30:17:7","position":7,"arabic":"١٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"So glorify Allâh [above all that (evil) they associate with Him (O believers)] when you come up to the evening [i.e. offer the (Maghrib ) sunset and (‘Ishâ’) night prayers], and when you enter the morning [i.e. offer the (Fajr) morning prayer].","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"30:17:1","targetGloss":"So glory be to","targetTransliteration":"fasub'ḥāna","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]}]}