{"entry":{"id":"l-eda514b588e7b3c0","lemma":"لَٰكِنّ","root":null,"arabic":"وَلَـٰكِنَّ","gloss":"but","transliteration":"walākinna","representativeKey":"43:78:4","exampleKeys":["43:78:4","44:39:5","9:56:8"],"occurrenceCount":57,"courseOrder":191,"sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"],"rootId":null,"approval":{"status":"pending"}},"examples":[{"ref":"43:78","tokens":[{"key":"43:78:1","position":1,"arabic":"لَقَدْ","kind":"word","gloss":"Certainly","transliteration":"laqad","lemma":"قَد","root":null,"entryId":"l-11a59b67e56e7412"},{"key":"43:78:2","position":2,"arabic":"جِئْنَـٰكُم","kind":"word","gloss":"We have brought you","transliteration":"ji'nākum","lemma":"جَآءَ","root":"جيا","entryId":"l-1abf61bfcb8fdd4c"},{"key":"43:78:3","position":3,"arabic":"بِٱلْحَقِّ","kind":"word","gloss":"the truth","transliteration":"bil-ḥaqi","lemma":"حَقّ","root":"حقق","entryId":"l-ab22afcdeb66ae98"},{"key":"43:78:4","position":4,"arabic":"وَلَـٰكِنَّ","kind":"word","gloss":"but","transliteration":"walākinna","lemma":"لَٰكِنّ","root":null,"entryId":"l-eda514b588e7b3c0"},{"key":"43:78:5","position":5,"arabic":"أَكْثَرَكُمْ","kind":"word","gloss":"most of you","transliteration":"aktharakum","lemma":"أَكْثَر","root":"كثر","entryId":"l-6b5293669ddc71bd"},{"key":"43:78:6","position":6,"arabic":"لِلْحَقِّ","kind":"word","gloss":"to the truth","transliteration":"lil'ḥaqqi","lemma":"حَقّ","root":"حقق","entryId":"l-ab22afcdeb66ae98"},{"key":"43:78:7","position":7,"arabic":"كَـٰرِهُونَ","kind":"word","gloss":"(are) averse","transliteration":"kārihūna","lemma":"كَٰرِهُون","root":"كره","entryId":null},{"key":"43:78:8","position":8,"arabic":"٧٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"Indeed We have brought the truth (Muhammad صلى الله عليه و سلم with the Qur’ân) to you, but most of you have a hatred for the truth.","translationSource":"qul-301-hilali-khan","notes":[{"text":"See the footnote of (V.41:46).","ref":{"surah":41,"ayah":46}}],"targetKey":"43:78:4","targetGloss":"but","targetTransliteration":"walākinna","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]},{"ref":"44:39","tokens":[{"key":"44:39:1","position":1,"arabic":"مَا","kind":"word","gloss":"Not","transliteration":"mā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"44:39:2","position":2,"arabic":"خَلَقْنَـٰهُمَآ","kind":"word","gloss":"We created both of them","transliteration":"khalaqnāhumā","lemma":"خَلَقَ","root":"خلق","entryId":"l-9e7414ba00a88ddc"},{"key":"44:39:3","position":3,"arabic":"إِلَّا","kind":"word","gloss":"but","transliteration":"illā","lemma":"إِلَّا","root":null,"entryId":"l-250ca4d5b58814dd"},{"key":"44:39:4","position":4,"arabic":"بِٱلْحَقِّ","kind":"word","gloss":"in [the] truth","transliteration":"bil-ḥaqi","lemma":"حَقّ","root":"حقق","entryId":"l-ab22afcdeb66ae98"},{"key":"44:39:5","position":5,"arabic":"وَلَـٰكِنَّ","kind":"word","gloss":"but","transliteration":"walākinna","lemma":"لَٰكِنّ","root":null,"entryId":"l-eda514b588e7b3c0"},{"key":"44:39:6","position":6,"arabic":"أَكْثَرَهُمْ","kind":"word","gloss":"most of them","transliteration":"aktharahum","lemma":"أَكْثَر","root":"كثر","entryId":"l-6b5293669ddc71bd"},{"key":"44:39:7","position":7,"arabic":"لَا","kind":"word","gloss":"(do) not","transliteration":"lā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"44:39:8","position":8,"arabic":"يَعْلَمُونَ","kind":"word","gloss":"know","transliteration":"yaʿlamūna","lemma":"عَلِمَ","root":"علم","entryId":"l-6de9979b254804ea"},{"key":"44:39:9","position":9,"arabic":"٣٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"We created them not except with truth (i.e. to examine and test those who are obedient and those who are disobedient and then reward the obedient ones and punish the disobedient ones), but most of them know not.","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"44:39:5","targetGloss":"but","targetTransliteration":"walākinna","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]},{"ref":"9:56","tokens":[{"key":"9:56:1","position":1,"arabic":"وَيَحْلِفُونَ","kind":"word","gloss":"And they swear","transliteration":"wayaḥlifūna","lemma":"حَلَفْ","root":"حلف","entryId":null},{"key":"9:56:2","position":2,"arabic":"بِٱللَّهِ","kind":"word","gloss":"by Allah","transliteration":"bil-lahi","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"9:56:3","position":3,"arabic":"إِنَّهُمْ","kind":"word","gloss":"indeed, they","transliteration":"innahum","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"9:56:4","position":4,"arabic":"لَمِنكُمْ","kind":"word","gloss":"surely (are) of you","transliteration":"laminkum","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"9:56:5","position":5,"arabic":"وَمَا","kind":"word","gloss":"while not","transliteration":"wamā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"9:56:6","position":6,"arabic":"هُم","kind":"word","gloss":"they","transliteration":"hum","lemma":null,"root":null,"entryId":null},{"key":"9:56:7","position":7,"arabic":"مِّنكُمْ","kind":"word","gloss":"(are) of you","transliteration":"minkum","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"9:56:8","position":8,"arabic":"وَلَـٰكِنَّهُمْ","kind":"word","gloss":"but they","transliteration":"walākinnahum","lemma":"لَٰكِنّ","root":null,"entryId":"l-eda514b588e7b3c0"},{"key":"9:56:9","position":9,"arabic":"قَوْمٌۭ","kind":"word","gloss":"(are) a people","transliteration":"qawmun","lemma":"قَوْم","root":"قوم","entryId":"l-049e2cd6a60d39f0"},{"key":"9:56:10","position":10,"arabic":"يَفْرَقُونَ","kind":"word","gloss":"(who) are afraid","transliteration":"yafraqūna","lemma":"فَرَقْ","root":"فرق","entryId":null},{"key":"9:56:11","position":11,"arabic":"٥٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"They swear by Allâh that they are truly of you while they are not of you, but they are a people (hypocrites) who are afraid (that you may kill them).","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"9:56:8","targetGloss":"but they","targetTransliteration":"walākinnahum","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]}]}