{"entry":{"id":"l-d74bbc36bff7ccce","lemma":"سَاعَة","root":"سوع","arabic":"ٱلسَّاعَةُ","gloss":"the Hour","transliteration":"l-sāʿatu","representativeKey":"54:1:2","exampleKeys":["54:1:2","30:12:3","30:14:3"],"occurrenceCount":48,"courseOrder":228,"sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"],"rootId":"r-9785a13855e22833","approval":{"status":"pending"}},"examples":[{"ref":"54:1","tokens":[{"key":"54:1:1","position":1,"arabic":"ٱقْتَرَبَتِ","kind":"word","gloss":"Has come near","transliteration":"iq'tarabati","lemma":"اقْتَرَبَ","root":"قرب","entryId":null},{"key":"54:1:2","position":2,"arabic":"ٱلسَّاعَةُ","kind":"word","gloss":"the Hour","transliteration":"l-sāʿatu","lemma":"سَاعَة","root":"سوع","entryId":"l-d74bbc36bff7ccce"},{"key":"54:1:3","position":3,"arabic":"وَٱنشَقَّ","kind":"word","gloss":"and has split","transliteration":"wa-inshaqqa","lemma":"انشَقَّ","root":"شقق","entryId":null},{"key":"54:1:4","position":4,"arabic":"ٱلْقَمَرُ","kind":"word","gloss":"the moon","transliteration":"l-qamaru","lemma":"قَمَر","root":"قمر","entryId":null},{"key":"54:1:5","position":5,"arabic":"١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"The Hour has drawn near, and the moon has been cleft asunder (the people of Makkah requested Prophet Muhammad صلى الله عليه وسلم to show them a miracle, so he showed them the splitting of the moon).","translationSource":"qul-301-hilali-khan","notes":[{"text":"Narrated Anas رضي الله عنه: The people of Makkah asked the Prophet صلى الله عليه وسلم to show them a sign (miracle). So he showed them (the miracle) of the cleaving of the moon. (Sahih Al-Bukhari, Vol.6, Hadîth No.390).","ref":null}],"targetKey":"54:1:2","targetGloss":"the Hour","targetTransliteration":"l-sāʿatu","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]},{"ref":"30:12","tokens":[{"key":"30:12:1","position":1,"arabic":"وَيَوْمَ","kind":"word","gloss":"And (the) Day","transliteration":"wayawma","lemma":"يَوْم","root":"يوم","entryId":"l-bd6f5747b4dfe79c"},{"key":"30:12:2","position":2,"arabic":"تَقُومُ","kind":"word","gloss":"will (be) established","transliteration":"taqūmu","lemma":"قَامَ","root":"قوم","entryId":null},{"key":"30:12:3","position":3,"arabic":"ٱلسَّاعَةُ","kind":"word","gloss":"the Hour","transliteration":"l-sāʿatu","lemma":"سَاعَة","root":"سوع","entryId":"l-d74bbc36bff7ccce"},{"key":"30:12:4","position":4,"arabic":"يُبْلِسُ","kind":"word","gloss":"will (be in) despair","transliteration":"yub'lisu","lemma":"يُبْلِسُ","root":"بلس","entryId":null},{"key":"30:12:5","position":5,"arabic":"ٱلْمُجْرِمُونَ","kind":"word","gloss":"the criminals","transliteration":"l-muj'rimūna","lemma":"مُجْرِم","root":"جرم","entryId":"l-20d9c5e788f748c8"},{"key":"30:12:6","position":6,"arabic":"١٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"And on the Day when the Hour will be established, the Mujrimûn (disbelievers, sinners, criminals, polytheists) will be plunged into destruction with (deep regrets, sorrows, and) despair.","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"30:12:3","targetGloss":"the Hour","targetTransliteration":"l-sāʿatu","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]},{"ref":"30:14","tokens":[{"key":"30:14:1","position":1,"arabic":"وَيَوْمَ","kind":"word","gloss":"And (the) Day","transliteration":"wayawma","lemma":"يَوْم","root":"يوم","entryId":"l-bd6f5747b4dfe79c"},{"key":"30:14:2","position":2,"arabic":"تَقُومُ","kind":"word","gloss":"will (be) established","transliteration":"taqūmu","lemma":"قَامَ","root":"قوم","entryId":null},{"key":"30:14:3","position":3,"arabic":"ٱلسَّاعَةُ","kind":"word","gloss":"the Hour","transliteration":"l-sāʿatu","lemma":"سَاعَة","root":"سوع","entryId":"l-d74bbc36bff7ccce"},{"key":"30:14:4","position":4,"arabic":"يَوْمَئِذٍۢ","kind":"word","gloss":"that Day","transliteration":"yawma-idhin","lemma":"يَوْمَئِذ","root":"يوم","entryId":"l-675d35e3d4bddca4"},{"key":"30:14:5","position":5,"arabic":"يَتَفَرَّقُونَ","kind":"word","gloss":"they will become separated","transliteration":"yatafarraqūna","lemma":"تَفَرَّقَ","root":"فرق","entryId":null},{"key":"30:14:6","position":6,"arabic":"١٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"And on the Day when the Hour will be established - that Day shall (all men) be separated (i.e. the believers will be separated from the disbelievers).","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"30:14:3","targetGloss":"the Hour","targetTransliteration":"l-sāʿatu","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]}]}