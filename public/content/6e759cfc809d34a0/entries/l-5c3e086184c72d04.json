,"arabic":"ٱلْأَلْبَـٰبِ","kind":"word","gloss":"(of) understanding","transliteration":"l-albābi","lemma":"أَلْبَٰب","root":"لبب","entryId":null},{"key":"2:179:7","position":7,"arabic":"لَعَلَّكُمْ","kind":"word","gloss":"So that you may","transliteration":"laʿallakum","lemma":"لَعَلّ","root":null,"entryId":"l-d6ec00bab0ae6b09"},{"key":"2:179:8","position":8,"arabic":"تَتَّقُونَ","kind":"word","gloss":"(become) righteous","transliteration":"tattaqūna","lemma":"اتَّقَىٰ","root":"وقي","entryId":"l-f72641a6cc6e53f2"},{"key":"2:179:9","position":9,"arabic":"١٧٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"And there is (a saving of) life for you in Al-Qisâs (the Law of Equality in punishment), O men of understanding, that you may become Al-Muttaqûn (the pious - See V.2: 2).","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"2:179:5","targetGloss":"O men","targetTransliteration":"yāulī","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]}]}