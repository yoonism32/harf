":"102:5:3","position":3,"arabic":"تَعْلَمُونَ","kind":"word","gloss":"you know","transliteration":"taʿlamūna","lemma":"عَلِمَ","root":"علم","entryId":"l-6de9979b254804ea"},{"key":"102:5:4","position":4,"arabic":"عِلْمَ","kind":"word","gloss":"(with) a knowledge","transliteration":"ʿil'ma","lemma":"عِلْم","root":"علم","entryId":"l-c2e53cd05dc28448"},{"key":"102:5:5","position":5,"arabic":"ٱلْيَقِينِ","kind":"word","gloss":"(of) certainty","transliteration":"l-yaqīni","lemma":"يَقِين","root":"يقن","entryId":null},{"key":"102:5:6","position":6,"arabic":"٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"Nay! If you knew with a sure knowledge (the end result of piling up, you would not have been occupied yourselves in worldly things).","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"102:5:4","targetGloss":"(with) a knowledge","targetTransliteration":"ʿil'ma","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]},{"ref":"7:7","tokens":[{"key":"7:7:1","position":1,"arabic":"فَلَنَقُصَّنَّ","kind":"word","gloss":"Then surely We will narrate","transliteration":"falanaquṣṣanna","lemma":"قَصَّ","root":"قصص","entryId":null},{"key":"7:7:2","position":2,"arabic":"عَلَيْهِم","kind":"word","gloss":"to them","transliteration":"ʿalayhim","lemma":"عَلَىٰ","root":null,"entryId":"l-08dd9283adb70e54"},{"key":"7:7:3","position":3,"arabic":"بِعِلْمٍۢ ۖ","kind":"word","gloss":"with knowledge","transliteration":"biʿil'min","lemma":"عِلْم","root":"علم","entryId":"l-c2e53cd05dc28448"},{"key":"7:7:4","position":4,"arabic":"وَمَا","kind":"word","gloss":"and not","transliteration":"wamā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"7:7:5","position":5,"arabic":"كُنَّا","kind":"word","gloss":"were We","transliteration":"kunnā","lemma":"كَانَ","root":"كون","entryId":"l-4b2f9969a9af0d45"},{"key":"7:7:6","position":6,"arabic":"غَآئِبِينَ","kind":"word","gloss":"absent","transliteration":"ghāibīna","lemma":"غَآئِبِين","root":"غيب","entryId":null},{"key":"7:7:7","position":7,"arabic":"٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"Then surely, We shall narrate unto them (their whole story) with knowledge, and indeed We have not been absent.","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"7:7:3","targetGloss":"with knowledge","targetTransliteration":"biʿil'min","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]}]}