{"entry":{"id":"l-73112703ea29a8c7","lemma":"أَضَلَّ","root":"ضلل","arabic":"أَضَلَّنَآ","gloss":"misguided us","transliteration":"aḍallanā","representativeKey":"26:99:2","exampleKeys":["26:99:2","20:79:1","47:8:5"],"occurrenceCount":64,"courseOrder":167,"sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"],"rootId":"r-3be22de1d2e348c1","approval":{"status":"pending"}},"examples":[{"ref":"26:99","tokens":[{"key":"26:99:1","position":1,"arabic":"وَمَآ","kind":"word","gloss":"And not","transliteration":"wamā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"26:99:2","position":2,"arabic":"أَضَلَّنَآ","kind":"word","gloss":"misguided us","transliteration":"aḍallanā","lemma":"أَضَلَّ","root":"ضلل","entryId":"l-73112703ea29a8c7"},{"key":"26:99:3","position":3,"arabic":"إِلَّا","kind":"word","gloss":"except","transliteration":"illā","lemma":"إِلَّا","root":null,"entryId":"l-250ca4d5b58814dd"},{"key":"26:99:4","position":4,"arabic":"ٱلْمُجْرِمُونَ","kind":"word","gloss":"the criminals","transliteration":"l-muj'rimūna","lemma":"مُجْرِم","root":"جرم","entryId":"l-20d9c5e788f748c8"},{"key":"26:99:5","position":5,"arabic":"٩٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"And none has brought us into error except the Mujrimûn [Iblîs (Satan) and those of human beings who commit crimes, murderers, polytheists, oppressors].","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"26:99:2","targetGloss":"misguided us","targetTransliteration":"aḍallanā","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]},{"ref":"20:79","tokens":[{"key":"20:79:1","position":1,"arabic":"وَأَضَلَّ","kind":"word","gloss":"And led astray","transliteration":"wa-aḍalla","lemma":"أَضَلَّ","root":"ضلل","entryId":"l-73112703ea29a8c7"},{"key":"20:79:2","position":2,"arabic":"فِرْعَوْنُ","kind":"word","gloss":"Firaun","transliteration":"fir'ʿawnu","lemma":"فِرْعَوْن","root":null,"entryI