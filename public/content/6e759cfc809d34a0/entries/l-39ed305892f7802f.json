:"l-3afba549abbd5639"},{"key":"2:12:3","position":3,"arabic":"هُمُ","kind":"word","gloss":"themselves","transliteration":"humu","lemma":null,"root":null,"entryId":null},{"key":"2:12:4","position":4,"arabic":"ٱلْمُفْسِدُونَ","kind":"word","gloss":"(are) the ones who spread corruption","transliteration":"l-muf'sidūna","lemma":"مُفْسِد","root":"فسد","entryId":null},{"key":"2:12:5","position":5,"arabic":"وَلَـٰكِن","kind":"word","gloss":"[and] but","transliteration":"walākin","lemma":"لَٰكِن","root":null,"entryId":"l-7b6f1068619bff35"},{"key":"2:12:6","position":6,"arabic":"لَّا","kind":"word","gloss":"not","transliteration":"lā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"2:12:7","position":7,"arabic":"يَشْعُرُونَ","kind":"word","gloss":"they realize (it)","transliteration":"yashʿurūna","lemma":"يَشْعُرُ","root":"شعر","entryId":null},{"key":"2:12:8","position":8,"arabic":"١٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"Verily! They are the ones who make mischief, but they perceive not.","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"2:12:1","targetGloss":"Beware","targetTransliteration":"alā","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]},{"ref":"10:62","tokens":[{"key":"10:62:1","position":1,"arabic":"أَلَآ","kind":"word","gloss":"No doubt","transliteration":"alā","lemma":"أَلَآ","root":null,"entryId":"l-39ed305892f7802f"},{"key":"10:62:2","position":2,"arabic":"إِنَّ","kind":"word","gloss":"Indeed","transliteration":"inna","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"10:62:3","position":3,"arabic":"أَوْلِيَآءَ","kind":"word","gloss":"(the) friends","transliteration":"awliyāa","lemma":"وَلِىّ","root":"ولي","entryId":"l-f7f7df4f9e685d9b"},{"key":"10:62:4","position":4,"arabic":"ٱللَّهِ","kind":"word","gloss":"(of) Allah","transliteration":"l-lahi","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"10:62:5","position":5,"arabic":"لَا","kind":"word","gloss":"(there will be) no","transliteration":"lā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"10:62:6","position":6,"arabic":"خَوْفٌ","kind":"word","gloss":"fear","transliteration":"khawfun","lemma":"خَوْف","root":"خوف","entryId":null},{"key":"10:62:7","position":7,"arabic":"عَلَيْهِمْ","kind":"word","gloss":"upon then","transliteration":"ʿalayhim","lemma":"عَلَىٰ","root":null,"entryId":"l-08dd9283adb70e54"},{"key":"10:62:8","position":8,"arabic":"وَلَا","kind":"word","gloss":"and not","transliteration":"walā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"10:62:9","position":9,"arabic":"هُمْ","kind":"word","gloss":"they","transliteration":"hum","lemma":null,"root":null,"entryId":null},{"key":"10:62:10","position":10,"arabic":"يَحْزَنُونَ","kind":"word","gloss":"will grieve","transliteration":"yaḥzanūna","lemma":"يَحْزُن","root":"حزن","entryId":"l-412efcd4663cd8d4"},{"key":"10:62:11","position":11,"arabic":"٦٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"No doubt! Verily, the Auliyâ’ of Allâh [i.e. those who believe in the Oneness of Allâh and fear Allâh much (abstain from all kinds of sins and evil deeds which he has forbidden), and love Allâh much (perform all kinds of good deeds which He has ordained)], no fear shall come upon them nor shall they grieve.","translationSource":"qul-301-hilali-khan","notes":[{"text":"Narrated Abu Sa‘îd Al-Khudrî رضي الله عنه: Allâh’s Messenger صلى الله عليه وسلم said, \"When the funeral is ready and the men carry it on their shoulders, if the deceased was righteous, it will say: ‘Present me (hurriedly),’ and if he was not righteous, it will say: ‘Woe to it (me)! Where are they taking it (me)?’ Its voice is heard by everything except man, and if he heard it, he would fall unconscious.\" (Sahih Al-Bukhari, Vol.2,Hadith No.400).","ref":null}],"targetKey":"10:62:1","targetGloss":"No doubt","targetTransliteration":"alā","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]}]}