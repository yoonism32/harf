{"entry":{"id":"l-9f30b74ee08bd80b","lemma":"كَبِير","root":"كبر","arabic":"وَكَبِيرٍۢ","gloss":"and big","transliteration":"wakabīrin","representativeKey":"54:53:3","exampleKeys":["54:53:3","13:9:4","17:43:6"],"occurrenceCount":40,"courseOrder":272,"sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"],"rootId":"r-451abe1eea593339","approval":{"status":"pending"}},"examples":[{"ref":"54:53","tokens":[{"key":"54:53:1","position":1,"arabic":"وَكُلُّ","kind":"word","gloss":"And every","transliteration":"wakullu","lemma":"كُلّ","root":"كلل","entryId":"l-6fac43bd71e38426"},{"key":"54:53:2","position":2,"arabic":"صَغِيرٍۢ","kind":"word","gloss":"small","transliteration":"ṣaghīrin","lemma":"صَغِير","root":"صغر","entryId":null},{"key":"54:53:3","position":3,"arabic":"وَكَبِيرٍۢ","kind":"word","gloss":"and big","transliteration":"wakabīrin","lemma":"كَبِير","root":"كبر","entryId":"l-9f30b74ee08bd80b"},{"key":"54:53:4","position":4,"arabic":"مُّسْتَطَرٌ","kind":"word","gloss":"(is) written down","transliteration":"mus'taṭarun","lemma":"مُّسْتَطَر","root":"سطر","entryId":null},{"key":"54:53:5","position":5,"arabic":"٥٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"And everything, small and big, is written down (in Al-Lauh Al-Mahfûz already beforehand i.e. before it befalls, or is done by its doer: الإيمان بالقدر) (See the Qur’ân V.57:22 and its footnote).","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"54:53:3","targetGloss":"and big","targetTransliteration":"wakabīrin","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]},{"ref":"13:9","tokens":[{"key":"13:9:1","position":1,"arabic":"عَـٰلِمُ","kind":"word","gloss":"Knower","transliteration":"ʿālimu","lemma":"عَٰلِم","root":"علم","entryId":null},{"key":"13:9:2","position":2,"arabic":"ٱلْغَيْبِ","kind":"word","gloss":"(of) the unseen","transliteration":"l-ghaybi","lemma":"غَيْب","root":"غيب","entryId":null},{"key":"13:9:3","position":3,"arabic":"وَٱلشَّهَـٰدَةِ","kind":"word","gloss":"and the witnessed","transliteration":"wal-shahādati","lemma":"شَهَٰدَة","root":"شهد","entryId":null},{"key":"13:9:4","position":4,"arabic":"ٱلْكَبِيرُ","kind":"word","gloss":"the Most Great","transliteration":"l-kabīru","lemma":"كَبِير","root":"كبر","entryId":"l-9f30b74ee08bd80b"},{"key":"13:9:5","position":5,"arabic":"ٱلْمُتَعَالِ","kind":"word","gloss":"the Most High","transliteration":"l-mutaʿāli","lemma":"مُتَعَال","root":"علو","entryId":null},{"key":"13:9:6","position":6,"arabic":"٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"All-Knower of the Unseen and the seen, the Most Great, the Most High.","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"13:9:4","targetGloss":"the Most Great","targetTransliteration":"l-kabīru","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]},{"ref":"17:43","tokens":[{"key":"17:43:1","position":1,"arabic":"سُبْحَـٰنَهُۥ","kind":"word","gloss":"Glorified is He","transliteration":"sub'ḥānahu","lemma":"سُبْحَٰن","root":"سبح","entryId":"l-f12e6ea449342e8c"},{"key":"17:43:2","position":2,"arabic":"وَتَعَـٰلَىٰ","kind":"word","gloss":"and Exalted is He","transliteration":"wataʿālā","lemma":"تَعَٰلَىٰ","root":"علو","entryId":null},{"key":"17:43:3","position":3,"arabic":"عَمَّا","kind":"word","gloss":"above what","transliteration":"ʿammā","lemma":"عَن","root":null,"entryId":"l-f1109a78c8548754"},{"key":"17:43:4","position":4,"arabic":"يَقُولُونَ","kind":"word","gloss":"they say","transliteration":"yaqūlūna","lemma":"قَالَ","root":"قول","entryId":"l-effaf24a5c86c56f"},{"key":"17:43:5","position":5,"arabic":"عُلُوًّۭا","kind":"word","gloss":"(by) height","transliteration":"ʿuluwwan","lemma":"عُلُوّ","root":"علو","entryId":null},{"key":"17:43:6","position":6,"arabic":"كَبِيرًۭا","kind":"word","gloss":"great","transliteration":"kabīran","lemma":"كَبِير","root":"كبر","entryId":"l-9f30b74ee08bd80b"},{"key":"17:43:7","position":7,"arabic":"٤٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"Glorified and Exalted be He! High above (the great falsehood) that they say! (i.e. forged statements that there are other gods along with Allâh, but He is Allâh, the One, the Self-Sufficient Master, Whom all creatures need. He begets not, nor was He begotten, and there is none comparable or coequal unto Him).","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"17:43:6","targetGloss":"great","targetTransliteration":"kabīran","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]}]}