oss":"And (let) not","transliteration":"walā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"43:62:2","position":2,"arabic":"يَصُدَّنَّكُمُ","kind":"word","gloss":"avert you","transliteration":"yaṣuddannakumu","lemma":"صَدَّ","root":"صدد","entryId":"l-ca9317c6385dd6cf"},{"key":"43:62:3","position":3,"arabic":"ٱلشَّيْطَـٰنُ ۖ","kind":"word","gloss":"the Shaitaan","transliteration":"l-shayṭānu","lemma":"شَيْطَٰن","root":"شطن","entryId":"l-1edf2a3c0afdde81"},{"key":"43:62:4","position":4,"arabic":"إِنَّهُۥ","kind":"word","gloss":"Indeed, he","transliteration":"innahu","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"43:62:5","position":5,"arabic":"لَكُمْ","kind":"word","gloss":"(is) for you","transliteration":"lakum","lemma":null,"root":null,"entryId":null},{"key":"43:62:6","position":6,"arabic":"عَدُوٌّۭ","kind":"word","gloss":"an enemy","transliteration":"ʿaduwwun","lemma":"عَدُوّ","root":"عدو","entryId":"l-f920590bc8ef63e8"},{"key":"43:62:7","position":7,"arabic":"مُّبِينٌۭ","kind":"word","gloss":"clear","transliteration":"mubīnun","lemma":"مُّبِين","root":"بين","entryId":"l-0d597777bd2bba00"},{"key":"43:62:8","position":8,"arabic":"٦٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"And let not Shaitân (Satan) hinder you (from the right religion, i.e. Islâmic Monotheism). Verily, he (Satan) to you is a plain enemy.","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"43:62:6","targetGloss":"an enemy","targetTransliteration":"ʿaduwwun","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]},{"ref":"43:67","tokens":[{"key":"43:67:1","position":1,"arabic":"ٱلْأَخِلَّآءُ","kind":"word","gloss":"Friends","transliteration":"al-akhilāu","lemma":"خَلِيل","root":"خلل","entryId":null},{"key":"43:67:2","position":2,"arabic":"يَوْمَئِذٍۭ","kind":"word","gloss":"that Day","transliteration":"yawma-idhin","lemma":"يَوْمَئِذ","root":"يوم","entryId":"l-675d