","position":2,"arabic":"مِّنَ","kind":"word","gloss":"from","transliteration":"mina","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"9:1:3","position":3,"arabic":"ٱللَّهِ","kind":"word","gloss":"Allah","transliteration":"l-lahi","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"9:1:4","position":4,"arabic":"وَرَسُولِهِۦٓ","kind":"word","gloss":"and His Messenger","transliteration":"warasūlihi","lemma":"رَسُول","root":"رسل","entryId":"l-165e008d0f146d23"},{"key":"9:1:5","position":5,"arabic":"إِلَى","kind":"word","gloss":"to","transliteration":"ilā","lemma":"إِلَىٰ","root":null,"entryId":"l-53539d2c3606b99e"},{"key":"9:1:6","position":6,"arabic":"ٱلَّذِينَ","kind":"word","gloss":"those (with) whom","transliteration":"alladhīna","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"9:1:7","position":7,"arabic":"عَـٰهَدتُّم","kind":"word","gloss":"you made a covenant","transliteration":"ʿāhadttum","lemma":"عَٰهَدَ","root":"عهد","entryId":null},{"key":"9:1:8","position":8,"arabic":"مِّنَ","kind":"word","gloss":"from","transliteration":"mina","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"9:1:9","position":9,"arabic":"ٱلْمُشْرِكِينَ","kind":"word","gloss":"the polytheists","transliteration":"l-mush'rikīna","lemma":"مُشْرِك","root":"شرك","entryId":"l-f1407d5b914fb36c"},{"key":"9:1:10","position":10,"arabic":"١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"Freedom from (all) obligations (is declared) from Allâh and His Messenger (صلى الله عليه وسلم) to those of the Mushrikûn (polytheists, pagans, idolaters, disbelievers in the Oneness of Allâh), with whom you made a treaty.","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"9:1:9","targetGloss":"the polytheists","targetTransliteration":"l-mush'rikīna","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]}]}