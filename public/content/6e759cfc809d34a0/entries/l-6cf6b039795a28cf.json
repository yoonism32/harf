m His Torment).","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"30:44:4","targetGloss":"(is) his disbelief","targetTransliteration":"kuf'ruhu","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]},{"ref":"2:88","tokens":[{"key":"2:88:1","position":1,"arabic":"وَقَالُوا۟","kind":"word","gloss":"And they said","transliteration":"waqālū","lemma":"قَالَ","root":"قول","entryId":"l-effaf24a5c86c56f"},{"key":"2:88:2","position":2,"arabic":"قُلُوبُنَا","kind":"word","gloss":"Our hearts","transliteration":"qulūbunā","lemma":"قَلْب","root":"قلب","entryId":"l-4fe27e415bdd53be"},{"key":"2:88:3","position":3,"arabic":"غُلْفٌۢ ۚ","kind":"word","gloss":"(are) wrapped","transliteration":"ghul'fun","lemma":"غُلْف","root":"غلف","entryId":null},{"key":"2:88:4","position":4,"arabic":"بَل","kind":"word","gloss":"Nay","transliteration":"bal","lemma":"بَل","root":null,"entryId":"l-706f9c6eca0445cc"},{"key":"2:88:5","position":5,"arabic":"لَّعَنَهُمُ","kind":"word","gloss":"has cursed them","transliteration":"laʿanahumu","lemma":"لَعَنَ","root":"لعن","entryId":null},{"key":"2:88:6","position":6,"arabic":"ٱللَّهُ","kind":"word","gloss":"Allah","transliteration":"l-lahu","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"2:88:7","position":7,"arabic":"بِكُفْرِهِمْ","kind":"word","gloss":"for their disbelief","transliteration":"bikuf'rihim","lemma":"كُفْر","root":"كفر","entryId":"l-6cf6b039795a28cf"},{"key":"2:88:8","position":8,"arabic":"فَقَلِيلًۭا","kind":"word","gloss":"so little","transliteration":"faqalīlan","lemma":null,"root":"قلل","entryId":null},{"key":"2:88:9","position":9,"arabic":"مَّا","kind":"word","gloss":"(is) what","transliteration":"mā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"2:88:10","position":10,"arabic":"يُؤْمِنُونَ","kind":"word","gloss":"they believe","transliteration":"yu'minūna","lemma":"ءَامَنَ","root":"امن","entryId":"l-f6ec3a6dc0f76aa6"},{"key":"2:88:11","position":11,"arabic":"٨٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"And they say, \"Our hearts are wrapped (i.e. do not hear or understand Allâh’s Word).\" Nay, Allâh has cursed them for their disbelief, so little is that which they believe.","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"2:88:7","targetGloss":"for their disbelief","targetTransliteration":"bikuf'rihim","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]}]}