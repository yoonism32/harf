,"arabic":"٢٤٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"And fight in the Way of Allâh and know that Allâh is All-Hearer, All-Knower.","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"2:244:1","targetGloss":"And fight","targetTransliteration":"waqātilū","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]},{"ref":"22:39","tokens":[{"key":"22:39:1","position":1,"arabic":"أُذِنَ","kind":"word","gloss":"Permission is given","transliteration":"udhina","lemma":"أَذِنَ","root":"اذن","entryId":null},{"key":"22:39:2","position":2,"arabic":"لِلَّذِينَ","kind":"word","gloss":"to those who","transliteration":"lilladhīna","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"22:39:3","position":3,"arabic":"يُقَـٰتَلُونَ","kind":"word","gloss":"are being fought","transliteration":"yuqātalūna","lemma":"قَٰتَلَ","root":"قتل","entryId":"l-6499f22bdaad6937"},{"key":"22:39:4","position":4,"arabic":"بِأَنَّهُمْ","kind":"word","gloss":"because they","transliteration":"bi-annahum","lemma":"أَنّ","root":null,"entryId":"l-9a8e074398908017"},{"key":"22:39:5","position":5,"arabic":"ظُلِمُوا۟ ۚ","kind":"word","gloss":"were wronged","transliteration":"ẓulimū","lemma":"ظَلَمَ","root":"ظلم","entryId":"l-6578ab7d9a1fffd5"},{"key":"22:39:6","position":6,"arabic":"وَإِنَّ","kind":"word","gloss":"And indeed","transliteration":"wa-inna","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"22:39:7","position":7,"arabic":"ٱللَّهَ","kind":"word","gloss":"Allah","transliteration":"l-laha","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"22:39:8","position":8,"arabic":"عَلَىٰ","kind":"word","gloss":"for","transliteration":"ʿalā","lemma":"عَلَىٰ","root":null,"entryId":"l-08dd9283adb70e54"},{"key":"22:39:9","position":9,"arabic":"نَصْرِهِمْ","kind":"word","gloss":"their victory","transliteration":"naṣrihim","lemma":"نَصْر","root":"نصر","entryId":null},{"key":"22:39:10","position":10,"arabic":"لَقَدِيرٌ","kind":"word","gloss":"(is) surely Able","transliteration":"laqadīrun","lemma":"قَدِير","root":"قدر","entryId":"l-75eb12aa4d87567b"},{"key":"22:39:11","position":11,"arabic":"٣٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"Permission to fight (against disbelievers) is given to those (believers) who are fought against, because they have been wronged; and surely, Allâh is Able to give them (believers) victory -","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"22:39:3","targetGloss":"are being fought","targetTransliteration":"yuqātalūna","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]},{"ref":"3:111","tokens":[{"key":"3:111:1","position":1,"arabic":"لَن","kind":"word","gloss":"Never","transliteration":"lan","lemma":"لَن","root":null,"entryId":"l-3db5462128ff695e"},{"key":"3:111:2","position":2,"arabic":"يَضُرُّوكُمْ","kind":"word","gloss":"will they harm you","transliteration":"yaḍurrūkum","lemma":"يَضُرَّ","root":"ضرر","entryId":null},{"key":"3:111:3","position":3,"arabic":"إِلَّآ","kind":"word","gloss":"except","transliteration":"illā","lemma":"إِلَّا","root":null,"entryId":"l-250ca4d5b58814dd"},{"key":"3:111:4","position":4,"arabic":"أَذًۭى ۖ","kind":"word","gloss":"a hurt","transliteration":"adhan","lemma":"أَذًى","root":"اذي","entryId":null},{"key":"3:111:5","position":5,"arabic":"وَإِن","kind":"word","gloss":"And if","transliteration":"wa-in","lemma":"إِن","root":null,"entryId":"l-de626c6526849733"},{"key":"3:111:6","position":6,"arabic":"يُقَـٰتِلُوكُمْ","kind":"word","gloss":"they fight you","transliteration":"yuqātilūkum","lemma":"قَٰتَلَ","root":"قتل","entryId":"l-6499f22bdaad6937"},{"key":"3:111:7","position":7,"arabic":"يُوَلُّوكُمُ","kind":"word","gloss":"they will turn (towards) you","transliteration":"yuwallūkumu","lemma":"وَلَّىٰ","root":"ولي","entryId":null},{"key":"3:111:8","position":8,"arabic":"ٱلْأَدْبَارَ","kind":"word","gloss":"the backs","transliteration":"l-adbāra","lemma":null,"root":"دبر","entryId":null},{"key":"3:111:9","position":9,"arabic":"ثُمَّ","kind":"word","gloss":"then","transliteration":"thumma","lemma":"ثُمّ","root":null,"entryId":"l-75b66396af12da75"},{"key":"3:111:10","position":10,"arabic":"لَا","kind":"word","gloss":"not","transliteration":"lā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"3:111:11","position":11,"arabic":"يُنصَرُونَ","kind":"word","gloss":"they will be helped","transliteration":"yunṣarūna","lemma":"نَصَرَ","root":"نصر","entryId":"l-95578e4abda411cc"},{"key":"3:111:12","position":12,"arabic":"١١١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"They will do you no harm, barring a trifling annoyance; and if they fight against you, they will show you their backs, and they will not be helped.","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"3:111:6","targetGloss":"they fight you","targetTransliteration":"yuqātilūkum","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]}]}