{"entry":{"id":"l-5f5d4e3c1d9b05b3","lemma":"نَزَّلَ","root":"نزل","arabic":"نَزَّلْنَـٰهُ","gloss":"We (had) revealed it","transliteration":"nazzalnāhu","representativeKey":"26:198:2","exampleKeys":["26:198:2","76:23:3","15:9:3"],"occurrenceCount":62,"courseOrder":176,"sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"],"rootId":"r-b61eb77e5d358d70","approval":{"status":"pending"}},"examples":[{"ref":"26:198","tokens":[{"key":"26:198:1","position":1,"arabic":"وَلَوْ","kind":"word","gloss":"And if","transliteration":"walaw","lemma":"لَو","root":null,"entryId":"l-9e02d9e1c2596c32"},{"key":"26:198:2","position":2,"arabic":"نَزَّلْنَـٰهُ","kind":"word","gloss":"We (had) revealed it","transliteration":"nazzalnāhu","lemma":"نَزَّلَ","root":"نزل","entryId":"l-5f5d4e3c1d9b05b3"},{"key":"26:198:3","position":3,"arabic":"عَلَىٰ","kind":"word","gloss":"to","transliteration":"ʿalā","lemma":"عَلَىٰ","root":null,"entryId":"l-08dd9283adb70e54"},{"key":"26:198:4","position":4,"arabic":"بَعْضِ","kind":"word","gloss":"any","transliteration":"baʿḍi","lemma":"بَعْض","root":"بعض","entryId":"l-c0cec17f16fd2f5d"},{"key":"26:198:5","position":5,"arabic":"ٱلْأَعْجَمِينَ","kind":"word","gloss":"(of) the non-Arabs","transliteration":"l-aʿjamīna","lemma":"أَعْجَمِين","root":"عجم","entryId":null},{"key":"26:198:6","position":6,"arabic":"١٩٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"And if We had revealed it (this Qur’ân) unto any of the non-Arabs,","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"26:198:2","targetGloss":"We (had) revealed it","targetTransliteration":"nazzalnāhu","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]},{"ref":"76:23","tokens":[{"key":"76:23:1","position":1,"arabic":"إِنَّا","kind":"word","gloss":"Indeed, We","transliteration":"innā","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"76:23:2","position":2,"arabic":"نَحْنُ","kind":"word","gloss":"[We]","transliteration":"naḥnu","lemma":null,"root":null,"entryId":null},{"key":"76:23:3","position":3,"arabic":"نَزَّلْنَا","kind":"word","gloss":"[We] revealed","transliteration":"nazzalnā","lemma":"نَزَّلَ","root":"نزل","entryId":"l-5f5d4e3c1d9b05b3"},{"key":"76:23:4","position":4,"arabic":"عَلَيْكَ","kind":"word","gloss":"to you","transliteration":"ʿalayka","lemma":"عَلَىٰ","root":null,"entryId":"l-08dd9283adb70e54"},{"key":"76:23:5","position":5,"arabic":"ٱلْقُرْءَانَ","kind":"word","gloss":"the Quran","transliteration":"l-qur'āna","lemma":"قُرْءَان","root":"قرا","entryId":"l-5ff4c6fce3db7bd6"},{"key":"76:23:6","position":6,"arabic":"تَنزِيلًۭا","kind":"word","gloss":"progressively","transliteration":"tanzīlan","lemma":"تَنزِيل","root":"نزل","entryId":null},{"key":"76:23:7","position":7,"arabic":"٢٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"Verily, it is We Who have sent down the Qur’ân to you (O Muhammad صلى الله عليه وسلم) by stages.","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"76:23:3","targetGloss":"[We] revealed","targetTransliteration":"nazzalnā","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]},{"ref":"15:9","tokens":[{"key":"15:9:1","position":1,"arabic":"إِنَّا","kind":"word","gloss":"Indeed, We","transliteration":"innā","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"15:9:2","position":2,"arabic":"نَحْنُ","kind":"word","gloss":"We","transliteration":"naḥnu","lemma":null,"root":null,"entryId":null},{"key":"15:9:3","position":3,"arabic":"نَزَّلْنَا","kind":"word","gloss":"have sent down","transliteration":"nazzalnā","lemma":"نَزَّلَ","root":"نزل","entryId":"l-5f5d4e3c1d9b05b3"},{"key":"15:9:4","position":4,"arabic":"ٱلذِّكْرَ","kind":"word","gloss":"the Reminder","transliteration":"l-dhik'ra","lemma":"ذِكْر","root":"ذكر","entryId":"l-b273b8ee66c296d9"},{"key":"15:9:5","position":5,"arabic":"وَإِنَّا","kind":"word","gloss":"and indeed, We","transliteration":"wa-innā","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"15:9:6","position":6,"arabic":"لَهُۥ","kind":"word","gloss":"of it","transliteration":"lahu","lemma":null,"root":null,"entryId":null},{"key":"15:9:7","position":7,"arabic":"لَحَـٰفِظُونَ","kind":"word","gloss":"(are) surely Guardians","transliteration":"laḥāfiẓūna","lemma":"حَٰفِظ","root":"حفظ","entryId":null},{"key":"15:9:8","position":8,"arabic":"٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"Verily, We, it is We Who have sent down the Dhikr (i.e. the Qur’ân) and surely, We will guard it (from corruption).","translationSource":"qul-301-hilali-khan","notes":[{"text":"This Verse is a challenge to mankind and everyone is obliged to believe in the miracles of this Qur’ân. It is a clear fact that more than 1400 years have elapsed and not a single word of this Qur’ân has been changed, although the disbelievers tried their utmost to change it in every way, but they failed miserably in their efforts. As it is mentioned in this holy Verse: \"We will guard it.\" By Allâh! He has guarded it. On the contrary, all the other holy Books [the Taurât (Torah), the Injeel (Gospel).] have been corrupted in the form of additions or subtractions or alterations in the original text.","ref":null}],"targetKey":"15:9:3","targetGloss":"have sent down","targetTransliteration":"nazzalnā","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]}]}