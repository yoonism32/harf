{"entry":{"id":"l-d6185269501ba306","lemma":"يَد","root":"يدي","arabic":"يَدَآ","gloss":"(the) hands","transliteration":"yadā","representativeKey":"111:1:2","exampleKeys":["111:1:2","7:108:2","26:33:2"],"occurrenceCount":120,"courseOrder":92,"sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"],"rootId":"r-67227af96eb89fd5","approval":{"status":"pending"}},"examples":[{"ref":"111:1","tokens":[{"key":"111:1:1","position":1,"arabic":"تَبَّتْ","kind":"word","gloss":"Perish","transliteration":"tabbat","lemma":"تَبَّ","root":"تبب","entryId":null},{"key":"111:1:2","position":2,"arabic":"يَدَآ","kind":"word","gloss":"(the) hands","transliteration":"yadā","lemma":"يَد","root":"يدي","entryId":"l-d6185269501ba306"},{"key":"111:1:3","position":3,"arabic":"أَبِى","kind":"word","gloss":"(of) Abu","transliteration":"abī","lemma":"أَبٌ","root":"ابو","entryId":"l-ad3be2b27679026b"},{"key":"111:1:4","position":4,"arabic":"لَهَبٍۢ","kind":"word","gloss":"Lahab","transliteration":"lahabin","lemma":"لَهَب","root":"لهب","entryId":null},{"key":"111:1:5","position":5,"arabic":"وَتَبَّ","kind":"word","gloss":"and perish he","transliteration":"watabba","lemma":"تَبَّ","root":"تبب","entryId":null},{"key":"111:1:6","position":6,"arabic":"١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"Perish the two hands of Abû Lahab (an uncle of the Prophet) and perish he!","translationSource":"qul-301-hilali-khan","notes":[{"text":"Narrated Ibn ‘Abbâs رضي الله عنهما : \"When the Verse, ‘And warn your tribe (O Muhammad صلى الله عليه وسلم) of near kindred.’ (V.26:214) was revealed, Allâh’s Messenger صلى الله عليه وسلم went out, and when he had ascended As-Safâ mountain, he shouted, ‘Yâ Sabâhâh !’* The people said, ‘What is that?’ Then they gathered around him, whereupon he said, ‘Do you see? If I inform you that cavalrymen are proceeding up the side of this mountain, will you believe me?’ They said, ‘We have never heard you telling a lie.’ Then he said, ‘I am a plain warner to you of a coming severe punishment.’ Abû Lahab said, ‘May you perish! You gathered us only for this reason?’ Then Abu Lahab went away. So [Sûrat Al-Masad] ‘Perish the hands of Abu Lahab!’ was revealed. (V.111:1). (Sahih Al-Bukhari, Vol. 6, Hadith No.495). * \"Yâ Sabâhâh!\" is an Arabic expression used when one appeals for help or draws the attention of others to some danger.","ref":null}],"targetKey":"111:1:2","targetGloss":"(the) hands","targetTransliteration":"yadā","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]},{"ref":"7:108","tokens":[{"key":"7:108:1","position":1,"arabic":"وَنَزَعَ","kind":"word","gloss":"And he drew out","transliteration":"wanazaʿa","lemma":"نَزَعَ","root":"نزع","entryId":null},{"key":"7:108:2","position":2,"arabic":"يَدَهُۥ","kind":"word","gloss":"his hand","transliteration":"yadahu","lemma":"يَد","root":"يدي","entryId":"l-d6185269501ba306"},{"key":"7:108:3","position":3,"arabic":"فَإِذَا","kind":"word","gloss":"and suddenly","transliteration":"fa-idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"7:108:4","position":4,"arabic":"هِىَ","kind":"word","gloss":"it","transliteration":"hiya","lemma":null,"root":null,"entryId":null},{"key":"7:108:5","position":5,"arabic":"بَيْضَآءُ","kind":"word","gloss":"(was) white","transliteration":"bayḍāu","lemma":"أَبْيَض","root":"بيض","entryId":null},{"key":"7:108:6","position":6,"arabic":"لِلنَّـٰظِرِينَ","kind":"word","gloss":"for the observers","transliteration":"lilnnāẓirīna","lemma":"نَٰظِرِين","root":"نظر","entryId":null},{"key":"7:108:7","position":7,"arabic":"١٠٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"And he drew out his hand, and behold! it was white (with radiance) for the beholders.","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"7:108:2","targetGloss":"his hand","targetTransliteration":"yadahu","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]},{"ref":"26:33","tokens":[{"key":"26:33:1","position":1,"arabic":"وَنَزَعَ","kind":"word","gloss":"And he drew out","transliteration":"wanazaʿa","lemma":"نَزَعَ","root":"نزع","entryId":null},{"key":"26:33:2","position":2,"arabic":"يَدَهُۥ","kind":"word","gloss":"his hand","transliteration":"yadahu","lemma":"يَد","root":"يدي","entryId":"l-d6185269501ba306"},{"key":"26:33:3","position":3,"arabic":"فَإِذَا","kind":"word","gloss":"and behold","transliteration":"fa-idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"26:33:4","position":4,"arabic":"هِىَ","kind":"word","gloss":"It","transliteration":"hiya","lemma":null,"root":null,"entryId":null},{"key":"26:33:5","position":5,"arabic":"بَيْضَآءُ","kind":"word","gloss":"(was) white","transliteration":"bayḍāu","lemma":"أَبْيَض","root":"بيض","entryId":null},{"key":"26:33:6","position":6,"arabic":"لِلنَّـٰظِرِينَ","kind":"word","gloss":"for the observers","transliteration":"lilnnāẓirīna","lemma":"نَٰظِرِين","root":"نظر","entryId":null},{"key":"26:33:7","position":7,"arabic":"٣٣","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"And he drew out his hand, and behold, it was white to all beholders!","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"26:33:2","targetGloss":"his hand","targetTransliteration":"yadahu","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]}]}