{"entry":{"id":"l-ad7819fc39b763e0","lemma":"سَأَلَ","root":"سال","arabic":"لَنَسْـَٔلَنَّهُمْ","gloss":"surely We will question them","transliteration":"lanasalannahum","representativeKey":"15:92:2","exampleKeys":["15:92:2","81:8:3","51:12:1"],"occurrenceCount":76,"courseOrder":136,"sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"],"rootId":"r-0d20732d1cce100e","approval":{"status":"pending"}},"examples":[{"ref":"15:92","tokens":[{"key":"15:92:1","position":1,"arabic":"فَوَرَبِّكَ","kind":"word","gloss":"So by your Lord","transliteration":"fawarabbika","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"15:92:2","position":2,"arabic":"لَنَسْـَٔلَنَّهُمْ","kind":"word","gloss":"surely We will question them","transliteration":"lanasalannahum","lemma":"سَأَلَ","root":"سال","entryId":"l-ad7819fc39b763e0"},{"key":"15:92:3","position":3,"arabic":"أَجْمَعِينَ","kind":"word","gloss":"all","transliteration":"ajmaʿīna","lemma":"أَجْمَعِين","root":"جمع","entryId":null},{"key":"15:92:4","position":4,"arabic":"٩٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"So, by your Lord (O Muhammad صلى الله عليه و سلم), We shall certainly call all of them to account.","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"15:92:2","targetGloss":"surely We will question them","targetTransliteration":"lanasalannahum","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]},{"ref":"81:8","tokens":[{"key":"81:8:1","position":1,"arabic":"وَإِذَا","kind":"word","gloss":"And when","transliteration":"wa-idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"81:8:2","position":2,"arabic":"ٱلْمَوْءُۥدَةُ","kind":"word","gloss":"the female infant buried alive","transliteration":"l-mawūdatu","lemma":"مَوْءُدَة","root":"واد","entryId":null},{"key":"81:8:3","position":3,"arabic":"سُئِلَتْ","kind":"word","gloss":"is asked","transliteration":"su-ilat","lemma":"سَأَلَ","root":"سال","entryId":"l-ad7819fc39b763e0"},{"key":"81:8:4","position":4,"arabic":"٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"And when the female (infant) buried alive (as the pagan Arabs used to do) is questioned:","translationSource":"qul-301-hilali-khan","notes":[{"text":"Narrated Al-Mughîrah bin Shu‘bah رضي الله عنه: The Prophet صلى الله عليه وسلم said, \"Allâh has forbidden for you: (1) to be undutiful to your mothers, (2) to bury your daughters alive, (3) not to pay the rights of the others (e.g., charity), and (4) to beg of men (i.e., begging). And Allâh hates for you: (1) sinful and useless talk like backbiting, or that you talk too much about others, (2) to ask too many questions (in disputed religious matters), and (3) to waste the wealth (by extravagance with lack of wisdom and thinking).\" (Sahih Al-Bukhari, Vol.3, Hadith No.591).","ref":null}],"targetKey":"81:8:3","targetGloss":"is asked","targetTransliteration":"su-ilat","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]},{"ref":"51:12","tokens":[{"key":"51:12:1","position":1,"arabic":"يَسْـَٔلُونَ","kind":"word","gloss":"They ask","transliteration":"yasalūna","lemma":"سَأَلَ","root":"سال","entryId":"l-ad7819fc39b763e0"},{"key":"51:12:2","position":2,"arabic":"أَيَّانَ","kind":"word","gloss":"When","transliteration":"ayyāna","lemma":"أَيَّان","root":null,"entryId":null},{"key":"51:12:3","position":3,"arabic":"يَوْمُ","kind":"word","gloss":"(is the) Day","transliteration":"yawmu","lemma":"يَوْم","root":"يوم","entryId":"l-bd6f5747b4dfe79c"},{"key":"51:12:4","position":4,"arabic":"ٱلدِّينِ","kind":"word","gloss":"(of) Judgment","transliteration":"l-dīni","lemma":"دِين","root":"دين","entryId":"l-869ef1d12b24f52a"},{"key":"51:12:5","position":5,"arabic":"١٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"They ask: \"When will be the Day of Recompense?\"","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"51:12:1","targetGloss":"They ask","targetTransliteration":"yasalūna","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]}]}