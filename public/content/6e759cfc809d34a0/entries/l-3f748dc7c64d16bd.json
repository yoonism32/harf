{"entry":{"id":"l-3f748dc7c64d16bd","lemma":"بَيِّنَة","root":"بين","arabic":"بَيِّنَةًۭ","gloss":"(as) evidence","transliteration":"bayyinatan","representativeKey":"29:35:5","exampleKeys":["29:35:5","22:16:4","24:1:7"],"occurrenceCount":71,"courseOrder":152,"sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"],"rootId":"r-63b0b1537eb37d68","approval":{"status":"pending"}},"examples":[{"ref":"29:35","tokens":[{"key":"29:35:1","position":1,"arabic":"وَلَقَد","kind":"word","gloss":"And verily","transliteration":"walaqad","lemma":"قَد","root":null,"entryId":"l-11a59b67e56e7412"},{"key":"29:35:2","position":2,"arabic":"تَّرَكْنَا","kind":"word","gloss":"We have left","transliteration":"taraknā","lemma":"تَرَكَ","root":"ترك","entryId":"l-5532fa6a591dae0f"},{"key":"29:35:3","position":3,"arabic":"مِنْهَآ","kind":"word","gloss":"about it","transliteration":"min'hā","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"29:35:4","position":4,"arabic":"ءَايَةًۢ","kind":"word","gloss":"a sign","transliteration":"āyatan","lemma":"ءَايَة","root":"ايي","entryId":"l-5ab33552830ad5b5"},{"key":"29:35:5","position":5,"arabic":"بَيِّنَةًۭ","kind":"word","gloss":"(as) evidence","transliteration":"bayyinatan","lemma":"بَيِّنَة","root":"بين","entryId":"l-3f748dc7c64d16bd"},{"key":"29:35:6","position":6,"arabic":"لِّقَوْمٍۢ","kind":"word","gloss":"for a people","transliteration":"liqawmin","lemma":"قَوْم","root":"قوم","entryId":"l-049e2cd6a60d39f0"},{"key":"29:35:7","position":7,"arabic":"يَعْقِلُونَ","kind":"word","gloss":"who use reason","transliteration":"yaʿqilūna","lemma":"عَقَلُ","root":"عقل","entryId":"l-195e95d9a611ddfa"},{"key":"29:35:8","position":8,"arabic":"٣٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"And indeed We have left thereof an evident Ayâh (a lesson and a warning and a sign - the place where the Dead Sea is now in Palestine) for a folk who understand.","translationSource":"qul-301-hilali-khan","notes":[{"text":"See the book of history كتاب التاريخ لابن كثير \"Stories of the Prophets\" by Ibn Kathir (رحمه الله).","ref":null}],"targetKey":"29:35:5","targetGloss":"(as) evidence","targetTransliteration":"bayyinatan","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]},{"ref":"22:16","tokens":[{"key":"22:16:1","position":1,"arabic":"وَكَذَٰلِكَ","kind":"word","gloss":"And thus","transliteration":"wakadhālika","lemma":"ذَٰلِك","root":null,"entryId":"l-096a9ad382db7640"},{"key":"22:16:2","position":2,"arabic":"أَنزَلْنَـٰهُ","kind":"word","gloss":"We sent it down","transliteration":"anzalnāhu","lemma":"أَنزَلَ","root":"نزل","entryId":"l-81ead5682cb1835c"},{"key":"22:16:3","position":3,"arabic":"ءَايَـٰتٍۭ","kind":"word","gloss":"(as) clear Verses","transliteration":"āyātin","lemma":"ءَايَة","root":"ايي","entryId":"l-5ab33552830ad5b5"},{"key":"22:16:4","position":4,"arabic":"بَيِّنَـٰتٍۢ","kind":"word","gloss":"(as) clear Verses","transliteration":"bayyinātin","lemma":"بَيِّنَة","root":"بين","entryId":"l-3f748dc7c64d16bd"},{"key":"22:16:5","position":5,"arabic":"وَأَنَّ","kind":"word","gloss":"and that","transliteration":"wa-anna","lemma":"أَنّ","root":null,"entryId":"l-9a8e074398908017"},{"key":"22:16:6","position":6,"arabic":"ٱللَّهَ","kind":"word","gloss":"Allah","transliteration":"l-laha","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"22:16:7","position":7,"arabic":"يَهْدِى","kind":"word","gloss":"guides","transliteration":"yahdī","lemma":"هَدَى","root":"هدي","entryId":"l-e0ac61a274311deb"},{"key":"22:16:8","position":8,"arabic":"مَن","kind":"word","gloss":"whom","transliteration":"man","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"22:16:9","position":9,"arabic":"يُرِيدُ","kind":"word","gloss":"He intends","transliteration":"yurīdu","lemma":"أَرَادَ","root":"رود","entryId":"l-1eaa86c69a1267cc"},{"key":"22:16:10","position":10,"arabic":"١٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"Thus have We sent it (this Qur’ân) down (to Muhammad صلى الله عليه وسلم) as clear signs, evidence and proofs, and surely, Allâh guides whom He wills.","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"22:16:4","targetGloss":"(as) clear Verses","targetTransliteration":"bayyinātin","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]},{"ref":"24:1","tokens":[{"key":"24:1:1","position":1,"arabic":"سُورَةٌ","kind":"word","gloss":"A Surah","transliteration":"sūratun","lemma":"سُورَة","root":"سور","entryId":null},{"key":"24:1:2","position":2,"arabic":"أَنزَلْنَـٰهَا","kind":"word","gloss":"We (have) sent it down","transliteration":"anzalnāhā","lemma":"أَنزَلَ","root":"نزل","entryId":"l-81ead5682cb1835c"},{"key":"24:1:3","position":3,"arabic":"وَفَرَضْنَـٰهَا","kind":"word","gloss":"and We (have) made it obligatory","transliteration":"wafaraḍnāhā","lemma":"فَرَضَ","root":"فرض","entryId":null},{"key":"24:1:4","position":4,"arabic":"وَأَنزَلْنَا","kind":"word","gloss":"and We (have) revealed","transliteration":"wa-anzalnā","lemma":"أَنزَلَ","root":"نزل","entryId":"l-81ead5682cb1835c"},{"key":"24:1:5","position":5,"arabic":"فِيهَآ","kind":"word","gloss":"therein","transliteration":"fīhā","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"24:1:6","position":6,"arabic":"ءَايَـٰتٍۭ","kind":"word","gloss":"Verses","transliteration":"āyātin","lemma":"ءَايَة","root":"ايي","entryId":"l-5ab33552830ad5b5"},{"key":"24:1:7","position":7,"arabic":"بَيِّنَـٰتٍۢ","kind":"word","gloss":"clear","transliteration":"bayyinātin","lemma":"بَيِّنَة","root":"بين","entryId":"l-3f748dc7c64d16bd"},{"key":"24:1:8","position":8,"arabic":"لَّعَلَّكُمْ","kind":"word","gloss":"so that you may","transliteration":"laʿallakum","lemma":"لَعَلّ","root":null,"entryId":"l-d6ec00bab0ae6b09"},{"key":"24:1:9","position":9,"arabic":"تَذَكَّرُونَ","kind":"word","gloss":"take heed","transliteration":"tadhakkarūna","lemma":"تَذَكَّرَ","root":"ذكر","entryId":"l-9bc7d78e536db086"},{"key":"24:1:10","position":10,"arabic":"١","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"(This is) a Sûrah (chapter of the Qur’ân) which We have sent down and which We have enjoined, (ordained its laws); and in it We have revealed manifest Ayât (proofs, evidence, verses, lessons, signs, revelations - lawful and unlawful things, and set boundaries of Islâmic Religion), that you may remember.","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"24:1:7","targetGloss":"clear","targetTransliteration":"bayyinātin","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]}]}