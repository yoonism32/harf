{"entry":{"id":"l-1da2ca8bba8c752f","lemma":"أُدْخِلَ","root":"دخل","arabic":"وَيُدْخِلُهُمُ","gloss":"And admit them","transliteration":"wayud'khiluhumu","representativeKey":"47:6:1","exampleKeys":["47:6:1","21:75:1","21:86:1"],"occurrenceCount":42,"courseOrder":254,"sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"],"rootId":"r-5cb7b8d73973fe65","approval":{"status":"pending"}},"examples":[{"ref":"47:6","tokens":[{"key":"47:6:1","position":1,"arabic":"وَيُدْخِلُهُمُ","kind":"word","gloss":"And admit them","transliteration":"wayud'khiluhumu","lemma":"أُدْخِلَ","root":"دخل","entryId":"l-1da2ca8bba8c752f"},{"key":"47:6:2","position":2,"arabic":"ٱلْجَنَّةَ","kind":"word","gloss":"(to) Paradise","transliteration":"l-janata","lemma":"جَنَّة","root":"جنن","entryId":"l-9f22ab6b78dd8a22"},{"key":"47:6:3","position":3,"arabic":"عَرَّفَهَا","kind":"word","gloss":"He has made it known","transliteration":"ʿarrafahā","lemma":"عَرَّفَ","root":"عرف","entryId":null},{"key":"47:6:4","position":4,"arabic":"لَهُمْ","kind":"word","gloss":"to them","transliteration":"lahum","lemma":null,"root":null,"entryId":null},{"key":"47:6:5","position":5,"arabic":"٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"And admit them to Paradise which He has made known to them (i.e. they will know their places in Paradise better than they used to know their homes in the world). [Tafsir Ibn Kathir ]","translationSource":"qul-301-hilali-khan","notes":[{"text":"Narrated Abû Sa‘îd Al-Khudrî رضي الله عنه: Allâh’s Messenger صلى الله عليه وسلم said, \"The believers, after being saved from the (Hell) Fire, will be stopped at a bridge between Paradise and Hell and mutual retaliation will take place among them regarding the wrongs they have committed in the world against one another. After they are cleansed and purified (through the retaliation), they will be admitted into Paradise; and by Him in Whose Hand Muhammad’s soul is, everyone of them will know his dwelling in Paradise better than he knew his dwelling in this world.\" (Sahih Al-Bukhari, Vol.8, Hadith No.542)","ref":null}],"targetKey":"47:6:1","targetGloss":"And admit them","targetTransliteration":"wayud'khiluhumu","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]},{"ref":"21:75","tokens":[{"key":"21:75:1","position":1,"arabic":"وَأَدْخَلْنَـٰهُ","kind":"word","gloss":"And We admitted him","transliteration":"wa-adkhalnāhu","lemma":"أُدْخِلَ","root":"دخل","entryId":"l-1da2ca8bba8c752f"},{"key":"21:75:2","position":2,"arabic":"فِى","kind":"word","gloss":"into","transliteration":"fī","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"21:75:3","position":3,"arabic":"رَحْمَتِنَآ ۖ","kind":"word","gloss":"Our Mercy","transliteration":"raḥmatinā","lemma":"رَحْمَة","root":"رحم","entryId":"l-502d5d2b9f402d4c"},{"key":"21:75:4","position":4,"arabic":"إِنَّهُۥ","kind":"word","gloss":"Indeed, he","transliteration":"innahu","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"21:75:5","position":5,"arabic":"مِنَ","kind":"word","gloss":"(was) of","transliteration":"mina","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"21:75:6","position":6,"arabic":"ٱلصَّـٰلِحِينَ","kind":"word","gloss":"the righteous","transliteration":"l-ṣāliḥīna","lemma":"صَٰلِح","root":"صلح","entryId":"l-fc63b5b8005cab08"},{"key":"21:75:7","position":7,"arabic":"٧٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"And We admitted him to Our Mercy; truly, he was of the righteous.","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"21:75:1","targetGloss":"And We admitted him","targetTransliteration":"wa-adkhalnāhu","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]},{"ref":"21:86","tokens":[{"key":"21:86:1","position":1,"arabic":"وَأَدْخَلْنَـٰهُمْ","kind":"word","gloss":"And We admitted them","transliteration":"wa-adkhalnāhum","lemma":"أُدْخِلَ","root":"دخل","entryId":"l-1da2ca8bba8c752f"},{"key":"21:86:2","position":2,"arabic":"فِى","kind":"word","gloss":"in","transliteration":"fī","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"21:86:3","position":3,"arabic":"رَحْمَتِنَآ ۖ","kind":"word","gloss":"Our Mercy","transliteration":"raḥmatinā","lemma":"رَحْمَة","root":"رحم","entryId":"l-502d5d2b9f402d4c"},{"key":"21:86:4","position":4,"arabic":"إِنَّهُم","kind":"word","gloss":"Indeed, they","transliteration":"innahum","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"21:86:5","position":5,"arabic":"مِّنَ","kind":"word","gloss":"(were) of","transliteration":"mina","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"21:86:6","position":6,"arabic":"ٱلصَّـٰلِحِينَ","kind":"word","gloss":"the righteous","transliteration":"l-ṣāliḥīna","lemma":"صَٰلِح","root":"صلح","entryId":"l-fc63b5b8005cab08"},{"key":"21:86:7","position":7,"arabic":"٨٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"And We admitted them to Our Mercy. Verily, they were of the righteous.","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"21:86:1","targetGloss":"And We admitted them","targetTransliteration":"wa-adkhalnāhum","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]}]}