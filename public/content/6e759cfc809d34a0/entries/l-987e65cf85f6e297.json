fter (from Allâh’s punishment).","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"74:53:4","targetGloss":"they fear","targetTransliteration":"yakhāfūna","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]}]}