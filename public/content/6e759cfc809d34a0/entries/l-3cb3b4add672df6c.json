{"entry":{"id":"l-3cb3b4add672df6c","lemma":"إِيمَٰن","root":"امن","arabic":"إِيمَـٰنَهُم","gloss":"their belief","transliteration":"īmānahum","representativeKey":"6:82:5","exampleKeys":["6:82:5","32:29:8","3:177:5"],"occurrenceCount":45,"courseOrder":236,"sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"],"rootId":"r-44b1f7fc6772dd2b","approval":{"status":"pending"}},"examples":[{"ref":"6:82","tokens":[{"key":"6:82:1","position":1,"arabic":"ٱلَّذِينَ","kind":"word","gloss":"Those who","transliteration":"alladhīna","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"6:82:2","position":2,"arabic":"ءَامَنُوا۟","kind":"word","gloss":"believed","transliteration":"āmanū","lemma":"ءَامَنَ","root":"امن","entryId":"l-f6ec3a6dc0f76aa6"},{"key":"6:82:3","position":3,"arabic":"وَلَمْ","kind":"word","gloss":"and (did) not","transliteration":"walam","lemma":"لَم","root":null,"entryId":"l-a5ee2f54ca9bbf2c"},{"key":"6:82:4","position":4,"arabic":"يَلْبِسُوٓا۟","kind":"word","gloss":"mix","transliteration":"yalbisū","lemma":"لَبَسْ","root":"لبس","entryId":null},{"key":"6:82:5","position":5,"arabic":"إِيمَـٰنَهُم","kind":"word","gloss":"their belief","transliteration":"īmānahum","lemma":"إِيمَٰن","root":"امن","entryId":"l-3cb3b4add672df6c"},{"key":"6:82:6","position":6,"arabic":"بِظُلْمٍ","kind":"word","gloss":"with wrong","transliteration":"biẓul'min","lemma":"ظُلْم","root":"ظلم","entryId":null},{"key":"6:82:7","position":7,"arabic":"أُو۟لَـٰٓئِكَ","kind":"word","gloss":"those","transliteration":"ulāika","lemma":"أُولَٰٓئِك","root":null,"entryId":"l-9b2e48d460410286"},{"key":"6:82:8","position":8,"arabic":"لَهُمُ","kind":"word","gloss":"for them","transliteration":"lahumu","lemma":null,"root":null,"entryId":null},{"key":"6:82:9","position":9,"arabic":"ٱلْأَمْنُ","kind":"word","gloss":"(is) the security","transliteration":"l-amnu","lemma":"أَمْن","root":"امن","entryId":null},{"key":"6:82:10","position":10,"arabic":"وَهُم","kind":"word","gloss":"and they","transliteration":"wahum","lemma":null,"root":null,"entryId":null},{"key":"6:82:11","position":11,"arabic":"مُّهْتَدُونَ","kind":"word","gloss":"(are) rightly guided","transliteration":"muh'tadūna","lemma":"مُّهْتَدُون","root":"هدي","entryId":null},{"key":"6:82:12","position":12,"arabic":"٨٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"It is those who believe (in the Oneness of Allâh and worship none but Him Alone) and confuse not their belief with Zulm (wrong i.e. by worshipping others besides Allâh), for them (only) there is security and they are the guided.","translationSource":"qul-301-hilali-khan","notes":[{"text":": See the footnote (C) of (V.27:59).","ref":null}],"targetKey":"6:82:5","targetGloss":"their belief","targetTransliteration":"īmānahum","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]},{"ref":"32:29","tokens":[{"key":"32:29:1","position":1,"arabic":"قُلْ","kind":"word","gloss":"Say","transliteration":"qul","lemma":"قَالَ","root":"قول","entryId":"l-effaf24a5c86c56f"},{"key":"32:29:2","position":2,"arabic":"يَوْمَ","kind":"word","gloss":"(On the) Day","transliteration":"yawma","lemma":"يَوْم","root":"يوم","entryId":"l-bd6f5747b4dfe79c"},{"key":"32:29:3","position":3,"arabic":"ٱلْفَتْحِ","kind":"word","gloss":"(of) the Decision","transliteration":"l-fatḥi","lemma":"فَتْح","root":"فتح","entryId":null},{"key":"32:29:4","position":4,"arabic":"لَا","kind":"word","gloss":"not","transliteration":"lā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"32:29:5","position":5,"arabic":"يَنفَعُ","kind":"word","gloss":"will benefit","transliteration":"yanfaʿu","lemma":"نَفَعَ","root":"نفع","entryId":null},{"key":"32:29:6","position":6,"arabic":"ٱلَّذِينَ","kind":"word","gloss":"those who","transliteration":"alladhīna","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"32:29:7","position":7,"arabic":"كَفَرُوٓا۟","kind":"word","gloss":"disbelieve","transliteration":"kafarū","lemma":"كَفَرَ","root":"كفر","entryId":"l-f6f8e55e4806177f"},{"key":"32:29:8","position":8,"arabic":"إِيمَـٰنُهُمْ","kind":"word","gloss":"their belief","transliteration":"īmānuhum","lemma":"إِيمَٰن","root":"امن","entryId":"l-3cb3b4add672df6c"},{"key":"32:29:9","position":9,"arabic":"وَلَا","kind":"word","gloss":"and not","transliteration":"walā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"32:29:10","position":10,"arabic":"هُمْ","kind":"word","gloss":"they","transliteration":"hum","lemma":null,"root":null,"entryId":null},{"key":"32:29:11","position":11,"arabic":"يُنظَرُونَ","kind":"word","gloss":"will be granted respite","transliteration":"yunẓarūna","lemma":"يُنظَرُ","root":"نظر","entryId":null},{"key":"32:29:12","position":12,"arabic":"٢٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"Say: \"On the Day of Al-Fath (Decision), no profit will it be to those who disbelieve if they (then) believe! Nor will they be granted a respite.\"","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"32:29:8","targetGloss":"their belief","targetTransliteration":"īmānuhum","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]},{"ref":"3:177","tokens":[{"key":"3:177:1","position":1,"arabic":"إِنَّ","kind":"word","gloss":"Indeed","transliteration":"inna","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"3:177:2","position":2,"arabic":"ٱلَّذِينَ","kind":"word","gloss":"those who","transliteration":"alladhīna","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"3:177:3","position":3,"arabic":"ٱشْتَرَوُا۟","kind":"word","gloss":"(have) purchased","transliteration":"ish'tarawū","lemma":"اشْتَرَىٰ","root":"شري","entryId":null},{"key":"3:177:4","position":4,"arabic":"ٱلْكُفْرَ","kind":"word","gloss":"[the] disbelief","transliteration":"l-kuf'ra","lemma":"كُفْر","root":"كفر","entryId":"l-6cf6b039795a28cf"},{"key":"3:177:5","position":5,"arabic":"بِٱلْإِيمَـٰنِ","kind":"word","gloss":"with the faith","transliteration":"bil-īmāni","lemma":"إِيمَٰن","root":"امن","entryId":"l-3cb3b4add672df6c"},{"key":"3:177:6","position":6,"arabic":"لَن","kind":"word","gloss":"never","transliteration":"lan","lemma":"لَن","root":null,"entryId":"l-3db5462128ff695e"},{"key":"3:177:7","position":7,"arabic":"يَضُرُّوا۟","kind":"word","gloss":"will they harm","transliteration":"yaḍurrū","lemma":"يَضُرَّ","root":"ضرر","entryId":null},{"key":"3:177:8","position":8,"arabic":"ٱللَّهَ","kind":"word","gloss":"Allah","transliteration":"l-laha","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"3:177:9","position":9,"arabic":"شَيْـًۭٔا","kind":"word","gloss":"(in) anything","transliteration":"shayan","lemma":"شَىْء","root":"شيا","entryId":"l-180c07cc91c0f47b"},{"key":"3:177:10","position":10,"arabic":"وَلَهُمْ","kind":"word","gloss":"and for them","transliteration":"walahum","lemma":null,"root":null,"entryId":null},{"key":"3:177:11","position":11,"arabic":"عَذَابٌ","kind":"word","gloss":"(is) a punishment","transliteration":"ʿadhābun","lemma":"عَذَاب","root":"عذب","entryId":"l-3eb7e15951d31876"},{"key":"3:177:12","position":12,"arabic":"أَلِيمٌۭ","kind":"word","gloss":"painful","transliteration":"alīmun","lemma":"أَلِيم","root":"الم","entryId":"l-e6db50422187d325"},{"key":"3:177:13","position":13,"arabic":"١٧٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"Verily, those who purchase disbelief at the price of Faith, not the least harm will they do to Allâh. For them, there is a painful torment.","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"3:177:5","targetGloss":"with the faith","targetTransliteration":"bil-īmāni","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]}]}