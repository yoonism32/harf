{"entry":{"id":"l-2798330af5521eb0","lemma":"ابْن","root":"بني","arabic":"ٱبْنُ","gloss":"(the) son","transliteration":"ub'nu","representativeKey":"19:34:3","exampleKeys":["19:34:3","43:57:3","17:26:6"],"occurrenceCount":63,"courseOrder":169,"sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"],"rootId":"r-c41e99a19a362128","approval":{"status":"pending"}},"examples":[{"ref":"19:34","tokens":[{"key":"19:34:1","position":1,"arabic":"ذَٰلِكَ","kind":"word","gloss":"That","transliteration":"dhālika","lemma":"ذَٰلِك","root":null,"entryId":"l-096a9ad382db7640"},{"key":"19:34:2","position":2,"arabic":"عِيسَى","kind":"word","gloss":"(was) Isa","transliteration":"ʿīsā","lemma":"عِيسَى","root":null,"entryId":null},{"key":"19:34:3","position":3,"arabic":"ٱبْنُ","kind":"word","gloss":"(the) son","transliteration":"ub'nu","lemma":"ابْن","root":"بني","entryId":"l-2798330af5521eb0"},{"key":"19:34:4","position":4,"arabic":"مَرْيَمَ ۚ","kind":"word","gloss":"(of) Maryam","transliteration":"maryama","lemma":"مَرْيَم","root":null,"entryId":null},{"key":"19:34:5","position":5,"arabic":"قَوْلَ","kind":"word","gloss":"a statement","transliteration":"qawla","lemma":"قَوْل","root":"قول","entryId":"l-5fc9c7afcefb8aa7"},{"key":"19:34:6","position":6,"arabic":"ٱلْحَقِّ","kind":"word","gloss":"(of) truth","transliteration":"l-ḥaqi","lemma":"حَقّ","root":"حقق","entryId":"l-ab22afcdeb66ae98"},{"key":"19:34:7","position":7,"arabic":"ٱلَّذِى","kind":"word","gloss":"that which","transliteration":"alladhī","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"19:34:8","position":8,"arabic":"فِيهِ","kind":"word","gloss":"about it","transliteration":"fīhi","lemma":"فِى","root":null,"entryId":"l-f0418efd4241a27e"},{"key":"19:34:9","position":9,"arabic":"يَمْتَرُونَ","kind":"word","gloss":"they dispute","transliteration":"yamtarūna","lemma":"يَمْتَرُ","root":"مري","entryId":null},{"key":"19:34:10","position":10,"arabic":"٣٤","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"Such is ‘Îsâ (Jesus), son of Maryam (Mary). (It is) a statement of truth, about which they doubt (or dispute).","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"19:34:3","targetGloss":"(the) son","targetTransliteration":"ub'nu","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]},{"ref":"43:57","tokens":[{"key":"43:57:1","position":1,"arabic":"۞ وَلَمَّا","kind":"word","gloss":"And when","transliteration":"walammā","lemma":"لَمَّا","root":null,"entryId":"l-c1b5336198ac1aed"},{"key":"43:57:2","position":2,"arabic":"ضُرِبَ","kind":"word","gloss":"is presented","transliteration":"ḍuriba","lemma":"ضَرَبَ","root":"ضرب","entryId":"l-000e14456237ca88"},{"key":"43:57:3","position":3,"arabic":"ٱبْنُ","kind":"word","gloss":"(the) son","transliteration":"ub'nu","lemma":"ابْن","root":"بني","entryId":"l-2798330af5521eb0"},{"key":"43:57:4","position":4,"arabic":"مَرْيَمَ","kind":"word","gloss":"(of) Maryam","transliteration":"maryama","lemma":"مَرْيَم","root":null,"entryId":null},{"key":"43:57:5","position":5,"arabic":"مَثَلًا","kind":"word","gloss":"(as) an example","transliteration":"mathalan","lemma":"مَثَل","root":"مثل","entryId":"l-b67e1c19ddcf5a93"},{"key":"43:57:6","position":6,"arabic":"إِذَا","kind":"word","gloss":"behold","transliteration":"idhā","lemma":"إِذَا","root":null,"entryId":"l-d00a4141bad00037"},{"key":"43:57:7","position":7,"arabic":"قَوْمُكَ","kind":"word","gloss":"Your people","transliteration":"qawmuka","lemma":"قَوْم","root":"قوم","entryId":"l-049e2cd6a60d39f0"},{"key":"43:57:8","position":8,"arabic":"مِنْهُ","kind":"word","gloss":"about it","transliteration":"min'hu","lemma":"مِن","root":null,"entryId":"l-9235e02e84a628b3"},{"key":"43:57:9","position":9,"arabic":"يَصِدُّونَ","kind":"word","gloss":"laughed aloud","transliteration":"yaṣiddūna","lemma":"صَدَّ","root":"صدد","entryId":"l-ca9317c6385dd6cf"},{"key":"43:57:10","position":10,"arabic":"٥٧","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"And when the son of Maryam (Mary) is quoted as an example [i.e. ‘Îsâ (Jesus) is worshipped like their idols], behold, your people cry aloud (laugh out at the example).","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"43:57:3","targetGloss":"(the) son","targetTransliteration":"ub'nu","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]},{"ref":"17:26","tokens":[{"key":"17:26:1","position":1,"arabic":"وَءَاتِ","kind":"word","gloss":"And give","transliteration":"waāti","lemma":"آتَى","root":"اتي","entryId":"l-45664741cd653ab4"},{"key":"17:26:2","position":2,"arabic":"ذَا","kind":"word","gloss":"the relatives","transliteration":"dhā","lemma":"ذَا","root":null,"entryId":null},{"key":"17:26:3","position":3,"arabic":"ٱلْقُرْبَىٰ","kind":"word","gloss":"the relatives","transliteration":"l-qur'bā","lemma":"قُرْبَىٰ","root":"قرب","entryId":null},{"key":"17:26:4","position":4,"arabic":"حَقَّهُۥ","kind":"word","gloss":"his right","transliteration":"ḥaqqahu","lemma":"حَقّ","root":"حقق","entryId":"l-ab22afcdeb66ae98"},{"key":"17:26:5","position":5,"arabic":"وَٱلْمِسْكِينَ","kind":"word","gloss":"and the needy","transliteration":"wal-mis'kīna","lemma":"مِسْكِين","root":"سكن","entryId":null},{"key":"17:26:6","position":6,"arabic":"وَٱبْنَ","kind":"word","gloss":"and the wayfarer","transliteration":"wa-ib'na","lemma":"ابْن","root":"بني","entryId":"l-2798330af5521eb0"},{"key":"17:26:7","position":7,"arabic":"ٱلسَّبِيلِ","kind":"word","gloss":"and the wayfarer","transliteration":"l-sabīli","lemma":"سَبِيل","root":"سبل","entryId":"l-c204df14296b43ea"},{"key":"17:26:8","position":8,"arabic":"وَلَا","kind":"word","gloss":"and (do) not","transliteration":"walā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"17:26:9","position":9,"arabic":"تُبَذِّرْ","kind":"word","gloss":"spend","transliteration":"tubadhir","lemma":"تُبَذِّرْ","root":"بذر","entryId":null},{"key":"17:26:10","position":10,"arabic":"تَبْذِيرًا","kind":"word","gloss":"wastefully","transliteration":"tabdhīran","lemma":"تَبْذِير","root":"بذر","entryId":null},{"key":"17:26:11","position":11,"arabic":"٢٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"And give to the kinsman his due and to the Miskîn (poor) and to the wayfarer. But spend not wastefully (your wealth) in the manner of a spendthrift. (Tafsir At-Tabarî)","translationSource":"qul-301-hilali-khan","notes":[{"text":"See the footnote of (V.2:83).","ref":{"surah":2,"ayah":83}},{"text":"You have to follow a middle course in your spendings - neither a miser nor a spendthrift, and not to be like those who spend in the disobedience of Allâh and His Messenger صلى الله عليه وسلم.","ref":null}],"targetKey":"17:26:6","targetGloss":"and the wayfarer","targetTransliteration":"wa-ib'na","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]}]}