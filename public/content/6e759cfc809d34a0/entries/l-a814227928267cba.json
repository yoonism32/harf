{"entry":{"id":"l-a814227928267cba","lemma":"اسْتَغْفَرَ","root":"غفر","arabic":"يَسْتَغْفِرُونَ","gloss":"would ask forgiveness","transliteration":"yastaghfirūna","representativeKey":"51:18:3","exampleKeys":["51:18:3","71:10:2","4:106:1"],"occurrenceCount":40,"courseOrder":266,"sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"],"rootId":"r-bd8facafd6cb4680","approval":{"status":"pending"}},"examples":[{"ref":"51:18","tokens":[{"key":"51:18:1","position":1,"arabic":"وَبِٱلْأَسْحَارِ","kind":"word","gloss":"And in the hours before dawn","transliteration":"wabil-asḥāri","lemma":"سَحَر","root":"سحر","entryId":null},{"key":"51:18:2","position":2,"arabic":"هُمْ","kind":"word","gloss":"they","transliteration":"hum","lemma":null,"root":null,"entryId":null},{"key":"51:18:3","position":3,"arabic":"يَسْتَغْفِرُونَ","kind":"word","gloss":"would ask forgiveness","transliteration":"yastaghfirūna","lemma":"اسْتَغْفَرَ","root":"غفر","entryId":"l-a814227928267cba"},{"key":"51:18:4","position":4,"arabic":"١٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"And in the hours before dawn, they were (found) asking (Allâh) for forgiveness.","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"51:18:3","targetGloss":"would ask forgiveness","targetTransliteration":"yastaghfirūna","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]},{"ref":"71:10","tokens":[{"key":"71:10:1","position":1,"arabic":"فَقُلْتُ","kind":"word","gloss":"Then I said","transliteration":"faqul'tu","lemma":"قَالَ","root":"قول","entryId":"l-effaf24a5c86c56f"},{"key":"71:10:2","position":2,"arabic":"ٱسْتَغْفِرُوا۟","kind":"word","gloss":"Ask forgiveness","transliteration":"is'taghfirū","lemma":"اسْتَغْفَرَ","root":"غفر","entryId":"l-a814227928267cba"},{"key":"71:10:3","position":3,"arabic":"رَبَّكُمْ","kind":"word","gloss":"(from) your Lord","transliteration":"rabbakum","lemma":"رَبّ","root":"ربب","entryId":"l-a0ed3c982709a296"},{"key":"71:10:4","position":4,"arabic":"إِنَّهُۥ","kind":"word","gloss":"Indeed, He","transliteration":"innahu","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"71:10:5","position":5,"arabic":"كَانَ","kind":"word","gloss":"is","transliteration":"kāna","lemma":"كَانَ","root":"كون","entryId":"l-4b2f9969a9af0d45"},{"key":"71:10:6","position":6,"arabic":"غَفَّارًۭا","kind":"word","gloss":"Oft-Forgiving","transliteration":"ghaffāran","lemma":"غَفَّار","root":"غفر","entryId":null},{"key":"71:10:7","position":7,"arabic":"١٠","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"\"I said (to them): ‘Ask forgiveness from your Lord, verily, He is Oft-Forgiving;","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"71:10:2","targetGloss":"Ask forgiveness","targetTransliteration":"is'taghfirū","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]},{"ref":"4:106","tokens":[{"key":"4:106:1","position":1,"arabic":"وَٱسْتَغْفِرِ","kind":"word","gloss":"And seek forgiveness","transliteration":"wa-is'taghfiri","lemma":"اسْتَغْفَرَ","root":"غفر","entryId":"l-a814227928267cba"},{"key":"4:106:2","position":2,"arabic":"ٱللَّهَ ۖ","kind":"word","gloss":"(of) Allah","transliteration":"l-laha","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"4:106:3","position":3,"arabic":"إِنَّ","kind":"word","gloss":"Indeed","transliteration":"inna","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"4:106:4","position":4,"arabic":"ٱللَّهَ","kind":"word","gloss":"Allah","transliteration":"l-laha","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"4:106:5","position":5,"arabic":"كَانَ","kind":"word","gloss":"is","transliteration":"kāna","lemma":null,"root":"كون","entryId":null},{"key":"4:106:6","position":6,"arabic":"غَفُورًۭا","kind":"word","gloss":"Oft-Forgiving","transliteration":"ghafūran","lemma":"كَانَ","root":"غفر","entryId":null},{"key":"4:106:7","position":7,"arabic":"رَّحِيمًۭا","kind":"word","gloss":"Most Merciful","transliteration":"raḥīman","lemma":"رَّحِيم","root":"رحم","entryId":"l-32ecfde63eaeeb3f"},{"key":"4:106:8","position":8,"arabic":"١٠٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"And seek the Forgiveness of Allâh, certainly, Allâh is Ever Oft-Forgiving, Most Merciful.","translationSource":"qul-301-hilali-khan","notes":[{"text":"The Prophet’s صلى الله عليه وسلم seeking of Allâh’s Forgiveness by daytime and at night. Narrated Abu Hurairah رضي الله عنه: I heard Allâh’s Messenger صلى الله عليه وسلم saying: \"By Allâh! I seek Allâh’s Forgiveness and turn to Him in repentance for more than seventy times a day.\" (Sahih Al-Bukhâri’, Vol.8, Hadîth No.319).","ref":null}],"targetKey":"4:106:1","targetGloss":"And seek forgiveness","targetTransliteration":"wa-is'taghfiri","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]}]}