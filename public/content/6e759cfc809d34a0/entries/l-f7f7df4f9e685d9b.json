{"entry":{"id":"l-f7f7df4f9e685d9b","lemma":"وَلِىّ","root":"ولي","arabic":"وَلِـِّۧىَ","gloss":"my protector","transliteration":"waliyyiya","representativeKey":"7:196:2","exampleKeys":["7:196:2","10:62:3","3:175:5"],"occurrenceCount":44,"courseOrder":249,"sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"],"rootId":"r-9477d29d9ad02910","approval":{"status":"pending"}},"examples":[{"ref":"7:196","tokens":[{"key":"7:196:1","position":1,"arabic":"إِنَّ","kind":"word","gloss":"Indeed","transliteration":"inna","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"7:196:2","position":2,"arabic":"وَلِـِّۧىَ","kind":"word","gloss":"my protector","transliteration":"waliyyiya","lemma":"وَلِىّ","root":"ولي","entryId":"l-f7f7df4f9e685d9b"},{"key":"7:196:3","position":3,"arabic":"ٱللَّهُ","kind":"word","gloss":"(is) Allah","transliteration":"l-lahu","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"7:196:4","position":4,"arabic":"ٱلَّذِى","kind":"word","gloss":"the One Who","transliteration":"alladhī","lemma":"الَّذِى","root":null,"entryId":"l-5016cb590bd9088a"},{"key":"7:196:5","position":5,"arabic":"نَزَّلَ","kind":"word","gloss":"revealed","transliteration":"nazzala","lemma":"نَزَّلَ","root":"نزل","entryId":"l-5f5d4e3c1d9b05b3"},{"key":"7:196:6","position":6,"arabic":"ٱلْكِتَـٰبَ ۖ","kind":"word","gloss":"the Book","transliteration":"l-kitāba","lemma":"كِتَٰب","root":"كتب","entryId":"l-a68c915be321aa35"},{"key":"7:196:7","position":7,"arabic":"وَهُوَ","kind":"word","gloss":"And He","transliteration":"wahuwa","lemma":null,"root":null,"entryId":null},{"key":"7:196:8","position":8,"arabic":"يَتَوَلَّى","kind":"word","gloss":"protects","transliteration":"yatawallā","lemma":"تَوَلَّىٰ","root":"ولي","entryId":"l-f32564c74acc4226"},{"key":"7:196:9","position":9,"arabic":"ٱلصَّـٰلِحِينَ","kind":"word","gloss":"the righteous","transliteration":"l-ṣāliḥīna","lemma":"صَٰلِح","root":"صلح","entryId":"l-fc63b5b8005cab08"},{"key":"7:196:10","position":10,"arabic":"١٩٦","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"Verily, my Walî (Protector, Supporter, and Helper) is Allâh Who has revealed the Book (the Qur’ân), and He protects (supports and helps) the righteous.","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"7:196:2","targetGloss":"my protector","targetTransliteration":"waliyyiya","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]},{"ref":"10:62","tokens":[{"key":"10:62:1","position":1,"arabic":"أَلَآ","kind":"word","gloss":"No doubt","transliteration":"alā","lemma":"أَلَآ","root":null,"entryId":"l-39ed305892f7802f"},{"key":"10:62:2","position":2,"arabic":"إِنَّ","kind":"word","gloss":"Indeed","transliteration":"inna","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"10:62:3","position":3,"arabic":"أَوْلِيَآءَ","kind":"word","gloss":"(the) friends","transliteration":"awliyāa","lemma":"وَلِىّ","root":"ولي","entryId":"l-f7f7df4f9e685d9b"},{"key":"10:62:4","position":4,"arabic":"ٱللَّهِ","kind":"word","gloss":"(of) Allah","transliteration":"l-lahi","lemma":"اللَّه","root":"اله","entryId":"l-4b28e3627200a6c3"},{"key":"10:62:5","position":5,"arabic":"لَا","kind":"word","gloss":"(there will be) no","transliteration":"lā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"10:62:6","position":6,"arabic":"خَوْفٌ","kind":"word","gloss":"fear","transliteration":"khawfun","lemma":"خَوْف","root":"خوف","entryId":null},{"key":"10:62:7","position":7,"arabic":"عَلَيْهِمْ","kind":"word","gloss":"upon then","transliteration":"ʿalayhim","lemma":"عَلَىٰ","root":null,"entryId":"l-08dd9283adb70e54"},{"key":"10:62:8","position":8,"arabic":"وَلَا","kind":"word","gloss":"and not","transliteration":"walā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"10:62:9","position":9,"arabic":"هُمْ","kind":"word","gloss":"they","transliteration":"hum","lemma":null,"root":null,"entryId":null},{"key":"10:62:10","position":10,"arabic":"يَحْزَنُونَ","kind":"word","gloss":"will grieve","transliteration":"yaḥzanūna","lemma":"يَحْزُن","root":"حزن","entryId":"l-412efcd4663cd8d4"},{"key":"10:62:11","position":11,"arabic":"٦٢","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"No doubt! Verily, the Auliyâ’ of Allâh [i.e. those who believe in the Oneness of Allâh and fear Allâh much (abstain from all kinds of sins and evil deeds which he has forbidden), and love Allâh much (perform all kinds of good deeds which He has ordained)], no fear shall come upon them nor shall they grieve.","translationSource":"qul-301-hilali-khan","notes":[{"text":"Narrated Abu Sa‘îd Al-Khudrî رضي الله عنه: Allâh’s Messenger صلى الله عليه وسلم said, \"When the funeral is ready and the men carry it on their shoulders, if the deceased was righteous, it will say: ‘Present me (hurriedly),’ and if he was not righteous, it will say: ‘Woe to it (me)! Where are they taking it (me)?’ Its voice is heard by everything except man, and if he heard it, he would fall unconscious.\" (Sahih Al-Bukhari, Vol.2,Hadith No.400).","ref":null}],"targetKey":"10:62:3","targetGloss":"(the) friends","targetTransliteration":"awliyāa","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]},{"ref":"3:175","tokens":[{"key":"3:175:1","position":1,"arabic":"إِنَّمَا","kind":"word","gloss":"(It is) only","transliteration":"innamā","lemma":"إِنّ","root":null,"entryId":"l-3afba549abbd5639"},{"key":"3:175:2","position":2,"arabic":"ذَٰلِكُمُ","kind":"word","gloss":"that","transliteration":"dhālikumu","lemma":"ذَٰلِك","root":null,"entryId":"l-096a9ad382db7640"},{"key":"3:175:3","position":3,"arabic":"ٱلشَّيْطَـٰنُ","kind":"word","gloss":"the Shaitaan","transliteration":"l-shayṭānu","lemma":"شَيْطَٰن","root":"شطن","entryId":"l-1edf2a3c0afdde81"},{"key":"3:175:4","position":4,"arabic":"يُخَوِّفُ","kind":"word","gloss":"frightens (you)","transliteration":"yukhawwifu","lemma":"يُخَوِّفُ","root":"خوف","entryId":null},{"key":"3:175:5","position":5,"arabic":"أَوْلِيَآءَهُۥ","kind":"word","gloss":"(of) his allies","transliteration":"awliyāahu","lemma":"وَلِىّ","root":"ولي","entryId":"l-f7f7df4f9e685d9b"},{"key":"3:175:6","position":6,"arabic":"فَلَا","kind":"word","gloss":"So (do) not","transliteration":"falā","lemma":"لَا","root":null,"entryId":"l-93952243ccc22536"},{"key":"3:175:7","position":7,"arabic":"تَخَافُوهُمْ","kind":"word","gloss":"fear them","transliteration":"takhāfūhum","lemma":"خَافَ","root":"خوف","entryId":"l-987e65cf85f6e297"},{"key":"3:175:8","position":8,"arabic":"وَخَافُونِ","kind":"word","gloss":"but fear Me","transliteration":"wakhāfūni","lemma":"خَافَ","root":"خوف","entryId":"l-987e65cf85f6e297"},{"key":"3:175:9","position":9,"arabic":"إِن","kind":"word","gloss":"if","transliteration":"in","lemma":"إِن","root":null,"entryId":"l-de626c6526849733"},{"key":"3:175:10","position":10,"arabic":"كُنتُم","kind":"word","gloss":"you are","transliteration":"kuntum","lemma":"كَانَ","root":"كون","entryId":"l-4b2f9969a9af0d45"},{"key":"3:175:11","position":11,"arabic":"مُّؤْمِنِينَ","kind":"word","gloss":"believers","transliteration":"mu'minīna","lemma":"مُؤْمِن","root":"امن","entryId":"l-e50e89ab6c1d4965"},{"key":"3:175:12","position":12,"arabic":"١٧٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"It is only Shaitân (Satan) that suggests to you the fear of his Auliyâ’ [supporters and friends (polytheists, disbelievers in the Oneness of Allâh and in His Messenger, Muhammad صلى الله عليه وسلم)]; so fear them not, but fear Me, if you are (true) believers.","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"3:175:5","targetGloss":"(of) his allies","targetTransliteration":"awliyāahu","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]}]}