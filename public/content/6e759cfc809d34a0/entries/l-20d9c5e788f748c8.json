{"entry":{"id":"l-20d9c5e788f748c8","lemma":"مُجْرِم","root":"جرم","arabic":"كَٱلْمُجْرِمِينَ","gloss":"like the criminals","transliteration":"kal-muj'rimīna","representativeKey":"68:35:3","exampleKeys":["68:35:3","77:18:3","26:99:4"],"occurrenceCount":52,"courseOrder":212,"sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"],"rootId":"r-67da1146db36c653","approval":{"status":"pending"}},"examples":[{"ref":"68:35","tokens":[{"key":"68:35:1","position":1,"arabic":"أَفَنَجْعَلُ","kind":"word","gloss":"Then will We treat","transliteration":"afanajʿalu","lemma":"جَعَلَ","root":"جعل","entryId":"l-784f751d925aef34"},{"key":"68:35:2","position":2,"arabic":"ٱلْمُسْلِمِينَ","kind":"word","gloss":"the Muslims","transliteration":"l-mus'limīna","lemma":"مُسْلِم","root":"سلم","entryId":"l-d22b2ec969b5a01d"},{"key":"68:35:3","position":3,"arabic":"كَٱلْمُجْرِمِينَ","kind":"word","gloss":"like the criminals","transliteration":"kal-muj'rimīna","lemma":"مُجْرِم","root":"جرم","entryId":"l-20d9c5e788f748c8"},{"key":"68:35:4","position":4,"arabic":"٣٥","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"Shall We then treat the Muslims (believers of Islamic Monotheism, doers of righteous deeds) like the Mujrimûn (criminals, polytheists and disbelievers, etc.)?","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"68:35:3","targetGloss":"like the criminals","targetTransliteration":"kal-muj'rimīna","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]},{"ref":"77:18","tokens":[{"key":"77:18:1","position":1,"arabic":"كَذَٰلِكَ","kind":"word","gloss":"Thus","transliteration":"kadhālika","lemma":"ذَٰلِك","root":null,"entryId":"l-096a9ad382db7640"},{"key":"77:18:2","position":2,"arabic":"نَفْعَلُ","kind":"word","gloss":"We deal","transliteration":"nafʿalu","lemma":"فَعَلَ","root":"فعل","entryId":"l-b0a120934c602e5e"},{"key":"77:18:3","position":3,"arabic":"بِٱلْمُجْرِمِينَ","kind":"word","gloss":"with the criminals","transliteration":"bil-muj'rimīna","lemma":"مُجْرِم","root":"جرم","entryId":"l-20d9c5e788f748c8"},{"key":"77:18:4","position":4,"arabic":"١٨","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"Thus do We deal with the Mujrimûn (polytheists, disbelievers, sinners, criminals).","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"77:18:3","targetGloss":"with the criminals","targetTransliteration":"bil-muj'rimīna","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]},{"ref":"26:99","tokens":[{"key":"26:99:1","position":1,"arabic":"وَمَآ","kind":"word","gloss":"And not","transliteration":"wamā","lemma":"مَا","root":null,"entryId":"l-1323d62dd382644d"},{"key":"26:99:2","position":2,"arabic":"أَضَلَّنَآ","kind":"word","gloss":"misguided us","transliteration":"aḍallanā","lemma":"أَضَلَّ","root":"ضلل","entryId":"l-73112703ea29a8c7"},{"key":"26:99:3","position":3,"arabic":"إِلَّا","kind":"word","gloss":"except","transliteration":"illā","lemma":"إِلَّا","root":null,"entryId":"l-250ca4d5b58814dd"},{"key":"26:99:4","position":4,"arabic":"ٱلْمُجْرِمُونَ","kind":"word","gloss":"the criminals","transliteration":"l-muj'rimūna","lemma":"مُجْرِم","root":"جرم","entryId":"l-20d9c5e788f748c8"},{"key":"26:99:5","position":5,"arabic":"٩٩","kind":"end-marker","gloss":"","transliteration":"","lemma":null,"root":null,"entryId":null}],"translation":"And none has brought us into error except the Mujrimûn [Iblîs (Satan) and those of human beings who commit crimes, murderers, polytheists, oppressors].","translationSource":"qul-301-hilali-khan","notes":[],"targetKey":"26:99:4","targetGloss":"the criminals","targetTransliteration":"l-muj'rimūna","sourceIds":["qul-56","qul-92","qul-71","qul-75","qul-76","qul-301"]}]}