# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local scratch / research notes / personal data exports — not app code
/scripts/tmp-dump.ts
harf-backup-*.json
/1-5.txt
/inital-qsemantic.txt

# Supabase CLI local cache
/supabase/.temp/

# Agency run records live in ~/Code/my-agency/runs (private)
docs/agency-runs/

# graphify output (generated artifacts)
/graphify-out/

# QPC V2 page fonts: 105 MB of re-downloadable pinned inputs (QUL resource 249),
# byte-identical to the copies already shipped in public/content and pinned by fonts.json
data/source/qul/mushaf-v2/fonts/

# Personal working notes and agent tool state — kept locally, not published
/AGENTS.md
/CLAUDE.md
/HARF_REDESIGN_PLAN.md
/recently-fixed.md
/todo.md
/docs/ROADMAP.md
/docs/project_plan.md
